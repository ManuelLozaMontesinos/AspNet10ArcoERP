@model AspNet10ArcoERP.Models.PeriodoSistemaPageModel
@{
    ViewData["Title"] = "Períodos contables";
    var pageCount = Math.Max(1, (int)Math.Ceiling(Model.Total / (double)Model.PageSize));
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-1"><i class="bi bi-calendar3 me-2 text-primary"></i>Períodos contables</h3>
                <small class="text-muted">Administra los años del sistema y la habilitación de procesos por lotes.</small>
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-primary shadow-sm fw-semibold px-3" id="createPeriod">
                    <i class="bi bi-plus-circle-fill me-1"></i>Nuevo período
                </button>
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4">
    <div class="container-fluid">
        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-header bg-body-tertiary py-3">
                <form method="get" class="d-flex flex-wrap align-items-end gap-3">
                    <div style="min-width:320px;max-width:440px;flex:1 1 320px">
                        <label for="anio" class="form-label small fw-semibold">Buscar por año</label>
                        <input id="anio" name="anio" type="number" min="1900" max="9999" step="1"
                               value="@Model.SearchYear" class="form-control" placeholder="Ej. 2026" />
                    </div>
                    <div>
                        <label for="top" class="form-label small fw-semibold">Mostrando</label>
                        <select id="top" name="top" class="form-select">
                            @foreach (var size in new[] { 25, 50, 100, 500 })
                            {
                                <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>Buscar</button>
                    <a asp-area="AS" asp-controller="Periodo" asp-action="Index"
                       class="btn btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-arrow-counterclockwise"></i></a>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
                        @Model.Total período(s)
                    </span>
                </form>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0 table-fixed-header">
                    <thead class="bg-body-tertiary">
                        <tr>
                            <th class="text-center" style="width:100px">ID</th>
                            <th style="width:180px">Año</th>
                            <th>Procesos por lotes</th>
                            <th class="text-center" style="width:140px">Estado</th>
                            <th class="text-end" style="width:100px">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No se encontraron períodos.</td></tr>
                        }
                        @foreach (var item in Model.Items)
                        {
                            <tr class="@(item.Estado == "I" ? "text-body-secondary" : "")">
                                <td class="text-center">
                                    <span class="badge bg-secondary-subtle text-body border font-monospace">@item.Id</span>
                                </td>
                                <td class="fw-semibold">@item.Anio</td>
                                <td>
                                    @if (item.HabilitarProcesoBatch)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Habilitados</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-body-secondary border">Deshabilitados</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.Estado == "A")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-body-secondary border px-2 py-1">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (item.Estado == "A")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary js-edit"
                                                data-id="@item.Id" title="Editar configuración">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-body-tertiary d-flex flex-wrap align-items-center justify-content-between gap-2">
                <span class="small text-muted">Página @Model.Page de @pageCount · @Model.Total período(s)</span>
                <div class="btn-group btn-group-sm">
                    @if (Model.Page > 1)
                    {
                        <a class="btn btn-outline-secondary" asp-area="AS" asp-controller="Periodo" asp-action="Index"
                           asp-route-anio="@Model.SearchYear" asp-route-top="@Model.PageSize" asp-route-page="@(Model.Page - 1)">
                            <i class="bi bi-chevron-left me-1"></i>Anterior
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary" disabled><i class="bi bi-chevron-left me-1"></i>Anterior</button>
                    }
                    @if (Model.Page < pageCount)
                    {
                        <a class="btn btn-outline-secondary" asp-area="AS" asp-controller="Periodo" asp-action="Index"
                           asp-route-anio="@Model.SearchYear" asp-route-top="@Model.PageSize" asp-route-page="@(Model.Page + 1)">
                            Siguiente<i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary" disabled>Siguiente<i class="bi bi-chevron-right ms-1"></i></button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal-crud-periodo" tabindex="-1" aria-labelledby="periodModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <form id="periodForm" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="periodId" value="0" />
            <div class="modal-header sticky-top bg-body-tertiary">
                <div>
                    <h5 class="modal-title fw-bold" id="periodModalTitle"><i class="bi bi-calendar3 me-2"></i>Nuevo período</h5>
                    <div class="small text-muted">El año no se puede modificar después de crear el período.</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="card border-0 bg-body-tertiary">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-5">
                                <label for="periodYear" class="form-label small fw-semibold">
                                    Año <span class="text-danger">*</span>
                                </label>
                                <input type="number" class="form-control" id="periodYear" name="Anio"
                                       min="1900" max="9999" step="1" required />
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="periodBatch" name="HabilitarProcesoBatch" value="true" />
                                    <label class="form-check-label" for="periodBatch">Habilitar procesos por lotes</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer sticky-bottom bg-body-tertiary">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary" id="savePeriod">
                    <i class="bi bi-check2-circle me-1"></i>Guardar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <style>
        #modal-crud-periodo .modal-content {
            max-height: 90vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        #modal-crud-periodo .modal-body {
            max-height: calc(90vh - 135px) !important;
            overflow-y: auto !important;
            flex: 1 1 auto;
            scrollbar-width: thin;
            scrollbar-color: rgba(140, 150, 165, 0.4) transparent;
            scroll-behavior: smooth;
        }
        #modal-crud-periodo .modal-body::-webkit-scrollbar { width: 7px; }
        #modal-crud-periodo .modal-body::-webkit-scrollbar-track { background: transparent; }
        #modal-crud-periodo .modal-body::-webkit-scrollbar-thumb { background: rgba(140, 150, 165, 0.45); border-radius: 4px; }
        #modal-crud-periodo .modal-body::-webkit-scrollbar-thumb:hover { background: rgba(140, 150, 165, 0.75); }
    </style>
    <script>
        (() => {
            const modalElement = document.getElementById('modal-crud-periodo');
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            const form = document.getElementById('periodForm');
            const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
            const getUrl = '@Url.Action("Obtener", "Periodo", new { area = "AS" })';
            const saveUrl = '@Url.Action("Guardar", "Periodo", new { area = "AS" })';
            const idInput = document.getElementById('periodId');
            const yearInput = document.getElementById('periodYear');
            const batchInput = document.getElementById('periodBatch');

            async function postForm() {
                const response = await fetch(saveUrl, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body: new FormData(form)
                });
                const result = await response.json();
                if (!response.ok || !result.success)
                    throw new Error(result.message || 'No se pudo guardar el período.');
                return result;
            }

            document.getElementById('createPeriod').addEventListener('click', () => {
                form.reset();
                idInput.value = '0';
                yearInput.readOnly = false;
                yearInput.value = new Date().getFullYear();
                document.getElementById('periodModalTitle').innerHTML = '<i class="bi bi-calendar3 me-2"></i>Nuevo período';
                modal.show();
                setTimeout(() => yearInput.focus(), 200);
            });

            document.querySelectorAll('.js-edit').forEach(button => {
                button.addEventListener('click', async () => {
                    try {
                        const url = new URL(getUrl, window.location.origin);
                        url.searchParams.set('id', button.dataset.id);
                        const response = await fetch(url);
                        const result = await response.json();
                        if (!response.ok || !result.success)
                            throw new Error(result.message || 'No se pudo cargar el período.');
                        idInput.value = result.data.id;
                        yearInput.value = result.data.anio;
                        yearInput.readOnly = true;
                        batchInput.checked = result.data.habilitarProcesoBatch;
                        document.getElementById('periodModalTitle').innerHTML = '<i class="bi bi-pencil-square me-2"></i>Editar período';
                        modal.show();
                    } catch (error) {
                        Swal.fire({ icon: 'error', title: 'No se pudo abrir el período', text: error.message });
                    }
                });
            });

            form.addEventListener('submit', async event => {
                event.preventDefault();
                if (!form.reportValidity())
                    return;
                try {
                    const result = await postForm();
                    modal.hide();
                    await Swal.fire({
                        toast: true, position: 'top-end', icon: 'success', title: result.message,
                        showConfirmButton: false, timer: 2300
                    });
                    window.location.reload();
                } catch (error) {
                    Swal.fire({ icon: 'error', title: 'No se pudo guardar', text: error.message });
                }
            });
        })();
    </script>
}
