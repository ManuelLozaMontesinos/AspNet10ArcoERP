@addTagHelper *, AspNet10ArcoERP
@model AspNet10ArcoERP.Models.PeriodoSistemaPageModel
@{ ViewData["Title"]="Períodos contables"; }
<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid"><div class="row align-items-center g-3">
        <div class="col"><h3 class="mb-0 fw-bold d-flex align-items-center"><i class="bi bi-calendar3 me-2 text-primary"></i>Períodos contables</h3><small class="text-muted">Administra los años del sistema y la habilitación de procesos por lotes.</small></div>
        <div class="col-auto"><button type="button" class="btn btn-primary shadow-sm" id="createPeriod"><i class="bi bi-plus-circle-fill me-1"></i>Nuevo período</button></div>
    </div></div>
</div>
<div class="app-content py-4 erp-listing"><div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="card-body py-2 px-3 erp-filter-bar">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <form method="get" class="d-flex flex-wrap align-items-center gap-2 m-0">
                <input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="dir" value="@Model.Dir" /><input type="hidden" name="top" value="@Model.PageSize" />
                <div class="input-group input-group-sm listing-search">
                    <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input id="anio" name="anio" type="number" min="1900" max="9999" value="@Model.SearchYear" class="form-control border-start-0" placeholder="Buscar por año..." aria-label="Buscar por año" />
                    <button class="btn btn-outline-primary" type="submit">Buscar</button>
                    <a asp-action="Index" asp-route-top="@Model.PageSize" asp-route-sort="@Model.Sort" asp-route-dir="@Model.Dir" class="btn btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
                </div>
            </form>
            <partial name="_ListadoControles" model="Model" />
        </div>
    </div></div>
    <div class="card border-0 shadow-sm rounded-3 mb-3">
        <div class="table-responsive table-scroll"><table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
            <thead class="table-header-custom bg-body-tertiary border-bottom"><tr>
                <th erp-sort="id" erp-numeric="true" class="text-center">ID</th><th erp-sort="anio" erp-numeric="true">Año</th><th erp-sort="batch">Procesos por lotes</th><th erp-sort="estado" class="text-center">Estado</th><th class="listing-options">Opciones</th>
            </tr></thead>
            <tbody>
                @if(Model.Items.Count==0){<tr><td colspan="5" class="text-center text-muted py-5"><i class="bi bi-inbox fs-1 d-block mb-2"></i>No se encontraron períodos.</td></tr>}
                @foreach(var item in Model.Items)
                {
                    <tr>
                        <td class="text-center font-monospace small text-muted">@item.Id</td><td class="fw-semibold">@item.Anio</td>
                        <td><span class="badge @(item.HabilitarProcesoBatch?"bg-primary-subtle text-primary border border-primary-subtle":"bg-secondary-subtle text-body-secondary border")">@(item.HabilitarProcesoBatch?"Habilitados":"Deshabilitados")</span></td>
                        <td class="text-center"><span class="badge @(item.Estado=="A"?"bg-success-subtle text-success border border-success-subtle":"bg-secondary-subtle text-body-secondary border")">@(item.Estado=="A"?"Activo":"Inactivo")</span></td>
                        <td class="listing-options">@if(item.Estado=="A"){<button type="button" class="btn btn-sm btn-outline-primary js-edit" data-id="@item.Id" title="Editar configuración"><i class="bi bi-pencil-square"></i></button>}</td>
                    </tr>
                }
            </tbody>
        </table></div>
        <partial name="_ListadoPaginacion" model="Model" />
    </div>
</div></div>

<div class="modal fade" id="modal-crud-periodo" tabindex="-1" aria-labelledby="periodModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <form id="periodForm" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="periodId" value="0" />
            <div class="modal-header sticky-top bg-body-tertiary">
                <div>
                    <h5 class="modal-title fw-bold" id="periodModalTitle"><i class="bi bi-calendar3 me-2"></i>Nuevo período</h5>
                    <div class="small text-muted">El año no se puede modificar después de crear el período.</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="card border-0 bg-body-tertiary">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-5">
                                <label for="periodYear" class="form-label small fw-semibold">
                                    Año <span class="text-danger">*</span>
                                </label>
                                <input type="number" class="form-control" id="periodYear" name="Anio"
                                       min="1900" max="9999" step="1" required />
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="periodBatch" name="HabilitarProcesoBatch" value="true" />
                                    <label class="form-check-label" for="periodBatch">Habilitar procesos por lotes</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer sticky-bottom bg-body-tertiary">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary" id="savePeriod">
                    <i class="bi bi-check2-circle me-1"></i>Guardar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {

    <script>
        (() => {
            const modalElement = document.getElementById('modal-crud-periodo');
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            const form = document.getElementById('periodForm');
            const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
            const getUrl = '@Url.Action("Obtener", "Periodo", new { area = "AS" })';
            const saveUrl = '@Url.Action("Guardar", "Periodo", new { area = "AS" })';
            const idInput = document.getElementById('periodId');
            const yearInput = document.getElementById('periodYear');
            const batchInput = document.getElementById('periodBatch');

            async function postForm() {
                const response = await fetch(saveUrl, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body: new FormData(form)
                });
                const result = await response.json();
                if (!response.ok || !result.success)
                    throw new Error(result.message || 'No se pudo guardar el período.');
                return result;
            }

            document.getElementById('createPeriod').addEventListener('click', () => {
                form.reset();
                idInput.value = '0';
                yearInput.readOnly = false;
                yearInput.value = new Date().getFullYear();
                document.getElementById('periodModalTitle').innerHTML = '<i class="bi bi-calendar3 me-2"></i>Nuevo período';
                modal.show();
                setTimeout(() => yearInput.focus(), 200);
            });

            window.erpListings.onClick('.js-edit', async (button) => {
                    try {
                        const url = new URL(getUrl, window.location.origin);
                        url.searchParams.set('id', button.dataset.id);
                        const response = await fetch(url);
                        const result = await response.json();
                        if (!response.ok || !result.success)
                            throw new Error(result.message || 'No se pudo cargar el período.');
                        idInput.value = result.data.id;
                        yearInput.value = result.data.anio;
                        yearInput.readOnly = true;
                        batchInput.checked = result.data.habilitarProcesoBatch;
                        document.getElementById('periodModalTitle').innerHTML = '<i class="bi bi-pencil-square me-2"></i>Editar período';
                        modal.show();
                    } catch (error) {
                        Swal.fire({ icon: 'error', title: 'No se pudo abrir el período', text: error.message });
                    }
                });

            form.addEventListener('submit', async event => {
                event.preventDefault();
                if (!form.reportValidity())
                    return;
                try {
                    const result = await postForm();
                    modal.hide();
                    await Swal.fire({
                        toast: true, position: 'top-end', icon: 'success', title: result.message,
                        showConfirmButton: false, timer: 2300
                    });
                    window.location.reload();
                } catch (error) {
                    Swal.fire({ icon: 'error', title: 'No se pudo guardar', text: error.message });
                }
            });
        })();
    </script>
}
