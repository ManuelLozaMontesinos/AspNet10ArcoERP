@model List<NotificacionDto>
@{
    ViewData["Title"] = "Centro de Notificaciones";
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-bell-fill text-warning me-2"></i>Centro de Notificaciones
                    <span class="badge bg-primary ms-2 fs-6">@Model.Count</span>
                </h3>
                <small class="text-muted" data-erp-list-summary>Historial de avisos, recordatorios de agenda y alertas del sistema</small>
            </div>
            <div class="col-auto d-flex gap-2">
                <a href="/as/notificacion/index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
                </a>
                @if (Model.Count > 0)
                {
                    <button type="button" class="btn btn-outline-danger btn-sm" id="btn-vaciar-notif">
                        <i class="bi bi-trash3 me-1"></i>Vaciar Alertas
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4 erp-listing">
    <div class="container-fluid">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-light py-2 d-flex align-items-center justify-content-between">
                <h5 class="card-title text-secondary fw-semibold mb-0">Alertas Recientes</h5>
                <span class="text-muted small">Mostrando notificaciones del usuario</span>
            </div>
            <div class="card-body p-0">
                @if (Model.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-bell-slash fs-1 d-block mb-2 text-secondary opacity-50"></i>
                        <h5>No tienes notificaciones pendientes</h5>
                        <p class="mb-0 small">Todas tus alertas y recordatorios de eventos están al día.</p>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var n in Model)
                        {
                            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-start p-3" id="notif-row-@n.Id">
                                <div class="me-3">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle me-2">
                                            <i class="bi bi-info-circle me-1"></i>Aviso
                                        </span>
                                        <h6 class="mb-0 fw-bold">@n.Titulo</h6>
                                        <small class="text-muted ms-2">(@n.FechaFormateada)</small>
                                    </div>
                                    <p class="mb-1 text-secondary">@n.Descripcion</p>
                                </div>
                                <button type="button" class="btn btn-outline-danger btn-sm btn-eliminar-notif" data-id="@n.Id" title="Descartar notificación">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.btn-eliminar-notif').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const id = this.getAttribute('data-id');
                    if (!confirm('¿Desea descartar esta notificación?')) return;

                    try {
                        const res = await fetch(`/as/notificacion/eliminar?id=${id}`, {
                            method: 'POST'
                        });
                        const json = await res.json();
                        if (json.success) {
                            const row = document.getElementById(`notif-row-${id}`);
                            if (row) row.remove();
                        } else {
                            alert('No se pudo eliminar la notificación.');
                        }
                    } catch (e) {
                        console.error(e);
                        alert('Error al procesar la solicitud.');
                    }
                });
            });

            const btnVaciar = document.getElementById('btn-vaciar-notif');
            if (btnVaciar) {
                btnVaciar.addEventListener('click', async function () {
                    if (!confirm('¿Está seguro de que desea vaciar todas las notificaciones?')) return;

                    try {
                        const res = await fetch('/as/notificacion/vaciar', {
                            method: 'POST'
                        });
                        const json = await res.json();
                        if (json.success) {
                            window.location.reload();
                        } else {
                            alert('No se pudieron vaciar las notificaciones.');
                        }
                    } catch (e) {
                        console.error(e);
                        alert('Error al vaciar notificaciones.');
                    }
                });
            }
        });
    </script>
}

