@model AspNet10ArcoERP.Models.LeadSourcePageModel
@{
    ViewData["Title"] = "Origen de prospectos";
    var pageCount = Math.Max(1, (int)Math.Ceiling(Model.Total / (double)Model.PageSize));
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-1"><i class="bi bi-megaphone me-2 text-primary"></i>Origen de prospectos</h3>
                <small class="text-muted">Configura los canales de procedencia utilizados por Marketing y Ventas.</small>
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-primary shadow-sm fw-semibold px-3" id="createLeadSource">
                    <i class="bi bi-plus-circle-fill me-1"></i>Nuevo origen
                </button>
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4">
    <div class="container-fluid">
        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-header bg-body-tertiary py-3">
                <form method="get" class="d-flex flex-wrap align-items-end gap-3">
                    <div style="min-width:320px;max-width:440px;flex:1 1 320px">
                        <label for="search" class="form-label small fw-semibold">Buscar origen</label>
                        <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Nombre del canal..." />
                    </div>
                    <div>
                        <label for="estado" class="form-label small fw-semibold">Estado</label>
                        <select id="estado" name="estado" class="form-select">
                            <option value="">Todos los estados</option>
                            <option value="A" selected="@(Model.Estado == "A")">Activos</option>
                            <option value="I" selected="@(Model.Estado == "I")">Inactivos</option>
                        </select>
                    </div>
                    <div>
                        <label for="top" class="form-label small fw-semibold">Mostrando</label>
                        <select id="top" name="top" class="form-select">
                            @foreach (var size in new[] { 25, 50, 100, 500 })
                            {
                                <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>Buscar</button>
                    <a asp-area="MK" asp-controller="LeadSource" asp-action="Index" class="btn btn-outline-secondary" title="Limpiar filtros">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">@Model.Total origen(es)</span>
                </form>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0 table-fixed-header">
                    <thead class="bg-body-tertiary">
                        <tr>
                            <th class="text-center" style="width:90px">ID</th>
                            <th>Nombre del origen</th>
                            <th class="text-center" style="width:140px">Estado</th>
                            <th class="text-end" style="width:190px">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">No se encontraron orígenes de prospectos.</td></tr>
                        }
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-center"><span class="badge bg-secondary-subtle text-body border font-monospace">@item.Id</span></td>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td class="text-center">
                                    @if (item.Estado == "A")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-body-secondary border px-2 py-1">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-primary js-edit" data-id="@item.Id" title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-@(item.Estado == "A" ? "danger" : "success") js-toggle"
                                            data-id="@item.Id" data-name="@item.Nombre" data-state="@item.Estado"
                                            title="@(item.Estado == "A" ? "Desactivar" : "Activar")">
                                        <i class="bi bi-@(item.Estado == "A" ? "toggle-on" : "toggle-off")"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-body-tertiary d-flex flex-wrap align-items-center justify-content-between gap-2">
                <span class="small text-muted">Página @Model.Page de @pageCount · @Model.Total origen(es)</span>
                <div class="btn-group btn-group-sm">
                    @if (Model.Page > 1)
                    {
                        <a class="btn btn-outline-secondary" asp-area="MK" asp-controller="LeadSource" asp-action="Index"
                           asp-route-search="@Model.Search" asp-route-estado="@Model.Estado" asp-route-top="@Model.PageSize" asp-route-page="@(Model.Page - 1)">
                            <i class="bi bi-chevron-left me-1"></i>Anterior
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary" disabled><i class="bi bi-chevron-left me-1"></i>Anterior</button>
                    }
                    @if (Model.Page < pageCount)
                    {
                        <a class="btn btn-outline-secondary" asp-area="MK" asp-controller="LeadSource" asp-action="Index"
                           asp-route-search="@Model.Search" asp-route-estado="@Model.Estado" asp-route-top="@Model.PageSize" asp-route-page="@(Model.Page + 1)">
                            Siguiente<i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary" disabled>Siguiente<i class="bi bi-chevron-right ms-1"></i></button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal-crud-lead-source" tabindex="-1" aria-labelledby="leadSourceModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <form id="leadSourceForm" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="leadSourceId" value="0" />
            <div class="modal-header sticky-top bg-body-tertiary">
                <div>
                    <h5 class="modal-title fw-bold" id="leadSourceModalTitle"><i class="bi bi-megaphone me-2"></i>Nuevo origen</h5>
                    <div class="small text-muted">Registra el canal de captación de prospectos.</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="card border-0 bg-body-tertiary">
                    <div class="card-body">
                        <label for="leadSourceName" class="form-label small fw-semibold">Nombre del origen <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="leadSourceName" name="Nombre" maxlength="100" required />
                    </div>
                </div>
            </div>
            <div class="modal-footer sticky-bottom bg-body-tertiary">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary" id="saveLeadSource">
                    <i class="bi bi-check2-circle me-1"></i>Guardar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <style>
        #modal-crud-lead-source .modal-content {
            max-height: 90vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        #modal-crud-lead-source .modal-body {
            max-height: calc(90vh - 135px) !important;
            overflow-y: auto !important;
            flex: 1 1 auto;
            scrollbar-width: thin;
            scrollbar-color: rgba(140, 150, 165, 0.4) transparent;
            scroll-behavior: smooth;
        }

        #modal-crud-lead-source .modal-body::-webkit-scrollbar { width: 7px; }
        #modal-crud-lead-source .modal-body::-webkit-scrollbar-track { background: transparent; }
        #modal-crud-lead-source .modal-body::-webkit-scrollbar-thumb { background: rgba(140, 150, 165, 0.45); border-radius: 4px; }
        #modal-crud-lead-source .modal-body::-webkit-scrollbar-thumb:hover { background: rgba(140, 150, 165, 0.75); }
    </style>
    <script>
        (() => {
            const modalElement = document.getElementById('modal-crud-lead-source');
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            const form = document.getElementById('leadSourceForm');
            const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
            const getUrl = '@Url.Action("Obtener", "LeadSource", new { area = "MK" })';
            const saveUrl = '@Url.Action("Guardar", "LeadSource", new { area = "MK" })';
            const stateUrl = '@Url.Action("CambiarEstado", "LeadSource", new { area = "MK" })';

            async function post(url, body) {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body
                });
                const result = await response.json();
                if (!response.ok || result.success === false)
                    throw new Error(result.message || 'No se pudo completar la operación.');
                return result;
            }

            document.getElementById('createLeadSource').addEventListener('click', () => {
                form.reset();
                document.getElementById('leadSourceId').value = '0';
                document.getElementById('leadSourceModalTitle').innerHTML = '<i class="bi bi-megaphone me-2"></i>Nuevo origen';
                modal.show();
                setTimeout(() => document.getElementById('leadSourceName').focus(), 200);
            });

            document.querySelectorAll('.js-edit').forEach(button => {
                button.addEventListener('click', async () => {
                    try {
                        const url = new URL(getUrl, window.location.origin);
                        url.searchParams.set('id', button.dataset.id);
                        const response = await fetch(url);
                        const result = await response.json();
                        if (!response.ok || !result.success)
                            throw new Error(result.message || 'No se pudo cargar el origen.');
                        document.getElementById('leadSourceId').value = result.data.id;
                        document.getElementById('leadSourceName').value = result.data.nombre;
                        document.getElementById('leadSourceModalTitle').innerHTML = '<i class="bi bi-pencil-square me-2"></i>Editar origen';
                        modal.show();
                    } catch (error) {
                        Swal.fire({ icon: 'error', title: 'No se pudo abrir el registro', text: error.message });
                    }
                });
            });

            document.querySelectorAll('.js-toggle').forEach(button => {
                button.addEventListener('click', async () => {
                    const isActive = button.dataset.state === 'A';
                    const confirmation = await Swal.fire({
                        title: isActive ? '¿Desactivar este origen?' : '¿Activar este origen?',
                        text: button.dataset.name,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: isActive ? 'Sí, desactivar' : 'Sí, activar',
                        cancelButtonText: 'Cancelar'
                    });
                    if (!confirmation.isConfirmed)
                        return;
                    try {
                        const body = new URLSearchParams({ id: button.dataset.id });
                        const result = await post(stateUrl, body);
                        await Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: result.message, showConfirmButton: false, timer: 2300 });
                        window.location.reload();
                    } catch (error) {
                        Swal.fire({ icon: 'error', title: 'No se pudo cambiar el estado', text: error.message });
                    }
                });
            });

            form.addEventListener('submit', async event => {
                event.preventDefault();
                if (!form.reportValidity())
                    return;
                try {
                    const result = await post(saveUrl, new FormData(form));
                    modal.hide();
                    await Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: result.message, showConfirmButton: false, timer: 2300 });
                    window.location.reload();
                } catch (error) {
                    Swal.fire({ icon: 'error', title: 'No se pudo guardar', text: error.message });
                }
            });
        })();
    </script>
}
