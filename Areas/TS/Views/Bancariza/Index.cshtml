@model BancarizacionPageModel
@addTagHelper *, AspNet10ArcoERP
@{ViewData["Title"]="Bancarización";bool canWrite=ViewBag.PuedeEscribir==true;}
<div class="app-content-header py-3 border-bottom"><div class="container-fluid"><div class="row align-items-center g-3"><div class="col"><h3 class="mb-0 fw-bold d-flex align-items-center"><i class="bi bi-bank text-primary me-2"></i>Bancarización</h3><small class="text-muted" data-erp-list-summary>@if(Model.Contexto.Errores.Count==0){<span>Ejercicio @Model.Contexto.Anio · @Model.Contexto.NombreSede(Model.Filtro.ConsultaId) · Importe mínimo en moneda local: @Model.Umbral.ToString("N4")</span>}else{<span>Revise el contexto y la configuración de bancarización.</span>}</small></div></div></div></div>
<div class="app-content py-4 erp-listing"><div class="container-fluid">
    @if(Model.Contexto.Errores.Count>0){<div class="alert alert-warning" role="alert"><ul class="mb-0">@foreach(var error in Model.Contexto.Errores){<li>@error</li>}</ul></div>}
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="card-body py-2 px-3 erp-filter-bar"><div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <form method="get" id="bn-filters" class="d-flex flex-wrap align-items-center gap-2 m-0"><input type="hidden" name="top" value="@Model.PageSize" /><input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="dir" value="@Model.Dir" />
            <div class="input-group input-group-sm listing-search"><span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span><input name="search" value="@Model.Filtro.Search" class="form-control border-start-0" maxlength="150" placeholder="Documento o cliente..." aria-label="Buscar comprobante" /></div>
            <select name="consultaId" class="form-select form-select-sm w-auto" aria-label="Sede de consulta">@foreach(var item in Model.Contexto.Sedes){<option value="@item.Id" selected="@(Model.Filtro.ConsultaId==item.Id)">@item.Nombre</option>}</select>
            <input name="numero" value="@Model.Filtro.Numero" class="form-control form-control-sm w-auto" maxlength="8" placeholder="Número exacto" aria-label="Número exacto de comprobante" />
            <input name="identidad" value="@Model.Filtro.Identidad" class="form-control form-control-sm w-auto" maxlength="35" placeholder="Documento de identidad" aria-label="Documento de identidad del cliente" />
            <input name="cliente" value="@Model.Filtro.Cliente" class="form-control form-control-sm w-auto" maxlength="150" placeholder="Razón social" aria-label="Razón social del cliente" />
            <div class="input-group input-group-sm w-auto"><span class="input-group-text bg-body-tertiary">Desde</span><input type="date" name="desde" class="form-control" value="@Model.Filtro.Desde?.ToString("yyyy-MM-dd")" min="1900-01-01" max="9998-12-31" aria-label="Fecha inicial" /></div>
            <div class="input-group input-group-sm w-auto"><span class="input-group-text bg-body-tertiary">Hasta</span><input type="date" name="hasta" class="form-control" value="@Model.Filtro.Hasta?.ToString("yyyy-MM-dd")" min="1900-01-01" max="9998-12-31" aria-label="Fecha final" /></div>
            <select name="bancarizado" class="form-select form-select-sm w-auto" aria-label="Indicador de bancarización"><option value="">Todos</option><option value="S" selected="@(Model.Filtro.Bancarizado=="S")">Bancarizado: Sí</option><option value="N" selected="@(Model.Filtro.Bancarizado=="N")">Bancarizado: No</option></select>
            <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i>Buscar</button><a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
        </form><partial name="_ListadoControles" model="Model" />
    </div></div></div>
    <div class="small text-muted mb-3">Facturas y boletas activas con estado de comprobante emitido. El importe mínimo se compara en moneda local con el T/C del documento. Se marca “Sí” cuando existe al menos una cobranza activa.</div>
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="table-responsive table-scroll"><table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options><thead class="table-header-custom bg-body-tertiary border-bottom"><tr><th erp-sort="tipo">Tipo</th><th erp-sort="documento">Documento</th><th erp-sort="fecha">Fecha</th><th erp-sort="cliente">Cliente</th><th erp-sort="identidad">Identidad</th><th erp-sort="moneda">Moneda</th><th erp-sort="total" erp-numeric="true" class="text-end">Total</th><th erp-sort="local" erp-numeric="true" class="text-end">Total local</th><th erp-sort="bancarizado">Bancarizado</th><th class="listing-options">Opciones</th></tr></thead>
        <tbody>@if(Model.Items.Count==0){<tr><td colspan="10" class="text-center text-muted py-4">No se encontraron comprobantes.</td></tr>}
        @foreach(var row in Model.Items){<tr><td>@row.Tipo</td><td class="text-nowrap">@row.Documento</td><td class="text-nowrap">@row.Fecha.ToString("dd/MM/yyyy")</td><td>@row.Cliente</td><td>@row.Identidad</td><td>@row.Moneda</td><td class="text-end">@row.Total.ToString("N4")</td><td class="text-end">@row.TotalLocal.ToString("N4")</td><td><span class="badge @(row.Bancarizado=="S"?"bg-success-subtle text-success":"bg-secondary-subtle text-body-secondary")">@(row.Bancarizado=="S"?"Sí":row.Bancarizado=="N"?"No":"Sin marcar")</span></td><td class="listing-options"><button type="button" class="btn btn-sm btn-outline-primary js-bn-open" data-id="@row.Id" data-consulta="@row.ConsultaId" title="Consultar" aria-label="Consultar"><i class="bi bi-eye"></i></button>@if(canWrite){<button type="button" class="btn btn-sm btn-outline-primary js-bn-open" data-id="@row.Id" data-consulta="@row.ConsultaId" data-edit="true" title="Administrar cobranzas" aria-label="Administrar cobranzas"><i class="bi bi-pencil-square"></i></button>}</td></tr>}
        </tbody></table></div><partial name="_ListadoPaginacion" model="Model" /></div>
</div></div>
<div class="modal fade" id="bn-modal" tabindex="-1" aria-labelledby="bn-title" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><form id="bn-form" class="modal-content" method="post" asp-action="Guardar" autocomplete="off">
    <div class="modal-header sticky-top bg-body-tertiary"><h5 class="modal-title" id="bn-title">Bancarización del comprobante</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
    <div class="modal-body">@Html.AntiForgeryToken()<input type="hidden" name="ContextoId" value="@ViewBag.ContextoId" /><input type="hidden" name="ConsultaId" /><input type="hidden" name="ComprobanteId" /><input type="hidden" name="DocumentoRevision" /><input type="hidden" name="Id" /><input type="hidden" name="Revision" />
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><strong id="bn-document"></strong><span id="bn-mode" class="badge bg-primary-subtle text-primary"></span></div><small id="bn-site" class="d-block text-muted mb-3"></small>
        <dl id="bn-info" class="row mb-3"></dl>
        <div class="border-top pt-3"><h6 class="fw-semibold">Cobranzas</h6><p id="bn-account-note" class="small text-muted"></p>
            <div class="d-flex flex-wrap align-items-center gap-2 erp-filter-bar mb-3"><div class="input-group input-group-sm listing-search"><span class="input-group-text bg-body-tertiary"><i class="bi bi-search"></i></span><input id="bn-search" class="form-control" maxlength="150" placeholder="Operación, banco o cuenta..." aria-label="Buscar cobranza" /><button id="bn-find" type="button" class="btn btn-outline-primary">Buscar</button><button id="bn-clear" type="button" class="btn btn-outline-secondary" title="Limpiar búsqueda"><i class="bi bi-x-lg"></i></button></div>@if(canWrite){<button id="bn-new" type="button" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg me-1"></i>Agregar cobranza</button>}<select id="bn-size" class="form-select form-select-sm w-auto ms-auto" aria-label="Mostrar registros del detalle">@foreach(var size in new[]{25,50,100,500}){<option value="@size">@size registros</option>}</select></div>
            <div id="bn-editor" class="border rounded-3 p-3 mb-3 bg-body-tertiary" hidden><h6 id="bn-editor-title" class="fw-semibold"></h6><div class="row g-3"><div class="col-md-4"><label for="bn-date" class="form-label">Fecha</label><input id="bn-date" name="Fecha" type="date" class="form-control" min="1900-01-01" max="9998-12-31" required disabled /></div><div class="col-md-4"><label for="bn-operation" class="form-label">Número de operación</label><input id="bn-operation" name="Operacion" class="form-control" maxlength="50" required disabled /></div><div class="col-md-4"><label for="bn-amount" class="form-label">Monto en moneda del comprobante</label><input id="bn-amount" name="Monto" type="number" step="0.0001" min="0.0001" max="999999999999999.9999" class="form-control" required disabled /></div><div class="col-12"><label for="bn-account" class="form-label">Cuenta bancaria</label><select id="bn-account" name="CuentaId" class="form-select" required disabled></select></div></div><div class="d-flex justify-content-end gap-2 mt-3"><button id="bn-discard" type="button" class="btn btn-sm btn-outline-secondary">Cerrar detalle</button>@if(canWrite){<button id="bn-save" type="submit" class="btn btn-sm btn-primary">Guardar cobranza</button>}</div></div>
            <div class="table-responsive table-scroll border rounded-3"><table class="table table-striped table-hover align-middle mb-0" data-erp-grid="details" data-erp-options><thead id="bn-head" class="table-header-custom bg-body-tertiary"></thead><tbody id="bn-rows"></tbody></table></div>
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pt-3"><small id="bn-range" class="text-muted" aria-live="polite"></small><nav aria-label="Páginas de cobranzas"><div class="btn-group btn-group-sm"><button id="bn-prev" type="button" class="btn btn-outline-secondary">Anterior</button><button id="bn-next" type="button" class="btn btn-outline-secondary">Siguiente</button></div></nav></div>
        </div>
    </div><div class="modal-footer sticky-bottom bg-body-tertiary"><button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button></div>
</form></div></div>
@section Scripts {
    <script id="bancarizacion-config" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new{canWrite,contextoId=ViewBag.ContextoId,urls=new{obtener=Url.Action("Obtener"),cobranzas=Url.Action("Cobranzas"),guardar=Url.Action("Guardar"),anular=Url.Action("Anular")}}))</script>
    <script src="~/js/bancarizacion.js" asp-append-version="true"></script>
}
