@model List<AspNet10ArcoERP.Models.CuentaBancoModel>
@{
    ViewData["Title"] = "Cuentas Bancarias";
    var bancos = ViewBag.Bancos as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new();
    var monedas = ViewBag.Monedas as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new();
    string search = ViewBag.Search as string ?? string.Empty;
    int? bancoId = ViewBag.BancoId as int?;
    string estado = ViewBag.Estado as string ?? string.Empty;
    int top = ViewBag.Top is int pageSize ? pageSize : 25;
    int total = ViewBag.Total is int totalCount ? totalCount : Model.Count;
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-1"><i class="bi bi-bank me-2 text-primary"></i>Cuentas bancarias</h3>
                <small class="text-muted">Cuentas de la empresa para cobros y operaciones bancarias.</small>
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-primary shadow-sm fw-semibold px-3" id="newAccountButton">
                    <i class="bi bi-plus-circle-fill me-1"></i>Nueva cuenta
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .table-header-custom th {
        padding-top: 0.45rem !important;
        padding-bottom: 0.45rem !important;
        font-size: 0.78rem !important;
        letter-spacing: 0.5px;
        white-space: nowrap !important;
        vertical-align: middle !important;
        height: 40px !important;
        line-height: 1.2;
    }

    .th-sortable {
        cursor: pointer;
        user-select: none;
        transition: background-color 0.15s ease, color 0.15s ease;
    }

    .th-sortable:hover {
        background-color: var(--bs-tertiary-bg);
        color: var(--bs-primary);
    }

    #modal-crud-cuenta-banco .modal-dialog {
        max-width: 900px;
    }

    #modal-crud-cuenta-banco .modal-content {
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 0;
        border-radius: 0.75rem;
        box-shadow: var(--bs-box-shadow-lg);
    }

    #modal-crud-cuenta-banco .modal-body {
        max-height: calc(90vh - 135px) !important;
        overflow-y: auto !important;
        flex: 1 1 auto;
        scrollbar-width: thin;
        scrollbar-color: rgba(140, 150, 165, 0.4) transparent;
        scroll-behavior: smooth;
    }

    #modal-crud-cuenta-banco .modal-body::-webkit-scrollbar { width: 7px; }
    #modal-crud-cuenta-banco .modal-body::-webkit-scrollbar-track { background: transparent; }
    #modal-crud-cuenta-banco .modal-body::-webkit-scrollbar-thumb { background: rgba(140, 150, 165, 0.45); border-radius: 4px; }
    #modal-crud-cuenta-banco .modal-body::-webkit-scrollbar-thumb:hover { background: rgba(140, 150, 165, 0.75); }

    #modal-crud-cuenta-banco .modal-header,
    #modal-crud-cuenta-banco .modal-footer {
        flex: 0 0 auto;
    }
</style>

<div class="app-content py-4">
    <div class="container-fluid">
        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3">
                <form method="get" id="accountFilterForm" class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <div class="input-group input-group-sm" style="min-width:320px;max-width:440px">
                            <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input id="search" name="search" value="@search" class="form-control border-start-0 ps-0" placeholder="Buscar por banco, nombre o cuenta..." />
                            <button type="button" class="btn btn-outline-secondary" id="clearAccountSearch" title="Limpiar búsqueda"><i class="bi bi-x-lg"></i></button>
                        </div>
                        <div class="input-group input-group-sm" style="width:auto">
                            <span class="input-group-text bg-body-tertiary text-muted border-end-0"><i class="bi bi-bank text-primary"></i></span>
                            <select id="bancoId" name="bancoId" class="form-select form-select-sm border-start-0" style="min-width:170px" title="Filtrar por banco">
                                <option value="">Todos los bancos</option>
                                @foreach (var banco in bancos)
                                {
                                    <option value="@banco.Id" selected="@(bancoId == banco.Id)">@banco.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="input-group input-group-sm" style="width:auto">
                            <span class="input-group-text bg-body-tertiary text-muted border-end-0"><i class="bi bi-toggle-on text-primary"></i></span>
                            <select id="estado" name="estado" class="form-select form-select-sm border-start-0" style="min-width:145px" title="Filtrar por estado">
                                <option value="">Todos los estados</option>
                                <option value="A" selected="@(estado == "A")">Solo activos</option>
                                <option value="I" selected="@(estado == "I")">Solo inactivos</option>
                            </select>
                        </div>
                        <input type="hidden" id="top" name="top" value="@top" />
                    </div>

                    <div class="d-flex align-items-center gap-3 ms-auto">
                        <div class="text-muted small text-nowrap">
                            <span>Total: <strong class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6" id="accountCount">@total</strong> cuentas</span>
                        </div>
                        <div class="dropdown flex-shrink-0">
                            <button class="btn btn-sm btn-outline-primary dropdown-toggle d-flex align-items-center gap-1 shadow-sm px-2 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Cantidad de registros a mostrar">
                                <i class="bi bi-funnel-fill text-primary"></i>
                                <span>Mostrando: <strong class="badge text-bg-primary ms-1" id="currentAccountTop">@top</strong></span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li class="dropdown-header text-uppercase small fw-bold">Registros a listar</li>
                                @foreach (var count in new[] { 25, 50, 100, 500 })
                                {
                                    <li><button type="button" class="dropdown-item account-top-option @(top == count ? "active" : "")" data-top="@count">@count registros</button></li>
                                }
                            </ul>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0 table-responsive">
                <table class="table table-striped table-hover align-middle mb-0 table-fixed-header" id="accountTable">
                    <thead class="table-header-custom border-bottom bg-body-tertiary">
                        <tr>
                            <th style="width:70px" class="text-center th-sortable" onclick="sortAccountTable(0, true)">ID <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i></th>
                            <th style="width:190px" class="th-sortable" onclick="sortAccountTable(1, false)">Banco <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i></th>
                            <th class="th-sortable" onclick="sortAccountTable(2, false)">Nombre de la cuenta <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i></th>
                            <th style="width:130px" class="th-sortable" onclick="sortAccountTable(3, false)">Moneda <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i></th>
                            <th style="width:190px" class="th-sortable" onclick="sortAccountTable(4, false)">Número de cuenta <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i></th>
                            <th style="width:210px">Cuenta interbancaria</th>
                            <th style="width:110px" class="text-center th-sortable" onclick="sortAccountTable(6, false)">Estado <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i></th>
                            <th style="width:120px" class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr id="emptyAccountRow"><td colspan="8" class="text-center text-muted py-5"><i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>No se encontraron cuentas bancarias</td></tr>
                        }
                        @foreach (var cuenta in Model)
                        {
                            <tr class="account-row" data-account-id="@cuenta.Id" data-search="@($"{cuenta.BancoNombre} {cuenta.Nombre} {cuenta.Cuenta} {cuenta.CuentaInterbancaria} {cuenta.MonedaNombre}".ToLowerInvariant())" data-state="@cuenta.Estado">
                                <td class="text-center font-monospace text-muted small">@cuenta.Id</td>
                                <td class="fw-semibold">@cuenta.BancoNombre</td>
                                <td>@cuenta.Nombre</td>
                                <td>@cuenta.MonedaNombre</td>
                                <td><span class="font-monospace small">@cuenta.Cuenta</span></td>
                                <td><span class="font-monospace small text-body-secondary">@cuenta.CuentaInterbancaria</span></td>
                                <td>
                                    @if (cuenta.Estado == "A")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-body-secondary border px-2 py-1">Inactivo</span>
                                    }
                                </td>
                                <td class="text-center text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 js-edit-account" data-id="@cuenta.Id" title="Editar"><i class="bi bi-pencil"></i></button>
                                    <button type="button" class="btn btn-sm @(cuenta.Estado == "A" ? "btn-outline-danger" : "btn-outline-success") py-0 px-2 ms-1 js-toggle-account" data-id="@cuenta.Id" data-state="@cuenta.Estado" data-name="@cuenta.Nombre" title="@(cuenta.Estado == "A" ? "Desactivar" : "Activar")">
                                        <i class="bi @(cuenta.Estado == "A" ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal-crud-cuenta-banco" tabindex="-1" aria-labelledby="accountModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <form id="accountForm" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header sticky-top bg-body-tertiary">
                <div>
                    <h5 class="modal-title fw-bold" id="accountModalTitle"><i class="bi bi-bank text-primary me-2"></i>Nueva cuenta bancaria</h5>
                    <small class="text-muted">Datos de la cuenta registrada para la empresa.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" name="Id" id="accountId" value="0" />
                <input type="hidden" name="BancoId" id="accountBancoId" value="0" />
                <input type="hidden" name="MonedaId" id="accountMonedaId" value="0" />
                <input type="hidden" name="CuentaInterbancaria" id="accountCci" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="accountBankSelect" class="form-label">Banco <span class="text-danger">*</span></label>
                        <select id="accountBankSelect" class="form-select">
                            <option value="">Seleccione...</option>
                            @foreach (var banco in bancos)
                            {
                                <option value="@banco.Id">@banco.Nombre</option>
                            }
                        </select>
                        <div id="accountBankBadge" class="d-none"><span class="badge bg-body-secondary text-body border" id="accountBankName"></span></div>
                    </div>
                    <div class="col-md-6">
                        <label for="accountCurrencySelect" class="form-label">Moneda <span class="text-danger">*</span></label>
                        <select id="accountCurrencySelect" class="form-select">
                            <option value="">Seleccione...</option>
                            @foreach (var moneda in monedas)
                            {
                                <option value="@moneda.Id">@moneda.Nombre</option>
                            }
                        </select>
                        <div id="accountCurrencyBadge" class="d-none"><span class="badge bg-body-secondary text-body border" id="accountCurrencyName"></span></div>
                    </div>
                    <div class="col-md-6">
                        <label for="accountName" class="form-label">Nombre de la cuenta <span class="text-danger">*</span></label>
                        <input id="accountName" name="Nombre" maxlength="100" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label for="accountNumber" class="form-label">Número de cuenta <span class="text-danger">*</span></label>
                        <input id="accountNumber" name="Cuenta" maxlength="50" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label for="accountCciInput" class="form-label">Cuenta interbancaria (CCI)</label>
                        <input id="accountCciInput" maxlength="50" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="modal-footer sticky-bottom bg-body-tertiary">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary" id="saveAccountButton"><i class="bi bi-check2-circle me-1"></i>Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const modalElement = document.getElementById('modal-crud-cuenta-banco');
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            const form = document.getElementById('accountForm');
            const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
            const bankSelect = document.getElementById('accountBankSelect');
            const currencySelect = document.getElementById('accountCurrencySelect');
            const notify = (icon, title) => Swal.fire({ toast: true, position: 'top-end', icon, title, showConfirmButton: false, timer: 3000 });
            let accountSortColumn = -1;
            let accountSortAscending = true;
            let searchTimer;

            function sortAccountTable(column, numeric) {
                const table = document.getElementById('accountTable');
                const headers = table.querySelectorAll('thead .sort-icon');
                accountSortAscending = accountSortColumn === column ? !accountSortAscending : true;
                accountSortColumn = column;
                headers.forEach(icon => {
                    icon.className = 'bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon';
                });
                const currentIcon = table.querySelectorAll('thead th')[column].querySelector('.sort-icon');
                currentIcon.className = `bi ${numeric
                    ? accountSortAscending ? 'bi-sort-numeric-down' : 'bi-sort-numeric-down-alt'
                    : accountSortAscending ? 'bi-sort-alpha-down' : 'bi-sort-alpha-down-alt'} text-primary ms-1 sort-icon`;

                const rows = [...table.querySelectorAll('tbody .account-row')];
                rows.sort((left, right) => {
                    const leftValue = left.children[column].textContent.trim();
                    const rightValue = right.children[column].textContent.trim();
                    const compare = numeric
                        ? Number(leftValue) - Number(rightValue)
                        : leftValue.localeCompare(rightValue, undefined, { numeric: true, sensitivity: 'base' });
                    return accountSortAscending ? compare : -compare;
                });
                const tbody = table.querySelector('tbody');
                rows.forEach(row => tbody.append(row));
            }
            window.sortAccountTable = sortAccountTable;

            const filterForm = document.getElementById('accountFilterForm');
            document.getElementById('search').addEventListener('input', () => {
                window.clearTimeout(searchTimer);
                searchTimer = window.setTimeout(() => filterForm.requestSubmit(), 400);
            });
            document.getElementById('bancoId').addEventListener('change', () => filterForm.requestSubmit());
            document.getElementById('estado').addEventListener('change', () => filterForm.requestSubmit());
            document.getElementById('clearAccountSearch').addEventListener('click', () => {
                document.getElementById('search').value = '';
                filterForm.requestSubmit();
            });
            document.querySelectorAll('.account-top-option').forEach(option => {
                option.addEventListener('click', () => {
                    document.getElementById('top').value = option.dataset.top;
                    filterForm.requestSubmit();
                });
            });

            function resetForm() {
                form.reset();
                document.getElementById('accountId').value = '0';
                document.getElementById('accountBancoId').value = '0';
                document.getElementById('accountMonedaId').value = '0';
                bankSelect.disabled = false;
                currencySelect.disabled = false;
                bankSelect.classList.remove('d-none');
                currencySelect.classList.remove('d-none');
                document.getElementById('accountBankBadge').classList.add('d-none');
                document.getElementById('accountCurrencyBadge').classList.add('d-none');
                document.getElementById('accountModalTitle').textContent = 'Nueva cuenta bancaria';
            }

            document.getElementById('newAccountButton').addEventListener('click', () => {
                resetForm();
                modal.show();
            });

            document.querySelectorAll('.js-edit-account').forEach(button => {
                button.addEventListener('click', async () => {
                    try {
                        const response = await fetch(`/TS/CuentaBanco/Obtener?id=${button.dataset.id}`);
                        const result = await response.json();
                        if (!response.ok || !result.success) {
                            notify('error', result.message || 'No se pudo cargar la cuenta bancaria.');
                            return;
                        }
                        const item = result.data;
                        resetForm();
                        document.getElementById('accountId').value = item.id;
                        document.getElementById('accountBancoId').value = item.bancoId;
                        document.getElementById('accountMonedaId').value = item.monedaId;
                        document.getElementById('accountName').value = item.nombre;
                        document.getElementById('accountNumber').value = item.cuenta;
                        document.getElementById('accountCciInput').value = item.cuentaInterbancaria;
                        bankSelect.value = item.bancoId;
                        currencySelect.value = item.monedaId;
                        bankSelect.disabled = true;
                        currencySelect.disabled = true;
                        bankSelect.classList.add('d-none');
                        currencySelect.classList.add('d-none');
                        document.getElementById('accountBankName').textContent = item.bancoNombre;
                        document.getElementById('accountCurrencyName').textContent = item.monedaNombre;
                        document.getElementById('accountBankBadge').classList.remove('d-none');
                        document.getElementById('accountCurrencyBadge').classList.remove('d-none');
                        document.getElementById('accountModalTitle').textContent = `Editar cuenta bancaria #${item.id}`;
                        modal.show();
                    } catch {
                        notify('error', 'Ocurrió un error de comunicación al cargar la cuenta.');
                    }
                });
            });

            bankSelect.addEventListener('change', () => {
                document.getElementById('accountBancoId').value = bankSelect.value || '0';
            });
            currencySelect.addEventListener('change', () => {
                document.getElementById('accountMonedaId').value = currencySelect.value || '0';
            });

            form.addEventListener('submit', async event => {
                event.preventDefault();
                document.getElementById('accountCci').value = document.getElementById('accountCciInput').value.trim();
                const data = new FormData(form);
                data.set('BancoId', document.getElementById('accountBancoId').value);
                data.set('MonedaId', document.getElementById('accountMonedaId').value);
                const button = document.getElementById('saveAccountButton');
                button.disabled = true;
                try {
                    const response = await fetch('/TS/CuentaBanco/Guardar', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token },
                        body: data
                    });
                    const result = await response.json();
                    if (!response.ok || !result.success) {
                        notify('error', result.message || 'No se pudo guardar la cuenta bancaria.');
                        return;
                    }
                    notify('success', result.message);
                    modal.hide();
                    window.location.reload();
                } catch {
                    notify('error', 'Ocurrió un error de comunicación al guardar la cuenta.');
                } finally {
                    button.disabled = false;
                }
            });

            document.querySelectorAll('.js-toggle-account').forEach(button => {
                button.addEventListener('click', async () => {
                    const isActive = button.dataset.state === 'A';
                    const confirmation = await Swal.fire({
                        title: `¿${isActive ? 'Desactivar' : 'Activar'} cuenta?`,
                        text: button.dataset.name,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: isActive ? 'Desactivar' : 'Activar',
                        cancelButtonText: 'Cancelar'
                    });
                    if (!confirmation.isConfirmed) return;

                    try {
                        const data = new FormData();
                        data.append('id', button.dataset.id);
                        const response = await fetch('/TS/CuentaBanco/CambiarEstado', {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': token },
                            body: data
                        });
                        const result = await response.json();
                        if (!response.ok || !result.success) {
                            notify('error', result.message || 'No se pudo cambiar el estado.');
                            return;
                        }
                        notify('success', result.message);
                        window.location.reload();
                    } catch {
                        notify('error', 'Ocurrió un error de comunicación al cambiar el estado.');
                    }
                });
            });
        })();
    </script>
}
