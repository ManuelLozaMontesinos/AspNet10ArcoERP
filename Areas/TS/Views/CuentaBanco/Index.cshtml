@addTagHelper *, AspNet10ArcoERP
@model AspNet10ArcoERP.Models.CuentaBancoPageModel
@{
    ViewData["Title"]="Cuentas bancarias";
    var bancos=ViewBag.Bancos as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new();
    var monedas=ViewBag.Monedas as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new();
    string search=ViewBag.Search as string ?? "";
    int? bancoId=ViewBag.BancoId as int?;
    string estado=ViewBag.Estado as string ?? "";
}
<div class="app-content-header py-3 border-bottom"><div class="container-fluid"><div class="row align-items-center g-3">
    <div class="col"><h3 class="mb-0 fw-bold d-flex align-items-center"><i class="bi bi-bank me-2 text-primary"></i>Cuentas bancarias</h3><small class="text-muted">Cuentas de la empresa para cobros y operaciones bancarias.</small></div>
    <div class="col-auto"><button type="button" class="btn btn-primary shadow-sm" id="newAccountButton"><i class="bi bi-plus-circle-fill me-1"></i>Nueva cuenta</button></div>
</div></div></div>
<div class="app-content py-4 erp-listing"><div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="card-body py-2 px-3 erp-filter-bar">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <form method="get" id="accountFilterForm" class="d-flex flex-wrap align-items-center gap-2 m-0">
                <input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="dir" value="@Model.Dir" /><input type="hidden" name="top" value="@Model.PageSize" />
                <div class="input-group input-group-sm listing-search">
                    <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input id="search" name="search" value="@search" maxlength="150" class="form-control border-start-0" placeholder="Buscar cuenta, banco, moneda o CCI..." aria-label="Buscar cuenta bancaria" />
                    <button class="btn btn-outline-primary" type="submit">Buscar</button>
                    <a asp-action="Index" asp-route-top="@Model.PageSize" asp-route-sort="@Model.Sort" asp-route-dir="@Model.Dir" class="btn btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
                </div>
                <div class="input-group input-group-sm w-auto"><span class="input-group-text bg-body-tertiary"><i class="bi bi-bank"></i></span><select id="bancoId" name="bancoId" class="form-select form-select-sm" aria-label="Banco"><option value="">Todos los bancos</option>@foreach(var item in bancos){<option value="@item.Id" selected="@(bancoId==item.Id)">@item.Nombre</option>}</select></div>
                <div class="input-group input-group-sm w-auto"><span class="input-group-text bg-body-tertiary"><i class="bi bi-toggle-on"></i></span><select id="estado" name="estado" class="form-select form-select-sm" aria-label="Estado"><option value="">Todos los estados</option><option value="A" selected="@(estado=="A")">Activas</option><option value="I" selected="@(estado=="I")">Inactivas</option></select></div>
            </form>
            <partial name="_ListadoControles" model="Model" />
        </div>
    </div></div>
    <div class="card border-0 shadow-sm rounded-3 mb-3">
        <div class="table-responsive table-scroll">
            <table class="table table-striped table-hover align-middle mb-0" id="accountTable" data-erp-grid="main" data-erp-options>
                <thead class="table-header-custom bg-body-tertiary border-bottom"><tr>
                    <th erp-sort="id" erp-numeric="true" class="text-center">ID</th><th erp-sort="banco">Banco</th><th erp-sort="nombre">Nombre de la cuenta</th><th erp-sort="moneda">Moneda</th><th erp-sort="cuenta">Número de cuenta</th><th erp-sort="cci">Cuenta interbancaria</th><th erp-sort="estado" class="text-center">Estado</th><th class="listing-options">Opciones</th>
                </tr></thead>
                <tbody>
                    @if(Model.Items.Count==0){<tr><td colspan="8" class="text-center text-muted py-5"><i class="bi bi-inbox fs-1 d-block mb-2"></i>No se encontraron cuentas bancarias.</td></tr>}
                    @foreach(var cuenta in Model.Items)
                    {
                        <tr>
                            <td class="text-center font-monospace small text-muted">@cuenta.Id</td><td class="fw-semibold">@cuenta.BancoNombre</td><td>@cuenta.Nombre</td><td>@cuenta.MonedaNombre</td><td class="font-monospace">@cuenta.Cuenta</td><td class="font-monospace">@cuenta.CuentaInterbancaria</td>
                            <td class="text-center"><span class="badge @(cuenta.Estado=="A"?"bg-success-subtle text-success border border-success-subtle":"bg-secondary-subtle text-body-secondary border")">@(cuenta.Estado=="A"?"Activa":"Inactiva")</span></td>
                            <td class="listing-options">
                                <button type="button" class="btn btn-sm btn-outline-primary js-edit-account" data-id="@cuenta.Id" title="Editar cuenta"><i class="bi bi-pencil-square"></i></button>
                                <button type="button" class="btn btn-sm @(cuenta.Estado=="A"?"btn-outline-danger":"btn-outline-success") js-toggle-account" data-id="@cuenta.Id" data-state="@cuenta.Estado" data-name="@cuenta.Nombre" title="@(cuenta.Estado=="A"?"Desactivar cuenta":"Activar cuenta")"><i class="bi @(cuenta.Estado=="A"?"bi-toggle-on":"bi-toggle-off")"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_ListadoPaginacion" model="Model" />
    </div>
</div></div>

<div class="modal fade" id="modal-crud-cuenta-banco" tabindex="-1" aria-labelledby="accountModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <form id="accountForm" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header sticky-top bg-body-tertiary">
                <div>
                    <h5 class="modal-title fw-bold" id="accountModalTitle"><i class="bi bi-bank text-primary me-2"></i>Nueva cuenta bancaria</h5>
                    <small class="text-muted">Datos de la cuenta registrada para la empresa.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" name="Id" id="accountId" value="0" />
                <input type="hidden" name="BancoId" id="accountBancoId" value="0" />
                <input type="hidden" name="MonedaId" id="accountMonedaId" value="0" />
                <input type="hidden" name="CuentaInterbancaria" id="accountCci" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="accountBankSelect" class="form-label">Banco <span class="text-danger">*</span></label>
                        <select id="accountBankSelect" class="form-select">
                            <option value="">Seleccione...</option>
                            @foreach (var banco in bancos)
                            {
                                <option value="@banco.Id">@banco.Nombre</option>
                            }
                        </select>
                        <div id="accountBankBadge" class="d-none"><span class="badge bg-body-secondary text-body border" id="accountBankName"></span></div>
                    </div>
                    <div class="col-md-6">
                        <label for="accountCurrencySelect" class="form-label">Moneda <span class="text-danger">*</span></label>
                        <select id="accountCurrencySelect" class="form-select">
                            <option value="">Seleccione...</option>
                            @foreach (var moneda in monedas)
                            {
                                <option value="@moneda.Id">@moneda.Nombre</option>
                            }
                        </select>
                        <div id="accountCurrencyBadge" class="d-none"><span class="badge bg-body-secondary text-body border" id="accountCurrencyName"></span></div>
                    </div>
                    <div class="col-md-6">
                        <label for="accountName" class="form-label">Nombre de la cuenta <span class="text-danger">*</span></label>
                        <input id="accountName" name="Nombre" maxlength="100" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label for="accountNumber" class="form-label">Número de cuenta <span class="text-danger">*</span></label>
                        <input id="accountNumber" name="Cuenta" maxlength="50" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label for="accountCciInput" class="form-label">Cuenta interbancaria (CCI)</label>
                        <input id="accountCciInput" maxlength="50" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="modal-footer sticky-bottom bg-body-tertiary">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary" id="saveAccountButton"><i class="bi bi-check2-circle me-1"></i>Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const modalElement = document.getElementById('modal-crud-cuenta-banco');
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            const form = document.getElementById('accountForm');
            const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
            const bankSelect = document.getElementById('accountBankSelect');
            const currencySelect = document.getElementById('accountCurrencySelect');
            const notify = (icon, title) => Swal.fire({ toast: true, position: 'top-end', icon, title, showConfirmButton: false, timer: 3000 });
            function resetForm() {
                form.reset();
                document.getElementById('accountId').value = '0';
                document.getElementById('accountBancoId').value = '0';
                document.getElementById('accountMonedaId').value = '0';
                bankSelect.disabled = false;
                currencySelect.disabled = false;
                bankSelect.classList.remove('d-none');
                currencySelect.classList.remove('d-none');
                document.getElementById('accountBankBadge').classList.add('d-none');
                document.getElementById('accountCurrencyBadge').classList.add('d-none');
                document.getElementById('accountModalTitle').textContent = 'Nueva cuenta bancaria';
            }

            document.getElementById('newAccountButton').addEventListener('click', () => {
                resetForm();
                modal.show();
            });

            window.erpListings.onClick('.js-edit-account', async (button) => {
                    try {
                        const response = await fetch(`/TS/CuentaBanco/Obtener?id=${button.dataset.id}`);
                        const result = await response.json();
                        if (!response.ok || !result.success) {
                            notify('error', result.message || 'No se pudo cargar la cuenta bancaria.');
                            return;
                        }
                        const item = result.data;
                        resetForm();
                        document.getElementById('accountId').value = item.id;
                        document.getElementById('accountBancoId').value = item.bancoId;
                        document.getElementById('accountMonedaId').value = item.monedaId;
                        document.getElementById('accountName').value = item.nombre;
                        document.getElementById('accountNumber').value = item.cuenta;
                        document.getElementById('accountCciInput').value = item.cuentaInterbancaria;
                        bankSelect.value = item.bancoId;
                        currencySelect.value = item.monedaId;
                        bankSelect.disabled = true;
                        currencySelect.disabled = true;
                        bankSelect.classList.add('d-none');
                        currencySelect.classList.add('d-none');
                        document.getElementById('accountBankName').textContent = item.bancoNombre;
                        document.getElementById('accountCurrencyName').textContent = item.monedaNombre;
                        document.getElementById('accountBankBadge').classList.remove('d-none');
                        document.getElementById('accountCurrencyBadge').classList.remove('d-none');
                        document.getElementById('accountModalTitle').textContent = `Editar cuenta bancaria #${item.id}`;
                        modal.show();
                    } catch {
                        notify('error', 'Ocurrió un error de comunicación al cargar la cuenta.');
                    }
                });

            bankSelect.addEventListener('change', () => {
                document.getElementById('accountBancoId').value = bankSelect.value || '0';
            });
            currencySelect.addEventListener('change', () => {
                document.getElementById('accountMonedaId').value = currencySelect.value || '0';
            });

            form.addEventListener('submit', async event => {
                event.preventDefault();
                document.getElementById('accountCci').value = document.getElementById('accountCciInput').value.trim();
                const data = new FormData(form);
                data.set('BancoId', document.getElementById('accountBancoId').value);
                data.set('MonedaId', document.getElementById('accountMonedaId').value);
                const button = document.getElementById('saveAccountButton');
                button.disabled = true;
                try {
                    const response = await fetch('/TS/CuentaBanco/Guardar', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token },
                        body: data
                    });
                    const result = await response.json();
                    if (!response.ok || !result.success) {
                        notify('error', result.message || 'No se pudo guardar la cuenta bancaria.');
                        return;
                    }
                    notify('success', result.message);
                    modal.hide();
                    window.location.reload();
                } catch {
                    notify('error', 'Ocurrió un error de comunicación al guardar la cuenta.');
                } finally {
                    button.disabled = false;
                }
            });

            window.erpListings.onClick('.js-toggle-account', async (button) => {
                    const isActive = button.dataset.state === 'A';
                    const confirmation = await Swal.fire({
                        title: `¿${isActive ? 'Desactivar' : 'Activar'} cuenta?`,
                        text: button.dataset.name,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: isActive ? 'Desactivar' : 'Activar',
                        cancelButtonText: 'Cancelar'
                    });
                    if (!confirmation.isConfirmed) return;

                    try {
                        const data = new FormData();
                        data.append('id', button.dataset.id);
                        const response = await fetch('/TS/CuentaBanco/CambiarEstado', {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': token },
                            body: data
                        });
                        const result = await response.json();
                        if (!response.ok || !result.success) {
                            notify('error', result.message || 'No se pudo cambiar el estado.');
                            return;
                        }
                        notify('success', result.message);
                        window.location.reload();
                    } catch {
                        notify('error', 'Ocurrió un error de comunicación al cambiar el estado.');
                    }
                });
        })();
    </script>
}
