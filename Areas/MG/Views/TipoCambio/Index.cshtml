@model List<AspNet10ArcoERP.Models.TipoCambioModel>
@{
    ViewData["Title"] = "Tipos de Cambio Diarios";
    var tiposCatalogo = ViewBag.TiposCambio as List<AspNet10ArcoERP.Models.TipoCambioCatalogoItem> ?? new List<AspNet10ArcoERP.Models.TipoCambioCatalogoItem>();
    var monedasCatalogo = ViewBag.Monedas as List<AspNet10ArcoERP.Models.MonedaCatalogoItem> ?? new List<AspNet10ArcoERP.Models.MonedaCatalogoItem>();
    var tiposCambioMaestros = ViewBag.TiposCambioMaestros as List<AspNet10ArcoERP.Models.TipoCambioMaestroModel> ?? new();

    int currentTop = ViewBag.Top != null ? (int)ViewBag.Top : 25;
    string currentSearch = ViewBag.Search as string ?? "";
    int? currentTipo = ViewBag.Tipo as int?;
    string currentEstado = ViewBag.Estado as string ?? "";
}

<style>
    #modal-crud-tc .modal-content { max-height: 90vh; display: flex; flex-direction: column; overflow: hidden; }
    #modal-crud-tc .modal-body { max-height: calc(90vh - 135px) !important; overflow-y: auto !important; flex: 1 1 auto; scrollbar-width: thin; scrollbar-color: rgba(140, 150, 165, 0.4) transparent; scroll-behavior: smooth; }
    #modal-crud-tc .modal-body::-webkit-scrollbar { width: 7px; }
    #modal-crud-tc .modal-body::-webkit-scrollbar-track { background: transparent; }
    #modal-crud-tc .modal-body::-webkit-scrollbar-thumb { background: rgba(140, 150, 165, 0.45); border-radius: 4px; }
    #modal-crud-tc .modal-body::-webkit-scrollbar-thumb:hover { background: rgba(140, 150, 165, 0.75); }
    #modal-tipo-cambio-maestro .modal-content { max-height: 90vh; display: flex; flex-direction: column; overflow: hidden; }
    #modal-tipo-cambio-maestro .modal-body { max-height: calc(90vh - 135px) !important; overflow-y: auto !important; flex: 1 1 auto; scrollbar-width: thin; scrollbar-color: rgba(140, 150, 165, 0.4) transparent; scroll-behavior: smooth; }
    #modal-tipo-cambio-maestro .modal-body::-webkit-scrollbar { width: 7px; }
    #modal-tipo-cambio-maestro .modal-body::-webkit-scrollbar-track { background: transparent; }
    #modal-tipo-cambio-maestro .modal-body::-webkit-scrollbar-thumb { background: rgba(140, 150, 165, 0.45); border-radius: 4px; }
    #modal-tipo-cambio-maestro .modal-body::-webkit-scrollbar-thumb:hover { background: rgba(140, 150, 165, 0.75); }
    /* Estabilidad y altura fija compacta en cabecera de la tabla */
    .table-fixed-header {
        table-layout: auto;
    }
    .table-header-custom th {
        padding-top: 0.45rem !important;
        padding-bottom: 0.45rem !important;
        font-size: 0.78rem !important;
        letter-spacing: 0.5px;
        white-space: nowrap !important;
        vertical-align: middle !important;
        height: 40px !important;
        line-height: 1.2;
    }
    .th-sortable {
        cursor: pointer;
        user-select: none;
        transition: background-color 0.15s ease, color 0.15s ease;
    }
    .th-sortable:hover {
        background-color: var(--bs-tertiary-bg);
        color: var(--bs-primary);
    }
</style>

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-currency-exchange text-success me-2" style="font-size: 1.6rem;"></i>Tipos de Cambio Diarios
                </h3>
                <small class="text-muted">Cotizaciones oficiales y comerciales de paridad cambiaria (Compra y Venta)</small>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <button type="button" class="btn btn-primary shadow-sm fw-semibold px-3" onclick="abrirModalCrear();">
                    <i class="bi bi-plus-circle-fill me-1"></i>Nuevo Tipo de Cambio
                </button>
                <button type="button" class="btn btn-outline-primary shadow-sm fw-semibold px-3 ms-1" onclick="abrirModalTipoCambioMaestro();">
                    <i class="bi bi-gear-fill me-1"></i>Tipos de Cambio
                </button>
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4">
    <div class="container-fluid">
        <!-- BARRA DE FILTROS EN LÍNEA: BUSCADOR - TIPO - ESTADO - MOSTRANDO (POR DEFECTO 25) -->
        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    
                    <!-- CONTENEDOR DE FILTROS EN LÍNEA -->
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <!-- 1. Buscador con soporte de búsqueda en servidor (Enter / botón) y filtro en vivo -->
                        <div class="input-group input-group-sm" style="width: 320px;">
                            <span class="input-group-text bg-body-tertiary border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" id="filtro-tabla" class="form-control border-start-0 ps-0" 
                                   placeholder="Buscar por fecha (dd/mm/aaaa) o monto..." 
                                   value="@currentSearch"
                                   onkeypress="if(event.keyCode==13){ buscarEnServidor(); }"
                                   onkeyup="aplicarFiltrosLocal();" />
                            <button type="button" class="btn btn-outline-primary" onclick="buscarEnServidor();" title="Buscar en Base de Datos">
                                <i class="bi bi-search"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary" onclick="limpiarFiltros();" title="Limpiar"><i class="bi bi-x-lg"></i></button>
                        </div>

                        <!-- 2. Filtro por Tipo de Paridad (Select) -->
                        <div class="input-group input-group-sm" style="width: auto;">
                            <span class="input-group-text bg-body-tertiary text-muted border-end-0">
                                <i class="bi bi-tag text-primary"></i>
                            </span>
                            <select id="filtro-tipo" class="form-select form-select-sm border-start-0" style="min-width: 140px;" onchange="buscarEnServidor();" title="Filtrar por Tipo">
                                <option value="">Todos los Tipos</option>
                                @foreach (var tc in tiposCatalogo)
                                {
                                    <option value="@tc.Id" selected="@(currentTipo == tc.Id ? "selected" : null)">@tc.Nombre</option>
                                }
                            </select>
                        </div>

                        <!-- 3. Estado (Select) -->
                        <div class="input-group input-group-sm" style="width: auto;">
                            <span class="input-group-text bg-body-tertiary text-muted border-end-0">
                                <i class="bi bi-toggle-on text-primary"></i>
                            </span>
                            <select id="filtro-estado" class="form-select form-select-sm border-start-0" style="min-width: 140px;" onchange="buscarEnServidor();" title="Filtrar por Estado">
                                <option value="" selected="@(string.IsNullOrEmpty(currentEstado) ? "selected" : null)">Todos los Estados</option>
                                <option value="A" selected="@(currentEstado == "A" ? "selected" : null)">Solo Activos</option>
                                <option value="I" selected="@(currentEstado == "I" ? "selected" : null)">Solo Inactivos</option>
                            </select>
                        </div>

                        <div class="text-muted small ms-2">
                            <span>Listando: <strong class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6" id="total-registros">@(Model?.Count ?? 0)</strong> registros</span>
                        </div>
                    </div>

                    <!-- 4. BOTÓN DROPDOWN 'MOSTRANDO: 25' (POR DEFECTO 25) -->
                    <div class="dropdown flex-shrink-0">
                        <button class="btn btn-sm btn-outline-primary dropdown-toggle d-flex align-items-center gap-1 shadow-sm px-2 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Cantidad de registros a mostrar">
                            <i class="bi bi-funnel-fill text-primary"></i>
                            <span>Mostrando: <strong class="badge bg-primary text-white ms-1" id="lbl-top-actual">@currentTop</strong></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li class="dropdown-header text-uppercase small fw-bold">Registros a listar</li>
                            <li><a class="dropdown-item item-top @(currentTop == 25 ? "active" : "")" href="@Url.Action("Index", new { search = currentSearch, tipo = currentTipo, estado = currentEstado, top = 25 })">25 registros</a></li>
                            <li><a class="dropdown-item item-top @(currentTop == 50 ? "active" : "")" href="@Url.Action("Index", new { search = currentSearch, tipo = currentTipo, estado = currentEstado, top = 50 })">50 registros</a></li>
                            <li><a class="dropdown-item item-top @(currentTop == 100 ? "active" : "")" href="@Url.Action("Index", new { search = currentSearch, tipo = currentTipo, estado = currentEstado, top = 100 })">100 registros</a></li>
                            <li><a class="dropdown-item item-top @(currentTop == 500 ? "active" : "")" href="@Url.Action("Index", new { search = currentSearch, tipo = currentTipo, estado = currentEstado, top = 500 })">500 registros</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0 table-responsive">
                <table class="table table-striped table-hover align-middle mb-0 table-fixed-header" id="tabla-tipocambio">
                    <thead class="table-header-custom border-bottom bg-body-tertiary">
                        <tr>
                            <th style="width: 70px; min-width: 70px;" class="text-center th-sortable" onclick="ordenarTabla('tabla-tipocambio', 0, true)">
                                <span>ID</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th style="width: 140px; min-width: 140px;" class="text-center th-sortable" onclick="ordenarTabla('tabla-tipocambio', 1, false)">
                                <span>Fecha</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th style="width: 130px; min-width: 130px;" class="text-center th-sortable" onclick="ordenarTabla('tabla-tipocambio', 2, false)">
                                <span>Tipo</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th style="width: 120px; min-width: 120px;" class="text-center th-sortable" onclick="ordenarTabla('tabla-tipocambio', 3, false)">
                                <span>Moneda</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th style="min-width: 140px;" class="text-end th-sortable pe-4" onclick="ordenarTabla('tabla-tipocambio', 4, true)">
                                <span>T.C. Compra</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th style="min-width: 140px;" class="text-end th-sortable pe-4" onclick="ordenarTabla('tabla-tipocambio', 5, true)">
                                <span>T.C. Venta</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th style="width: 100px; min-width: 100px;" class="text-center th-sortable" onclick="ordenarTabla('tabla-tipocambio', 6, false)">
                                <span>Estado</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <!-- COLUMNA ACCIONES AMPLIA Y CÓMODA -->
                            <th style="width: 120px; min-width: 120px;" class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr id="fila-@item.Id" 
                                    data-search="@item.Fecha.ToString("dd/MM/yyyy") @item.Fecha.ToString("yyyy-MM-dd") @item.TipoCambioNombre.ToLower() @item.MontoCompra.ToString("N4") @item.MontoVenta.ToString("N4")" 
                                    data-tipo="@item.TipoCambioId"
                                    data-estado="@item.Estado">
                                    <td class="text-center font-monospace text-muted small">@item.Id</td>
                                    <td class="text-center font-monospace fw-semibold">
                                        <i class="bi bi-calendar-event me-1 text-muted"></i>@item.Fecha.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="text-center">
                                        @if (item.TipoCambioId == 1 || item.TipoCambioNombre.ToUpper().Contains("OFICIAL"))
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                                <i class="bi bi-bank me-1"></i>@item.TipoCambioNombre
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1">
                                                <i class="bi bi-shop me-1"></i>@item.TipoCambioNombre
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                                            @item.MonedaSimbolo (@item.MonedaNombre)
                                        </span>
                                    </td>
                                    <td class="text-end font-monospace pe-4">
                                        <span class="text-success fw-bold fs-6">S/ @item.MontoCompra.ToString("N4")</span>
                                    </td>
                                    <td class="text-end font-monospace pe-4">
                                        <span class="text-primary fw-bold fs-6">S/ @item.MontoVenta.ToString("N4")</span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.Estado == "A")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Inactivo</span>
                                        }
                                    </td>
                                    <!-- BOTONES DE ACCIÓN AMPLIOS Y SEPARADOS -->
                                    <td class="text-center text-nowrap">
                                        <div class="d-inline-flex align-items-center justify-content-center gap-2">
                                            <button class="btn btn-sm btn-outline-primary px-2 py-1 shadow-sm" title="Editar" onclick="abrirModalEditar(@item.Id);">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm @(item.Estado == "A" ? "btn-outline-danger" : "btn-outline-success") px-2 py-1 shadow-sm" 
                                                    title="@(item.Estado == "A" ? "Desactivar" : "Activar")" 
                                                    onclick="cambiarEstado(@item.Id, '@item.Estado', '@item.Fecha.ToString("dd/MM/yyyy") - @item.TipoCambioNombre');">
                                                <i class="bi @(item.Estado == "A" ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="fila-vacia">
                                <td colspan="8" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    <span>No se encontraron tipos de cambio registrados</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card border-0 shadow-sm rounded-3 mt-3" id="tipo-cambio-catalogo">
            <div class="card-header bg-body d-flex justify-content-between align-items-center">
                <div><h5 class="mb-0 fw-semibold">Catálogo de tipos de cambio</h5><small class="text-muted">Paridades disponibles para cotizaciones diarias</small></div>
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="nuevoTipoCambioMaestro()"><i class="bi bi-plus-circle me-1"></i>Nuevo tipo</button>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead><tr><th>Código</th><th>Nombre</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
                    <tbody>
                        @foreach (var tipoMaestro in tiposCambioMaestros)
                        {
                            <tr>
                                <td><span class="badge bg-secondary-subtle text-secondary border font-monospace">@tipoMaestro.Codigo</span></td>
                                <td>@tipoMaestro.Nombre</td>
                                <td>@if (tipoMaestro.Estado == "A") { <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span> } else { <span class="badge bg-secondary-subtle text-secondary border">Inactivo</span> }</td>
                                <td class="text-end text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="editarTipoCambioMaestro(@tipoMaestro.Id)" title="Editar"><i class="bi bi-pencil"></i></button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="cambiarEstadoTipoCambioMaestro(@tipoMaestro.Id, '@tipoMaestro.Estado', this.dataset.nombre)" data-nombre="@tipoMaestro.Nombre" title="Cambiar estado"><i class="bi bi-toggle-on"></i></button>
                                </td>
                            </tr>
                        }
                        @if (tiposCambioMaestros.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-3">No hay tipos de cambio definidos.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL CRUD: TIPO DE CAMBIO DIARIO                        -->
<!-- ======================================================== -->
<div class="modal fade" id="modal-crud-tc" tabindex="-1" aria-labelledby="modalTcLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <form class="modal-content shadow border-0 rounded-4" id="form-tc" onsubmit="guardarTc(event);">
            @Html.AntiForgeryToken()
            <input type="hidden" id="tc-id" name="Id" value="0" />
            <div class="modal-header sticky-top bg-body-tertiary border-bottom py-3 px-4">
                <h5 class="modal-title fw-bold" id="modalTcLabel">
                    <i class="bi bi-currency-exchange text-success me-2"></i><span id="modal-titulo">Nuevo Tipo de Cambio</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
                <div class="modal-body p-4">
                    
                    <div class="row g-2 mb-3">
                        <div class="col-7">
                            <label for="tc-fecha" class="form-label fw-semibold">Fecha <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="tc-fecha" name="Fecha" required />
                        </div>
                        <div class="col-5">
                            <label for="tc-tipo-id" class="form-label fw-semibold">Paridad <span class="text-danger">*</span></label>
                            <select class="form-select" id="tc-tipo-id" name="TipoCambioId" required>
                                @foreach (var tc in tiposCatalogo)
                                {
                                    <option value="@tc.Id">@tc.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="tc-moneda-id" class="form-label fw-semibold">Moneda Extranjera <span class="text-danger">*</span></label>
                        <select class="form-select" id="tc-moneda-id" name="MonedaId" required>
                            @foreach (var m in monedasCatalogo.Where(x => x.Simbolo != "S/"))
                            {
                                <option value="@m.Id" selected>@m.Nombre (@m.Simbolo)</option>
                            }
                        </select>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label for="tc-monto-c" class="form-label fw-semibold text-success">
                                <i class="bi bi-graph-down-arrow me-1"></i>T.C. Compra (S/) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text font-monospace">S/</span>
                                <input type="number" step="0.0001" min="0.0001" class="form-control font-monospace fw-bold" id="tc-monto-c" name="MontoCompra" placeholder="Ej: 3.4230" required />
                            </div>
                        </div>
                        <div class="col-6">
                            <label for="tc-monto-v" class="form-label fw-semibold text-primary">
                                <i class="bi bi-graph-up-arrow me-1"></i>T.C. Venta (S/) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text font-monospace">S/</span>
                                <input type="number" step="0.0001" min="0.0001" class="form-control font-monospace fw-bold" id="tc-monto-v" name="MontoVenta" placeholder="Ej: 3.4310" required />
                            </div>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label for="tc-estado" class="form-label fw-semibold">Estado</label>
                        <select class="form-select" id="tc-estado" name="Estado">
                            <option value="A">Activo</option>
                            <option value="I">Inactivo</option>
                        </select>
                    </div>

                </div>
                <div class="modal-footer sticky-bottom border-top py-3 px-4 bg-body-tertiary">
                    <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold" id="btn-guardar-tc" disabled>
                        <i class="bi bi-check-circle me-1"></i>Guardar Cotización
                    </button>
                </div>
        </form>
    </div>
</div>

<div class="modal fade" id="modal-tipo-cambio-maestro" tabindex="-1" aria-labelledby="tipoCambioMaestroLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <form class="modal-content border-0 shadow rounded-4" id="form-tipo-cambio-maestro" onsubmit="guardarTipoCambioMaestro(event);">
            @Html.AntiForgeryToken()
            <input type="hidden" id="tipo-maestro-id" name="Id" value="0" />
            <div class="modal-header sticky-top bg-body-tertiary">
                <h5 class="modal-title fw-bold" id="tipoCambioMaestroLabel"><i class="bi bi-currency-exchange me-2"></i><span id="tipo-maestro-titulo">Nuevo tipo de cambio</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-3"><label class="form-label fw-semibold" for="tipo-maestro-codigo">Código *</label><input class="form-control text-uppercase font-monospace" id="tipo-maestro-codigo" name="Codigo" maxlength="2" required /></div>
                    <div class="col-md-7"><label class="form-label fw-semibold" for="tipo-maestro-nombre">Nombre *</label><input class="form-control" id="tipo-maestro-nombre" name="Nombre" maxlength="100" required /></div>
                    <div class="col-md-2"><label class="form-label fw-semibold" for="tipo-maestro-estado">Estado</label><select class="form-select" id="tipo-maestro-estado" name="Estado"><option value="A">Activo</option><option value="I">Inactivo</option></select></div>
                </div>
            </div>
            <div class="modal-footer sticky-bottom bg-body-tertiary">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary fw-semibold">Guardar tipo</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    var currentTop = @currentTop;
    var sortColIdx = -1;
    var sortAsc = true;
    var formInitialState = "";
    const tipoMaestroToken = () => $('#form-tipo-cambio-maestro input[name="__RequestVerificationToken"]').val();

    function sonCamposRequeridosValidos() {
        var fecha = ($('#tc-fecha').val() || '').trim();
        var compra = parseFloat($('#tc-monto-c').val()) || 0;
        var venta = parseFloat($('#tc-monto-v').val()) || 0;
        return (fecha !== '' && compra > 0 && venta > 0);
    }

    function actualizarEstadoBotonGuardar() {
        var id = parseInt($('#tc-id').val()) || 0;
        var valido = sonCamposRequeridosValidos();
        var $btn = $('#btn-guardar-tc');

        if (id === 0) {
            $btn.prop('disabled', !valido);
        } else {
            var haCambiado = (formInitialState !== "" && $('#form-tc').serialize() !== formInitialState);
            $btn.prop('disabled', !(valido && haCambiado));
        }
    }

    $(document).on('input change keyup', '#form-tc input, #form-tc select', function () {
        actualizarEstadoBotonGuardar();
    });

    function buscarEnServidor() {
        var search = ($('#filtro-tabla').val() || '').trim();
        var tipo = ($('#filtro-tipo').val() || '').trim();
        var estado = ($('#filtro-estado').val() || '').trim();
        var url = '@Url.Action("Index", "TipoCambio", new { area = "MG" })' 
            + '?search=' + encodeURIComponent(search) 
            + '&tipo=' + tipo 
            + '&estado=' + estado 
            + '&top=' + currentTop;
        window.location.href = url;
    }

    function aplicarFiltrosLocal() {
        var query = ($('#filtro-tabla').val() || '').toLowerCase().trim();
        var totalCoincidencias = 0;

        $('#tabla-tipocambio tbody tr:not(#fila-vacia)').each(function () {
            var $row = $(this);
            var search = ($row.data('search') || '').toString();

            var cumpleQuery = !query || search.indexOf(query) >= 0;

            if (cumpleQuery) {
                totalCoincidencias++;
                $row.removeClass('d-none');
            } else {
                $row.addClass('d-none');
            }
        });

        $('#total-registros').text(totalCoincidencias);
    }

    function limpiarFiltros() {
        window.location.href = '@Url.Action("Index", "TipoCambio", new { area = "MG", top = 25 })';
    }

    function ordenarTabla(tablaId, colIndex, isNumeric) {
        var $table = $('#' + tablaId);
        var $tbody = $table.find('tbody');
        var rows = $tbody.find('tr:not(#fila-vacia)').get();

        if (sortColIdx === colIndex) {
            sortAsc = !sortAsc;
        } else {
            sortColIdx = colIndex;
            sortAsc = true;
        }

        // Actualizar iconos
        $table.find('thead th .sort-icon').attr('class', 'bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon');
        var $th = $table.find('thead th').eq(colIndex);
        var iconClass = isNumeric
            ? (sortAsc ? 'bi-sort-numeric-down text-primary fw-bold' : 'bi-sort-numeric-down-alt text-primary fw-bold')
            : (sortAsc ? 'bi-sort-alpha-down text-primary fw-bold' : 'bi-sort-alpha-down-alt text-primary fw-bold');
        $th.find('.sort-icon').attr('class', 'bi ' + iconClass + ' ms-1 sort-icon');

        rows.sort(function (a, b) {
            var aVal = $(a).children('td').eq(colIndex).text().trim();
            var bVal = $(b).children('td').eq(colIndex).text().trim();

            if (isNumeric) {
                var aNum = parseFloat(aVal.replace(/[^0-9.-]/g, '')) || 0;
                var bNum = parseFloat(bVal.replace(/[^0-9.-]/g, '')) || 0;
                return sortAsc ? (aNum - bNum) : (bNum - aNum);
            } else {
                return sortAsc ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
            }
        });

        $.each(rows, function (index, row) {
            $tbody.append(row);
        });
    }

    function abrirModalCrear() {
        $('#modal-titulo').text('Nuevo Tipo de Cambio Diario');
        $('#tc-id').val(0);
        
        var hoy = new Date().toISOString().split('T')[0];
        $('#tc-fecha').val(hoy);
        $('#tc-tipo-id').val('1'); // Por defecto Oficial
        $('#tc-moneda-id').val('2'); // Dólares
        $('#tc-monto-c').val('');
        $('#tc-monto-v').val('');
        $('#tc-estado').val('A');

        formInitialState = "";
        actualizarEstadoBotonGuardar();

        var modal = new bootstrap.Modal(document.getElementById('modal-crud-tc'));
        modal.show();
        setTimeout(function () { $('#tc-monto-c').focus(); }, 300);
    }

    function abrirModalEditar(id) {
        $.ajax({
            url: '@Url.Action("Obtener", "TipoCambio", new { area = "MG" })',
            type: 'GET',
            data: { id: id },
            success: function (res) {
                if (res && res.success && res.data) {
                    $('#modal-titulo').text('Editar Tipo de Cambio #' + id);
                    $('#tc-id').val(res.data.id || res.data.Id);
                    
                    var f = res.data.fecha || res.data.Fecha;
                    if (f) $('#tc-fecha').val(f.substring(0, 10));

                    $('#tc-tipo-id').val(res.data.tipoCambioId || res.data.TipoCambioId || 1);
                    $('#tc-moneda-id').val(res.data.monedaId || res.data.MonedaId || 2);
                    $('#tc-monto-c').val(res.data.montoCompra || res.data.MontoCompra);
                    $('#tc-monto-v').val(res.data.montoVenta || res.data.MontoVenta);
                    $('#tc-estado').val(res.data.estado || res.data.Estado || 'A');

                    var modal = new bootstrap.Modal(document.getElementById('modal-crud-tc'));
                    modal.show();

                    setTimeout(function () {
                        formInitialState = $('#form-tc').serialize();
                        actualizarEstadoBotonGuardar();
                        $('#tc-monto-c').focus();
                    }, 300);
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'No se pudo cargar el registro.' });
                }
            },
            error: function () {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Error de comunicación con el servidor.' });
            }
        });
    }

    function guardarTc(e) {
        e.preventDefault();
        if (!sonCamposRequeridosValidos()) {
            Swal.fire({ icon: 'warning', title: 'Atención', text: 'La fecha, el tipo de cambio de compra y de venta son obligatorios y deben ser mayores a cero.' });
            return;
        }

        var $btn = $('#btn-guardar-tc');
        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Guardando...');

        var formData = $('#form-tc').serialize();
        $.ajax({
            url: '@Url.Action("Guardar", "TipoCambio", new { area = "MG" })',
            type: 'POST',
            data: formData,
            success: function (res) {
                $btn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>Guardar Cotización');
                if (res && res.success) {
                    bootstrap.Modal.getInstance(document.getElementById('modal-crud-tc')).hide();
                    Swal.fire({
                        icon: 'success',
                        title: '¡Éxito!',
                        text: res.message || 'Tipo de cambio guardado correctamente.',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(function () {
                        location.reload();
                    });
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'No se pudo guardar el registro.' });
                }
            },
            error: function () {
                $btn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>Guardar Cotización');
                Swal.fire({ icon: 'error', title: 'Error', text: 'Error de comunicación con el servidor.' });
            }
        });
    }

    function cambiarEstado(id, estadoActual, descripcion) {
        var accion = estadoActual === 'A' ? 'desactivar' : 'activar';
        Swal.fire({
            title: '¿Confirmar cambio de estado?',
            text: '¿Desea ' + accion + ' la cotización de ' + descripcion + '?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, ' + accion,
            cancelButtonText: 'Cancelar',
            confirmButtonColor: estadoActual === 'A' ? '#dc3545' : '#198754'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("CambiarEstado", "TipoCambio", new { area = "MG" })',
                    type: 'POST',
                    data: { id: id },
                    success: function (res) {
                        if (res && res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Actualizado',
                                text: res.message,
                                timer: 1200,
                                showConfirmButton: false
                            }).then(function () {
                                location.reload();
                            });
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'No se pudo cambiar el estado.' });
                        }

                        function abrirModalTipoCambioMaestro() {
                            document.getElementById('tipo-cambio-catalogo').scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }

                        function nuevoTipoCambioMaestro() {
                            $('#form-tipo-cambio-maestro')[0].reset();
                            $('#tipo-maestro-id').val(0);
                            $('#tipo-maestro-codigo').prop('disabled', false);
                            $('#tipo-maestro-titulo').text('Nuevo tipo de cambio');
                            bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-tipo-cambio-maestro')).show();
                        }

                        function editarTipoCambioMaestro(id) {
                            $.get('@Url.Action("ObtenerTipoCambioMaestro", "TipoCambio", new { area = "MG" })', { id }, function (res) {
                                if (!res.success) { Swal.fire({ icon: 'error', title: 'Error', text: res.message }); return; }
                                const d = res.data;
                                $('#tipo-maestro-id').val(d.id || d.Id);
                                $('#tipo-maestro-codigo').val(d.codigo || d.Codigo).prop('readonly', true);
                                $('#tipo-maestro-nombre').val(d.nombre || d.Nombre);
                                $('#tipo-maestro-estado').val(d.estado || d.Estado);
                                $('#tipo-maestro-titulo').text('Editar tipo de cambio #' + id);
                                bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-tipo-cambio-maestro')).show();
                            }).fail(function () { Swal.fire({ icon: 'error', title: 'Error', text: 'No se pudo cargar el tipo de cambio.' }); });
                        }

                        function guardarTipoCambioMaestro(e) {
                            e.preventDefault();
                            $.post('@Url.Action("GuardarTipoCambioMaestro", "TipoCambio", new { area = "MG" })', $('#form-tipo-cambio-maestro').serialize(), function (res) {
                                if (!res.success) { Swal.fire({ icon: 'error', title: 'No se pudo guardar', text: res.message }); return; }
                                bootstrap.Modal.getInstance(document.getElementById('modal-tipo-cambio-maestro')).hide();
                                Swal.fire({ icon: 'success', title: 'Guardado', text: res.message, timer: 1300, showConfirmButton: false }).then(function () { location.reload(); });
                            }).fail(function (xhr) {
                                Swal.fire({ icon: 'error', title: 'Error', text: xhr.responseJSON?.message || 'No se pudo guardar el tipo de cambio.' });
                            });
                        }

                        function cambiarEstadoTipoCambioMaestro(id, estado, nombre) {
                            Swal.fire({ title: estado === 'A' ? '¿Desactivar tipo de cambio?' : '¿Activar tipo de cambio?', text: nombre, icon: 'question', showCancelButton: true, confirmButtonText: 'Confirmar', cancelButtonText: 'Cancelar' }).then(function (result) {
                                if (!result.isConfirmed) return;
                                $.post('@Url.Action("CambiarEstadoTipoCambioMaestro", "TipoCambio", new { area = "MG" })', { id, __RequestVerificationToken: tipoMaestroToken() }, function (res) {
                                    if (res.success) location.reload();
                                    else Swal.fire({ icon: 'error', title: 'Error', text: res.message });
                                }).fail(function () { Swal.fire({ icon: 'error', title: 'Error', text: 'No se pudo cambiar el estado.' }); });
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({ icon: 'error', title: 'Error', text: 'Error de comunicación con el servidor.' });
                    }
                });
            }
        });
    }
</script>
}
