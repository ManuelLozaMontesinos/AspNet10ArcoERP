@model List<AspNet10ArcoERP.Models.RemMinVitalModel>
@{
    ViewData["Title"] = "Remuneración Mínima Vital (RMV)";
}

<style>
    /* Estabilidad y altura fija compacta en cabecera de la tabla */
    .table-fixed-header {
        table-layout: auto;
    }
    .table-header-custom th {
        padding-top: 0.45rem !important;
        padding-bottom: 0.45rem !important;
        font-size: 0.78rem !important;
        letter-spacing: 0.5px;
        white-space: nowrap !important;
        vertical-align: middle !important;
        height: 40px !important;
        line-height: 1.2;
    }
    .th-sortable {
        cursor: pointer;
        user-select: none;
        transition: background-color 0.15s ease, color 0.15s ease;
    }
    .th-sortable:hover {
        background-color: var(--bs-tertiary-bg);
        color: var(--bs-primary);
    }
</style>

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-wallet2 text-info me-2" style="font-size: 1.6rem;"></i>Remuneración Mínima Vital (RMV)
                </h3>
                <small class="text-muted">Sueldos mínimos vitales de ley aplicados a planillas y subsidios</small>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <button type="button" class="btn btn-primary shadow-sm fw-semibold px-3" onclick="abrirModalCrear();">
                    <i class="bi bi-plus-circle-fill me-1"></i>Nueva RMV
                </button>
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4">
    <div class="container-fluid">
        <!-- BARRA DE FILTROS: BUSCADOR - ESTADO - MOSTRANDO -->
        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    
                    <!-- CONTENEDOR DE FILTROS EN LÍNEA -->
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <!-- 1. Buscador -->
                        <div class="input-group input-group-sm" style="min-width: 320px; max-width: 440px;">
                            <span class="input-group-text bg-body-tertiary border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" id="filtro-tabla" class="form-control border-start-0 ps-0" placeholder="Buscar por monto o fecha..." onkeyup="aplicarFiltros();" />
                            <button type="button" class="btn btn-outline-secondary" onclick="limpiarFiltros();" title="Limpiar"><i class="bi bi-x-lg"></i></button>
                        </div>

                        <!-- 2. Estado (Select) -->
                        <div class="input-group input-group-sm" style="width: auto;">
                            <span class="input-group-text bg-body-tertiary text-muted border-end-0">
                                <i class="bi bi-toggle-on text-primary"></i>
                            </span>
                            <select id="filtro-estado" class="form-select form-select-sm border-start-0" style="min-width: 140px;" onchange="aplicarFiltros();" title="Filtrar por Estado">
                                <option value="">Todos los Estados</option>
                                <option value="A">Solo Activos</option>
                                <option value="I">Solo Inactivos</option>
                            </select>
                        </div>

                        <div class="text-muted small ms-2">
                            <span>Total: <strong class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6" id="total-registros">@(Model?.Count ?? 0)</strong> periodos</span>
                        </div>
                    </div>

                    <!-- 3. BOTÓN DROPDOWN 'MOSTRANDO: 25' -->
                    <div class="dropdown flex-shrink-0">
                        <button class="btn btn-sm btn-outline-primary dropdown-toggle d-flex align-items-center gap-1 shadow-sm px-2 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Cantidad de registros a mostrar">
                            <i class="bi bi-funnel-fill text-primary"></i>
                            <span>Mostrando: <strong class="badge bg-primary text-white ms-1" id="lbl-top-actual">25</strong></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li class="dropdown-header text-uppercase small fw-bold">Registros a listar</li>
                            <li><a class="dropdown-item item-top active" href="javascript:void(0)" onclick="cambiarTop(25)">25 registros</a></li>
                            <li><a class="dropdown-item item-top" href="javascript:void(0)" onclick="cambiarTop(50)">50 registros</a></li>
                            <li><a class="dropdown-item item-top" href="javascript:void(0)" onclick="cambiarTop(100)">100 registros</a></li>
                            <li><a class="dropdown-item item-top" href="javascript:void(0)" onclick="cambiarTop(500)">500 registros</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0 table-responsive">
                <table class="table table-striped table-hover align-middle mb-0 table-fixed-header" id="tabla-rmv">
                    <thead class="table-header-custom border-bottom bg-body-tertiary">
                        <tr>
                            <th style="width: 70px;" class="text-center th-sortable" onclick="ordenarTabla('tabla-rmv', 0, true)">
                                <span>ID</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th class="th-sortable" onclick="ordenarTabla('tabla-rmv', 1, true)">
                                <span>Monto Salarial RMV</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th style="width: 140px;" class="text-center th-sortable" onclick="ordenarTabla('tabla-rmv', 2, false)">
                                <span>Fecha Inicio</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th style="width: 140px;" class="text-center th-sortable" onclick="ordenarTabla('tabla-rmv', 3, false)">
                                <span>Fecha Fin</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th style="width: 120px;" class="text-center">
                                <span>Vigencia</span>
                            </th>
                            <th style="width: 100px;" class="text-center th-sortable" onclick="ordenarTabla('tabla-rmv', 5, false)">
                                <span>Estado</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th style="width: 110px;" class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var item in Model)
                            {
                                bool esVigente = item.Estado == "A" && DateTime.Today >= item.FechaAlta.Date && (!item.FechaBaja.HasValue || DateTime.Today <= item.FechaBaja.Value.Date);
                                <tr id="fila-@item.Id" data-search="@item.Monto @item.FechaAlta.ToString("yyyy-MM-dd") @item.FechaAlta.ToString("dd/MM/yyyy")" data-estado="@item.Estado">
                                    <td class="text-center font-monospace text-muted small">@item.Id</td>
                                    <td>
                                        <span class="fw-bold font-monospace text-primary fs-6">S/ @item.Monto.ToString("N2")</span>
                                    </td>
                                    <td class="text-center font-monospace">
                                        <i class="bi bi-calendar-event me-1 text-muted"></i>@item.FechaAlta.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="text-center font-monospace">
                                        @if (item.FechaBaja.HasValue)
                                        {
                                            <span>@item.FechaBaja.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">&mdash; Indefinido &mdash;</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (esVigente)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i>Vigente</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Histórico</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.Estado == "A")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-center text-nowrap">
                                        <div class="d-inline-flex align-items-center justify-content-center gap-2">
                                            <button class="btn btn-sm btn-outline-primary px-2 py-1 shadow-sm btn-action-edit" title="Editar" onclick="abrirModalEditar(@item.Id);">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm @(item.Estado == "A" ? "btn-outline-danger" : "btn-outline-success") px-2 py-1 shadow-sm btn-action-toggle" title="@(item.Estado == "A" ? "Desactivar" : "Activar")" onclick="cambiarEstado(@item.Id, '@item.Estado', 'S/ @item.Monto.ToString("N2")');">
                                                <i class="bi @(item.Estado == "A" ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="fila-vacia">
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    <span>No se encontraron registros de RMV</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL CRUD: REMUNERACIÓN MÍNIMA VITAL                     -->
<!-- ======================================================== -->
<div class="modal fade" id="modal-crud-rmv" tabindex="-1" aria-labelledby="modalRmvLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0 rounded-4">
            <div class="modal-header border-bottom py-3 px-4 bg-body-tertiary">
                <h5 class="modal-title fw-bold" id="modalRmvLabel">
                    <i class="bi bi-wallet2 text-info me-2"></i><span id="modal-titulo">Nueva RMV</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="form-rmv" onsubmit="guardarRmv(event);">
                @Html.AntiForgeryToken()
                <input type="hidden" id="rmv-id" name="Id" value="0" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label for="rmv-monto" class="form-label fw-semibold">Monto Salarial RMV (Soles) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">S/</span>
                            <input type="number" step="0.01" class="form-control" id="rmv-monto" name="Monto" placeholder="Ej: 1025.00" required min="1" />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label for="rmv-fecha-alta" class="form-label fw-semibold">Fecha Alta <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="rmv-fecha-alta" name="FechaAlta" required />
                        </div>
                        <div class="col-6">
                            <label for="rmv-fecha-baja" class="form-label fw-semibold">Fecha Baja (Opcional)</label>
                            <input type="date" class="form-control" id="rmv-fecha-baja" name="FechaBaja" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label for="rmv-estado" class="form-label fw-semibold">Estado</label>
                        <select class="form-select" id="rmv-estado" name="Estado">
                            <option value="A">Activo</option>
                            <option value="I">Inactivo</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top py-3 px-4 bg-body-tertiary">
                    <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold" id="btn-guardar-rmv" disabled>
                        <i class="bi bi-check-circle me-1"></i>Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var topActual = 25;
    var sortColIdx = -1;
    var sortAsc = true;
    var formInitialState = "";

    function sonCamposRequeridosValidos() {
        var monto = parseFloat($('#rmv-monto').val()) || 0;
        var fAlta = ($('#rmv-fecha-alta').val() || '').trim();
        return (monto > 0 && fAlta !== '');
    }

    function actualizarEstadoBotonGuardar() {
        var id = parseInt($('#rmv-id').val()) || 0;
        var valido = sonCamposRequeridosValidos();
        var $btn = $('#btn-guardar-rmv');

        if (id === 0) {
            $btn.prop('disabled', !valido);
        } else {
            var haCambiado = (formInitialState !== "" && $('#form-rmv').serialize() !== formInitialState);
            $btn.prop('disabled', !(valido && haCambiado));
        }
    }

    $(document).on('input change keyup', '#form-rmv input, #form-rmv select', function () {
        actualizarEstadoBotonGuardar();
    });

    function aplicarFiltros() {
        var query = ($('#filtro-tabla').val() || '').toLowerCase().trim();
        var estado = ($('#filtro-estado').val() || '').trim();
        var totalCoincidencias = 0;
        var mostrados = 0;

        $('#tabla-rmv tbody tr:not(#fila-vacia)').each(function () {
            var $row = $(this);
            var search = ($row.data('search') || '').toString();
            var rowEstado = ($row.data('estado') || '').toString();

            var cumpleQuery = !query || search.indexOf(query) >= 0;
            var cumpleEstado = !estado || rowEstado === estado;

            if (cumpleQuery && cumpleEstado) {
                totalCoincidencias++;
                var limit = topActual > 0 ? topActual : 25;
                if (mostrados < limit) {
                    $row.removeClass('d-none');
                    mostrados++;
                } else {
                    $row.addClass('d-none');
                }
            } else {
                $row.addClass('d-none');
            }
        });

        $('#total-registros').text(totalCoincidencias);
    }

    function limpiarFiltros() {
        $('#filtro-tabla').val('');
        $('#filtro-estado').val('');
        aplicarFiltros();
    }

    function cambiarTop(cant) {
        topActual = cant > 0 ? cant : 25;
        $('#lbl-top-actual').text(topActual);
        $('.item-top').removeClass('active');
        $(event.target).addClass('active');
        aplicarFiltros();
    }

    function ordenarTabla(tablaId, colIndex, isNumeric) {
        var $table = $('#' + tablaId);
        var $tbody = $table.find('tbody');
        var rows = $tbody.find('tr:not(#fila-vacia)').get();

        if (sortColIdx === colIndex) {
            sortAsc = !sortAsc;
        } else {
            sortColIdx = colIndex;
            sortAsc = true;
        }

        // Actualizar iconos
        $table.find('thead th .sort-icon').attr('class', 'bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon');
        var $th = $table.find('thead th').eq(colIndex);
        var iconClass = isNumeric
            ? (sortAsc ? 'bi-sort-numeric-down text-primary fw-bold' : 'bi-sort-numeric-down-alt text-primary fw-bold')
            : (sortAsc ? 'bi-sort-alpha-down text-primary fw-bold' : 'bi-sort-alpha-down-alt text-primary fw-bold');
        $th.find('.sort-icon').attr('class', 'bi ' + iconClass + ' ms-1 sort-icon');

        rows.sort(function (a, b) {
            var aVal = $(a).children('td').eq(colIndex).text().trim();
            var bVal = $(b).children('td').eq(colIndex).text().trim();

            if (isNumeric) {
                var aNum = parseFloat(aVal.replace(/[^0-9.-]/g, '')) || 0;
                var bNum = parseFloat(bVal.replace(/[^0-9.-]/g, '')) || 0;
                return sortAsc ? (aNum - bNum) : (bNum - aNum);
            } else {
                return sortAsc ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
            }
        });

        $.each(rows, function (index, row) {
            $tbody.append(row);
        });

        aplicarFiltros();
    }

    function abrirModalCrear() {
        $('#modal-titulo').text('Nueva RMV');
        $('#rmv-id').val(0);
        $('#rmv-monto').val('');
        var hoy = new Date().toISOString().split('T')[0];
        $('#rmv-fecha-alta').val(hoy);
        $('#rmv-fecha-baja').val('');
        $('#rmv-estado').val('A');

        formInitialState = "";
        actualizarEstadoBotonGuardar();

        var modal = new bootstrap.Modal(document.getElementById('modal-crud-rmv'));
        modal.show();
        setTimeout(function () { $('#rmv-monto').focus(); }, 300);
    }

    function abrirModalEditar(id) {
        $.ajax({
            url: '@Url.Action("Obtener", "RemMinVital", new { area = "MG" })',
            type: 'GET',
            data: { id: id },
            success: function (res) {
                if (res && res.success && res.data) {
                    $('#modal-titulo').text('Editar RMV #' + id);
                    $('#rmv-id').val(res.data.id || res.data.Id);
                    $('#rmv-monto').val(res.data.monto || res.data.Monto);
                    
                    var fAlta = res.data.fechaAlta || res.data.FechaAlta;
                    if (fAlta) $('#rmv-fecha-alta').val(fAlta.substring(0, 10));
                    
                    var fBaja = res.data.fechaBaja || res.data.FechaBaja;
                    if (fBaja) $('#rmv-fecha-baja').val(fBaja.substring(0, 10));
                    else $('#rmv-fecha-baja').val('');
                    
                    $('#rmv-estado').val(res.data.estado || res.data.Estado || 'A');

                    var modal = new bootstrap.Modal(document.getElementById('modal-crud-rmv'));
                    modal.show();

                    setTimeout(function () {
                        formInitialState = $('#form-rmv').serialize();
                        actualizarEstadoBotonGuardar();
                        $('#rmv-monto').focus();
                    }, 300);
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'No se pudo cargar la RMV.' });
                }
            },
            error: function () {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Error de comunicación con el servidor.' });
            }
        });
    }

    function guardarRmv(e) {
        e.preventDefault();
        var monto = $('#rmv-monto').val();
        var fAlta = $('#rmv-fecha-alta').val();
        if (!monto || !fAlta) {
            Swal.fire({ icon: 'warning', title: 'Atención', text: 'El monto y la fecha de alta son obligatorios.' });
            return;
        }

        var $btn = $('#btn-guardar-rmv');
        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Guardando...');

        var formData = $('#form-rmv').serialize();
        $.ajax({
            url: '@Url.Action("Guardar", "RemMinVital", new { area = "MG" })',
            type: 'POST',
            data: formData,
            success: function (res) {
                $btn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>Guardar');
                if (res && res.success) {
                    bootstrap.Modal.getInstance(document.getElementById('modal-crud-rmv')).hide();
                    Swal.fire({
                        icon: 'success',
                        title: '¡Éxito!',
                        text: res.message || 'RMV guardada correctamente.',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(function () {
                        location.reload();
                    });
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'No se pudo guardar.' });
                }
            },
            error: function () {
                $btn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>Guardar');
                Swal.fire({ icon: 'error', title: 'Error', text: 'Error de comunicación con el servidor.' });
            }
        });
    }

    function cambiarEstado(id, estadoActual, descripcion) {
        var accion = estadoActual === 'A' ? 'desactivar' : 'activar';
        Swal.fire({
            title: '¿Confirmar cambio de estado?',
            text: '¿Desea ' + accion + ' la RMV ' + descripcion + '?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, ' + accion,
            cancelButtonText: 'Cancelar',
            confirmButtonColor: estadoActual === 'A' ? '#dc3545' : '#198754'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("CambiarEstado", "RemMinVital", new { area = "MG" })',
                    type: 'POST',
                    data: { id: id },
                    success: function (res) {
                        if (res && res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Actualizado',
                                text: res.message,
                                timer: 1200,
                                showConfirmButton: false
                            }).then(function () {
                                location.reload();
                            });
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'No se pudo cambiar el estado.' });
                        }
                    },
                    error: function () {
                        Swal.fire({ icon: 'error', title: 'Error', text: 'Error de comunicación con el servidor.' });
                    }
                });
            }
        });
    }

    $(document).ready(function () {
        aplicarFiltros();
    });
</script>
}
