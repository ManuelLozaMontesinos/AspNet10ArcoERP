@model List<AspNet10ArcoERP.Models.GrupoClaseFamiliaModel>
@{
    ViewData["Title"] = "Familias de Producto";
    var clasesLookup = ViewBag.ClasesLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-diagram-2-fill text-danger me-2" style="font-size: 1.6rem;"></i>Familias de Producto
                </h3>
                <small class="text-muted">Jerarquía de categorización de catálogo: Grupo &rarr; Clase &rarr; Familia</small>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <button type="button" class="btn btn-primary shadow-sm font-weight-600 px-3" onclick="abrirModalCrear();">
                    <i class="bi bi-plus-circle-fill me-1"></i>Nueva Familia
                </button>
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4">
    <div class="container-fluid">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-body border-bottom py-3">
                <div class="row g-2 align-items-center justify-content-between">
                    <div class="col-md-5 d-flex align-items-center">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-body-tertiary border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" id="filtro-tabla" class="form-control border-start-0 ps-0" placeholder="Buscar por familia, clase o grupo..." onkeyup="filtrarTabla();" />
                        </div>
                    </div>
                    <div class="col-md-4 text-md-end text-muted small">
                        <span>Total: <strong class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6" id="total-registros">@Model.Count</strong> familias registradas</span>
                    </div>
                </div>
            </div>

            <div class="card-body p-0 table-responsive">
                <table class="table table-striped table-hover align-middle mb-0" id="tabla-familias">
                    <thead class="table-header-custom border-bottom">
                        <tr>
                            <th style="width: 70px;" class="text-center">ID</th>
                            <th style="width: 90px;" class="text-center">Cód.</th>
                            <th>Familia</th>
                            <th>Clase &bull; Grupo</th>
                            <th style="width: 110px;" class="text-center">Estado</th>
                            <th style="width: 130px;" class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr id="fila-@item.FamiliaId" data-search="@item.FamiliaCodigo.ToLower() @item.FamiliaNombre.ToLower() @item.ClaseNombre.ToLower() @item.GrupoNombre.ToLower()">
                                    <td class="text-center font-monospace text-muted small">@item.FamiliaId</td>
                                    <td class="text-center font-monospace fw-bold text-primary">@item.FamiliaCodigo</td>
                                    <td>
                                        <span class="fw-semibold text-body">@item.FamiliaNombre</span>
                                    </td>
                                    <td>
                                        <span class="text-muted small">@item.ClaseNombre</span>
                                        <small class="badge bg-secondary-subtle text-secondary border ms-1">@item.GrupoNombre</small>
                                    </td>
                                    <td class="text-center">
                                        @if (item.Estado == "A")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary py-0 px-2 btn-action-edit" title="Editar" onclick="abrirModalEditar(@item.FamiliaId);">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm @(item.Estado == "A" ? "btn-outline-danger" : "btn-outline-success") py-0 px-2 ms-1 btn-action-toggle" title="@(item.Estado == "A" ? "Desactivar" : "Activar")" onclick="cambiarEstado(@item.FamiliaId, '@item.Estado', '@item.FamiliaNombre');">
                                            <i class="bi @(item.Estado == "A" ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    <span>No se encontraron familias de producto</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL CRUD: FAMILIA DE PRODUCTO                          -->
<!-- ======================================================== -->
<div class="modal fade" id="modal-crud-familia" tabindex="-1" aria-labelledby="modalFamLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0 rounded-4">
            <div class="modal-header border-bottom py-3 px-4 bg-body-tertiary">
                <h5 class="modal-title fw-bold" id="modalFamLabel">
                    <i class="bi bi-diagram-2 text-danger me-2"></i><span id="modal-titulo">Nueva Familia de Producto</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="form-familia" onsubmit="guardarFamilia(event);">
                @Html.AntiForgeryToken()
                <input type="hidden" id="fam-id" name="FamiliaId" value="0" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label for="fam-clase-id" class="form-label fw-semibold">Clase de Producto <span class="text-danger">*</span></label>
                        <select class="form-select" id="fam-clase-id" name="ClaseId" required>
                            <option value="">-- Seleccione una clase --</option>
                            @foreach (var c in clasesLookup)
                            {
                                <option value="@c.Id">@c.Nombre (@c.Codigo)</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label for="fam-codigo" class="form-label fw-semibold">Código</label>
                            <input type="text" class="form-control text-uppercase" id="fam-codigo" name="FamiliaCodigo" placeholder="001" maxlength="3" />
                        </div>
                        <div class="col-8">
                            <label for="fam-nombre" class="form-label fw-semibold">Nombre de la Familia <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="fam-nombre" name="FamiliaNombre" placeholder="Ej: Pinturas Epóxicas..." maxlength="100" required />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label for="fam-estado" class="form-label fw-semibold">Estado</label>
                        <select class="form-select" id="fam-estado" name="Estado">
                            <option value="A">Activo</option>
                            <option value="I">Inactivo</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top py-3 px-4 bg-body-tertiary">
                    <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold" id="btn-guardar-fam">
                        <i class="bi bi-check-circle me-1"></i>Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function filtrarTabla() {
        var query = $('#filtro-tabla').val().toLowerCase().trim();
        var visibles = 0;
        $('#tabla-familias tbody tr').each(function () {
            var $row = $(this);
            var search = $row.data('search') || '';
            if (!query || search.indexOf(query) >= 0) {
                $row.removeClass('d-none');
                visibles++;
            } else {
                $row.addClass('d-none');
            }
        });
        $('#total-registros').text(visibles);
    }

    function abrirModalCrear() {
        $('#modal-titulo').text('Nueva Familia de Producto');
        $('#fam-id').val(0);
        $('#fam-clase-id').val('');
        $('#fam-codigo').val('');
        $('#fam-nombre').val('');
        $('#fam-estado').val('A');
        var modal = new bootstrap.Modal(document.getElementById('modal-crud-familia'));
        modal.show();
        setTimeout(function () { $('#fam-nombre').focus(); }, 300);
    }

    function abrirModalEditar(id) {
        $.ajax({
            url: '@Url.Action("Obtener", "FamiliaProducto", new { area = "MG" })',
            type: 'GET',
            data: { id: id },
            success: function (res) {
                if (res && res.success && res.data) {
                    $('#modal-titulo').text('Editar Familia #' + id);
                    $('#fam-id').val(res.data.familiaId || res.data.FamiliaId);
                    $('#fam-clase-id').val(res.data.claseId || res.data.ClaseId);
                    $('#fam-codigo').val(res.data.familiaCodigo || res.data.FamiliaCodigo || '');
                    $('#fam-nombre').val(res.data.familiaNombre || res.data.FamiliaNombre);
                    $('#fam-estado').val(res.data.estado || res.data.Estado || 'A');
                    var modal = new bootstrap.Modal(document.getElementById('modal-crud-familia'));
                    modal.show();
                    setTimeout(function () { $('#fam-nombre').focus(); }, 300);
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'No se pudo cargar la familia.' });
                }
            },
            error: function () {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Error de comunicación con el servidor.' });
            }
        });
    }

    function guardarFamilia(e) {
        e.preventDefault();
        var nombre = $('#fam-nombre').val().trim();
        var claseId = $('#fam-clase-id').val();
        if (!nombre || !claseId) {
            Swal.fire({ icon: 'warning', title: 'Atención', text: 'Por favor complete todos los campos obligatorios.' });
            return;
        }

        var $btn = $('#btn-guardar-fam');
        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Guardando...');

        var formData = $('#form-familia').serialize();
        $.ajax({
            url: '@Url.Action("Guardar", "FamiliaProducto", new { area = "MG" })',
            type: 'POST',
            data: formData,
            success: function (res) {
                $btn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>Guardar');
                if (res && res.success) {
                    bootstrap.Modal.getInstance(document.getElementById('modal-crud-familia')).hide();
                    Swal.fire({
                        icon: 'success',
                        title: '¡Éxito!',
                        text: res.message || 'Guardado correctamente.',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(function () {
                        location.reload();
                    });
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'No se pudo guardar.' });
                }
            },
            error: function () {
                $btn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>Guardar');
                Swal.fire({ icon: 'error', title: 'Error', text: 'Error de comunicación con el servidor.' });
            }
        });
    }

    function cambiarEstado(id, estadoActual, nombre) {
        var accion = estadoActual === 'A' ? 'desactivar' : 'activar';
        Swal.fire({
            title: '¿Confirmar cambio de estado?',
            text: '¿Desea ' + accion + ' la familia "' + nombre + '"?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, ' + accion,
            cancelButtonText: 'Cancelar',
            confirmButtonColor: estadoActual === 'A' ? '#dc3545' : '#198754'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("CambiarEstado", "FamiliaProducto", new { area = "MG" })',
                    type: 'POST',
                    data: { id: id },
                    success: function (res) {
                        if (res && res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Actualizado',
                                text: res.message,
                                timer: 1200,
                                showConfirmButton: false
                            }).then(function () {
                                location.reload();
                            });
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'No se pudo cambiar el estado.' });
                        }
                    },
                    error: function () {
                        Swal.fire({ icon: 'error', title: 'Error', text: 'Error de comunicación con el servidor.' });
                    }
                });
            }
        });
    }
</script>
}
