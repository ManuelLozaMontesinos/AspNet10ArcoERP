@model List<AspNet10ArcoERP.Models.GrupoClaseFamiliaModel>
@{
    ViewData["Title"] = "Familias de Producto";
    var clasesLookup = ViewBag.ClasesLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
}

<style>
    /* Estabilidad y altura fija compacta en cabecera de la tabla */
    .table-fixed-header {
        table-layout: auto;
    }
    .table-header-custom th {
        padding-top: 0.45rem !important;
        padding-bottom: 0.45rem !important;
        font-size: 0.78rem !important;
        letter-spacing: 0.5px;
        white-space: nowrap !important;
        vertical-align: middle !important;
        height: 40px !important;
        line-height: 1.2;
    }
    .th-sortable {
        cursor: pointer;
        user-select: none;
        transition: background-color 0.15s ease, color 0.15s ease;
    }
    .th-sortable:hover {
        background-color: var(--bs-tertiary-bg);
        color: var(--bs-primary);
    }
</style>

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-diagram-2-fill text-danger me-2" style="font-size: 1.6rem;"></i>Familias de Producto
                </h3>
                <small class="text-muted">Jerarquía de categorización de catálogo: Grupo &rarr; Clase &rarr; Familia</small>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <button type="button" class="btn btn-primary shadow-sm fw-semibold px-3" onclick="abrirModalCrear();">
                    <i class="bi bi-plus-circle-fill me-1"></i>Nueva Familia
                </button>
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4">
    <div class="container-fluid">
        <!-- BARRA DE FILTROS: BUSCADOR - CLASE - ESTADO - MOSTRANDO -->
        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    
                    <!-- CONTENEDOR DE FILTROS EN LÍNEA -->
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <!-- 1. Buscador -->
                        <div class="input-group input-group-sm" style="width: 280px;">
                            <span class="input-group-text bg-body-tertiary border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" id="filtro-tabla" class="form-control border-start-0 ps-0" placeholder="Buscar por familia, clase o grupo..." onkeyup="aplicarFiltros();" />
                            <button type="button" class="btn btn-outline-secondary" onclick="limpiarFiltros();" title="Limpiar"><i class="bi bi-x-lg"></i></button>
                        </div>

                        <!-- 2. Clase (Select) -->
                        <div class="input-group input-group-sm" style="width: auto;">
                            <span class="input-group-text bg-body-tertiary text-muted border-end-0">
                                <i class="bi bi-collection text-primary"></i>
                            </span>
                            <select id="filtro-clase" class="form-select form-select-sm border-start-0" style="min-width: 160px;" onchange="aplicarFiltros();" title="Filtrar por Clase">
                                <option value="">Todas las Clases</option>
                                @foreach (var c in clasesLookup)
                                {
                                    <option value="@c.Id">@c.Nombre</option>
                                }
                            </select>
                        </div>

                        <!-- 3. Estado (Select) -->
                        <div class="input-group input-group-sm" style="width: auto;">
                            <span class="input-group-text bg-body-tertiary text-muted border-end-0">
                                <i class="bi bi-toggle-on text-primary"></i>
                            </span>
                            <select id="filtro-estado" class="form-select form-select-sm border-start-0" style="min-width: 140px;" onchange="aplicarFiltros();" title="Filtrar por Estado">
                                <option value="">Todos los Estados</option>
                                <option value="A">Solo Activos</option>
                                <option value="I">Solo Inactivos</option>
                            </select>
                        </div>

                        <div class="text-muted small ms-2">
                            <span>Total: <strong class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6" id="total-registros">@(Model?.Count ?? 0)</strong> familias</span>
                        </div>
                    </div>

                    <!-- 4. BOTÓN DROPDOWN 'MOSTRANDO: 25' -->
                    <div class="dropdown flex-shrink-0">
                        <button class="btn btn-sm btn-outline-primary dropdown-toggle d-flex align-items-center gap-1 shadow-sm px-2 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Cantidad de registros a mostrar">
                            <i class="bi bi-funnel-fill text-primary"></i>
                            <span>Mostrando: <strong class="badge bg-primary text-white ms-1" id="lbl-top-actual">25</strong></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li class="dropdown-header text-uppercase small fw-bold">Registros a listar</li>
                            <li><a class="dropdown-item item-top active" href="javascript:void(0)" onclick="cambiarTop(25)">25 registros</a></li>
                            <li><a class="dropdown-item item-top" href="javascript:void(0)" onclick="cambiarTop(50)">50 registros</a></li>
                            <li><a class="dropdown-item item-top" href="javascript:void(0)" onclick="cambiarTop(100)">100 registros</a></li>
                            <li><a class="dropdown-item item-top" href="javascript:void(0)" onclick="cambiarTop(500)">500 registros</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0 table-responsive">
                <table class="table table-striped table-hover align-middle mb-0 table-fixed-header" id="tabla-familias">
                    <thead class="table-header-custom border-bottom bg-body-tertiary">
                        <tr>
                            <th style="width: 70px;" class="text-center th-sortable" onclick="ordenarTabla('tabla-familias', 0, true)">
                                <span>ID</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th style="width: 90px;" class="text-center th-sortable" onclick="ordenarTabla('tabla-familias', 1, false)">
                                <span>Cód.</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th class="th-sortable" onclick="ordenarTabla('tabla-familias', 2, false)">
                                <span>Familia</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th class="th-sortable" onclick="ordenarTabla('tabla-familias', 3, false)">
                                <span>Clase &bull; Grupo</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th style="width: 110px;" class="text-center th-sortable" onclick="ordenarTabla('tabla-familias', 4, false)">
                                <span>Estado</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th style="width: 130px;" class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr id="fila-@item.FamiliaId" data-search="@item.FamiliaCodigo.ToLower() @item.FamiliaNombre.ToLower() @item.ClaseNombre.ToLower() @item.GrupoNombre.ToLower()" data-clase="@item.ClaseId" data-estado="@item.Estado">
                                    <td class="text-center font-monospace text-muted small">@item.FamiliaId</td>
                                    <td class="text-center font-monospace fw-bold text-primary">@item.FamiliaCodigo</td>
                                    <td>
                                        <span class="fw-semibold text-body">@item.FamiliaNombre</span>
                                    </td>
                                    <td>
                                        <span class="text-muted small">@item.ClaseNombre</span>
                                        <small class="badge bg-secondary-subtle text-secondary border ms-1">@item.GrupoNombre</small>
                                    </td>
                                    <td class="text-center">
                                        @if (item.Estado == "A")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-2 align-items-center justify-content-center">
                                            <button class="btn btn-sm btn-outline-primary px-2 py-1 shadow-sm btn-action-edit" title="Editar" onclick="abrirModalEditar(@item.FamiliaId);">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm @(item.Estado == "A" ? "btn-outline-danger" : "btn-outline-success") px-2 py-1 shadow-sm btn-action-toggle" title="@(item.Estado == "A" ? "Desactivar" : "Activar")" onclick="cambiarEstado(@item.FamiliaId, '@item.Estado', '@item.FamiliaNombre');">
                                                <i class="bi @(item.Estado == "A" ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="fila-vacia">
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    <span>No se encontraron familias de producto</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL CRUD: FAMILIA DE PRODUCTO                          -->
<!-- ======================================================== -->
<div class="modal fade" id="modal-crud-familia" tabindex="-1" aria-labelledby="modalFamLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0 rounded-4">
            <div class="modal-header border-bottom py-3 px-4 bg-body-tertiary">
                <h5 class="modal-title fw-bold" id="modalFamLabel">
                    <i class="bi bi-diagram-2 text-danger me-2"></i><span id="modal-titulo">Nueva Familia de Producto</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="form-familia" onsubmit="guardarFamilia(event);">
                @Html.AntiForgeryToken()
                <input type="hidden" id="fam-id" name="FamiliaId" value="0" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label for="fam-clase-id" class="form-label fw-semibold">Clase de Producto <span class="text-danger">*</span></label>
                        <select class="form-select" id="fam-clase-id" name="ClaseId" required>
                            <option value="">-- Seleccione una clase --</option>
                            @foreach (var c in clasesLookup)
                            {
                                <option value="@c.Id">@c.Nombre (@c.Codigo)</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label for="fam-codigo" class="form-label fw-semibold">Código</label>
                            <input type="text" class="form-control text-uppercase" id="fam-codigo" name="FamiliaCodigo" placeholder="001" maxlength="3" />
                        </div>
                        <div class="col-8">
                            <label for="fam-nombre" class="form-label fw-semibold">Nombre de la Familia <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="fam-nombre" name="FamiliaNombre" placeholder="Ej: Pinturas Epóxicas..." maxlength="100" required />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label for="fam-estado" class="form-label fw-semibold">Estado</label>
                        <select class="form-select" id="fam-estado" name="Estado">
                            <option value="A">Activo</option>
                            <option value="I">Inactivo</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top py-3 px-4 bg-body-tertiary">
                    <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold" id="btn-guardar-fam" disabled>
                        <i class="bi bi-check-circle me-1"></i>Guardar Familia
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var topActual = 25;
    var sortColIdx = -1;
    var sortAsc = true;
    var formInitialState = "";

    function sonCamposRequeridosValidos() {
        var clase = $('#fam-clase-id').val();
        var nom = ($('#fam-nombre').val() || '').trim();
        return (clase !== '' && nom !== '');
    }

    function actualizarEstadoBotonGuardar() {
        var id = parseInt($('#fam-id').val()) || 0;
        var valido = sonCamposRequeridosValidos();
        var $btn = $('#btn-guardar-fam');

        if (id === 0) {
            $btn.prop('disabled', !valido);
        } else {
            var haCambiado = (formInitialState !== "" && $('#form-familia').serialize() !== formInitialState);
            $btn.prop('disabled', !(valido && haCambiado));
        }
    }

    $(document).on('input change keyup', '#form-familia input, #form-familia select', function () {
        actualizarEstadoBotonGuardar();
    });

    function aplicarFiltros() {
        var query = ($('#filtro-tabla').val() || '').toLowerCase().trim();
        var clase = ($('#filtro-clase').val() || '').trim();
        var estado = ($('#filtro-estado').val() || '').trim();
        var totalCoincidencias = 0;
        var mostrados = 0;

        $('#tabla-familias tbody tr:not(#fila-vacia)').each(function () {
            var $row = $(this);
            var search = ($row.data('search') || '').toString();
            var rowClase = ($row.data('clase') || '').toString();
            var rowEstado = ($row.data('estado') || '').toString();

            var cumpleQuery = !query || search.indexOf(query) >= 0;
            var cumpleClase = !clase || rowClase === clase;
            var cumpleEstado = !estado || rowEstado === estado;

            if (cumpleQuery && cumpleClase && cumpleEstado) {
                totalCoincidencias++;
                var limit = topActual > 0 ? topActual : 25;
                if (mostrados < limit) {
                    $row.removeClass('d-none');
                    mostrados++;
                } else {
                    $row.addClass('d-none');
                }
            } else {
                $row.addClass('d-none');
            }
        });

        $('#total-registros').text(totalCoincidencias);
    }

    function limpiarFiltros() {
        $('#filtro-tabla').val('');
        $('#filtro-clase').val('');
        $('#filtro-estado').val('');
        aplicarFiltros();
    }

    function cambiarTop(cant) {
        topActual = cant > 0 ? cant : 25;
        $('#lbl-top-actual').text(topActual);
        $('.item-top').removeClass('active');
        $(event.target).addClass('active');
        aplicarFiltros();
    }

    function ordenarTabla(tablaId, colIndex, isNumeric) {
        var $table = $('#' + tablaId);
        var $tbody = $table.find('tbody');
        var rows = $tbody.find('tr:not(#fila-vacia)').get();

        if (sortColIdx === colIndex) {
            sortAsc = !sortAsc;
        } else {
            sortColIdx = colIndex;
            sortAsc = true;
        }

        // Actualizar iconos
        $table.find('thead th .sort-icon').attr('class', 'bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon');
        var $th = $table.find('thead th').eq(colIndex);
        var iconClass = isNumeric
            ? (sortAsc ? 'bi-sort-numeric-down text-primary fw-bold' : 'bi-sort-numeric-down-alt text-primary fw-bold')
            : (sortAsc ? 'bi-sort-alpha-down text-primary fw-bold' : 'bi-sort-alpha-down-alt text-primary fw-bold');
        $th.find('.sort-icon').attr('class', 'bi ' + iconClass + ' ms-1 sort-icon');

        rows.sort(function (a, b) {
            var aVal = $(a).children('td').eq(colIndex).text().trim();
            var bVal = $(b).children('td').eq(colIndex).text().trim();

            if (isNumeric) {
                var aNum = parseFloat(aVal.replace(/[^0-9.-]/g, '')) || 0;
                var bNum = parseFloat(bVal.replace(/[^0-9.-]/g, '')) || 0;
                return sortAsc ? (aNum - bNum) : (bNum - aNum);
            } else {
                return sortAsc ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
            }
        });

        $.each(rows, function (index, row) {
            $tbody.append(row);
        });

        aplicarFiltros();
    }

    function abrirModalCrear() {
        $('#modal-titulo').text('Nueva Familia de Producto');
        $('#fam-id').val(0);
        $('#fam-clase-id').val('');
        $('#fam-codigo').val('');
        $('#fam-nombre').val('');
        $('#fam-estado').val('A');

        formInitialState = "";
        actualizarEstadoBotonGuardar();

        var modal = new bootstrap.Modal(document.getElementById('modal-crud-familia'));
        modal.show();
        setTimeout(function () { $('#fam-clase-id').focus(); }, 300);
    }

    function abrirModalEditar(id) {
        $.ajax({
            url: '@Url.Action("Obtener", "FamiliaProducto", new { area = "MG" })',
            type: 'GET',
            data: { id: id },
            success: function (res) {
                if (res && res.success && res.data) {
                    $('#modal-titulo').text('Editar Familia #' + id);
                    $('#fam-id').val(res.data.familiaId || res.data.FamiliaId);
                    $('#fam-clase-id').val(res.data.claseId || res.data.ClaseId);
                    $('#fam-codigo').val(res.data.familiaCodigo || res.data.FamiliaCodigo || '');
                    $('#fam-nombre').val(res.data.familiaNombre || res.data.FamiliaNombre);
                    $('#fam-estado').val(res.data.estado || res.data.Estado || 'A');

                    var modal = new bootstrap.Modal(document.getElementById('modal-crud-familia'));
                    modal.show();

                    setTimeout(function () {
                        formInitialState = $('#form-familia').serialize();
                        actualizarEstadoBotonGuardar();
                        $('#fam-nombre').focus();
                    }, 300);
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'No se pudo cargar la familia.' });
                }
            },
            error: function () {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Error de comunicación con el servidor.' });
            }
        });
    }

    function guardarFamilia(e) {
        e.preventDefault();
        var clase = $('#fam-clase-id').val();
        var nombre = $('#fam-nombre').val().trim();

        if (!clase || !nombre) {
            Swal.fire({ icon: 'warning', title: 'Atención', text: 'Por favor seleccione la clase e ingrese el nombre de la familia.' });
            return;
        }

        var $btn = $('#btn-guardar-fam');
        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Guardando...');

        var formData = $('#form-familia').serialize();
        $.ajax({
            url: '@Url.Action("Guardar", "FamiliaProducto", new { area = "MG" })',
            type: 'POST',
            data: formData,
            success: function (res) {
                $btn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>Guardar Familia');
                if (res && res.success) {
                    bootstrap.Modal.getInstance(document.getElementById('modal-crud-familia')).hide();
                    Swal.fire({
                        icon: 'success',
                        title: '¡Éxito!',
                        text: res.message || 'Familia de producto guardada correctamente.',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(function () {
                        location.reload();
                    });
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'No se pudo guardar.' });
                }
            },
            error: function () {
                $btn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>Guardar Familia');
                Swal.fire({ icon: 'error', title: 'Error', text: 'Error de comunicación con el servidor.' });
            }
        });
    }

    function cambiarEstado(id, estadoActual, descripcion) {
        var accion = estadoActual === 'A' ? 'desactivar' : 'activar';
        Swal.fire({
            title: '¿Confirmar cambio de estado?',
            text: '¿Desea ' + accion + ' la familia "' + descripcion + '"?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, ' + accion,
            cancelButtonText: 'Cancelar',
            confirmButtonColor: estadoActual === 'A' ? '#dc3545' : '#198754'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("CambiarEstado", "FamiliaProducto", new { area = "MG" })',
                    type: 'POST',
                    data: { id: id },
                    success: function (res) {
                        if (res && res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Actualizado',
                                text: res.message,
                                timer: 1200,
                                showConfirmButton: false
                            }).then(function () {
                                location.reload();
                            });
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'No se pudo cambiar el estado.' });
                        }
                    },
                    error: function () {
                        Swal.fire({ icon: 'error', title: 'Error', text: 'Error de comunicación con el servidor.' });
                    }
                });
            }
        });
    }

    $(document).ready(function () {
        aplicarFiltros();
    });
</script>
}
