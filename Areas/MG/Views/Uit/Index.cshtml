@model List<AspNet10ArcoERP.Models.UitModel>
@{
    ViewData["Title"] = "Maestro de UIT";
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-cash-coin text-success me-2" style="font-size: 1.6rem;"></i>Unidad Impositiva Tributaria (UIT)
                </h3>
                <small class="text-muted">Parámetros tributarios oficiales y montos históricos por año</small>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <button type="button" class="btn btn-primary shadow-sm font-weight-600 px-3" onclick="abrirModalCrear();">
                    <i class="bi bi-plus-circle-fill me-1"></i>Nueva UIT
                </button>
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4">
    <div class="container-fluid">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-body border-bottom py-3">
                <div class="row g-2 align-items-center justify-content-between">
                    <div class="col-md-5 d-flex align-items-center">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-body-tertiary border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" id="filtro-tabla" class="form-control border-start-0 ps-0" placeholder="Buscar por monto o fecha..." onkeyup="filtrarTabla();" />
                        </div>
                    </div>
                    <div class="col-md-4 text-md-end text-muted small">
                        <span>Total: <strong class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6" id="total-registros">@Model.Count</strong> periodos registrados</span>
                    </div>
                </div>
            </div>

            <div class="card-body p-0 table-responsive">
                <table class="table table-striped table-hover align-middle mb-0" id="tabla-uits">
                    <thead class="table-header-custom border-bottom">
                        <tr>
                            <th style="width: 80px;" class="text-center">ID</th>
                            <th>Monto de UIT</th>
                            <th style="width: 160px;" class="text-center">Fecha Alta</th>
                            <th style="width: 160px;" class="text-center">Fecha Baja</th>
                            <th style="width: 120px;" class="text-center">Estado</th>
                            <th style="width: 130px;" class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr id="fila-@item.Id" data-search="@item.Monto @item.FechaAlta.ToString("yyyy-MM-dd")">
                                    <td class="text-center font-monospace text-muted small">@item.Id</td>
                                    <td>
                                        <span class="fw-bold font-monospace text-success fs-6">S/ @item.Monto.ToString("N2")</span>
                                    </td>
                                    <td class="text-center font-monospace">
                                        <i class="bi bi-calendar-event me-1 text-muted"></i>@item.FechaAlta.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="text-center font-monospace">
                                        @if (item.FechaBaja.HasValue)
                                        {
                                            <span>@item.FechaBaja.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">&mdash; Vigente &mdash;</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.Estado == "A")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary py-0 px-2 btn-action-edit" title="Editar" onclick="abrirModalEditar(@item.Id);">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm @(item.Estado == "A" ? "btn-outline-danger" : "btn-outline-success") py-0 px-2 ms-1 btn-action-toggle" title="@(item.Estado == "A" ? "Desactivar" : "Activar")" onclick="cambiarEstado(@item.Id, '@item.Estado', '@item.Monto');">
                                            <i class="bi @(item.Estado == "A" ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    <span>No se encontraron registros de UIT</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL CRUD: UIT                                          -->
<!-- ======================================================== -->
<div class="modal fade" id="modal-crud-uit" tabindex="-1" aria-labelledby="modalUitLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0 rounded-4">
            <div class="modal-header border-bottom py-3 px-4 bg-body-tertiary">
                <h5 class="modal-title fw-bold" id="modalUitLabel">
                    <i class="bi bi-cash-coin text-success me-2"></i><span id="modal-titulo">Nueva UIT</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="form-uit" onsubmit="guardarUit(event);">
                @Html.AntiForgeryToken()
                <input type="hidden" id="uit-id" name="Id" value="0" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label for="uit-monto" class="form-label fw-semibold">Monto de la UIT (Soles) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">S/</span>
                            <input type="number" step="0.01" class="form-control" id="uit-monto" name="Monto" placeholder="Ej: 5350.00" required min="1" />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label for="uit-fecha-alta" class="form-label fw-semibold">Fecha Alta <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="uit-fecha-alta" name="FechaAlta" required />
                        </div>
                        <div class="col-6">
                            <label for="uit-fecha-baja" class="form-label fw-semibold">Fecha Baja (Opcional)</label>
                            <input type="date" class="form-control" id="uit-fecha-baja" name="FechaBaja" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label for="uit-estado" class="form-label fw-semibold">Estado</label>
                        <select class="form-select" id="uit-estado" name="Estado">
                            <option value="A">Activo</option>
                            <option value="I">Inactivo</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top py-3 px-4 bg-body-tertiary">
                    <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold" id="btn-guardar-uit">
                        <i class="bi bi-check-circle me-1"></i>Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function filtrarTabla() {
        var query = $('#filtro-tabla').val().toLowerCase().trim();
        var visibles = 0;
        $('#tabla-uits tbody tr').each(function () {
            var $row = $(this);
            var search = $row.data('search') || '';
            if (!query || search.indexOf(query) >= 0) {
                $row.removeClass('d-none');
                visibles++;
            } else {
                $row.addClass('d-none');
            }
        });
        $('#total-registros').text(visibles);
    }

    function abrirModalCrear() {
        $('#modal-titulo').text('Nueva UIT');
        $('#uit-id').val(0);
        $('#uit-monto').val('');
        var hoy = new Date().toISOString().split('T')[0];
        $('#uit-fecha-alta').val(hoy);
        $('#uit-fecha-baja').val('');
        $('#uit-estado').val('A');
        var modal = new bootstrap.Modal(document.getElementById('modal-crud-uit'));
        modal.show();
        setTimeout(function () { $('#uit-monto').focus(); }, 300);
    }

    function abrirModalEditar(id) {
        $.ajax({
            url: '@Url.Action("Obtener", "Uit", new { area = "MG" })',
            type: 'GET',
            data: { id: id },
            success: function (res) {
                if (res && res.success && res.data) {
                    $('#modal-titulo').text('Editar UIT #' + id);
                    $('#uit-id').val(res.data.id || res.data.Id);
                    $('#uit-monto').val(res.data.monto || res.data.Monto);
                    var fAlta = (res.data.fechaAlta || res.data.FechaAlta || '').split('T')[0];
                    var fBaja = (res.data.fechaBaja || res.data.FechaBaja || '').split('T')[0];
                    $('#uit-fecha-alta').val(fAlta);
                    $('#uit-fecha-baja').val(fBaja);
                    $('#uit-estado').val(res.data.estado || res.data.Estado || 'A');
                    var modal = new bootstrap.Modal(document.getElementById('modal-crud-uit'));
                    modal.show();
                    setTimeout(function () { $('#uit-monto').focus(); }, 300);
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'No se pudo cargar la UIT.' });
                }
            },
            error: function () {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Error de comunicación con el servidor.' });
            }
        });
    }

    function guardarUit(e) {
        e.preventDefault();
        var monto = parseFloat($('#uit-monto').val()) || 0;
        if (monto <= 0) {
            Swal.fire({ icon: 'warning', title: 'Atención', text: 'El monto de la UIT debe ser mayor a 0.' });
            return;
        }

        var $btn = $('#btn-guardar-uit');
        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Guardando...');

        var formData = $('#form-uit').serialize();
        $.ajax({
            url: '@Url.Action("Guardar", "Uit", new { area = "MG" })',
            type: 'POST',
            data: formData,
            success: function (res) {
                $btn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>Guardar');
                if (res && res.success) {
                    bootstrap.Modal.getInstance(document.getElementById('modal-crud-uit')).hide();
                    Swal.fire({
                        icon: 'success',
                        title: '¡Éxito!',
                        text: res.message || 'Guardado correctamente.',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(function () {
                        location.reload();
                    });
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'No se pudo guardar.' });
                }
            },
            error: function () {
                $btn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>Guardar');
                Swal.fire({ icon: 'error', title: 'Error', text: 'Error de comunicación con el servidor.' });
            }
        });
    }

    function cambiarEstado(id, estadoActual, monto) {
        var accion = estadoActual === 'A' ? 'desactivar' : 'activar';
        Swal.fire({
            title: '¿Confirmar cambio de estado?',
            text: '¿Desea ' + accion + ' la UIT de S/ ' + monto + '?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, ' + accion,
            cancelButtonText: 'Cancelar',
            confirmButtonColor: estadoActual === 'A' ? '#dc3545' : '#198754'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("CambiarEstado", "Uit", new { area = "MG" })',
                    type: 'POST',
                    data: { id: id },
                    success: function (res) {
                        if (res && res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Actualizado',
                                text: res.message,
                                timer: 1200,
                                showConfirmButton: false
                            }).then(function () {
                                location.reload();
                            });
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'No se pudo cambiar el estado.' });
                        }
                    },
                    error: function () {
                        Swal.fire({ icon: 'error', title: 'Error', text: 'Error de comunicación con el servidor.' });
                    }
                });
            }
        });
    }
</script>
}
