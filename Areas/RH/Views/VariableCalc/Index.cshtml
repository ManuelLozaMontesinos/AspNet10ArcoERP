@model List<AspNet10ArcoERP.Models.VariableCalculoModel>
@{
    ViewData["Title"] = "Variables de Cálculo";
    var tiposVariable = ViewBag.TiposVariableCalculo as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var tiposDato = ViewBag.TiposDato as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
}

<style>
    .table-fixed-header {
        table-layout: auto;
    }
    .table-header-custom th {
        padding-top: 0.45rem !important;
        padding-bottom: 0.45rem !important;
        font-size: 0.78rem !important;
        letter-spacing: 0.5px;
        white-space: nowrap !important;
        vertical-align: middle !important;
        height: 40px !important;
        line-height: 1.2;
    }
    .th-sortable {
        cursor: pointer;
        user-select: none;
        transition: background-color 0.15s ease, color 0.15s ease;
    }
    .th-sortable:hover {
        background-color: var(--bs-tertiary-bg);
        color: var(--bs-primary);
    }
    [data-bs-theme="dark"] .table-header-custom {
        background-color: #1e2227 !important;
        color: #e9ecef !important;
    }
    [data-bs-theme="dark"] .modal-content {
        background-color: #1e2227 !important;
        border: 1px solid #343a40 !important;
    }
    [data-bs-theme="dark"] .modal-header,
    [data-bs-theme="dark"] .modal-footer {
        background-color: #181b1f !important;
        border-color: #2b3035 !important;
    }
</style>

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-calculator text-primary me-2" style="font-size: 1.6rem;"></i>Variables de Cálculo
                </h3>
                <small class="text-muted">Parámetros, constantes, acumuladores y variables dinámicas para el motor de planilla</small>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <button type="button" class="btn btn-primary shadow-sm fw-semibold px-3" onclick="abrirModalCrear();">
                    <i class="bi bi-plus-circle-fill me-1"></i>Nueva Variable
                </button>
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4">
    <div class="container-fluid">
        <!-- BARRA DE FILTROS -->
        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <!-- Buscador -->
                        <div class="input-group input-group-sm" style="min-width: 320px; max-width: 440px;">
                            <span class="input-group-text bg-body-tertiary border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" id="filtro-tabla" class="form-control border-start-0 ps-0" placeholder="Buscar por código, nombre o tipo..." onkeyup="aplicarFiltros();" />
                            <button type="button" class="btn btn-outline-secondary" onclick="limpiarFiltros();" title="Limpiar"><i class="bi bi-x-lg"></i></button>
                        </div>

                        <!-- Estado -->
                        <div class="input-group input-group-sm" style="width: auto;">
                            <span class="input-group-text bg-body-tertiary text-muted border-end-0">
                                <i class="bi bi-toggle-on text-primary"></i>
                            </span>
                            <select id="filtro-estado" class="form-select form-select-sm border-start-0" style="min-width: 140px;" onchange="aplicarFiltros();" title="Filtrar por Estado">
                                <option value="">Todos los Estados</option>
                                <option value="A">Solo Activos</option>
                                <option value="I">Solo Inactivos</option>
                            </select>
                        </div>
                    </div>

                    <!-- TOTAL Y MOSTRANDO -->
                    <div class="d-flex align-items-center gap-3 ms-auto">
                        <div class="text-muted small text-nowrap">
                            <span>Total: <strong class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6" id="total-registros">@(Model?.Count ?? 0)</strong> variables</span>
                        </div>

                        <div class="dropdown flex-shrink-0">
                            <button class="btn btn-sm btn-outline-primary dropdown-toggle d-flex align-items-center gap-1 shadow-sm px-2 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-list-ol"></i>
                                <span>Mostrar: <strong>@(ViewBag.Top == 0 ? "Todos" : ViewBag.Top.ToString())</strong></span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li><a class="dropdown-item @(ViewBag.Top == 25 ? "active" : "")" asp-action="Index" asp-route-top="25" asp-route-search="@ViewBag.Search" asp-route-estado="@ViewBag.Estado">Top 25</a></li>
                                <li><a class="dropdown-item @(ViewBag.Top == 50 ? "active" : "")" asp-action="Index" asp-route-top="50" asp-route-search="@ViewBag.Search" asp-route-estado="@ViewBag.Estado">Top 50</a></li>
                                <li><a class="dropdown-item @(ViewBag.Top == 100 ? "active" : "")" asp-action="Index" asp-route-top="100" asp-route-search="@ViewBag.Search" asp-route-estado="@ViewBag.Estado">Top 100</a></li>
                                <li><a class="dropdown-item @(ViewBag.Top == 500 ? "active" : "")" asp-action="Index" asp-route-top="500" asp-route-search="@ViewBag.Search" asp-route-estado="@ViewBag.Estado">Top 500</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item @(ViewBag.Top == 0 ? "active" : "")" asp-action="Index" asp-route-top="0" asp-route-search="@ViewBag.Search" asp-route-estado="@ViewBag.Estado">Ver Todos</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TABLA -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-nowrap table-fixed-header" id="tabla-variables">
                        <thead class="table-header-custom border-bottom bg-body-tertiary">
                            <tr>
                                <th class="text-center px-3" style="width: 50px;">#</th>
                                <th class="th-sortable" onclick="ordenarTabla(1)">
                                    VARIABLE <i class="bi bi-arrow-down-up text-muted ms-1 small"></i>
                                </th>
                                <th class="th-sortable" onclick="ordenarTabla(2)">
                                    DESCRIPCIÓN <i class="bi bi-arrow-down-up text-muted ms-1 small"></i>
                                </th>
                                <th class="th-sortable" onclick="ordenarTabla(3)">
                                    TIPO VARIABLE <i class="bi bi-arrow-down-up text-muted ms-1 small"></i>
                                </th>
                                <th class="th-sortable" onclick="ordenarTabla(4)">
                                    TIPO DATO <i class="bi bi-arrow-down-up text-muted ms-1 small"></i>
                                </th>
                                <th class="text-center">VALOR NUM. V</th>
                                <th class="text-center">ALCANCE</th>
                                <th class="text-center th-sortable" onclick="ordenarTabla(7)" style="width: 100px;">
                                    ESTADO <i class="bi bi-arrow-down-up text-muted ms-1 small"></i>
                                </th>
                                <th class="text-end px-4" style="width: 100px;">ACCIONES</th>
                            </tr>
                        </thead>
                        <tbody id="tbody-variables">
                            @if (Model != null && Model.Any())
                            {
                                int idx = 1;
                                foreach (var item in Model)
                                {
                                    <tr id="fila-@item.Id" data-id="@item.Id" data-estado="@item.Estado">
                                        <td class="text-center text-muted fw-semibold px-3">@idx</td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-2 py-1 fs-6">
                                                @item.Variable
                                            </span>
                                        </td>
                                        <td class="fw-semibold">
                                            @item.Nombre
                                            @if (!string.IsNullOrWhiteSpace(item.Condicion))
                                            {
                                                <div class="small text-muted font-monospace"><i class="bi bi-code-slash me-1"></i>@item.Condicion</div>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                                @item.TipoVariableCalculoNombre
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-info-subtle text-info border border-info-subtle">
                                                @item.TipoDatoNombre
                                            </span>
                                        </td>
                                        <td class="text-center font-monospace">
                                            @item.ValorNumericoVerdad.ToString("N4")
                                        </td>
                                        <td class="text-center">
                                            @if (item.AlcanceFormulaHora == "S")
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle me-1" title="Alcance en Fórmula Hora">Hora</span>
                                            }
                                            @if (item.AlcanceFormula == "S")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle me-1" title="Alcance en Fórmulas Generales">Fórm</span>
                                            }
                                            @if (item.AlcanceCondicion == "S")
                                            {
                                                <span class="badge bg-info-subtle text-info border border-info-subtle" title="Alcance en Condiciones">Cond</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (item.Estado == "A")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 estado-badge">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Activo
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 estado-badge">
                                                    <i class="bi bi-x-circle-fill me-1"></i>Inactivo
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end px-4">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <button type="button" class="btn btn-outline-primary" onclick="abrirModalEditar(@item.Id);" title="Editar">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-warning" onclick="cambiarEstado(@item.Id, '@item.Estado');" title="@(item.Estado == "A" ? "Desactivar" : "Activar")">
                                                    <i class="bi @(item.Estado == "A" ? "bi-toggle-on text-success" : "bi-toggle-off text-muted")"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    idx++;
                                }
                            }
                            else
                            {
                                <tr id="fila-vacia">
                                    <td colspan="9" class="text-center py-5 text-muted">
                                        <i class="bi bi-calculator display-6 d-block mb-2 text-secondary opacity-50"></i>
                                        <span>No se encontraron variables de cálculo registradas.</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CREAR / EDITAR -->
<div class="modal fade" id="modalVariable" tabindex="-1" aria-labelledby="modalVariableLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold d-flex align-items-center" id="modalVariableLabel">
                    <i class="bi bi-calculator me-2 text-primary"></i>Nueva Variable de Cálculo
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="formVariable" onsubmit="guardarVariable(event);">
                <div class="modal-body p-4">
                    <input type="hidden" id="var-id" name="Id" value="0" />

                    <div class="row g-3">
                        <!-- Código/Variable -->
                        <div class="col-md-4">
                            <label for="var-variable" class="form-label fw-semibold small">Variable / Identificador <span class="text-danger">*</span></label>
                            <input type="text" class="form-control font-monospace" id="var-variable" name="Variable" maxlength="20" placeholder="Ej: HN, RMV, BASICO" required />
                            <small class="text-muted">Nombre corto o nemotécnico</small>
                        </div>

                        <!-- Nombre / Descripción -->
                        <div class="col-md-8">
                            <label for="var-nombre" class="form-label fw-semibold small">Descripción / Nombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="var-nombre" name="Nombre" maxlength="100" placeholder="Ej: Hora Normal Diurna" required />
                        </div>

                        <!-- Tipo de Variable -->
                        <div class="col-md-6">
                            <label for="var-tipo-v-calc" class="form-label fw-semibold small">Tipo de Variable <span class="text-danger">*</span></label>
                            <select class="form-select" id="var-tipo-v-calc" name="TipoVariableCalculoId" required>
                                <option value="">-- Seleccionar Tipo --</option>
                                @foreach (var t in tiposVariable)
                                {
                                    <option value="@t.Id">@t.Codigo - @t.Nombre</option>
                                }
                            </select>
                        </div>

                        <!-- Tipo de Dato -->
                        <div class="col-md-6">
                            <label for="var-tipo-dato" class="form-label fw-semibold small">Tipo de Dato <span class="text-danger">*</span></label>
                            <select class="form-select" id="var-tipo-dato" name="TipoDatoId" required>
                                <option value="">-- Seleccionar Tipo Dato --</option>
                                @foreach (var td in tiposDato)
                                {
                                    <option value="@td.Id">@td.Codigo - @td.Nombre</option>
                                }
                            </select>
                        </div>

                        <!-- Condición -->
                        <div class="col-md-12">
                            <label for="var-condicion" class="form-label fw-semibold small">Condición Lógica / Expresión SQL</label>
                            <input type="text" class="form-control font-monospace" id="var-condicion" name="Condicion" maxlength="100" placeholder="Ej: {AsignacionFamiliar} = {SI}" />
                        </div>

                        <!-- Valores Numéricos -->
                        <div class="col-md-6">
                            <label for="var-val-n-v" class="form-label fw-semibold small">Valor Numérico (Si Verdadero / Default)</label>
                            <input type="number" step="0.0001" class="form-control" id="var-val-n-v" name="ValorNumericoVerdad" value="0.0000" />
                        </div>
                        <div class="col-md-6">
                            <label for="var-val-n-f" class="form-label fw-semibold small">Valor Numérico (Si Falso)</label>
                            <input type="number" step="0.0001" class="form-control" id="var-val-n-f" name="ValorNumericoFalso" value="0.0000" />
                        </div>

                        <!-- Alcance en Fórmulas -->
                        <div class="col-md-12">
                            <label class="form-label fw-semibold small d-block">Ámbito de Uso / Alcance</label>
                            <div class="d-flex flex-wrap gap-4 p-3 bg-body-tertiary rounded-3 border">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="var-alc-for-h" value="S" checked />
                                    <label class="form-check-label fw-semibold small" for="var-alc-for-h">Fórmula de Hora</label>
                                    <input type="hidden" name="AlcanceFormulaHora" id="var-alc-for-h-hidden" value="S" />
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="var-alc-formu" value="S" />
                                    <label class="form-check-label fw-semibold small" for="var-alc-formu">Fórmulas Generales</label>
                                    <input type="hidden" name="AlcanceFormula" id="var-alc-formu-hidden" value="N" />
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="var-alc-condi" value="S" checked />
                                    <label class="form-check-label fw-semibold small" for="var-alc-condi">Condiciones de Evaluación</label>
                                    <input type="hidden" name="AlcanceCondicion" id="var-alc-condi-hidden" value="S" />
                                </div>
                            </div>
                        </div>

                        <!-- Estado -->
                        <div class="col-md-12">
                            <label for="var-estado" class="form-label fw-semibold small">Estado del Registro <span class="text-danger">*</span></label>
                            <select class="form-select" id="var-estado" name="Estado" required>
                                <option value="A">Activo (Habilitado para cálculos)</option>
                                <option value="I">Inactivo (Deshabilitado)</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top py-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="btnGuardarVariable">
                        <i class="bi bi-save me-1"></i>Guardar Variable
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let ordenActual = { col: -1, asc: true };

    function abrirModalCrear() {
        document.getElementById('formVariable').reset();
        document.getElementById('var-id').value = '0';
        document.getElementById('var-variable').readOnly = false;
        document.getElementById('var-tipo-dato').value = '3'; // Decimal por defecto
        document.getElementById('var-estado').value = 'A';
        
        document.getElementById('var-alc-for-h').checked = true;
        document.getElementById('var-alc-for-h-hidden').value = 'S';
        document.getElementById('var-alc-formu').checked = false;
        document.getElementById('var-alc-formu-hidden').value = 'N';
        document.getElementById('var-alc-condi').checked = true;
        document.getElementById('var-alc-condi-hidden').value = 'S';

        document.getElementById('modalVariableLabel').innerHTML = '<i class="bi bi-calculator me-2 text-primary"></i>Nueva Variable de Cálculo';
        const modal = new bootstrap.Modal(document.getElementById('modalVariable'));
        modal.show();
    }

    // Sincronizar checkboxes de switches con hidden inputs
    document.getElementById('var-alc-for-h').addEventListener('change', function() {
        document.getElementById('var-alc-for-h-hidden').value = this.checked ? 'S' : 'N';
    });
    document.getElementById('var-alc-formu').addEventListener('change', function() {
        document.getElementById('var-alc-formu-hidden').value = this.checked ? 'S' : 'N';
    });
    document.getElementById('var-alc-condi').addEventListener('change', function() {
        document.getElementById('var-alc-condi-hidden').value = this.checked ? 'S' : 'N';
    });

    async function abrirModalEditar(id) {
        try {
            const resp = await fetch(`/RH/VariableCalc/Obtener?id=${id}`);
            const res = await resp.json();
            if (!res.success) {
                Swal.fire('Error', res.message || 'No se pudo cargar la variable.', 'error');
                return;
            }

            const data = res.data;
            document.getElementById('var-id').value = data.id;
            document.getElementById('var-variable').value = data.variable;
            document.getElementById('var-variable').readOnly = false;
            document.getElementById('var-nombre').value = data.nombre;
            document.getElementById('var-tipo-v-calc').value = data.tipoVariableCalculoId;
            document.getElementById('var-tipo-dato').value = data.tipoDatoId || '3';
            document.getElementById('var-condicion').value = data.condicion || '';
            document.getElementById('var-val-n-v').value = data.valorNumericoVerdad;
            document.getElementById('var-val-n-f').value = data.valorNumericoFalso;
            
            const forH = data.alcanceFormulaHora === 'S';
            document.getElementById('var-alc-for-h').checked = forH;
            document.getElementById('var-alc-for-h-hidden').value = forH ? 'S' : 'N';

            const formu = data.alcanceFormula === 'S';
            document.getElementById('var-alc-formu').checked = formu;
            document.getElementById('var-alc-formu-hidden').value = formu ? 'S' : 'N';

            const condi = data.alcanceCondicion === 'S';
            document.getElementById('var-alc-condi').checked = condi;
            document.getElementById('var-alc-condi-hidden').value = condi ? 'S' : 'N';

            document.getElementById('var-estado').value = data.estado || 'A';

            document.getElementById('modalVariableLabel').innerHTML = '<i class="bi bi-pencil-square me-2 text-primary"></i>Editar Variable de Cálculo';
            const modal = new bootstrap.Modal(document.getElementById('modalVariable'));
            modal.show();
        } catch (err) {
            console.error(err);
            Swal.fire('Error', 'Ocurrió un error al obtener la información.', 'error');
        }
    }

    async function guardarVariable(e) {
        e.preventDefault();
        const btn = document.getElementById('btnGuardarVariable');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Guardando...';

        try {
            const form = document.getElementById('formVariable');
            const formData = new FormData(form);

            const resp = await fetch('/RH/VariableCalc/Guardar', {
                method: 'POST',
                body: formData
            });
            const res = await resp.json();

            if (res.success) {
                Swal.fire({
                    icon: 'success',
                    title: '¡Éxito!',
                    text: res.message,
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => {
                    location.reload();
                });
            } else {
                Swal.fire('Atención', res.message || 'No se pudo guardar la variable.', 'warning');
            }
        } catch (err) {
            console.error(err);
            Swal.fire('Error', 'Error de comunicación con el servidor.', 'error');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-save me-1"></i>Guardar Variable';
        }
    }

    async function cambiarEstado(id, estadoActual) {
        const accion = estadoActual === 'A' ? 'desactivar' : 'activar';
        const result = await Swal.fire({
            title: `¿Desea ${accion} esta variable?`,
            text: `El registro pasará a estar ${estadoActual === 'A' ? 'inactivo' : 'activo'}.`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: estadoActual === 'A' ? '#dc3545' : '#198754',
            cancelButtonColor: '#6c757d',
            confirmButtonText: `Sí, ${accion}`,
            cancelButtonText: 'Cancelar'
        });

        if (!result.isConfirmed) return;

        try {
            const formData = new FormData();
            formData.append('id', id);

            const resp = await fetch('/RH/VariableCalc/CambiarEstado', {
                method: 'POST',
                body: formData
            });
            const res = await resp.json();

            if (res.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Estado Actualizado',
                    text: res.message,
                    timer: 1200,
                    showConfirmButton: false
                }).then(() => {
                    location.reload();
                });
            } else {
                Swal.fire('Error', res.message || 'No se pudo cambiar el estado.', 'error');
            }
        } catch (err) {
            console.error(err);
            Swal.fire('Error', 'Error de comunicación con el servidor.', 'error');
        }
    }



    function aplicarFiltros() {
        const texto = document.getElementById('filtro-tabla').value.toLowerCase().trim();
        const estado = document.getElementById('filtro-estado').value;
        const filas = document.querySelectorAll('#tbody-variables tr:not(#fila-vacia)');
        let visibles = 0;

        filas.forEach(f => {
            const rowText = f.innerText.toLowerCase();
            const rowEstado = f.getAttribute('data-estado');

            const coincideTexto = !texto || rowText.includes(texto);
            const coincideEstado = !estado || rowEstado === estado;

            if (coincideTexto && coincideEstado) {
                f.style.display = '';
                visibles++;
            } else {
                f.style.display = 'none';
            }
        });

        const totalBadge = document.getElementById('total-registros');
        if (totalBadge) totalBadge.innerText = visibles;
    }

    function limpiarFiltros() {
        document.getElementById('filtro-tabla').value = '';
        document.getElementById('filtro-estado').value = '';
        aplicarFiltros();
    }

    function ordenarTabla(n) {
        const table = document.getElementById('tabla-variables');
        let switching = true;
        let dir = 'asc';
        let switchcount = 0;

        if (ordenActual.col === n) {
            dir = ordenActual.asc ? 'desc' : 'asc';
            ordenActual.asc = !ordenActual.asc;
        } else {
            ordenActual.col = n;
            ordenActual.asc = true;
            dir = 'asc';
        }

        while (switching) {
            switching = false;
            const rows = table.rows;
            let shouldSwitch = false;
            let i;

            for (i = 1; i < (rows.length - 1); i++) {
                if (rows[i].id === 'fila-vacia') continue;
                let x = rows[i].getElementsByTagName('TD')[n];
                let y = rows[i + 1].getElementsByTagName('TD')[n];
                if (!x || !y) continue;

                let cmpX = x.innerText.toLowerCase().trim();
                let cmpY = y.innerText.toLowerCase().trim();

                if (dir === 'asc') {
                    if (cmpX > cmpY) {
                        shouldSwitch = true;
                        break;
                    }
                } else if (dir === 'desc') {
                    if (cmpX < cmpY) {
                        shouldSwitch = true;
                        break;
                    }
                }
            }
            if (shouldSwitch) {
                rows[i].parentNode.insertBefore(rows[i + 1], rows[i]);
                switching = true;
                switchcount++;
            }
        }
    }
</script>
}
