        border-color: #2c3138 !important;
    }
    [data-bs-theme="dark"] .modal-header .btn-close {
        filter: invert(1) grayscale(100%) brightness(200%);
    }

    /* Cabeceras de tablas en modal (evita que se vean blancas en modo oscuro) */
    [data-bs-theme="dark"] .table-light,
    [data-bs-theme="dark"] .table thead.table-light th,
    [data-bs-theme="dark"] thead.table-light th {
        background-color: #16181b !important;
        color: #adb5bd !important;
        border-color: #2c3138 !important;
    }
    [data-bs-theme="dark"] .table thead.table-header-custom th,
    [data-bs-theme="dark"] thead.table-header-custom th {
        background-color: #16181b !important;
        color: #adb5bd !important;
        border-color: #2c3138 !important;
    }

    /* Barra de pestañas en modo oscuro */
    [data-bs-theme="dark"] .nav-tabs {
        background-color: #16181b !important;
        border-color: #2c3138 !important;
    }
    [data-bs-theme="dark"] .nav-tabs .nav-link {
        color: #adb5bd !important;
    }
    [data-bs-theme="dark"] .nav-tabs .nav-link:hover {
        color: #58a6ff !important;
        background: rgba(255, 255, 255, 0.03) !important;
    }
    [data-bs-theme="dark"] .nav-tabs .nav-link.active {
        color: #58a6ff !important;
        border-bottom: 2px solid #58a6ff !important;
        background: #1e2227 !important;
    }

    /* Títulos de sección dentro del modal en modo oscuro */
    [data-bs-theme="dark"] .tab-pane h6.text-primary {
        color: #58a6ff !important;
    }
    [data-bs-theme="dark"] .tab-pane .border-bottom {
        border-color: #2c3138 !important;
    }

    /* Controles de formulario en modo oscuro */
    [data-bs-theme="dark"] .form-control,
    [data-bs-theme="dark"] .form-select {
        background-color: #16181b !important;
        color: #e9ecef !important;
        border-color: #2c3138 !important;
    }
    [data-bs-theme="dark"] .form-control:focus,
    [data-bs-theme="dark"] .form-select:focus {
        background-color: #16181b !important;
        color: #ffffff !important;
        border-color: #58a6ff !important;
        box-shadow: 0 0 0 0.2rem rgba(88, 166, 255, 0.25) !important;
    }
    [data-bs-theme="dark"] .form-control::placeholder {
        color: #6c757d !important;
    }
    [data-bs-theme="dark"] .input-group-text {
        background-color: #16181b !important;
        color: #adb5bd !important;
        border-color: #2c3138 !important;
    }
    [data-bs-theme="dark"] .border {
        border-color: #2c3138 !important;
    }
</style>

<!-- ENCABEZADO DE PÁGINA -->
<div class="app-content-header py-3 border-bottom bg-body">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h4 class="mb-1 text-primary fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-person-lines-fill"></i> Registro de Personal
                </h4>
                <div class="text-muted small">Maestro de colaboradores, empleados y trabajadores de la empresa</div>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm rounded-pill" onclick="abrirModalCrear();">
                    <i class="bi bi-person-plus-fill me-1"></i>Nuevo Colaborador
                </button>
            </div>
        </div>
    </div>
</div>

<div class="app-content py-3">
    <div class="container-fluid">
        <!-- BARRA DE FILTROS SUPERIOR -->
        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3">
                <!-- 1. Píldoras de Estado y Selector Mostrando -->
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2 pb-2 border-bottom">
                    <!-- Píldoras de Estado -->
                    <div class="btn-group btn-group-sm shadow-sm flex-shrink-0" role="group" aria-label="Filtro de Estado">
                        <a href="@Url.Action("Index", new { search = ViewBag.Search, sort = currentSort, dir = currentDir, top = currentTop })" 
                           class="btn @(string.IsNullOrEmpty(estadoFiltro) ? "btn-primary" : "btn-outline-secondary")">
                            <i class="bi bi-people me-1"></i>Todos <span class="badge @(string.IsNullOrEmpty(estadoFiltro) ? "bg-white text-primary" : "bg-body-secondary text-body") ms-1">@totalCount</span>
                        </a>
                        <a href="@Url.Action("Index", new { search = ViewBag.Search, estado = "A", sort = currentSort, dir = currentDir, top = currentTop })" 
                           class="btn @(estadoFiltro == "A" ? "btn-primary" : "btn-outline-secondary")">
                            <i class="bi bi-check-circle me-1"></i>Activos <span class="badge @(estadoFiltro == "A" ? "bg-white text-primary" : "bg-body-secondary text-body") ms-1">@activosCount</span>
                        </a>
                        <a href="@Url.Action("Index", new { search = ViewBag.Search, estado = "C", sort = currentSort, dir = currentDir, top = currentTop })" 
                           class="btn @(estadoFiltro == "C" ? "btn-danger" : "btn-outline-secondary")">
                            <i class="bi bi-person-dash me-1"></i>Cesados <span class="badge @(estadoFiltro == "C" ? "bg-white text-danger" : "bg-body-secondary text-body") ms-1">@cesadosCount</span>
                        </a>
                    </div>

                    <!-- TOTAL Y MOSTRANDO -->
                    <div class="d-flex align-items-center gap-3 ms-auto">
                        <div class="text-muted small text-nowrap">
                            <span>Total: <strong class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6" id="total-registros">@(estadoFiltro == "A" ? activosCount : (estadoFiltro == "C" ? cesadosCount : totalCount))</strong> colaboradores</span>
                        </div>

                        <!-- Dropdown 'Mostrando' -->
                        <div class="dropdown flex-shrink-0">
                            <button class="btn btn-sm btn-outline-primary dropdown-toggle d-flex align-items-center gap-1 shadow-sm px-2 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Cantidad de registros a mostrar">
                                <i class="bi bi-funnel-fill text-primary"></i>
                                <span>Mostrando: <strong class="badge bg-primary text-white ms-1">@currentTop</strong></span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li class="dropdown-header text-uppercase small fw-bold">Registros a listar</li>
                                @foreach (var cant in new[] { 25, 50, 100, 500 })
                                {
                                    <li>
                                        <a class="dropdown-item d-flex justify-content-between align-items-center @(currentTop == cant ? "active" : "")" 
                                           href="@Url.Action("Index", new { search = ViewBag.Search, estado = estadoFiltro, sort = currentSort, dir = currentDir, top = cant })">
                                            <span>@cant colaboradores</span>
                                            @if (currentTop == cant)
                                            {
                                                <i class="bi bi-check text-primary"></i>
                                            }
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- 2. Buscador Dinámico -->
                <form method="get" class="d-flex flex-wrap align-items-center gap-2 m-0" id="filtro-form">
                    @if (!string.IsNullOrEmpty(estadoFiltro))
                    {
                        <input type="hidden" name="estado" value="@estadoFiltro" />
                    }
                    <input type="hidden" name="sort" value="@currentSort" />
                    <input type="hidden" name="dir" value="@currentDir" />
                    <input type="hidden" name="top" value="@currentTop" />

                    <div class="input-group input-group-sm flex-grow-1" style="max-width: 500px;">
                        <span class="input-group-text bg-body-tertiary border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Buscar por DNI, apellidos, nombres o código..." value="@ViewBag.Search" />
                        <button type="submit" class="btn btn-outline-primary">Buscar</button>
                        @if (!string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(estadoFiltro))
                        {
                            <a href="@Url.Action("Index", new { sort = currentSort, dir = currentDir, top = currentTop })" class="btn btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
                        }
                    </div>
                </form>
            </div>
        </div>

        <!-- GRILLA DE PERSONAL -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-fixed-header" id="tabla-personal">
                    <thead class="table-light table-header-custom border-bottom">
                        <tr>
                            <th class="ps-3 text-center" style="width: 85px;">
                                <a href="@SortUrl("codigo", currentSort, currentDir, ViewBag.Search, estadoFiltro, currentTop)" class="text-decoration-none text-body d-inline-flex align-items-center">
                                    CÓDIGO <i class="bi @SortIcon("codigo", currentSort, currentDir) ms-1 sort-icon"></i>
                                </a>
                            </th>
                            <th style="width: 130px;">
                                <a href="@SortUrl("documento", currentSort, currentDir, ViewBag.Search, estadoFiltro, currentTop)" class="text-decoration-none text-body d-inline-flex align-items-center">
                                    DOC. IDENTIDAD <i class="bi @SortIcon("documento", currentSort, currentDir) ms-1 sort-icon"></i>
                                </a>
                            </th>
                            <th>
                                <a href="@SortUrl("razonsocial", currentSort, currentDir, ViewBag.Search, estadoFiltro, currentTop)" class="text-decoration-none text-body d-inline-flex align-items-center">
                                    APELLIDOS Y NOMBRES <i class="bi @SortIcon("razonsocial", currentSort, currentDir) ms-1 sort-icon"></i>
                                </a>
                            </th>
                            <th style="width: 180px;">
                                <a href="@SortUrl("cargo", currentSort, currentDir, ViewBag.Search, estadoFiltro, currentTop)" class="text-decoration-none text-body d-inline-flex align-items-center">
                                    CARGO / PUESTO <i class="bi @SortIcon("cargo", currentSort, currentDir) ms-1 sort-icon"></i>
                                </a>
                            </th>
                            <th style="width: 170px;">
                                <a href="@SortUrl("centrocosto", currentSort, currentDir, ViewBag.Search, estadoFiltro, currentTop)" class="text-decoration-none text-body d-inline-flex align-items-center">
                                    CENTRO DE COSTO <i class="bi @SortIcon("centrocosto", currentSort, currentDir) ms-1 sort-icon"></i>
                                </a>
                            </th>
                            <th class="text-center" style="width: 110px;">
                                <a href="@SortUrl("fechaingreso", currentSort, currentDir, ViewBag.Search, estadoFiltro, currentTop)" class="text-decoration-none text-body d-inline-flex align-items-center">
                                    FEC. INGRESO <i class="bi @SortIcon("fechaingreso", currentSort, currentDir) ms-1 sort-icon"></i>
                                </a>
                            </th>
                            <th class="text-center" style="width: 110px;">
                                <a href="@SortUrl("fechacese", currentSort, currentDir, ViewBag.Search, estadoFiltro, currentTop)" class="text-decoration-none text-body d-inline-flex align-items-center">
                                    FEC. CESE <i class="bi @SortIcon("fechacese", currentSort, currentDir) ms-1 sort-icon"></i>
                                </a>
                            </th>
                            <th class="text-center" style="width: 95px;">
                                <a href="@SortUrl("estado", currentSort, currentDir, ViewBag.Search, estadoFiltro, currentTop)" class="text-decoration-none text-body d-inline-flex align-items-center">
                                    ESTADO <i class="bi @SortIcon("estado", currentSort, currentDir) ms-1 sort-icon"></i>
                                </a>
                            </th>
                            <th class="text-end pe-3" style="width: 125px;">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    No se encontraron colaboradores registrados según el criterio de búsqueda.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var p in Model)
                            {
                                <tr class="@(p.EstaCesado ? "colaborador-fila-cesado" : "")">
                                    <!-- Código -->
                                    <td class="ps-3 text-center">
                                        <span class="badge bg-body-secondary text-body border fw-mono">@p.Codigo</span>
                                    </td>

                                    <!-- Documento -->
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary me-1">@p.TipoDocIdentidad</span>
                                        <span class="fw-semibold">@p.NumDocIdentidad</span>
                                    </td>

                                    <!-- Apellidos y Nombres -->
                                    <td>
                                        <div class="fw-bold text-body">@p.RazonSocial</div>
                                        <small class="text-muted d-block text-truncate" style="max-width: 320px;" title="@p.DireccionCompleta">
                                            <i class="bi bi-geo-alt me-1"></i>@p.DireccionCompleta
                                        </small>
                                    </td>

                                    <!-- Cargo -->
                                    <td>
                                        <span class="text-nowrap">@(string.IsNullOrEmpty(p.CargoPersonalNombre) ? "-" : p.CargoPersonalNombre)</span>
                                    </td>

                                    <!-- Centro de Costo -->
                                    <td>
                                        <span class="badge bg-info-subtle text-info border border-info-subtle text-truncate" style="max-width: 160px;" title="@p.CentroCostoNombre">
                                            @(string.IsNullOrEmpty(p.CentroCostoNombre) ? "Sin Centro de Costo" : p.CentroCostoNombre)
                                        </span>
                                    </td>

                                    <!-- Fecha Ingreso -->
                                    <td class="text-center text-nowrap small">
                                        @p.FechaIngreso.ToString("dd/MM/yyyy")
                                    </td>

                                    <!-- Fecha Cese -->
                                    <td class="text-center text-nowrap small">
                                        @if (p.FechaCese.HasValue)
                                        {
                                            <span class="text-danger fw-semibold">@p.FechaCese.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <!-- Estado -->
                                    <td class="text-center">
                                        @if (p.EstaCesado)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Cesado</span>
                                        }
                                        else if (p.Estado == "A")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactivo</span>
                                        }
                                    </td>

                                    <!-- Acciones -->
                                    <td class="text-end pe-3 text-nowrap">
                                        <!-- Editar -->
                                        <button type="button" class="btn btn-outline-primary btn-sm px-2 py-1" onclick="abrirModalEditar(@p.Id);" title="Editar Colaborador">
                                            <i class="bi bi-pencil"></i>
                                        </button>

                                        <!-- Cese -->
                                        @if (!p.EstaCesado)
                                        {
                                            <button type="button" class="btn btn-outline-danger btn-sm px-2 py-1" onclick="abrirModalCese(@p.Id, '@p.RazonSocial');" title="Registrar Cese Laboral">
                                                <i class="bi bi-person-x"></i>
                                            </button>
                                        }

                                        <!-- Activar / Desactivar -->
                                        <button type="button" class="btn @(p.Estado == "A" ? "btn-outline-warning" : "btn-outline-success") btn-sm px-2 py-1" onclick="cambiarEstadoPersonal(@p.Id, '@p.Estado', '@p.RazonSocial');" title="@(p.Estado == "A" ? "Desactivar" : "Activar")">
                                            <i class="bi @(p.Estado == "A" ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                        </button>
                                    </td>
                                </tr>
