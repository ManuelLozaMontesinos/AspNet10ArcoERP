                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold"># Cuenta Haberes</label>
                                    <input type="text" class="form-control form-control-sm" id="pers-cta-haberes" name="NumeroCuentaAbono" maxlength="30" placeholder="Ej: 191-12345678-0-12" />
                                </div>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Banco CTS</label>
                                    <select class="form-select form-select-sm" id="pers-banco-cts-id" name="BancoCTSId">
