@section Scripts {
<script>
    // ========================================================
    // CASCADA DE UBIGEO Y PENSIONES (AJAX)
    // ========================================================
    function cargarProvincias(depId, selectedProvId, callback) {
        var $prov = $('#pers-prov-id');
        var $dist = $('#pers-dist-id');
        $prov.html('<option value="">-- Seleccionar Provincia --</option>');
        $dist.html('<option value="">-- Seleccionar Distrito --</option>');

        if (!depId) return;

        $.get('@Url.Action("ProvinciasPorDepartamento", "Personal", new { area = "RH" })', { departamentoId: depId }, function (data) {
            if (data && data.length > 0) {
                $.each(data, function (i, item) {
                    $prov.append('<option value="' + item.id + '">' + item.nombre + '</option>');
                });
                if (selectedProvId) {
                    $prov.val(selectedProvId);
                }
            }
            if (callback) callback();
        });
    }

    function cargarDistritos(provId, selectedDistId) {
        var $dist = $('#pers-dist-id');
        $dist.html('<option value="">-- Seleccionar Distrito --</option>');

        if (!provId) return;

        $.get('@Url.Action("DistritosPorProvincia", "Personal", new { area = "RH" })', { provinciaId: provId }, function (data) {
            if (data && data.length > 0) {
                $.each(data, function (i, item) {
                    $dist.append('<option value="' + item.id + '">' + item.nombre + '</option>');
                });
                if (selectedDistId) {
                    $dist.val(selectedDistId);
                }
            }
        });
    }

    function cargarEsquemasPension(regId, selectedEsqId) {
        var $esq = $('#pers-reg-pens-esq');
        $esq.html('<option value="">-- No aplica / Sin esquema --</option>');

        if (!regId) return;

        $.get('@Url.Action("EsquemasPorRegimenPensionario", "Personal", new { area = "RH" })', { regimenPensionarioId: regId }, function (data) {
            if (data && data.length > 0) {
                $.each(data, function (i, item) {
                    $esq.append('<option value="' + item.id + '">' + item.nombre + '</option>');
                });
                if (selectedEsqId) {
                    $esq.val(selectedEsqId);
                }
            }
        });
    }

    // ========================================================
    // ABRIR MODAL CREAR
    // ========================================================
    function abrirModalCrear() {
        $('#modal-titulo').text('Nuevo Colaborador');
        $('#modal-subtitulo').text('Registro completo de trabajador en el sistema');
        $('#modal-codigo-badge').text('NUEVO');

        $('#form-personal')[0].reset();
        $('#pers-id').val(0);
        $('#pers-proveedor-id').val(0);
        $('#pers-fecha-nac').val('@DateTime.Today.AddYears(-25).ToString("yyyy-MM-dd")');
        $('#pers-fecha-ingreso').val('@DateTime.Today.ToString("yyyy-MM-dd")');
        $('#pers-fecha-alta').val('@DateTime.Today.ToString("yyyy-MM-dd")');

        // Deshabilitar botones de pestañas hasta que exista ID
        $('#btn-nueva-rem, #btn-nuevo-dep, #btn-nueva-plan').prop('disabled', true);
        $('#tbody-remuneraciones').html('<tr><td colspan="4" class="text-center text-muted py-3">Guarde primero el colaborador para asignar remuneraciones.</td></tr>');
        $('#tbody-dependientes').html('<tr><td colspan="5" class="text-center text-muted py-3">Guarde primero el colaborador para registrar derechohabientes.</td></tr>');
        $('#tbody-planillas').html('<tr><td colspan="3" class="text-center text-muted py-3">Guarde primero el colaborador para asignar planillas.</td></tr>');

        // Activar primera pestaña
        bootstrap.Tab.getOrCreateInstance(document.getElementById('tab-ident-btn')).show();

        var modal = new bootstrap.Modal(document.getElementById('modal-crud-personal'));
        modal.show();
        setTimeout(function () { $('#pers-num-doc').focus(); }, 350);
    }

    // ========================================================
    // ABRIR MODAL EDITAR
    // ========================================================
    function abrirModalEditar(id) {
        $.ajax({
            url: '@Url.Action("Obtener", "Personal", new { area = "RH" })',
            type: 'GET',
            data: { id: id },
            success: function (res) {
                if (res && res.success && res.data) {
                    var d = res.data;

                    $('#modal-titulo').text('Editar Colaborador');
                    $('#modal-subtitulo').text('Actualización de datos personales, laborales y aseguramiento');
                    $('#modal-codigo-badge').text(d.codigo || ('ID #' + id));

                    $('#pers-id').val(d.id);
                    $('#pers-proveedor-id').val(d.proveedorId);
                    $('#pers-empresa-sede-id').val(d.empresaSedeId || 1);

                    // Identificación
                    $('#pers-tipo-doc').val(d.tipoDocIdentidadId);
                    $('#pers-num-doc').val(d.numDocIdentidad);
                    $('#pers-ape-pat').val(d.apellidoPaterno);
                    $('#pers-ape-mat').val(d.apellidoMaterno);
                    $('#pers-nombres').val(d.nombres);
                    $('#pers-sexo-id').val(d.sexoId);
                    $('#pers-estado-civil').val(d.estadoCivilId);
                    $('#pers-pais-id').val(d.paisId || 1);
                    $('#pers-pais-emisor-id').val(d.paisEmisorId || '');
                    $('#pers-telefono').val(d.telefono);
                    $('#pers-email').val(d.email);

                    if (d.fechaNacimiento) {
                        $('#pers-fecha-nac').val(d.fechaNacimiento.substring(0, 10));
                    }

                    // Domicilio 1
                    $('#pers-tipo-via').val(d.tipoViaId || 1);
                    $('#pers-nombre-via').val(d.nombreVia);
                    $('#pers-numero-via').val(d.numeroVia);
                    $('#pers-interior').val(d.interior);

                    // Ubigeo
                    if (d.departamentoId) {
                        $('#pers-dep-id').val(d.departamentoId);
                        cargarProvincias(d.departamentoId, d.provinciaId, function () {
                            if (d.provinciaId) {
                                cargarDistritos(d.provinciaId, d.distritoId);
                            }
                        });
                    }

                    // Laboral
                    if (d.fechaIngreso) {
                        $('#pers-fecha-ingreso').val(d.fechaIngreso.substring(0, 10));
                    }
                    if (d.fechaAlta) {
                        $('#pers-fecha-alta').val(d.fechaAlta.substring(0, 10));
                    }
                    $('#pers-cargo-id').val(d.cargoPersonalId);
                    $('#pers-cc-id').val(d.centroCostoId || '');
                    $('#pers-tipo-trabajador').val(d.tipoTrabajadorId || 1);
                    $('#pers-tipo-contrato').val(d.tipoContratoId || 1);
                    $('#pers-reg-laboral').val(d.regimenLaboralId || 1);
                    $('#pers-ocupacion-id').val(d.ocupacionId || 1);
                    $('#pers-cate-ocupa').val(d.categoriaOcupacionalId || '');
                    $('#pers-situa-educa').val(d.situacionEducativaId || '');
                    $('#pers-peri-remu').val(d.periodicidadRemunerativaId || 1);
                    $('#pers-num-fotocheck').val(d.numFotocheck);

                    $('#pers-asig-fami').prop('checked', d.asignacionFamiliar === 'S');
                    $('#pers-asig-fami-val').val(d.asignacionFamiliar || 'N');
                    $('#pers-es-eventual').prop('checked', d.esEventual === 'S');
                    $('#pers-es-eventual-val').val(d.esEventual || 'N');
                    $('#pers-es-jornada-max').prop('checked', d.esJornadaTrabajoMaxima === 'S');
                    $('#pers-es-jornada-max-val').val(d.esJornadaTrabajoMaxima || 'S');

                    // Aseguramiento
                    $('#pers-reg-salud').val(d.regimenSaludId || 1);
                    $('#pers-eps-id').val(d.epsId || '');
                    $('#pers-reg-pension').val(d.regimenPensionarioId || 1);
                    cargarEsquemasPension(d.regimenPensionarioId, d.regimenPensionarioEsquemaId);

                    $('#pers-num-cuspp').val(d.numeroCuspp);
                    if (d.fechaInscripcionRegimenPensionario) {
                        $('#pers-fecha-ins-pension').val(d.fechaInscripcionRegimenPensionario.substring(0, 10));
                    }
                    $('#pers-sctr-pension').val(d.sctrPensionId || '');
                    $('#pers-sctr-salud').val(d.sctrSaludId || '');
                    $('#pers-es-exon-5ta').prop('checked', d.esExonerado5ta === 'S');
                    $('#pers-es-exon-5ta-val').val(d.esExonerado5ta || 'N');
                    $('#pers-es-discapa').prop('checked', d.esDiscapacitado === 'S');
                    $('#pers-es-discapa-val').val(d.esDiscapacitado || 'N');

                    // Pagos
                    $('#pers-tipo-pago').val(d.tipoPagoRemuneracionId || 1);
                    $('#pers-banco-id').val(d.bancoId || '');
                    $('#pers-cta-haberes').val(d.numeroCuentaAbono);
                    $('#pers-banco-cts-id').val(d.bancoCTSId || '');
                    $('#pers-cta-cts').val(d.numeroCuentaCTS);
                    $('#pers-convenio-trib').val(d.convenioDobleTributacionId || 1);

                    // Habilitar pestañas secundarias
                    $('#btn-nueva-rem, #btn-nuevo-dep, #btn-nueva-plan').prop('disabled', false);
                    cargarRemuneraciones(id);
                    cargarDependientes(id);
                    cargarPlanillas(id);

                    // Activar primera pestaña
                    bootstrap.Tab.getOrCreateInstance(document.getElementById('tab-ident-btn')).show();

                    var modal = new bootstrap.Modal(document.getElementById('modal-crud-personal'));
                    modal.show();
                    setTimeout(function () { $('#pers-num-doc').focus(); }, 350);
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'No se pudo cargar el registro.' });
                }
            },
            error: function () {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Error de comunicación con el servidor.' });
            }
        });
    }

    // ========================================================
    // GUARDAR PERSONAL (SUBMIT FORM)
    // ========================================================
    function guardarPersonal(e) {
        e.preventDefault();
        var formData = $('#form-personal').serialize();

        $.ajax({
            url: '@Url.Action("Guardar", "Personal", new { area = "RH" })',
            type: 'POST',
            data: formData,
            success: function (res) {
                if (res && res.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Guardado',
                        text: res.message,
                        timer: 1300,
                        showConfirmButton: false
                    }).then(function () {
                        location.reload();
                    });
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'No se pudo guardar el registro.' });
                }
            },
            error: function () {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Error al procesar la solicitud en el servidor.' });
            }
        });
    }

    // ========================================================
    // CAMBIAR ESTADO
    // ========================================================
    function cambiarEstadoPersonal(id, estadoActual, descripcion) {
        var accion = estadoActual === 'A' ? 'desactivar' : 'activar';
        Swal.fire({
            title: '¿Confirmar cambio de estado?',
            text: '¿Desea ' + accion + ' a "' + descripcion + '"?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, ' + accion,
            cancelButtonText: 'Cancelar',
            confirmButtonColor: estadoActual === 'A' ? '#dc3545' : '#198754'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("CambiarEstado", "Personal", new { area = "RH" })',
                    type: 'POST',
                    data: { id: id },
                    success: function (res) {
                        if (res && res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Actualizado',
                                text: res.message,
                                timer: 1200,
                                showConfirmButton: false
                            }).then(function () {
                                location.reload();
                            });
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'No se pudo cambiar el estado.' });
                        }
                    },
                    error: function () {
                        Swal.fire({ icon: 'error', title: 'Error', text: 'Error de comunicación con el servidor.' });
                    }
                });
            }
        });
    }

    // ========================================================
    // REGISTRAR CESE
    // ========================================================
    function abrirModalCese(id, nombre) {
        $('#cese-personal-id').val(id);
        $('#cese-personal-nombre').text(nombre);
        var modal = new bootstrap.Modal(document.getElementById('modal-cese-personal'));
        modal.show();
    }

    function confirmarCese(e) {
        e.preventDefault();
        var id = $('#cese-personal-id').val();
        var fecha = $('#cese-fecha').val();
        var motivoId = $('#cese-motivo-id').val();

        $.ajax({
            url: '@Url.Action("RegistrarCese", "Personal", new { area = "RH" })',
            type: 'POST',
            data: { id: id, fechaCese: fecha, motivoId: motivoId },
            success: function (res) {
                if (res && res.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Cese Registrado',
                        text: res.message,
                        timer: 1400,
                        showConfirmButton: false
                    }).then(function () {
                        location.reload();
                    });
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'No se pudo registrar el cese.' });
                }
            },
            error: function () {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Error al comunicar con el servidor.' });
            }
        });
    }

    // ========================================================
    // GESTIÓN DE REMUNERACIONES (PESTAÑA 5)
    // ========================================================
    function cargarRemuneraciones(personalId) {
        $.get('@Url.Action("Remuneraciones", "Personal", new { area = "RH" })', { personalId: personalId }, function (res) {
            var $tbody = $('#tbody-remuneraciones');
            $tbody.empty();
            if (res && res.success && res.data && res.data.length > 0) {
                $.each(res.data, function (i, r) {
                    $tbody.append(
                        '<tr>' +
                            '<td>' + r.tipoRemuneracionNombre + '</td>' +
                            '<td class="text-center"><span class="badge bg-secondary-subtle text-secondary">' + r.monedaSimbolo + '</span></td>' +
                            '<td class="text-end fw-semibold">' + r.monto.toFixed(2) + '</td>' +
                            '<td class="text-end pe-2">' +
                                '<button type="button" class="btn btn-outline-danger btn-xs py-0 px-1" onclick="eliminarRemuneracion(' + r.id + ', ' + personalId + ');"><i class="bi bi-trash"></i></button>' +
                            '</td>' +
                        '</tr>'
                    );
                });
            } else {
                $tbody.append('<tr><td colspan="4" class="text-center text-muted py-2">Sin conceptos remunerativos asignados.</td></tr>');
            }
        });
    }

    function abrirModalNuevaRem() {
        var modal = new bootstrap.Modal(document.getElementById('modal-nueva-rem'));
        modal.show();
    }

    function guardarRemuneracionRapida(e) {
        e.preventDefault();
        var personalId = $('#pers-id').val();
        var tipoRemId = $('#modal-rem-tipo-id').val();
        var monedaId = $('#modal-rem-moneda-id').val();
        var monto = $('#modal-rem-monto').val();

        $.post('@Url.Action("GuardarRemuneracion", "Personal", new { area = "RH" })', {
            PersonalId: personalId,
            TipoRemuneracionId: tipoRemId,
            MonedaId: monedaId,
            Monto: monto
        }, function (res) {
            if (res && res.success) {
                bootstrap.Modal.getInstance(document.getElementById('modal-nueva-rem')).hide();
                cargarRemuneraciones(personalId);
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'Error al guardar remuneración.' });
            }
        });
    }

    function eliminarRemuneracion(id, personalId) {
        Swal.fire({
            title: '¿Eliminar concepto remunerativo?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.post('@Url.Action("EliminarRemuneracion", "Personal", new { area = "RH" })', { id: id }, function (res) {
                    cargarRemuneraciones(personalId);
                });
            }
        });
    }

    // ========================================================
    // GESTIÓN DE DERECHOHABIENTES (PESTAÑA 6)
    // ========================================================
    var dependientesActuales = [];

    function cargarDependientes(personalId) {
        $.get('@Url.Action("Dependientes", "Personal", new { area = "RH" })', { personalId: personalId }, function (res) {
            var $tbody = $('#tbody-dependientes');
            $tbody.empty();
            if (res && res.success && res.data && res.data.length > 0) {
                dependientesActuales = res.data;
                $.each(res.data, function (i, d) {
                    $tbody.append(
                        '<tr>' +
                            '<td>' + d.nombreCompleto + '</td>' +
                            '<td><span class="badge bg-secondary-subtle text-secondary me-1">' + d.tipoDocIdentidadNombre + '</span>' + d.numDocIdentidad + '</td>' +
                            '<td><span class="badge bg-info-subtle text-info border">' + d.vinculoFamiliarNombre + '</span></td>' +
                            '<td class="text-center">' + (d.fechaNacimiento ? d.fechaNacimiento.substring(0, 10) : '-') + '</td>' +
                            '<td class="text-end pe-2">' +
                                '<button type="button" class="btn btn-outline-primary btn-xs py-0 px-1 me-1" onclick="editarDependiente(' + d.id + ');"><i class="bi bi-pencil-square"></i></button>' +
                                '<button type="button" class="btn btn-outline-danger btn-xs py-0 px-1" onclick="eliminarDependiente(' + d.id + ', ' + personalId + ');"><i class="bi bi-trash"></i></button>' +
                            '</td>' +
                        '</tr>'
                    );
                });
            } else {
                dependientesActuales = [];
                $tbody.append('<tr><td colspan="5" class="text-center text-muted py-2">Sin familiares registrados.</td></tr>');
            }
        });
    }

    function abrirModalNuevoDep() {
        $('#form-dependiente')[0].reset();
        $('#modal-dep-id').val(0);
        $('#modal-nuevo-dep .modal-title').text('Agregar Derechohabiente');
        $('#form-dependiente button[type="submit"]').text('Guardar Familiar');
        var modal = new bootstrap.Modal(document.getElementById('modal-nuevo-dep'));
        modal.show();
    }

    function editarDependiente(id) {
        var dependiente = dependientesActuales.find(function (item) { return item.id === id; });
        if (!dependiente) {
            Swal.fire({ icon: 'error', title: 'Error', text: 'No se encontró el derechohabiente seleccionado.' });
            return;
        }

        $('#modal-dep-id').val(dependiente.id);
        $('#modal-dep-tipo-doc').val(dependiente.tipoDocIdentidadId);
        $('#modal-dep-num-doc').val(dependiente.numDocIdentidad);
        $('#modal-dep-pais-emisor-id').val(dependiente.paisEmisorId || '');
        $('#modal-dep-ape-pat').val(dependiente.apellidoPaterno);
        $('#modal-dep-ape-mat').val(dependiente.apellidoMaterno);
        $('#modal-dep-nombres').val(dependiente.nombres);
        $('#modal-dep-vinculo-id').val(dependiente.vinculoFamiliarId);
        $('#modal-dep-fecha-nac').val(dependiente.fechaNacimiento ? dependiente.fechaNacimiento.substring(0, 10) : '');
        $('#modal-nuevo-dep .modal-title').text('Editar Derechohabiente');
        $('#form-dependiente button[type="submit"]').text('Guardar cambios');
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-nuevo-dep')).show();
    }

    function guardarDependienteRapido(e) {
        e.preventDefault();
        var personalId = $('#pers-id').val();
        var tipoDoc = $('#modal-dep-tipo-doc').val();
        var numDoc = $('#modal-dep-num-doc').val();
        var apePat = $('#modal-dep-ape-pat').val();
        var apeMat = $('#modal-dep-ape-mat').val();
        var nombres = $('#modal-dep-nombres').val();
        var vinculo = $('#modal-dep-vinculo-id').val();
        var fechaNac = $('#modal-dep-fecha-nac').val();

        $.post('@Url.Action("GuardarDependiente", "Personal", new { area = "RH" })', {
            Id: $('#modal-dep-id').val(),
            PersonalId: personalId,
            TipoDocIdentidadId: tipoDoc,
            NumDocIdentidad: numDoc,
            PaisEmisorId: $('#modal-dep-pais-emisor-id').val(),
            ApellidoPaterno: apePat,
            ApellidoMaterno: apeMat,
            Nombres: nombres,
            VinculoFamiliarId: vinculo,
            FechaNacimiento: fechaNac
        }, function (res) {
            if (res && res.success) {
                bootstrap.Modal.getInstance(document.getElementById('modal-nuevo-dep')).hide();
                cargarDependientes(personalId);
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'Error al guardar familiar.' });
            }
        });
    }

    function eliminarDependiente(id, personalId) {
        Swal.fire({
            title: '¿Eliminar familiar registrado?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.post('@Url.Action("EliminarDependiente", "Personal", new { area = "RH" })', { id: id }, function (res) {
                    cargarDependientes(personalId);
                });
            }
        });
    }

    // ========================================================
    // GESTIÓN DE PLANILLAS ASIGNADAS (PESTAÑA 7)
    // ========================================================
    function cargarPlanillas(personalId) {
        $.get('@Url.Action("Planillas", "Personal", new { area = "RH" })', { personalId: personalId }, function (res) {
            var $tbody = $('#tbody-planillas');
            $tbody.empty();
            if (res && res.success && res.data && res.data.length > 0) {
                $.each(res.data, function (i, p) {
                    $tbody.append(
                        '<tr>' +
                            '<td class="fw-semibold">' + p.planillaNombre + '</td>' +
                            '<td class="text-center"><span class="badge bg-success-subtle text-success border">Asignado</span></td>' +
                            '<td class="text-end pe-2">' +
                                '<button type="button" class="btn btn-outline-danger btn-xs py-0 px-1" onclick="eliminarPlanilla(' + p.id + ', ' + personalId + ');"><i class="bi bi-trash"></i></button>' +
                            '</td>' +
                        '</tr>'
                    );
                });
            } else {
                $tbody.append('<tr><td colspan="3" class="text-center text-muted py-2">Sin planillas asignadas.</td></tr>');
            }
        });
    }

    function abrirModalNuevaPlan() {
        var modal = new bootstrap.Modal(document.getElementById('modal-nueva-plan'));
        modal.show();
    }

    function guardarPlanillaRapida(e) {
        e.preventDefault();
        var personalId = $('#pers-id').val();
        var planId = $('#modal-plan-id').val();

        $.post('@Url.Action("GuardarPlanilla", "Personal", new { area = "RH" })', {
            PersonalId: personalId,
            PlanillaId: planId
        }, function (res) {
            if (res && res.success) {
                bootstrap.Modal.getInstance(document.getElementById('modal-nueva-plan')).hide();
                cargarPlanillas(personalId);
            } else {
                Swal.fire({ icon: 'warning', title: 'Atención', text: res.message || 'No se pudo asignar a la planilla.' });
            }
        });
    }

    function eliminarPlanilla(id, personalId) {
        Swal.fire({
            title: '¿Remover asignación de planilla?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí, remover',
            cancelButtonText: 'Cancelar'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.post('@Url.Action("EliminarPlanilla", "Personal", new { area = "RH" })', { id: id }, function (res) {
                    cargarPlanillas(personalId);
                });
            }
        });
    }
</script>
}
