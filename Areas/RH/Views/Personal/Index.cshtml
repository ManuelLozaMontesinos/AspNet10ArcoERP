@model List<AspNet10ArcoERP.Models.PersonalModel>
@{
    ViewData["Title"] = "Registro de Personal";
    
    var tiposDocLookup = ViewBag.TiposDocLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var sexosLookup = ViewBag.SexosLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var estadosCivilesLookup = ViewBag.EstadosCivilesLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var paisesLookup = ViewBag.PaisesLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var paisesEmisoresLookup = ViewBag.PaisesEmisoresLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var departamentosLookup = ViewBag.DepartamentosLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var tiposViaLookup = ViewBag.TiposViaLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var tiposZonaLookup = ViewBag.TiposZonaLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var tiposTrabajadorLookup = ViewBag.TiposTrabajadorLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var categoriasOcupacionalesLookup = ViewBag.CategoriasOcupacionalesLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var regimenesLaboralesLookup = ViewBag.RegimenesLaboralesLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var situacionesEducativasLookup = ViewBag.SituacionesEducativasLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var cargosLookup = ViewBag.CargosLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var ocupacionesLookup = ViewBag.OcupacionesLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var centrosCostoLookup = ViewBag.CentrosCostoLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var tiposContratoLookup = ViewBag.TiposContratoLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var situacionesEspecialesLookup = ViewBag.SituacionesEspecialesLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var periodicidadesRemuLookup = ViewBag.PeriodicidadesRemuLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var regimenesSaludLookup = ViewBag.RegimenesSaludLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var epsLookup = ViewBag.EpsLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var regimenesPensionariosLookup = ViewBag.RegimenesPensionariosLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var sctrPensionLookup = ViewBag.SctrPensionLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var sctrSaludLookup = ViewBag.SctrSaludLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var tiposPagoRemuLookup = ViewBag.TiposPagoRemuLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var bancosLookup = ViewBag.BancosLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var conveniosDobleTribLookup = ViewBag.ConveniosDobleTribLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var motivosFinPeriodoLookup = ViewBag.MotivosFinPeriodoLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var vinculosFamiliaresLookup = ViewBag.VinculosFamiliaresLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var tiposRemuneracionLookup = ViewBag.TiposRemuneracionLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var planillasLookup = ViewBag.PlanillasLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
    var monedasLookup = ViewBag.MonedasLookup as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();

    string? estadoFiltro = ViewBag.Estado as string;
    string currentSort = (ViewBag.Sort as string ?? "codigo").ToLower();
    string currentDir = (ViewBag.Dir as string ?? "desc").ToLower();
    int currentTop = ViewBag.Top != null ? (int)ViewBag.Top : 25;

    int totalCount = ViewBag.TotalCount ?? (Model?.Count ?? 0);
    int activosCount = ViewBag.ActivosCount ?? 0;
    int cesadosCount = ViewBag.CesadosCount ?? 0;
}

@functions {
    string SortUrl(string col, string curSort, string curDir, string? search, string? estado, int top)
    {
        string nextDir = (curSort == col && curDir == "asc") ? "desc" : "asc";
        return Url.Action("Index", new { search, estado, sort = col, dir = nextDir, top }) ?? "#";
    }

    string SortIcon(string col, string curSort, string curDir, bool isNumeric = false)
    {
        if (curSort != col) return "bi-arrow-down-up text-muted opacity-50";
        if (isNumeric)
            return curDir == "asc" ? "bi-sort-numeric-down text-primary fw-bold" : "bi-sort-numeric-down-alt text-primary fw-bold";
        return curDir == "asc" ? "bi-sort-alpha-down text-primary fw-bold" : "bi-sort-alpha-down-alt text-primary fw-bold";
    }
}

<style>
    .table-fixed-header th {
        padding-top: 0.45rem !important;
        padding-bottom: 0.45rem !important;
        font-size: 0.78rem !important;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }
    .colaborador-fila-cesado {
        background-color: rgba(220, 53, 69, 0.04) !important;
    }
    [data-bs-theme="dark"] .colaborador-fila-cesado {
        background-color: rgba(220, 53, 69, 0.12) !important;
    }

    /* Pestañas (nav-tabs) dentro del modal */
    .nav-tabs .nav-link {
        font-size: 0.82rem;
        font-weight: 500;
        color: var(--bs-body-color);
        padding: 0.5rem 0.85rem;
        border: none;
        border-bottom: 2px solid transparent;
        background: transparent;
        transition: all 0.15s ease-in-out;
    }
    .nav-tabs .nav-link:hover {
        color: var(--bs-primary);
        border-bottom-color: rgba(var(--bs-primary-rgb), 0.4);
    }
    .nav-tabs .nav-link.active {
        font-weight: 700;
        color: var(--bs-primary) !important;
        border-bottom: 2px solid var(--bs-primary) !important;
        background: transparent !important;
    }

    /* ==========================================================================
       ADAPTACIONES COMPLETAS DE TEMA OSCURO (MODALES, CABECERAS Y CONTROLES)
       ========================================================================== */
    [data-bs-theme="dark"] .modal-content {
        background-color: #1e2227 !important;
        color: #e9ecef !important;
        border: 1px solid #2c3138 !important;
    }
    [data-bs-theme="dark"] .modal-header,
    [data-bs-theme="dark"] .modal-footer {
