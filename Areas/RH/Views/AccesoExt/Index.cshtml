@model AspNet10ArcoERP.Models.SolicitudAccesoPageModel
@{
    ViewData["Title"] = "Aprobación de accesos extendidos";
    var pageCount = Math.Max(1, (int)Math.Ceiling(Model.Total / (double)Model.PageSize));
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-1"><i class="bi bi-person-check me-2 text-primary"></i>Aprobación de accesos extendidos</h3>
                <small class="text-muted">Revisa las solicitudes de salida y autoriza la hora de retorno del personal.</small>
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4">
    <div class="container-fluid">
        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-header bg-body-tertiary py-3">
                <form method="get" class="d-flex flex-wrap align-items-end gap-3">
                    <div>
                        <label for="fechaDesde" class="form-label small fw-semibold">Fecha desde</label>
                        <input id="fechaDesde" name="fechaDesde" type="date" value="@Model.FechaDesde?.ToString("yyyy-MM-dd")" class="form-control" />
                    </div>
                    <div>
                        <label for="fechaHasta" class="form-label small fw-semibold">Fecha hasta</label>
                        <input id="fechaHasta" name="fechaHasta" type="date" value="@Model.FechaHasta?.ToString("yyyy-MM-dd")" class="form-control" />
                    </div>
                    <div>
                        <label for="estadoAprobacionId" class="form-label small fw-semibold">Estado</label>
                        <select id="estadoAprobacionId" name="estadoAprobacionId" class="form-select">
                            <option value="">Todos los estados</option>
                            @foreach (var estado in Model.Estados)
                            {
                                <option value="@estado.Id" selected="@(Model.EstadoSeleccionadoId == estado.Id)">@estado.Nombre</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="top" class="form-label small fw-semibold">Mostrando</label>
                        <select id="top" name="top" class="form-select">
                            @foreach (var size in new[] { 25, 50, 100, 500 })
                            {
                                <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>Filtrar</button>
                    <a asp-area="RH" asp-controller="AccesoExt" asp-action="Index" class="btn btn-outline-secondary" title="Limpiar filtros">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">@Model.Total solicitud(es)</span>
                </form>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0 table-fixed-header">
                    <thead class="bg-body-tertiary">
                        <tr>
                            <th>Solicitante</th>
                            <th>Fecha solicitada</th>
                            <th>Hora solicitada</th>
                            <th>Autorizado por</th>
                            <th>Hora autorizada</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">No se encontraron solicitudes para los filtros seleccionados.</td></tr>
                        }
                        @foreach (var solicitud in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@solicitud.PersonalNombre</div>
                                    <span class="small text-muted font-monospace">@solicitud.PersonalCodigo</span>
                                </td>
                                <td>
                                    <div>@solicitud.Fecha.ToString("dd/MM/yyyy")</div>
                                    <span class="small text-muted">Registrada @solicitud.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</span>
                                </td>
                                <td><span class="badge bg-body-secondary text-body border font-monospace">@solicitud.HoraSolicitada</span></td>
                                <td>@(string.IsNullOrWhiteSpace(solicitud.PersonalAutorizaNombre) ? "—" : solicitud.PersonalAutorizaNombre)</td>
                                <td class="font-monospace">@(string.IsNullOrWhiteSpace(solicitud.HoraAutorizada) ? "—" : solicitud.HoraAutorizada)</td>
                                <td>
                                    @if (solicitud.EstadoAprobacionCodigo == "P")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">@solicitud.EstadoAprobacionNombre</span>
                                    }
                                    else if (solicitud.EstadoAprobacionCodigo == "A")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">@solicitud.EstadoAprobacionNombre</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-body-secondary border px-2 py-1">@solicitud.EstadoAprobacionNombre</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @if (solicitud.EstadoAprobacionCodigo == "P")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary js-approve"
                                                data-request-id="@solicitud.Id"
                                                data-employee="@solicitud.PersonalNombre"
                                                data-date="@solicitud.Fecha.ToString("dd/MM/yyyy")"
                                                data-requested-hour="@solicitud.HoraSolicitada">
                                            <i class="bi bi-check-circle me-1"></i>Aprobar
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger js-reject" data-request-id="@solicitud.Id">
                                            <i class="bi bi-x-circle me-1"></i>Desaprobar
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-body-tertiary d-flex flex-wrap align-items-center justify-content-between gap-2">
                <span class="small text-muted">Página @Model.Page de @pageCount · @Model.Total solicitud(es)</span>
                <div class="btn-group btn-group-sm">
                    @if (Model.Page > 1)
                    {
                        <a class="btn btn-outline-secondary" asp-area="RH" asp-controller="AccesoExt" asp-action="Index"
                           asp-route-fechaDesde="@Model.FechaDesde?.ToString("yyyy-MM-dd")"
                           asp-route-fechaHasta="@Model.FechaHasta?.ToString("yyyy-MM-dd")"
                           asp-route-estadoAprobacionId="@Model.EstadoSeleccionadoId"
                           asp-route-top="@Model.PageSize" asp-route-page="@(Model.Page - 1)">
                            <i class="bi bi-chevron-left me-1"></i>Anterior
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary" disabled><i class="bi bi-chevron-left me-1"></i>Anterior</button>
                    }
                    @if (Model.Page < pageCount)
                    {
                        <a class="btn btn-outline-secondary" asp-area="RH" asp-controller="AccesoExt" asp-action="Index"
                           asp-route-fechaDesde="@Model.FechaDesde?.ToString("yyyy-MM-dd")"
                           asp-route-fechaHasta="@Model.FechaHasta?.ToString("yyyy-MM-dd")"
                           asp-route-estadoAprobacionId="@Model.EstadoSeleccionadoId"
                           asp-route-top="@Model.PageSize" asp-route-page="@(Model.Page + 1)">
                            Siguiente<i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary" disabled>Siguiente<i class="bi bi-chevron-right ms-1"></i></button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal-crud-acceso-extendido" tabindex="-1" aria-labelledby="accesoExtendidoTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <form id="formAprobarAcceso" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" id="solicitudId" />
            <div class="modal-header sticky-top bg-body-tertiary">
                <div>
                    <h5 class="modal-title fw-bold" id="accesoExtendidoTitle"><i class="bi bi-person-check me-2"></i>Aprobar acceso extendido</h5>
                    <div class="small text-muted" id="solicitudSubtitle"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="horaSolicitada" class="form-label small fw-semibold">Hora solicitada</label>
                        <input id="horaSolicitada" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label for="horaAutorizada" class="form-label small fw-semibold">Hora autorizada</label>
                        <input id="horaAutorizada" type="time" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <div class="alert alert-info mb-0" role="alert">
                            La hora autorizada se guardará junto con el usuario que aprueba y la fecha de autorización.
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer sticky-bottom bg-body-tertiary">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Confirmar aprobación</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <style>
        #modal-crud-acceso-extendido .modal-content {
            max-height: 90vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        #modal-crud-acceso-extendido .modal-body {
            max-height: calc(90vh - 135px) !important;
            overflow-y: auto !important;
            flex: 1 1 auto;
            scrollbar-width: thin;
            scrollbar-color: rgba(140, 150, 165, 0.4) transparent;
            scroll-behavior: smooth;
        }

        #modal-crud-acceso-extendido .modal-body::-webkit-scrollbar { width: 7px; }
        #modal-crud-acceso-extendido .modal-body::-webkit-scrollbar-track { background: transparent; }
        #modal-crud-acceso-extendido .modal-body::-webkit-scrollbar-thumb { background: rgba(140, 150, 165, 0.45); border-radius: 4px; }
        #modal-crud-acceso-extendido .modal-body::-webkit-scrollbar-thumb:hover { background: rgba(140, 150, 165, 0.75); }
    </style>
    <script>
        (() => {
            const modalElement = document.getElementById('modal-crud-acceso-extendido');
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            const form = document.getElementById('formAprobarAcceso');
            const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
            const approveUrl = '@Url.Action("Aprobar", "AccesoExt", new { area = "RH" })';
            const rejectUrl = '@Url.Action("Desaprobar", "AccesoExt", new { area = "RH" })';

            async function send(url, body) {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(body)
                });
                const result = await response.json();
                if (!response.ok || result.success === false)
                    throw new Error(result.message || 'No se pudo resolver la solicitud.');
                return result;
            }

            function refresh() {
                window.location.reload();
            }

            document.querySelectorAll('.js-approve').forEach(button => {
                button.addEventListener('click', () => {
                    document.getElementById('solicitudId').value = button.dataset.requestId;
                    document.getElementById('solicitudSubtitle').textContent =
                        `${button.dataset.employee} · ${button.dataset.date}`;
                    document.getElementById('horaSolicitada').value = button.dataset.requestedHour;
                    document.getElementById('horaAutorizada').value = button.dataset.requestedHour;
                    modal.show();
                });
            });

            document.querySelectorAll('.js-reject').forEach(button => {
                button.addEventListener('click', async () => {
                    const confirmation = await Swal.fire({
                        title: '¿Desaprobar solicitud?',
                        text: 'La solicitud cambiará al estado desaprobado.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Sí, desaprobar',
                        cancelButtonText: 'Cancelar'
                    });
                    if (!confirmation.isConfirmed)
                        return;
                    try {
                        const result = await send(rejectUrl, { id: Number(button.dataset.requestId) });
                        await Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: result.message, showConfirmButton: false, timer: 2500 });
                        refresh();
                    } catch (error) {
                        Swal.fire({ icon: 'error', title: 'No se pudo desaprobar', text: error.message });
                    }
                });
            });

            form.addEventListener('submit', async event => {
                event.preventDefault();
                if (!form.reportValidity())
                    return;
                try {
                    const result = await send(approveUrl, {
                        id: Number(document.getElementById('solicitudId').value),
                        horaAutorizada: document.getElementById('horaAutorizada').value
                    });
                    modal.hide();
                    await Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: result.message, showConfirmButton: false, timer: 2500 });
                    refresh();
                } catch (error) {
                    Swal.fire({ icon: 'error', title: 'No se pudo aprobar', text: error.message });
                }
            });
        })();
    </script>
}
