@model List<AspNet10ArcoERP.Models.HoraRemunerativaModel>
@{
    ViewData["Title"] = "Horas Remunerativas";
    var variablesCalculo = ViewBag.VariablesCalculo as List<AspNet10ArcoERP.Models.LookupItemModel> ?? new List<AspNet10ArcoERP.Models.LookupItemModel>();
}

<style>
    .table-fixed-header {
        table-layout: auto;
    }
    .table-header-custom th {
        padding-top: 0.45rem !important;
        padding-bottom: 0.45rem !important;
        font-size: 0.78rem !important;
        letter-spacing: 0.5px;
        white-space: nowrap !important;
        vertical-align: middle !important;
        height: 40px !important;
        line-height: 1.2;
    }
    .th-sortable {
        cursor: pointer;
        user-select: none;
        transition: background-color 0.15s ease, color 0.15s ease;
    }
    .th-sortable:hover {
        background-color: var(--bs-tertiary-bg);
        color: var(--bs-primary);
    }
    [data-bs-theme="dark"] .table-header-custom {
        background-color: #1e2227 !important;
        color: #e9ecef !important;
    }
    [data-bs-theme="dark"] .modal-content {
        background-color: #1e2227 !important;
        border: 1px solid #343a40 !important;
    }
    [data-bs-theme="dark"] .modal-header,
    [data-bs-theme="dark"] .modal-footer {
        background-color: #181b1f !important;
        border-color: #2b3035 !important;
    }
</style>

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-hourglass-split text-info me-2" style="font-size: 1.6rem;"></i>Horas Remunerativas
                </h3>
                <small class="text-muted">Catálogo de horas laborables, sobretiempos, tardanzas y faltas con fórmulas asociadas</small>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <button type="button" class="btn btn-primary shadow-sm fw-semibold px-3" onclick="abrirModalCrear();">
                    <i class="bi bi-plus-circle-fill me-1"></i>Nueva Hora
                </button>
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4">
    <div class="container-fluid">
        <!-- BARRA DE FILTROS -->
        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <!-- Buscador -->
                        <div class="input-group input-group-sm" style="min-width: 320px; max-width: 440px;">
                            <span class="input-group-text bg-body-tertiary border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" id="filtro-tabla" class="form-control border-start-0 ps-0" placeholder="Buscar por código, nombre o abreviatura..." onkeyup="aplicarFiltros();" />
                            <button type="button" class="btn btn-outline-secondary" onclick="limpiarFiltros();" title="Limpiar"><i class="bi bi-x-lg"></i></button>
                        </div>

                        <!-- Estado -->
                        <div class="input-group input-group-sm" style="width: auto;">
                            <span class="input-group-text bg-body-tertiary text-muted border-end-0">
                                <i class="bi bi-toggle-on text-primary"></i>
                            </span>
                            <select id="filtro-estado" class="form-select form-select-sm border-start-0" style="min-width: 140px;" onchange="aplicarFiltros();" title="Filtrar por Estado">
                                <option value="">Todos los Estados</option>
                                <option value="A">Solo Activos</option>
                                <option value="I">Solo Inactivos</option>
                            </select>
                        </div>
                    </div>

                    <!-- TOTAL Y MOSTRANDO -->
                    <div class="d-flex align-items-center gap-3 ms-auto">
                        <div class="text-muted small text-nowrap">
                            <span>Total: <strong class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6" id="total-registros">@(Model?.Count ?? 0)</strong> tipos</span>
                        </div>

                        <div class="dropdown flex-shrink-0">
                            <button class="btn btn-sm btn-outline-primary dropdown-toggle d-flex align-items-center gap-1 shadow-sm px-2 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-funnel-fill text-primary"></i>
                                <span>Mostrando: <strong class="badge bg-primary text-white ms-1" id="lbl-top-actual">25</strong></span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li class="dropdown-header text-uppercase small fw-bold">Registros a listar</li>
                                <li><a class="dropdown-item item-top active" href="javascript:void(0)" onclick="cambiarTop(25)">25 registros</a></li>
                                <li><a class="dropdown-item item-top" href="javascript:void(0)" onclick="cambiarTop(50)">50 registros</a></li>
                                <li><a class="dropdown-item item-top" href="javascript:void(0)" onclick="cambiarTop(100)">100 registros</a></li>
                                <li><a class="dropdown-item item-top" href="javascript:void(0)" onclick="cambiarTop(500)">500 registros</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TABLA PRINCIPAL -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0 table-responsive">
                <table class="table table-striped table-hover align-middle mb-0 table-fixed-header" id="tabla-horas">
                    <thead class="table-header-custom border-bottom bg-body-tertiary">
                        <tr>
                            <th style="width: 70px;" class="text-center th-sortable" onclick="ordenarTabla('tabla-horas', 0, true)">
                                <span>ID</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th style="width: 90px;" class="text-center th-sortable" onclick="ordenarTabla('tabla-horas', 1, false)">
                                <span>Código</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th class="th-sortable" onclick="ordenarTabla('tabla-horas', 2, false)">
                                <span>Nombre de la Hora</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th style="width: 100px;" class="text-center th-sortable" onclick="ordenarTabla('tabla-horas', 3, false)">
                                <span>Abrev.</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th class="th-sortable" onclick="ordenarTabla('tabla-horas', 4, false)">
                                <span>Variable de Cálculo</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th style="width: 110px;" class="text-center th-sortable" onclick="ordenarTabla('tabla-horas', 5, false)">
                                <span>Estado</span> <i class="bi bi-arrow-down-up text-muted opacity-50 ms-1 sort-icon"></i>
                            </th>
                            <th style="width: 120px;" class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr id="fila-@item.Id" data-search="@($"{item.Codigo} {item.Nombre} {item.Abreviatura} {item.VariableCalculoNombre}".ToLower())" data-estado="@item.Estado">
                                    <td class="text-center font-monospace text-muted small">@item.Id</td>
                                    <td class="text-center font-monospace fw-semibold text-info">@item.Codigo</td>
                                    <td>
                                        <span class="fw-semibold text-body item-nombre">@item.Nombre</span>
                                    </td>
                                    <td class="text-center font-monospace fw-bold text-secondary">
                                        @item.Abreviatura
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary border px-2 py-1 font-monospace">
                                            <i class="bi bi-calculator me-1"></i>@item.VariableCalculoNombre
                                        </span>
                                    </td>
                                    <td class="text-center col-estado">
                                        @if (item.Estado == "A")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary py-0 px-2 btn-action-edit" title="Editar" onclick="abrirModalEditar(@item.Id);">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm @(item.Estado == "A" ? "btn-outline-danger" : "btn-outline-success") py-0 px-2 ms-1 btn-action-toggle" title="@(item.Estado == "A" ? "Desactivar" : "Activar")" onclick="cambiarEstado(@item.Id, '@item.Estado', '@item.Nombre');">
                                            <i class="bi @(item.Estado == "A" ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="fila-vacia">
                                <td colspan="7" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    <span>No se encontraron registros de horas remunerativas</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CRUD: HORA REMUNERATIVA -->
<div class="modal fade" id="modal-crud-hora" tabindex="-1" aria-labelledby="modalHoraLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0 rounded-4">
            <div class="modal-header border-bottom py-3 px-4 bg-body-tertiary">
                <h5 class="modal-title fw-bold" id="modalHoraLabel">
                    <i class="bi bi-hourglass-split text-info me-2"></i><span id="modal-titulo">Nueva Hora Remunerativa</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="form-hora" onsubmit="guardarHora(event);">
                @Html.AntiForgeryToken()
                <input type="hidden" id="hora-id" name="Id" value="0" />
                <div class="modal-body p-4">
                    <div class="mb-3" id="grupo-codigo-hora" style="display: none;">
                        <label for="hora-codigo" class="form-label fw-semibold">Código</label>
                        <input type="text" class="form-control font-monospace" id="hora-codigo" name="Codigo" readonly />
                    </div>
                    <div class="mb-3">
                        <label for="hora-nombre" class="form-label fw-semibold">Nombre de la Hora <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="hora-nombre" name="Nombre" placeholder="Ej: HORAS NORMALES, HORA EXTRA AL 25%..." maxlength="100" required />
                    </div>
                    <div class="mb-3">
                        <label for="hora-abrev" class="form-label fw-semibold">Abreviatura <span class="text-danger">*</span></label>
                        <input type="text" class="form-control font-monospace" id="hora-abrev" name="Abreviatura" placeholder="Ej: HN, HE25, Tard..." maxlength="20" required />
                    </div>
                    <div class="mb-3">
                        <label for="hora-var-calc" class="form-label fw-semibold">Variable de Cálculo Asociada <span class="text-danger">*</span></label>
                        <select class="form-select" id="hora-var-calc" name="VariableCalculoId" required>
                            <option value="">-- Seleccione Variable de Cálculo --</option>
                            @foreach (var v in variablesCalculo)
                            {
                                <option value="@v.Id">@v.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label for="hora-estado" class="form-label fw-semibold">Estado</label>
                        <select class="form-select" id="hora-estado" name="Estado">
                            <option value="A">Activo</option>
                            <option value="I">Inactivo</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top py-3 px-4 bg-body-tertiary">
                    <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold" id="btn-guardar-hora" disabled>
                        <i class="bi bi-check-circle me-1"></i>Guardar Hora
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var topActual = 25;
    var sortColIdx = -1;
    var sortAsc = true;
    var formInitialState = "";

    function sonCamposRequeridosValidos() {
        var nom = ($('#hora-nombre').val() || '').trim();
        var abr = ($('#hora-abrev').val() || '').trim();
        var vc = parseInt($('#hora-var-calc').val()) || 0;
        return nom !== '' && abr !== '' && vc > 0;
    }

    function actualizarEstadoBotonGuardar() {
        var id = parseInt($('#hora-id').val()) || 0;
        var valido = sonCamposRequeridosValidos();
        var $btn = $('#btn-guardar-hora');

        if (id === 0) {
            $btn.prop('disabled', !valido);
        } else {
            var haCambiado = (formInitialState !== "" && $('#form-hora').serialize() !== formInitialState);
            $btn.prop('disabled', !(valido && haCambiado));
        }
    }

    $(document).on('input change keyup', '#form-hora input, #form-hora select', function () {
        actualizarEstadoBotonGuardar();
    });

    function aplicarFiltros() {
        var query = ($('#filtro-tabla').val() || '').toLowerCase().trim();
        var estado = ($('#filtro-estado').val() || '').trim();
        var totalCoincidencias = 0;
        var mostrados = 0;

        $('#tabla-horas tbody tr:not(#fila-vacia)').each(function () {
            var $row = $(this);
            var searchTxt = $row.data('search') || '';
            var rowEstado = $row.data('estado') || '';

            var cumpleQuery = (query === '' || searchTxt.indexOf(query) !== -1);
            var cumpleEstado = (estado === '' || rowEstado === estado);

            if (cumpleQuery && cumpleEstado) {
                totalCoincidencias++;
                if (topActual === 0 || mostrados < topActual) {
                    $row.show();
                    mostrados++;
                } else {
                    $row.hide();
                }
            } else {
                $row.hide();
            }
        });

        $('#total-registros').text(totalCoincidencias);

        if (totalCoincidencias === 0) {
            if ($('#fila-vacia').length === 0) {
                $('#tabla-horas tbody').append(
                    '<tr id="fila-vacia"><td colspan="7" class="text-center text-muted py-5">' +
                    '<i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>' +
                    '<span>No se encontraron registros que coincidan con la búsqueda</span></td></tr>'
                );
            } else {
                $('#fila-vacia').show();
            }
        } else {
            $('#fila-vacia').hide();
        }
    }

    function limpiarFiltros() {
        $('#filtro-tabla').val('');
        $('#filtro-estado').val('');
        aplicarFiltros();
    }

    function cambiarTop(nuevoTop) {
        topActual = nuevoTop;
        $('#lbl-top-actual').text(nuevoTop === 0 ? 'Todos' : nuevoTop);
        $('.item-top').removeClass('active');
        $(event.target).addClass('active');
        aplicarFiltros();
    }

    function ordenarTabla(idTabla, colIdx, esNumerico) {
        var table = document.getElementById(idTabla);
        var tbody = table.querySelector('tbody');
        var rows = Array.from(tbody.querySelectorAll('tr:not(#fila-vacia)'));

        if (sortColIdx === colIdx) {
            sortAsc = !sortAsc;
        } else {
            sortColIdx = colIdx;
            sortAsc = true;
        }

        $('#' + idTabla + ' .sort-icon').removeClass('bi-arrow-down bi-arrow-up text-primary').addClass('bi-arrow-down-up opacity-50');
        var th = $('#' + idTabla + ' thead th').eq(colIdx);
        var icon = th.find('.sort-icon');
        icon.removeClass('bi-arrow-down-up opacity-50').addClass(sortAsc ? 'bi-arrow-up text-primary' : 'bi-arrow-down text-primary');

        rows.sort(function (a, b) {
            var valA = a.children[colIdx].innerText.trim();
            var valB = b.children[colIdx].innerText.trim();

            if (esNumerico) {
                var numA = parseFloat(valA.replace(/[^0-9.-]/g, '')) || 0;
                var numB = parseFloat(valB.replace(/[^0-9.-]/g, '')) || 0;
                return sortAsc ? (numA - numB) : (numB - numA);
            } else {
                return sortAsc ? valA.localeCompare(valB) : valB.localeCompare(valA);
            }
        });

        rows.forEach(function (r) { tbody.appendChild(r); });
        aplicarFiltros();
    }

    function abrirModalCrear() {
        $('#form-hora')[0].reset();
        $('#hora-id').val(0);
        $('#grupo-codigo-hora').hide();
        $('#modal-titulo').text('Nueva Hora Remunerativa');
        $('#hora-var-calc').val('');
        $('#hora-estado').val('A');
        formInitialState = $('#form-hora').serialize();
        actualizarEstadoBotonGuardar();
        var modal = new bootstrap.Modal(document.getElementById('modal-crud-hora'));
        modal.show();
        setTimeout(function () { $('#hora-nombre').focus(); }, 400);
    }

    function abrirModalEditar(id) {
        $.get('/RH/HoraRemunerativa/Obtener/' + id, function (res) {
            if (res.success && res.data) {
                var d = res.data;
                $('#hora-id').val(d.id);
                $('#hora-codigo').val(d.codigo);
                $('#grupo-codigo-hora').show();
                $('#hora-nombre').val(d.nombre);
                $('#hora-abrev').val(d.abreviatura);
                $('#hora-var-calc').val(d.variableCalculoId);
                $('#hora-estado').val(d.estado);
                $('#modal-titulo').text('Editar Hora Remunerativa (' + d.codigo + ')');
                formInitialState = $('#form-hora').serialize();
                actualizarEstadoBotonGuardar();
                var modal = new bootstrap.Modal(document.getElementById('modal-crud-hora'));
                modal.show();
                setTimeout(function () { $('#hora-nombre').focus(); }, 400);
            } else {
                Swal.fire('Error', res.message || 'No se pudo cargar la información de la hora.', 'error');
            }
        }).fail(function () {
            Swal.fire('Error', 'Error al comunicar con el servidor.', 'error');
        });
    }

    function guardarHora(e) {
        e.preventDefault();
        var $btn = $('#btn-guardar-hora');
        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Guardando...');

        $.ajax({
            url: '/RH/HoraRemunerativa/Guardar',
            type: 'POST',
            data: $('#form-hora').serialize(),
            success: function (res) {
                if (res.success) {
                    bootstrap.Modal.getInstance(document.getElementById('modal-crud-hora')).hide();
                    Swal.fire({
                        icon: 'success',
                        title: 'Éxito',
                        text: res.message,
                        timer: 1500,
                        showConfirmButton: false
                    }).then(function () {
                        location.reload();
                    });
                } else {
                    Swal.fire('Atención', res.message, 'warning');
                    $btn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>Guardar Hora');
                }
            },
            error: function () {
                Swal.fire('Error', 'Ocurrió un error al guardar la hora remunerativa.', 'error');
                $btn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>Guardar Hora');
            }
        });
    }

    function cambiarEstado(id, estadoActual, nombre) {
        var accion = estadoActual === 'A' ? 'desactivar' : 'activar';
        Swal.fire({
            title: '¿Confirmar acción?',
            text: '¿Desea ' + accion + ' la hora remunerativa "' + nombre + '"?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: estadoActual === 'A' ? '#dc3545' : '#198754',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Sí, ' + accion,
            cancelButtonText: 'Cancelar'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.post('/RH/HoraRemunerativa/CambiarEstado/' + id, function (res) {
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Actualizado',
                            text: res.message,
                            timer: 1500,
                            showConfirmButton: false
                        }).then(function () {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                }).fail(function () {
                    Swal.fire('Error', 'No se pudo cambiar el estado.', 'error');
                });
            }
        });
    }

    $(document).ready(function () {
        aplicarFiltros();
    });
</script>
}
