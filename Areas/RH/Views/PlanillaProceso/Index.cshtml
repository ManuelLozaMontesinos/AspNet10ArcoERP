@addTagHelper *, AspNet10ArcoERP
@model AspNet10ArcoERP.Models.PlanillaProcesoPageModel
@{
    ViewData["Title"]="Procesos de planilla";
    string search=ViewBag.Search as string ?? "";
    int? mes=ViewBag.Mes as int?;
    int? anio=ViewBag.Anio as int?;
    bool puedeEscribir=ViewBag.PuedeEscribir is true;
}
<div class="app-content-header py-3 border-bottom"><div class="container-fluid"><div class="row align-items-center g-3">
    <div class="col"><h3 class="mb-0 fw-bold d-flex align-items-center"><i class="bi bi-calendar2-check me-2 text-primary"></i>Procesos de planilla</h3><small class="text-muted">Procesos y remuneraciones de la sede seleccionada. Período @Model.PeriodoAnio.</small></div>
    @if(puedeEscribir){<div class="col-auto"><button type="button" class="btn btn-primary shadow-sm" id="createProcess"><i class="bi bi-plus-circle-fill me-1"></i>Nuevo proceso</button></div>}
</div></div></div>
<div class="app-content py-4 erp-listing"><div class="container-fluid">
    <div class="alert alert-info" role="status"><i class="bi bi-info-circle me-2"></i>El cálculo de remuneraciones no está disponible en esta versión. Puede consultar los resultados existentes. El estado abierto o cerrado es independiente del cálculo.</div>
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="card-body py-2 px-3 erp-filter-bar">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <form method="get" class="d-flex flex-wrap align-items-center gap-2 m-0">
                <input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="dir" value="@Model.Dir" /><input type="hidden" name="top" value="@Model.PageSize" />
                @if(anio.HasValue){<input type="hidden" name="anio" value="@anio" />}
                <div class="input-group input-group-sm listing-search">
                    <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input id="search" name="search" value="@search" maxlength="150" class="form-control border-start-0" placeholder="Buscar por nombre de planilla..." aria-label="Buscar planilla" />
                    <button type="submit" class="btn btn-outline-primary">Buscar</button>
                    <a asp-action="Index" asp-route-top="@Model.PageSize" asp-route-sort="@Model.Sort" asp-route-dir="@Model.Dir" class="btn btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
                </div>
                <div class="input-group input-group-sm w-auto"><span class="input-group-text bg-body-tertiary"><i class="bi bi-calendar-month"></i></span><select id="mes" name="mes" class="form-select form-select-sm" aria-label="Mes del proceso"><option value="">Cualquier mes</option>@foreach(var item in Model.Meses){<option value="@item.Id" selected="@(mes==item.Id)">@item.Nombre</option>}</select></div>
            </form>
            <partial name="_ListadoControles" model="Model" />
        </div>
    </div></div>
    <div class="card border-0 shadow-sm rounded-3 mb-3">
        <div class="table-responsive table-scroll"><table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
            <thead class="table-header-custom bg-body-tertiary border-bottom"><tr>
                <th erp-sort="id" erp-numeric="true" class="text-center">ID</th>
                <th erp-sort="planilla">Planilla</th><th erp-sort="mes" erp-numeric="true">Mes</th><th erp-sort="numero" erp-numeric="true">Nº proceso</th>
                <th erp-sort="desde">Desde</th><th erp-sort="hasta">Hasta</th><th erp-sort="moneda">Moneda</th><th erp-sort="estado">Estado</th>
                <th erp-sort="trabajadores" erp-numeric="true" class="text-end">Trabajadores</th><th erp-sort="neto" erp-numeric="true" class="text-end">Neto</th><th class="listing-options">Opciones</th>
            </tr></thead>
            <tbody>
                @if(Model.Items.Count==0){<tr><td colspan="11" class="text-center text-muted py-5"><i class="bi bi-inbox fs-1 d-block mb-2"></i>No se encontraron procesos en el período y la sede seleccionados.</td></tr>}
                @foreach(var item in Model.Items)
                {
                    <tr>
                        <td class="text-center font-monospace small text-muted">@item.Id</td>
                        <td class="fw-semibold">@item.PlanillaNombre<small class="d-block text-muted">@item.PeriRemuNombre</small></td>
                        <td>@item.MesNombre</td><td class="font-monospace">@item.ProcAnual</td>
                        <td class="text-nowrap">@item.FechaDesde.ToString("dd/MM/yyyy")</td><td class="text-nowrap">@item.FechaHasta.ToString("dd/MM/yyyy")</td><td>@item.MonedaNombre</td>
                        <td><span class="badge @(item.EstadoPlanProceCodigo=="01"?"bg-success-subtle text-success border border-success-subtle":"bg-secondary-subtle text-body-secondary border")">@item.EstadoPlanProceNombre</span>@if(item.Estado!="A"){<span class="badge bg-danger-subtle text-danger border border-danger-subtle">Anulado</span>}</td>
                        <td class="text-end">@item.TotalTrabajadores</td><td class="text-end font-monospace">@item.TotalNeto.ToString("N2")</td>
                        <td class="listing-options">
                            <button type="button" class="btn btn-sm btn-outline-primary js-open-process" data-id="@item.Id" title="Abrir cabecera y resultados"><i class="bi bi-folder2-open"></i></button>
                            @if(puedeEscribir && item.Estado=="A" && item.EstadoPlanProceCodigo=="01"){<button type="button" class="btn btn-sm btn-outline-danger js-cancel-process" data-id="@item.Id" title="Anular proceso"><i class="bi bi-x-circle"></i></button>}
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
        <partial name="_ListadoPaginacion" model="Model" />
    </div>
</div></div>

<div class="modal fade" id="processModal" tabindex="-1" aria-labelledby="processTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <form id="processForm" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="processId" value="0" />
            <div class="modal-header sticky-top bg-body-tertiary">
                <div>
                    <h5 id="processTitle" class="modal-title fw-bold">Proceso de planilla</h5>
                    <small class="text-muted" id="processSubtitle">Período @Model.PeriodoAnio</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <fieldset id="processFields">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="processPlanilla" class="form-label">Planilla</label>
                            <select id="processPlanilla" name="PlanillaId" class="form-select" required>
                                <option value="">Seleccione...</option>
                                @foreach (var item in Model.Planillas) { <option value="@item.Id">@item.Nombre</option> }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="processMonth" class="form-label">Mes</label>
                            <select id="processMonth" name="MesId" class="form-select" required>
                                <option value="">Seleccione...</option>
                                @foreach (var item in Model.Meses) { <option value="@item.Id">@item.Nombre</option> }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="processNumber" class="form-label">Nº de proceso</label>
                            <input id="processNumber" name="ProcAnual" class="form-control" type="number" min="1" max="32767" step="1" value="1" required />
                        </div>
                        <div class="col-md-4">
                            <label for="processPeriodicity" class="form-label">Período de pago</label>
                            <select id="processPeriodicity" name="PeriRemuId" class="form-select" required>
                                <option value="">Seleccione...</option>
                                @foreach (var item in Model.Periodicidades) { <option value="@item.Id">@item.Nombre</option> }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="processCurrency" class="form-label">Moneda</label>
                            <select id="processCurrency" name="MonedaId" class="form-select" required>
                                <option value="">Seleccione...</option>
                                @foreach (var item in Model.Monedas) { <option value="@item.Id">@item.Nombre</option> }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="processExchange" class="form-label">Tipo de cambio</label>
                            <input id="processExchange" name="MontoTipoCambio" class="form-control" type="number" min="0.0001" max="99999999.9999" step="0.0001" value="1" required />
                        </div>
                        <div class="col-md-6">
                            <label for="processFrom" class="form-label">Fecha de inicio</label>
                            <input id="processFrom" name="FechaDesde" class="form-control" type="date" min="1753-01-01" max="9999-12-31" required />
                        </div>
                        <div class="col-md-6">
                            <label for="processTo" class="form-label">Fecha de fin</label>
                            <input id="processTo" name="FechaHasta" class="form-control" type="date" min="1753-01-01" max="9999-12-31" required />
                        </div>
                    </div>
                    <p class="small text-body-secondary mb-3">La planilla, el mes, el número de proceso y el período de pago se conservan después del alta.</p>
                </fieldset>
                <section id="calculationSection" class="d-none border-top pt-3" aria-labelledby="calculationTitle">
                    <h6 id="calculationTitle">Resultados existentes</h6>
                    <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                        <div style="min-width:260px;flex:1 1 320px">
                            <label for="detailSearch" class="form-label small">Buscar trabajador o concepto</label>
                            <input id="detailSearch" class="form-control" placeholder="Nombre, documento o concepto..." />
                        </div>
                        <div>
                            <label for="detailSize" class="form-label small">Por página</label>
                            <select id="detailSize" class="form-select">
                                @foreach (var size in new[] { 25, 50, 100, 500 }) { <option value="@size">@size</option> }
                            </select>
                        </div>
                        <button id="loadDetails" type="button" class="btn btn-outline-primary"><i class="bi bi-arrow-clockwise me-1"></i>Cargar resultados</button>
                    </div>
                    <div class="table-responsive border rounded process-details">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead class="sticky-top bg-body-tertiary"><tr><th>Trabajador</th><th>Concepto</th><th>Tipo</th><th class="text-end">Horas</th><th class="text-end">Subtotal</th><th class="text-end">Monto</th></tr></thead>
                            <tbody id="detailBody"></tbody>
                        </table>
                    </div>
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2">
                        <span id="detailCount" class="small text-muted" role="status"></span>
                        <div class="btn-group btn-group-sm">
                            <button type="button" id="detailPrevious" class="btn btn-outline-secondary">Anterior</button>
                            <button type="button" id="detailNext" class="btn btn-outline-secondary">Siguiente</button>
                        </div>
                    </div>
                    <p id="detailNet" class="small text-end mt-2 mb-0"></p>
                </section>
            </div>
            <div class="modal-footer sticky-bottom bg-body-tertiary">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="submit" class="btn btn-primary" id="saveProcess"><i class="bi bi-check2-circle me-1"></i>Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <style>
        #processModal .process-details { max-height:360px; overflow:auto; scrollbar-width:thin; }
    </style>
    <script id="processConfig" type="application/json">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            getUrl = Url.Action("Obtener"), detailUrl = Url.Action("DetalleCalculo"),
            saveUrl = Url.Action("Guardar"), cancelUrl = Url.Action("Anular"),
            canWrite = puedeEscribir, year = Model.PeriodoAnio, localCurrencyId = Model.MonedaLocalId
        }))
    </script>
    <script src="~/js/planilla-proceso.js" asp-append-version="true"></script>
}
