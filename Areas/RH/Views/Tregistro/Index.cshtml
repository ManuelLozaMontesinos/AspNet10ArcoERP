@model TRegistroExportModel
@{
    ViewData["Title"] = "Generador T-Registro SUNAT";
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-cloud-arrow-down-fill text-success me-2"></i>Generador T-Registro SUNAT
                </h3>
                <small class="text-muted" data-erp-list-summary>Estructura de importación para el aplicativo SUNAT T-Registro · @ViewBag.SedeNombre</small>
            </div>
            <div class="col-auto d-flex align-items-center gap-2">
                <a asp-action="DescargarEstructura" class="btn btn-primary btn-sm shadow-sm">
                    <i class="bi bi-file-earmark-arrow-down-fill me-1"></i>Descargar Archivo Estructurado (.TXT)
                </a>
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4 erp-listing">
    <div class="container-fluid">
        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body p-3 bg-light rounded-3 d-flex justify-content-between align-items-center">
                <div>
                    <span class="fw-bold">Período Fiscal:</span> @Model.Periodo
                    <span class="mx-3 text-muted">|</span>
                    <span class="fw-bold">Total Colaboradores en Registro:</span> @Model.TotalTrabajadores
                </div>
                <div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                        <i class="bi bi-check-circle-fill me-1"></i>Estructura Validada SUNAT
                    </span>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-sm">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Colaborador</th>
                            <th>Tipo Doc</th>
                            <th>N° Documento</th>
                            <th>Modalidad Contrato</th>
                            <th>Fecha Ingreso</th>
                            <th>Cargo / Ocupación</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Trabajadores.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-1"></i>No hay colaboradores para el T-Registro.
                                </td>
                            </tr>
                        }
                        @foreach (var t in Model.Trabajadores)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@t.NombreCompleto</td>
                                <td><span class="badge bg-light text-dark border">DNI</span></td>
                                <td class="font-monospace">@t.NumeroDocumento</td>
                                <td><span class="badge bg-light text-secondary border">@t.TipoContratoCodigo - @t.TipoContratoNombre</span></td>
                                <td>@(t.FechaIngreso?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td>@t.Cargo</td>
                                <td><span class="badge bg-success">Activo</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

