@addTagHelper *, AspNet10ArcoERP
@model AspNet10ArcoERP.Models.PlanillaPageModel
@{
    ViewData["Title"]="Planillas";
    string search=ViewBag.Search as string ?? "";
    string estado=ViewBag.Estado as string ?? "";
    bool canWrite=ViewBag.PuedeEscribir is true;
}
<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-0 fw-bold d-flex align-items-center"><i class="bi bi-file-earmark-spreadsheet text-primary me-2"></i>Planillas</h3>
                <small class="text-muted">Tipos de planilla y secuencia de conceptos remunerativos por categoría laboral.</small>
            </div>
            @if(canWrite)
            {
                <div class="col-auto"><button type="button" id="newPayroll" class="btn btn-primary shadow-sm"><i class="bi bi-plus-circle-fill me-1"></i>Nueva planilla</button></div>
            }
        </div>
    </div>
</div>
<div class="app-content py-4 erp-listing">
    <div class="container-fluid">
        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3 erp-filter-bar">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <form method="get" class="d-flex flex-wrap align-items-center gap-2 m-0">
                        <input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="dir" value="@Model.Dir" /><input type="hidden" name="top" value="@Model.PageSize" />
                        <div class="input-group input-group-sm listing-search">
                            <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input name="search" value="@search" maxlength="150" class="form-control border-start-0" placeholder="Buscar por nombre o tipo de trabajador..." aria-label="Buscar planilla" />
                            <button type="submit" class="btn btn-outline-primary">Buscar</button>
                            <a asp-action="Index" asp-route-top="@Model.PageSize" asp-route-sort="@Model.Sort" asp-route-dir="@Model.Dir" class="btn btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
                        </div>
                        <div class="input-group input-group-sm w-auto"><span class="input-group-text bg-body-tertiary"><i class="bi bi-toggle-on"></i></span><select name="estado" class="form-select form-select-sm" aria-label="Estado de planilla">
                            <option value="">Todos los estados</option><option value="A" selected="@(estado=="A")">Activas</option><option value="I" selected="@(estado=="I")">Anuladas</option>
                        </select></div>
                    </form>
                    <partial name="_ListadoControles" model="Model" />
                </div>
            </div>
        </div>
        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="table-responsive table-scroll">
                <table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
                    <thead class="table-header-custom bg-body-tertiary border-bottom">
                        <tr>
                            <th erp-sort="id" erp-numeric="true" class="text-center">ID</th>
                            <th erp-sort="nombre">Nombre de la planilla</th>
                            <th erp-sort="trabajador">Tipo de trabajador</th>
                            <th erp-sort="procesos" erp-numeric="true" class="text-center">Procesos anuales</th>
                            <th erp-sort="estado" class="text-center">Estado</th>
                            <th class="listing-options">Opciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(Model.Items.Count==0){<tr><td colspan="6" class="text-center text-muted py-5"><i class="bi bi-inbox d-block fs-1 mb-2"></i>No se encontraron planillas.</td></tr>}
                        @foreach(var item in Model.Items)
                        {
                            <tr>
                                <td class="text-center font-monospace small text-muted">@item.Id</td>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td><span class="badge bg-info-subtle text-info border border-info-subtle">@item.TipoTrabajadorNombre</span></td>
                                <td class="text-center font-monospace">@item.ProcesoAnual</td>
                                <td class="text-center"><span class="badge @(item.Estado=="A"?"bg-success-subtle text-success border border-success-subtle":"bg-secondary-subtle text-body-secondary border")">@(item.Estado=="A"?"Activa":"Anulada")</span></td>
                                <td class="listing-options">
                                    <button type="button" class="btn btn-sm btn-outline-primary js-open-payroll" data-id="@item.Id" title="@(canWrite && item.Estado=="A"?"Editar cabecera y conceptos":"Consultar cabecera y conceptos")"><i class="bi bi-pencil-square"></i></button>
                                    @if(canWrite && item.Estado=="A"){<button type="button" class="btn btn-sm btn-outline-danger js-cancel-payroll" data-id="@item.Id" data-name="@item.Nombre" title="Anular planilla"><i class="bi bi-x-circle"></i></button>}
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_ListadoPaginacion" model="Model" />
        </div>
    </div>
</div>
<div class="modal fade" id="payrollModal" tabindex="-1" aria-labelledby="payrollTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <form id="payrollForm" class="modal-content" novalidate>
            @Html.AntiForgeryToken()
            <input name="Id" id="payrollId" type="hidden" value="0" />
            <div class="modal-header sticky-top bg-body-tertiary">
                <div><h5 class="modal-title fw-bold" id="payrollTitle">Planilla</h5><small class="text-muted">Cabecera y conceptos remunerativos</small></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <fieldset id="payrollFields">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6"><label for="payrollName" class="form-label">Nombre</label><input id="payrollName" name="Nombre" class="form-control" maxlength="150" required /></div>
                        <div class="col-md-4">
                            <label for="payrollWorker" class="form-label">Tipo de trabajador</label>
                            <select id="payrollWorker" name="TipoTrabajadorId" class="form-select" required>
                                <option value="">Seleccione...</option>@foreach(var item in Model.TiposTrabajador){<option value="@item.Id">@item.Nombre</option>}
                            </select>
                        </div>
                        <div class="col-md-2"><label for="payrollProcesses" class="form-label">Procesos anuales</label><input id="payrollProcesses" name="ProcesoAnual" type="number" min="1" max="32767" step="1" value="1" class="form-control" required /></div>
                    </div>
                </fieldset>
                <section class="border-top pt-3 erp-listing" aria-labelledby="payrollConceptTitle">
                    <h6 id="payrollConceptTitle">Conceptos remunerativos</h6>
                    <p id="payrollConceptHint" class="small text-muted">Guarde la cabecera para habilitar los conceptos.</p>
                    <fieldset id="conceptFields" disabled class="mb-3">
                        <input id="conceptId" type="hidden" value="0" />
                        <div class="row g-2 align-items-end">
                            <div class="col-md-7"><label for="payrollConcept" class="form-label small">Concepto</label>
                                <select id="payrollConcept" class="form-select">
                                    <option value="">Seleccione...</option>@foreach(var item in Model.ConceptosDisponibles){<option value="@item.Id">@item.Codigo · @item.Nombre</option>}
                                </select>
                            </div>
                            <div class="col-md-2"><label for="conceptOrder" class="form-label small">Secuencia</label><input id="conceptOrder" class="form-control" type="number" min="-32768" max="32767" step="1" value="0" /></div>
                            <div class="col-md-3 d-flex gap-2">
                                <button type="button" id="saveConcept" class="btn btn-outline-primary"><i class="bi bi-check2 me-1"></i>Agregar</button>
                                <button type="button" id="resetConcept" class="btn btn-outline-secondary" title="Cancelar edición del concepto"><i class="bi bi-x-lg"></i></button>
                            </div>
                        </div>
                    </fieldset>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <div class="input-group input-group-sm listing-search"><span class="input-group-text bg-body-tertiary"><i class="bi bi-search"></i></span><input id="conceptSearch" class="form-control" placeholder="Buscar concepto o tipo..." aria-label="Buscar conceptos" /></div>
                        <div class="d-flex align-items-center gap-2 ms-auto"><label for="conceptTop" class="small text-muted">Mostrando</label><select id="conceptTop" class="form-select form-select-sm w-auto">@foreach(var size in new[]{25,50,100,500}){<option value="@size">@size</option>}</select></div>
                    </div>
                    <div class="table-responsive border rounded table-scroll">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead class="table-header-custom bg-body-tertiary"><tr>
                                <th aria-sort="ascending" id="conceptOrderHeader"><button type="button" class="btn btn-sm p-0 fw-semibold text-body js-concept-sort" data-sort="orden">Secuencia <i class="bi bi-sort-numeric-down"></i></button></th>
                                <th aria-sort="none"><button type="button" class="btn btn-sm p-0 fw-semibold text-body js-concept-sort" data-sort="codigo">Código <i class="bi bi-arrow-down-up"></i></button></th>
                                <th aria-sort="none"><button type="button" class="btn btn-sm p-0 fw-semibold text-body js-concept-sort" data-sort="nombre">Concepto <i class="bi bi-arrow-down-up"></i></button></th>
                                <th aria-sort="none"><button type="button" class="btn btn-sm p-0 fw-semibold text-body js-concept-sort" data-sort="tipoNombre">Tipo <i class="bi bi-arrow-down-up"></i></button></th>
                                <th class="listing-options">Opciones</th>
                            </tr></thead>
                            <tbody id="conceptBody"><tr><td colspan="5" class="text-center text-muted py-4">Guarde o seleccione una planilla para consultar sus conceptos.</td></tr></tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between align-items-center gap-2 mt-2">
                        <span id="conceptCount" class="small text-muted" role="status"></span>
                        <div class="btn-group btn-group-sm"><button id="conceptPrevious" type="button" class="btn btn-outline-secondary" disabled>Anterior</button><button id="conceptNext" type="button" class="btn btn-outline-secondary" disabled>Siguiente</button></div>
                    </div>
                </section>
            </div>
            <div class="modal-footer sticky-bottom bg-body-tertiary">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="submit" id="savePayroll" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Guardar cabecera</button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <style>#payrollModal .table-scroll{max-height:320px;scrollbar-width:thin}</style>
    <script id="payrollConfig" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        getUrl=Url.Action("Obtener"), saveUrl=Url.Action("Guardar"), cancelUrl=Url.Action("Anular"),
        conceptsUrl=Url.Action("Conceptos"), saveConceptUrl=Url.Action("GuardarConcepto"), cancelConceptUrl=Url.Action("AnularConcepto"), canWrite
    }))</script>
    <script src="~/js/planilla.js" asp-append-version="true"></script>
}
