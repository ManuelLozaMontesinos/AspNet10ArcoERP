@model RutaProduccionPageModel
@{
    ViewData["Title"] = "Rutas de producción";
    bool canWrite = ViewBag.PuedeEscribir is true;
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-signpost-split text-primary me-2"></i>Rutas de producción
                </h3>
                <small class="text-muted">Catálogo de rutas y secuencia de subprocesos operativos</small>
            </div>
            <div class="col-auto">
                @if (canWrite)
                {
                    <button type="button" id="rp-new" class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-lg me-1"></i>Nueva ruta
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4 erp-listing">
    <div class="container-fluid">
        @if (Model.Errores.Count > 0)
        {
            <div class="alert alert-warning" role="alert">@string.Join(" ", Model.Errores)</div>
        }

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3 erp-filter-bar">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <form method="get" class="d-flex flex-wrap align-items-center gap-2 m-0">
                        <input type="hidden" name="top" value="@Model.PageSize" />
                        <input type="hidden" name="sort" value="@Model.Sort" />
                        <input type="hidden" name="dir" value="@Model.Dir" />

                        <div class="input-group input-group-sm listing-search">
                            <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input name="search" value="@Model.Search" maxlength="100" class="form-control border-start-0" placeholder="Nombre de la ruta..." aria-label="Buscar rutas" />
                            <button type="submit" class="btn btn-outline-primary">Buscar</button>
                            <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
                        </div>

                        <select name="estado" class="form-select form-select-sm w-auto" aria-label="Estado">
                            <option value="">Todos los estados</option>
                            <option value="A" selected="@(Model.Estado == "A")">Activos</option>
                            <option value="I" selected="@(Model.Estado == "I")">Anulados</option>
                        </select>
                    </form>
                    <partial name="_ListadoControles" model="Model" />
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="table-responsive table-scroll">
                <table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
                    <thead class="table-header-custom bg-body-tertiary border-bottom">
                        <tr>
                            <th erp-sort="nombre">Nombre de la ruta</th>
                            <th erp-sort="items" class="text-center" style="width: 140px;">Subprocesos</th>
                            <th erp-sort="estado" style="width: 120px;">Estado</th>
                            <th class="listing-options text-center" style="width: 130px;">Opciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">No se encontraron rutas de producción.</td>
                            </tr>
                        }
                        @foreach (var row in Model.Items)
                        {
                            <tr>
                                <td class="fw-medium">@row.Nombre</td>
                                <td class="text-center">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                        <i class="bi bi-diagram-3 me-1"></i>@row.CantidadSubprocesos
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(row.Estado == "A" ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-body-secondary border")">
                                        @(row.Estado == "A" ? "Activo" : "Anulado")
                                    </span>
                                </td>
                                <td class="listing-options text-center">
                                    <button type="button" class="btn btn-sm btn-outline-primary js-rp-view" data-id="@row.Id" title="Consultar ruta"><i class="bi bi-eye"></i></button>
                                    @if (canWrite && row.Estado == "A")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary js-rp-edit" data-id="@row.Id" title="Editar ruta"><i class="bi bi-pencil"></i></button>
                                        <button type="button" class="btn btn-sm btn-outline-danger js-rp-cancel" data-id="@row.Id" data-name="@row.Nombre" title="Anular ruta"><i class="bi bi-x-circle"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_ListadoPaginacion" model="Model" />
        </div>
    </div>
</div>

@* Modal de Edición de Ruta y Secuencia *@
<div class="modal fade" id="rp-modal" tabindex="-1" aria-labelledby="rp-title" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header sticky-top bg-body-tertiary">
                <h5 class="modal-title" id="rp-title">
                    <i class="bi bi-signpost-split me-2 text-primary"></i>Ruta de producción
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="rp-form">
                    <input type="hidden" name="ContextoId" value="@ViewBag.ContextoId" />
                    <input type="hidden" name="Id" value="0" />
                    <input type="hidden" name="Revision" />

                    <div class="mb-3">
                        <label for="rp-name" class="form-label fw-bold">Nombre de la ruta <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input id="rp-name" name="Nombre" class="form-control text-uppercase" maxlength="100" placeholder="Ej: RUTA GENERAL DE CORTE Y CANTO" required />
                            @if (canWrite)
                            {
                                <button id="rp-save" type="submit" class="btn btn-primary">
                                    <i class="bi bi-save me-1"></i>Guardar ruta
                                </button>
                            }
                        </div>
                    </div>
                </form>

                <section class="border-top pt-3 mt-3" id="rp-secuencia-section">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h6 class="fw-bold mb-0 text-secondary">
                            <i class="bi bi-list-ol me-1"></i>Secuencia de subprocesos
                        </h6>
                        <span id="rp-sub-count" class="badge bg-secondary-subtle text-secondary">0 subprocesos</span>
                    </div>
                    <p id="rp-note" class="small text-muted mb-3" role="status">
                        Guarde la ruta para agregar y ordenar sus subprocesos.
                    </p>

                    <div id="rp-panel" hidden>
                        @if (canWrite)
                        {
                            <div class="card border bg-body-tertiary p-3 mb-3">
                                <label for="rp-sub-select" class="form-label small fw-bold mb-1">Agregar subproceso operativo:</label>
                                <div class="input-group input-group-sm">
                                    <select id="rp-sub-select" class="form-select">
                                        <option value="">Seleccione un subproceso...</option>
                                    </select>
                                    <button id="rp-add-sub" type="button" class="btn btn-success" disabled>
                                        <i class="bi bi-plus-circle me-1"></i>Agregar a la ruta
                                    </button>
                                </div>
                            </div>
                        }

                        <div class="table-responsive border rounded-3">
                            <table class="table table-sm table-striped table-hover align-middle mb-0" id="rp-subs-table">
                                <thead class="table-header-custom bg-body-tertiary">
                                    <tr>
                                        <th class="text-center" style="width: 70px;">Orden</th>
                                        <th>Proceso</th>
                                        <th>Subproceso</th>
                                        <th class="text-center" style="width: 130px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="rp-subs-body">
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-3">No hay subprocesos en la secuencia.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            </div>
            <div class="modal-footer sticky-bottom bg-body-tertiary">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script id="ruta-config" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        canWrite,
        contextoId = ViewBag.ContextoId,
        urls = new {
            obtener = Url.Action("Obtener"),
            guardar = Url.Action("Guardar"),
            anular = Url.Action("Anular"),
            subprocesosDisponibles = Url.Action("SubprocesosDisponibles"),
            agregarSubproceso = Url.Action("AgregarSubproceso"),
            actualizarOrden = Url.Action("ActualizarOrden"),
            quitarSubproceso = Url.Action("QuitarSubproceso")
        }
    }))</script>
    <script src="~/js/ruta-produccion.js" asp-append-version="true"></script>
}

