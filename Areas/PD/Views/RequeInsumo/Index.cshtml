@model RequeInsumoPageModel
@{
    ViewData["Title"] = "Requerimiento de insumos";
    bool canWrite = ViewBag.PuedeEscribir == true;
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-box-seam-fill text-primary me-2"></i>Requerimiento de insumos
                </h3>
                <small class="text-muted" data-erp-list-summary>Despacho y control de insumos requeridos en producción · @ViewBag.SedeNombre</small>
            </div>
            <div class="col-auto d-flex align-items-center gap-2">
                <a asp-area="PD" asp-controller="OrdenProdu" asp-action="Index" class="btn btn-outline-secondary btn-sm shadow-sm">
                    <i class="bi bi-gear-wide-connected me-1"></i>Órdenes de Producción
                </a>
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4 erp-listing">
    <div class="container-fluid">
        @if (Model.Errores.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                <ul class="mb-0">
                    @foreach (var error in Model.Errores)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3 erp-filter-bar">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <form method="get" id="reque-filters" class="d-flex flex-wrap align-items-center gap-2 m-0">
                        <input type="hidden" name="top" value="@Model.PageSize" />
                        <input type="hidden" name="sort" value="@Model.Sort" />
                        <input type="hidden" name="dir" value="@Model.Dir" />

                        <div class="input-group input-group-sm listing-search">
                            <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input name="search" value="@Model.Search" class="form-control border-start-0" maxlength="150" placeholder="N° OP, Cotización, Cliente..." aria-label="Buscar requerimiento" />
                        </div>

                        <div class="input-group input-group-sm w-auto">
                            <span class="input-group-text bg-body-tertiary">Desde</span>
                            <input type="date" name="fechaDesde" value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" class="form-control" />
                        </div>

                        <div class="input-group input-group-sm w-auto">
                            <span class="input-group-text bg-body-tertiary">Hasta</span>
                            <input type="date" name="fechaHasta" value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" class="form-control" />
                        </div>

                        <select name="estadoDespachoId" class="form-select form-select-sm w-auto" aria-label="Estado Atención">
                            <option value="">Todo despacho</option>
                            @foreach (var est in Model.EstadosDespacho)
                            {
                                <option value="@est.Id" selected="@(Model.EstadoDespachoId == est.Id)">@est.Descripcion</option>
                            }
                        </select>

                        <div class="form-check form-check-inline form-switch ms-1 mb-0">
                            <input class="form-check-input" type="checkbox" name="mostrarAnulados" value="true" id="chk-anulados" @(Model.MostrarAnulados ? "checked" : "") onchange="this.form.submit()" />
                            <label class="form-check-label small" for="chk-anulados">Ver anulados</label>
                        </div>

                        <button type="submit" class="btn btn-outline-primary btn-sm">Buscar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
                    </form>

                    <partial name="_ListadoControles" model="Model" />
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 erp-table">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 100px;">N° OP</th>
                                <th style="width: 100px;">Fecha</th>
                                <th style="width: 100px;">#Pedido</th>
                                <th>Cliente</th>
                                <th>Vendedor</th>
                                <th style="width: 140px;">Estado Despacho</th>
                                <th>Obs. Despacho</th>
                                <th class="text-end" style="width: 120px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">
                                        <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                                        No se encontraron requerimientos de insumo con los filtros seleccionados.
                                    </td>
                                </tr>
                            }
                            @foreach (var item in Model.Items)
                            {
                                bool isAnulado = item.Estado == "I";
                                <tr class="@(isAnulado ? "table-danger text-muted" : "")">
                                    <td class="fw-bold font-monospace">@item.Codigo</td>
                                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.CotizacionCodigo))
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary font-monospace">@item.CotizacionCodigo</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-truncate" style="max-width: 260px;" title="@item.ClienteRazonSocial">@item.ClienteRazonSocial</div>
                                        <small class="text-muted">@item.ClienteDocumento</small>
                                    </td>
                                    <td>
                                        <small class="text-truncate d-inline-block" style="max-width: 140px;">@(item.VendedorNombre ?? "-")</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info border">@(item.EstadoDespachoNombre ?? "PENDIENTE")</span>
                                    </td>
                                    <td>
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 200px;">@(item.Comentarios ?? "-")</small>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <button type="button" class="btn btn-outline-primary btn-sm js-insumo-view" data-id="@item.Id" title="Ver Insumos">
                                            <i class="bi bi-box-seam"></i>
                                        </button>
                                        @if (canWrite && !isAnulado)
                                        {
                                            <button type="button" class="btn btn-outline-success btn-sm js-insumo-close" data-id="@item.Id" data-codigo="@item.Codigo" title="Cerrar Requerimiento">
                                                <i class="bi bi-check2-circle"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            @if (Model.PageCount > 1)
            {
                <div class="card-footer bg-transparent py-2 px-3 border-top">
                    <partial name="_ListadoPaginacion" model="Model" />
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Ver Insumos de la Orden -->
<div class="modal fade" id="modal-insumos" tabindex="-1" aria-labelledby="modalInsumosLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="modalInsumosLabel">
                    <i class="bi bi-box-seam text-primary me-2"></i>Insumos de la Orden
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Código</th>
                                <th>Descripción</th>
                                <th>Detalle</th>
                                <th class="text-end" style="width: 100px;">Cantidad</th>
                                <th class="text-center" style="width: 70px;">U.M.</th>
                            </tr>
                        </thead>
                        <tbody id="tbody-insumos">
                            <tr><td colspan="5" class="text-center text-muted py-3">Cargando...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Cerrar Requerimiento de Insumos -->
<div class="modal fade" id="modal-cerrar-insumo" tabindex="-1" aria-labelledby="modalCerrarLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="modalCerrarLabel">
                    <i class="bi bi-check2-circle text-success me-2"></i>Cerrar Requerimiento de Insumo
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="form-cerrar-insumo">
                    <input type="hidden" id="cerrar-op-id" name="ordenProduccionId" value="0" />

                    <div class="mb-3">
                        <label class="form-label small fw-bold">N° Orden de Producción</label>
                        <input type="text" id="cerrar-op-codigo" class="form-control form-control-sm font-monospace fw-bold" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Estado Despacho</label>
                        <select id="cerrar-estado-despacho" name="estadoDespachoId" class="form-select form-select-sm" required>
                            @foreach (var est in Model.EstadosDespacho)
                            {
                                <option value="@est.Id">@est.Descripcion</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Observación de Despacho</label>
                        <textarea id="cerrar-obs" name="observacion" rows="3" maxlength="150" class="form-control form-control-sm" placeholder="Observaciones del despacho de insumos..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success btn-sm text-white js-btn-save-cerrar" id="btn-save-cerrar">
                    <i class="bi bi-check-lg me-1"></i>Confirmar Cierre
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/reque-insumo.js" asp-append-version="true"></script>
}

