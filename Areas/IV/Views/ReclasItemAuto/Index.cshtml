@model ReclasItemAutoPageModel
@{
    ViewData["Title"] = "Autorización de reclasificación de items";
    bool canWrite = ViewBag.PuedeEscribir == true;
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-shield-check text-warning me-2"></i>Autorización de Reclasificación de Items
                </h3>
                <small class="text-muted" data-erp-list-summary>Bandeja de aprobación y control de conversiones de materiales · @ViewBag.SedeNombre</small>
            </div>
            <div class="col-auto d-flex align-items-center gap-2">
                <a asp-area="IV" asp-controller="ReclasItem" asp-action="Index" class="btn btn-outline-secondary btn-sm shadow-sm" title="Ir a reclasificación de items">
                    <i class="bi bi-arrow-repeat me-1"></i>Listado de Reclasificaciones
                </a>
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4 erp-listing">
    <div class="container-fluid">
        @if (Model.Errores.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                <ul class="mb-0">
                    @foreach (var error in Model.Errores)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3 erp-filter-bar">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <form method="get" id="rauto-filters" class="d-flex flex-wrap align-items-center gap-2 m-0">
                        <input type="hidden" name="top" value="@Model.PageSize" />
                        <input type="hidden" name="sort" value="@Model.Sort" />
                        <input type="hidden" name="dir" value="@Model.Dir" />

                        <div class="input-group input-group-sm listing-search">
                            <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input name="search" value="@Model.Search" class="form-control border-start-0" maxlength="150" placeholder="N° Reclasif, movimiento, cliente..." aria-label="Buscar reclasificación" />
                        </div>

                        <select name="almacenId" class="form-select form-select-sm w-auto" aria-label="Almacén">
                            <option value="">Almacén: Todos</option>
                            @foreach (var alm in Model.Almacenes)
                            {
                                <option value="@alm.Id" selected="@(Model.AlmacenId == alm.Id)">@alm.Nombre</option>
                            }
                        </select>

                        <div class="d-flex align-items-center gap-1">
                            <span class="small text-muted">Desde:</span>
                            <input type="date" name="fechaDesde" value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm w-auto" />
                            <span class="small text-muted">Hasta:</span>
                            <input type="date" name="fechaHasta" value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm w-auto" />
                        </div>

                        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i>Buscar</button>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
                    </form>
                    <partial name="_ListadoControles" model="Model" />
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="table-responsive table-scroll">
                <table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
                    <thead class="table-header-custom bg-body-tertiary border-bottom">
                        <tr>
                            <th erp-sort="codigo" style="width: 120px;">N° Reclasif.</th>
                            <th erp-sort="fecha" style="width: 105px;">Fecha</th>
                            <th erp-sort="almacen" style="width: 160px;">Almacén</th>
                            <th erp-sort="movimiento" style="width: 130px;">Movimiento</th>
                            <th erp-sort="cliente">Cliente / Proveedor</th>
                            <th class="text-center" style="width: 70px;">Items</th>
                            <th class="text-center" style="width: 130px;">Estado</th>
                            <th class="listing-options text-center" style="width: 130px;">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">No hay reclasificaciones pendientes de autorización.</td>
                            </tr>
                        }
                        @foreach (var row in Model.Items)
                        {
                            <tr>
                                <td class="font-monospace fw-bold text-primary">
                                    <i class="bi bi-tag me-1"></i>@row.Codigo
                                </td>
                                <td>@row.FechaTexto</td>
                                <td>
                                    <div class="fw-semibold">@row.AlmacenNombre</div>
                                </td>
                                <td>
                                    <span class="font-monospace fw-bold text-secondary">
                                        <i class="bi bi-box-arrow-right me-1"></i>@row.MovimientoAlmacenCodigo
                                    </span>
                                </td>
                                <td>
                                    <span class="small fw-medium">@row.ClienteProveedorNombre</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-body-secondary text-body fw-bold">@row.CantidadItems</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                        <i class="bi bi-clock me-1"></i>PENDIENTE
                                    </span>
                                </td>
                                <td class="listing-options text-center">
                                    <button type="button" class="btn btn-outline-primary btn-sm js-rauto-review" data-id="@row.Id" title="Revisar y Autorizar">
                                        <i class="bi bi-eye me-1"></i>Revisar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_ListadoPaginacion" model="Model" />
        </div>
    </div>
</div>

<!-- Modal Revisión y Autorización -->
<div class="modal fade" id="rauto-modal" tabindex="-1" aria-labelledby="rauto-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-body-tertiary">
                <div>
                    <h5 class="modal-title fw-bold" id="rauto-modal-title">Revisión de Reclasificación</h5>
                    <small id="rauto-modal-subtitle" class="text-muted"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="rauto-id" value="0" />
                <input type="hidden" id="rauto-revision" value="" />
                <input type="hidden" id="rauto-contexto-id" value="@ViewBag.PeriodoEmpresaSedeId" />

                <!-- Datos Resumen -->
                <div class="row g-2 mb-3 p-3 bg-light rounded-3 border">
                    <div class="col-sm-3">
                        <small class="text-muted d-block">Almacén</small>
                        <strong id="rauto-alm" class="text-body"></strong>
                    </div>
                    <div class="col-sm-3">
                        <small class="text-muted d-block">Movimiento Original</small>
                        <strong id="rauto-mov" class="text-primary font-monospace"></strong>
                    </div>
                    <div class="col-sm-3">
                        <small class="text-muted d-block">Cliente / Proveedor</small>
                        <span id="rauto-cliente" class="text-body small fw-medium"></span>
                    </div>
                    <div class="col-sm-3">
                        <small class="text-muted d-block">Fecha Reclasificación</small>
                        <span id="rauto-fecha" class="text-body font-monospace"></span>
                    </div>
                    <div class="col-12">
                        <small class="text-muted d-block">Observación / Justificación</small>
                        <span id="rauto-obs" class="text-muted fst-italic"></span>
                    </div>
                </div>

                <!-- Detalle de Productos -->
                <h6 class="fw-bold mb-2 d-flex align-items-center">
                    <i class="bi bi-arrow-repeat me-2 text-primary"></i>Productos y Reclasificaciones Asignadas
                </h6>
                <div class="table-responsive border rounded-3 mb-2" style="max-height: 320px;">
                    <table class="table table-sm table-striped align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th style="width: 110px;">Cód. Original</th>
                                <th>Producto Original</th>
                                <th class="text-center" style="width: 65px;">U.M.</th>
                                <th class="text-end" style="width: 100px;">Cant. Orig.</th>
                                <th style="width: 120px;">Cód. Reclasif.</th>
                                <th>Producto Destino</th>
                                <th class="text-center" style="width: 65px;">U.M.</th>
                                <th class="text-end" style="width: 105px;">Cant. Recl.</th>
                            </tr>
                        </thead>
                        <tbody id="rauto-items-tbody">
                            <tr><td colspan="8" class="text-center text-muted py-3">Cargando datos...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-body-tertiary justify-content-between">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                @if (canWrite)
                {
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-danger btn-sm js-rauto-reject">
                            <i class="bi bi-x-circle me-1"></i>Desaprobar
                        </button>
                        <button type="button" class="btn btn-success btn-sm shadow-sm js-rauto-approve">
                            <i class="bi bi-check-circle me-1"></i>Aprobar Reclasificación
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/reclas-item-auto.js" asp-append-version="true"></script>
}

