@model TransfeIngresoPageModel
@{
    ViewData["Title"] = "Recepciones de transferencias";
    bool canWrite = ViewBag.PuedeEscribir == true;
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-box-arrow-in-down text-primary me-2"></i>Transferencias entre Almacenes (Recepciones)
                </h3>
                <small class="text-muted" data-erp-list-summary>Recepción y registro de ingreso de mercadería en tránsito · @ViewBag.SedeNombre</small>
            </div>
            <div class="col-auto d-flex align-items-center gap-2">
                <a asp-area="IV" asp-controller="TransfeSalida" asp-action="Index" class="btn btn-outline-secondary btn-sm shadow-sm" title="Ver envíos de transferencias">
                    <i class="bi bi-arrow-left-right me-1"></i>Envíos (Salidas)
                </a>
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4 erp-listing">
    <div class="container-fluid">
        @if (Model.Errores.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                <ul class="mb-0">
                    @foreach (var error in Model.Errores)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3 erp-filter-bar">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <form method="get" id="ting-filters" class="d-flex flex-wrap align-items-center gap-2 m-0">
                        <input type="hidden" name="top" value="@Model.PageSize" />
                        <input type="hidden" name="sort" value="@Model.Sort" />
                        <input type="hidden" name="dir" value="@Model.Dir" />

                        <div class="input-group input-group-sm listing-search">
                            <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input name="search" value="@Model.Search" class="form-control border-start-0" maxlength="150" placeholder="N° Operación, G/R, almacén..." aria-label="Buscar transferencia" />
                        </div>

                        <select name="almacenOrigenId" class="form-select form-select-sm w-auto" aria-label="Almacén Origen">
                            <option value="">Origen: Todos</option>
                            @foreach (var alm in Model.AlmacenesOrigen)
                            {
                                <option value="@alm.Id" selected="@(Model.AlmacenOrigenId == alm.Id)">@alm.Nombre</option>
                            }
                        </select>

                        <select name="estadoMovimientoAlmacenId" class="form-select form-select-sm w-auto" aria-label="Estado">
                            <option value="">Todos los estados</option>
                            @foreach (var em in Model.EstadosMovimiento)
                            {
                                <option value="@em.Id" selected="@(Model.EstadoMovimientoAlmacenId == em.Id)">@em.Nombre</option>
                            }
                        </select>

                        <div class="d-flex align-items-center gap-1">
                            <span class="small text-muted">Desde:</span>
                            <input type="date" name="fechaDesde" value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm w-auto" />
                            <span class="small text-muted">Hasta:</span>
                            <input type="date" name="fechaHasta" value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm w-auto" />
                        </div>

                        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i>Buscar</button>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
                    </form>
                    <partial name="_ListadoControles" model="Model" />
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="table-responsive table-scroll">
                <table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
                    <thead class="table-header-custom bg-body-tertiary border-bottom">
                        <tr>
                            <th erp-sort="codigo" style="width: 110px;">N° Salida</th>
                            <th erp-sort="fecha" style="width: 105px;">Fecha Envío</th>
                            <th erp-sort="origen" style="width: 180px;">Almacén Origen</th>
                            <th erp-sort="destino" style="width: 180px;">Almacén Destino</th>
                            <th style="width: 140px;">Doc. Referencia</th>
                            <th class="text-center" style="width: 65px;" title="Items">Items</th>
                            <th erp-sort="total" class="text-end" style="width: 110px;">Total</th>
                            <th erp-sort="estado" class="text-center" style="width: 130px;">Estado</th>
                            <th class="listing-options">Opciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">No se encontraron transferencias para recepcionar con los filtros aplicados.</td>
                            </tr>
                        }
                        @foreach (var row in Model.Items)
                        {
                            <tr>
                                <td class="font-monospace fw-bold text-primary">
                                    <i class="bi bi-tag me-1"></i>@row.Codigo
                                </td>
                                <td>@row.FechaTexto</td>
                                <td>
                                    <div class="fw-semibold">@row.AlmacenOrigenNombre</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-success">
                                        <i class="bi bi-arrow-right-short"></i>@row.AlmacenDestinoNombre
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(row.NumeroGuiaRemision))
                                    {
                                        <div class="small"><span class="text-muted">G/R:</span> <strong class="font-monospace">@row.NumeroGuiaRemision</strong></div>
                                    }
                                    @if (!string.IsNullOrEmpty(row.SerieDocumento) || !string.IsNullOrEmpty(row.NumeroDocumento))
                                    {
                                        <div class="small text-muted font-monospace">Doc: @row.SerieDocumento-@row.NumeroDocumento</div>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-body-secondary text-body fw-bold">@row.CantidadItems</span>
                                </td>
                                <td class="text-end font-monospace fw-semibold">
                                    @row.MontoTotalTexto
                                </td>
                                <td class="text-center">
                                    @if (row.EsPendienteRecepcion)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                            <i class="bi bi-truck me-1"></i>EN TRÁNSITO
                                        </span>
                                    }
                                    else if (row.EsRecepcionado)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check2-circle me-1"></i>RECEPCIONADA
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">ANULADA</span>
                                    }
                                </td>
                                <td class="listing-options">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-secondary js-ting-view" data-id="@row.Id" title="Ver detalle de items">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        @if (canWrite && row.EsPendienteRecepcion)
                                        {
                                            <button type="button" class="btn btn-success js-ting-recep" data-id="@row.Id" data-codigo="@row.Codigo" data-revision="@row.Revision" data-contexto="@row.PeriodoEmpresaSedeId" title="Recepcionar en almacén">
                                                <i class="bi bi-box-arrow-in-down me-1"></i>Recepcionar
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_ListadoPaginacion" model="Model" />
        </div>
    </div>
</div>

<!-- Modal Recepción Transferencia -->
<div class="modal fade" id="ting-modal" tabindex="-1" aria-labelledby="ting-modal-title" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <div>
                    <h5 class="modal-title fw-bold" id="ting-modal-title">
                        <i class="bi bi-box-arrow-in-down me-2"></i>Recepcionar Transferencia de Almacén
                    </h5>
                    <small id="ting-modal-subtitle" class="text-white-50"></small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="ting-form" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="ting-id" value="0" />
                <input type="hidden" name="ContextoId" id="ting-contexto-id" value="@ViewBag.PeriodoEmpresaSedeId" />
                <input type="hidden" name="Revision" id="ting-revision" value="" />

                <div class="modal-body p-4">
                    <div class="alert alert-info d-flex align-items-center mb-3 py-2">
                        <i class="bi bi-info-circle fs-4 me-2"></i>
                        <span class="small">Al confirmar la recepción se generará automáticamente un <strong>Movimiento de Ingreso</strong> en el almacén de destino y se cerrará el tránsito de la transferencia.</span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold required">Fecha de Recepción en Almacén</label>
                            <input type="date" name="FechaRecepcion" id="ting-fecha" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Observación de Recepción</label>
                            <input type="text" name="Observacion" id="ting-obs" class="form-control" placeholder="Conforme / Revisión física..." maxlength="200" />
                        </div>
                    </div>

                    <h6 class="fw-bold border-bottom pb-2 mb-2"><i class="bi bi-boxes me-1"></i>Productos en Transferencia</h6>
                    <div class="table-responsive border rounded" style="max-height: 240px;">
                        <table class="table table-sm table-striped align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Código</th>
                                    <th>Descripción</th>
                                    <th class="text-center">U.M.</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end">Valor Unit.</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody id="ting-items-tbody">
                                <tr><td colspan="6" class="text-center text-muted py-3">Cargando productos...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    @if (canWrite)
                    {
                        <button type="submit" class="btn btn-success shadow-sm" id="btn-save-ting">
                            <i class="bi bi-check2-circle me-1"></i>Confirmar Recepción
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/transfe-ingreso.js" asp-append-version="true"></script>
}

