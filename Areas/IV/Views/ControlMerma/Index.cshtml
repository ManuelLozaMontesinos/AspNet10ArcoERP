@model ControlMermaPageModel
@{
    ViewData["Title"] = "Control de mermas";
    bool canWrite = ViewBag.PuedeEscribir == true;
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-trash3 text-danger me-2"></i>Control de Mermas de Almacén
                </h3>
                <small class="text-muted" data-erp-list-summary>Registro y ajuste de mermas por deterioro, evaporación o calibración · @ViewBag.SedeNombre</small>
            </div>
            <div class="col-auto d-flex align-items-center gap-2">
                <a asp-area="IV" asp-controller="ControlMermaAuto" asp-action="Index" class="btn btn-outline-secondary btn-sm shadow-sm" title="Ir a autorización de mermas">
                    <i class="bi bi-shield-check me-1"></i>Autorizaciones
                </a>
                @if (canWrite)
                {
                    <button type="button" class="btn btn-primary btn-sm shadow-sm js-merma-new">
                        <i class="bi bi-plus-lg me-1"></i>Nuevo Registro
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4 erp-listing">
    <div class="container-fluid">
        @if (Model.Errores.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                <ul class="mb-0">
                    @foreach (var error in Model.Errores)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3 erp-filter-bar">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <form method="get" id="merma-filters" class="d-flex flex-wrap align-items-center gap-2 m-0">
                        <input type="hidden" name="top" value="@Model.PageSize" />
                        <input type="hidden" name="sort" value="@Model.Sort" />
                        <input type="hidden" name="dir" value="@Model.Dir" />

                        <div class="input-group input-group-sm listing-search">
                            <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input name="search" value="@Model.Search" class="form-control border-start-0" maxlength="150" placeholder="N° Movimiento, observación..." aria-label="Buscar merma" />
                        </div>

                        <select name="tipoMovimientoAlmacenId" class="form-select form-select-sm w-auto" aria-label="Tipo">
                            <option value="">Tipo: Todos</option>
                            @foreach (var t in Model.TiposMovimiento)
                            {
                                <option value="@t.Id" selected="@(Model.TipoMovimientoAlmacenId == t.Id)">@t.Nombre</option>
                            }
                        </select>

                        <select name="almacenId" class="form-select form-select-sm w-auto" aria-label="Almacén">
                            <option value="">Almacén: Todos</option>
                            @foreach (var alm in Model.Almacenes)
                            {
                                <option value="@alm.Id" selected="@(Model.AlmacenId == alm.Id)">@alm.Nombre</option>
                            }
                        </select>

                        <select name="estadoAprobacionId" class="form-select form-select-sm w-auto" aria-label="Aprobación">
                            <option value="">Aprobación: Todos</option>
                            @foreach (var ea in Model.EstadosAprobacion)
                            {
                                <option value="@ea.Id" selected="@(Model.EstadoAprobacionId == ea.Id)">@ea.Nombre</option>
                            }
                        </select>

                        <div class="d-flex align-items-center gap-1">
                            <span class="small text-muted">Desde:</span>
                            <input type="date" name="fechaDesde" value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm w-auto" />
                            <span class="small text-muted">Hasta:</span>
                            <input type="date" name="fechaHasta" value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm w-auto" />
                        </div>

                        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i>Buscar</button>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
                    </form>
                    <partial name="_ListadoControles" model="Model" />
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="table-responsive table-scroll">
                <table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
                    <thead class="table-header-custom bg-body-tertiary border-bottom">
                        <tr>
                            <th erp-sort="codigo" style="width: 120px;">N° Operación</th>
                            <th erp-sort="fecha" style="width: 105px;">Fecha</th>
                            <th erp-sort="tipo" style="width: 140px;">Tipo Merma</th>
                            <th erp-sort="almacen" style="width: 170px;">Almacén</th>
                            <th>Observación</th>
                            <th class="text-center" style="width: 70px;">Items</th>
                            <th erp-sort="total" class="text-end" style="width: 110px;">Total</th>
                            <th erp-sort="aprobacion" class="text-center" style="width: 130px;">Aprobación</th>
                            <th class="listing-options">Opciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">No se encontraron registros de mermas con los filtros aplicados.</td>
                            </tr>
                        }
                        @foreach (var row in Model.Items)
                        {
                            <tr class="@(row.EsAnulado ? "text-decoration-line-through text-muted" : "")">
                                <td class="font-monospace fw-bold text-primary">
                                    <i class="bi bi-tag me-1"></i>@row.Codigo
                                </td>
                                <td>@row.FechaTexto</td>
                                <td>
                                    @if (row.EsIngreso)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-arrow-down-left me-1"></i>INGRESO (S07)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            <i class="bi bi-arrow-up-right me-1"></i>SALIDA (S08)
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold">@row.AlmacenNombre</div>
                                </td>
                                <td>
                                    <span class="text-muted small">@row.Observacion</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-body-secondary text-body fw-bold">@row.CantidadItems</span>
                                </td>
                                <td class="text-end font-monospace fw-semibold">
                                    @row.MontoTotalTexto
                                </td>
                                <td class="text-center">
                                    @if (row.EsPendienteAprobacion)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                            <i class="bi bi-clock me-1"></i>PENDIENTE
                                        </span>
                                    }
                                    else if (row.EsAprobado)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check2 me-1"></i>APROBADO
                                        </span>
                                    }
                                    else if (row.EsDesaprobado)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            <i class="bi bi-x-circle me-1"></i>DESAPROBADO
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">SIN ENVIAR</span>
                                    }
                                </td>
                                <td class="listing-options">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Exportar" asp-route-id="@row.Id" class="btn btn-outline-success" title="Descargar Excel">
                                            <i class="bi bi-file-earmark-excel"></i>
                                        </a>
                                        @if (canWrite && !row.EsAprobado && !row.EsAnulado)
                                        {
                                            <button type="button" class="btn btn-outline-primary js-merma-edit" data-id="@row.Id" title="Editar merma">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-warning js-merma-solicitar" data-id="@row.Id" data-codigo="@row.Codigo" data-revision="@row.Revision" data-contexto="@row.PeriodoEmpresaSedeId" title="Solicitar aprobación">
                                                <i class="bi bi-send"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger js-merma-anular" data-id="@row.Id" data-codigo="@row.Codigo" data-revision="@row.Revision" data-contexto="@row.PeriodoEmpresaSedeId" title="Anular merma">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_ListadoPaginacion" model="Model" />
        </div>
    </div>
</div>

<!-- Modal Principal Control Merma -->
<div class="modal fade" id="merma-modal" tabindex="-1" aria-labelledby="merma-modal-title" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-body-tertiary">
                <div>
                    <h5 class="modal-title fw-bold" id="merma-modal-title">Control de Merma</h5>
                    <small id="merma-modal-subtitle" class="text-muted"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-0">
                <ul class="nav nav-tabs px-3 pt-2 bg-body-tertiary border-bottom" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold" id="tab-merma-hdr" data-bs-toggle="tab" data-bs-target="#panel-merma-hdr" type="button" role="tab">
                            <i class="bi bi-info-circle me-1"></i>Datos del Movimiento
                        </button>
                    </li>
                    <li class="nav-item js-merma-tab-detail" role="presentation">
                        <button class="nav-link fw-semibold" id="tab-merma-items" data-bs-toggle="tab" data-bs-target="#panel-merma-items" type="button" role="tab">
                            <i class="bi bi-boxes me-1"></i>Items Afectados
                        </button>
                    </li>
                </ul>

                <div class="tab-content p-3">
                    <!-- Panel 1: Cabecera -->
                    <div class="tab-pane fade show active" id="panel-merma-hdr" role="tabpanel">
                        <form id="merma-form" class="row g-3">
                            <input type="hidden" name="Id" id="merma-id" value="0" />
                            <input type="hidden" name="ContextoId" id="merma-contexto-id" value="@ViewBag.PeriodoEmpresaSedeId" />
                            <input type="hidden" name="Revision" id="merma-revision" value="" />

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">N° Operación</label>
                                <input type="text" id="merma-codigo" class="form-control form-control-sm font-monospace fw-bold bg-body-tertiary" readonly placeholder="[Autogenerado]" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold required">Tipo de Movimiento</label>
                                <select name="TipoMovimientoAlmacenId" id="merma-tipo-id" class="form-select form-select-sm" required>
                                    <option value="1">Ingreso por Merma (S07)</option>
                                    <option value="2" selected>Salida por Merma (S08)</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold required">Fecha</label>
                                <input type="date" name="Fecha" id="merma-fecha" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold required">Almacén</label>
                                <select name="AlmacenId" id="merma-almacen-id" class="form-select form-select-sm" required>
                                    <option value="">-- Seleccionar --</option>
                                    @foreach (var alm in Model.Almacenes)
                                    {
                                        <option value="@alm.Id">@alm.Nombre</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-semibold">Observación / Causa de la Merma</label>
                                <textarea name="Observacion" id="merma-obs" class="form-control form-control-sm" rows="3" maxlength="400" placeholder="Detalle técnico de la merma, causa o justificación..."></textarea>
                            </div>

                            <div class="col-12 text-end pt-2 border-top">
                                <button type="button" class="btn btn-outline-secondary btn-sm me-2" data-bs-dismiss="modal">Cerrar</button>
                                @if (canWrite)
                                {
                                    <button type="submit" class="btn btn-primary btn-sm shadow-sm" id="btn-save-merma-hdr">
                                        <i class="bi bi-save me-1"></i>Guardar y Continuar a Items
                                    </button>
                                }
                            </div>
                        </form>
                    </div>

                    <!-- Panel 2: Detalle de Productos -->
                    <div class="tab-pane fade" id="panel-merma-items" role="tabpanel">
                        @if (canWrite)
                        {
                            <div class="card bg-body-tertiary border-0 rounded-3 p-3 mb-3">
                                <form id="merma-item-form" class="row g-2 align-items-end">
                                    <input type="hidden" name="Id" id="merma-item-id" value="0" />
                                    <input type="hidden" name="MovimientoAlmacenId" id="merma-item-mov-id" value="0" />
                                    <input type="hidden" name="ContextoId" id="merma-item-contexto-id" value="@ViewBag.PeriodoEmpresaSedeId" />
                                    <input type="hidden" name="ProductoId" id="merma-item-prd-id" value="" />

                                    <div class="col-md-6 position-relative">
                                        <label class="form-label small fw-semibold required">Producto / Material</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                                            <input type="text" id="merma-item-prd-search" class="form-control" placeholder="Buscar código o descripción..." autocomplete="off" />
                                        </div>
                                        <div id="merma-item-prd-results" class="list-group position-absolute shadow-lg d-none mt-1" style="z-index: 1060; width: 100%; max-height: 220px; overflow-y: auto;"></div>
                                        <div id="merma-item-prd-selected" class="mt-1 p-2 bg-white border rounded d-none">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <div>
                                                    <span class="badge bg-secondary font-monospace me-1" id="merma-item-prd-badge"></span>
                                                    <strong class="small" id="merma-item-prd-name"></strong>
                                                    <span class="text-muted small ms-1" id="merma-item-prd-um"></span>
                                                </div>
                                                <button type="button" class="btn btn-sm btn-link text-danger p-0 js-merma-clear-item-prd">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label small fw-semibold required">Cantidad</label>
                                        <input type="number" step="0.01" min="0.01" name="Cantidad" id="merma-item-cant" class="form-control form-control-sm text-end fw-bold" placeholder="0.00" required />
                                    </div>

                                    <div class="col-md-2">
                                        <label class="form-label small fw-semibold">Valor Unit. Estimado</label>
                                        <input type="number" step="0.0001" min="0" name="ValorUnitario" id="merma-item-val-u" class="form-control form-control-sm text-end" placeholder="0.0000" />
                                    </div>

                                    <div class="col-md-1">
                                        <button type="submit" class="btn btn-primary btn-sm w-100 shadow-sm" id="btn-save-merma-item" title="Agregar item">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        }

                        <div class="table-responsive border rounded-3 mb-2" style="max-height: 340px;">
                            <table class="table table-sm table-hover align-middle mb-0" id="merma-items-table">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 120px;">Código</th>
                                        <th>Descripción</th>
                                        <th class="text-center" style="width: 70px;">U.M.</th>
                                        <th class="text-end" style="width: 110px;">Cantidad</th>
                                        <th class="text-end" style="width: 110px;">Valor Unit.</th>
                                        <th class="text-end" style="width: 120px;">Total</th>
                                        <th class="text-end" style="width: 60px;"></th>
                                    </tr>
                                </thead>
                                <tbody id="merma-items-tbody">
                                    <tr><td colspan="7" class="text-center text-muted py-3">No hay productos registrados en esta merma.</td></tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded border">
                            <span class="text-muted small">Total de materiales: <strong id="merma-items-count">0</strong></span>
                            <div class="fw-bold">
                                <span>Total Merma: </span>
                                <span class="text-primary font-monospace fs-6" id="merma-items-total">S/ 0.00</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-body-tertiary">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/control-merma.js" asp-append-version="true"></script>
}

