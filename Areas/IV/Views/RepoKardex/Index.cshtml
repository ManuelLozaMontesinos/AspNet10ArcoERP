@model KardexUnidadPageModel
@{ ViewData["Title"] = Model.Titulo; }
<partial name="_ReporteCabecera" model="Model" />
<div class="app-content py-4 erp-listing"><div class="container-fluid">
    <partial name="_ReporteFiltros" model="Model" />
    <p class="small text-muted mb-3">El saldo acumula el saldo inicial y las entradas/salidas en orden cronológico. Se conserva aunque ordene la tabla por otra columna. La consulta hasta fecha comprende el mes contable de la fecha elegida, dentro del ejercicio seleccionado.</p>
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="table-responsive table-scroll"><table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
        <thead class="table-header-custom bg-body-tertiary border-bottom"><tr>
            <th erp-sort="codigo">Código</th><th erp-sort="producto">Producto</th><th erp-sort="unidad">U.M.</th><th erp-sort="fecha">Fecha</th><th erp-sort="operacion">Operación</th><th erp-sort="tipo">Tipo</th><th erp-sort="transaccion">Transacción</th>
            <th erp-sort="ingreso" erp-numeric="true" class="text-end">Ingreso</th><th erp-sort="salida" erp-numeric="true" class="text-end">Salida</th><th erp-sort="saldo" erp-numeric="true" class="text-end">Saldo acumulado</th><th class="listing-options">Opciones</th>
        </tr></thead><tbody>
            @if (Model.Items.Count == 0) { <tr><td colspan="11" class="text-center text-muted py-4">@(Model.Consultada ? "No se encontraron registros para los filtros seleccionados." : "Seleccione almacén y período de consulta. Para anual, seleccione también un producto.")</td></tr> }
            @foreach (var item in Model.Items)
            {
                <tr class="@(item.OrdenRegistro == 0 ? "fw-semibold" : "")"><td class="font-monospace text-muted">@item.Codigo</td><td>@item.Producto</td><td>@item.Unidad</td><td class="text-nowrap">@item.Fecha.ToString("dd/MM/yyyy")</td><td class="font-monospace">@item.Operacion</td><td>@item.TipoMovimiento</td><td>@item.Transaccion</td>
                    <td class="text-end">@item.Ingreso.ToString("N4")</td><td class="text-end">@item.Salida.ToString("N4")</td><td class="text-end @(item.Saldo < 0 ? "text-danger" : "")">@item.Saldo.ToString("N4")</td>
                    <td class="listing-options">@if (item.MovimientoId > 0) { <button type="button" class="btn btn-sm btn-outline-primary js-report-movement" data-id="@item.MovimientoId" title="Consultar movimiento"><i class="bi bi-eye"></i></button> } else { <span class="badge bg-secondary-subtle text-body-secondary">Inicial</span> }</td>
                </tr>
            }
        </tbody>
    </table></div><partial name="_ListadoPaginacion" model="Model" /></div>
</div></div>
<partial name="_ReporteModal" />
@section Scripts { <partial name="_ReporteScript" model="Model" /> }
