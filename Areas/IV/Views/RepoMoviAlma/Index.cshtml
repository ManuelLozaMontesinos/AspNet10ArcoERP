@model MovimientoReportePageModel
@{ ViewData["Title"] = Model.Titulo; }
<partial name="_ReporteCabecera" model="Model" />
<div class="app-content py-4 erp-listing"><div class="container-fluid">
    <partial name="_ReporteFiltros" model="Model" />
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="table-responsive table-scroll"><table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
        <thead class="table-header-custom bg-body-tertiary border-bottom"><tr>
            <th erp-sort="fecha">Fecha</th><th erp-sort="operacion">Operación</th><th erp-sort="tipo">Tipo</th><th erp-sort="codigo">Código</th><th erp-sort="producto">Producto</th><th erp-sort="unidad">U.M.</th>
            <th erp-sort="cantidad" erp-numeric="true" class="text-end">Cantidad</th><th erp-sort="valor" erp-numeric="true" class="text-end">Valor unit. ingreso</th><th erp-sort="tercero">Tercero</th><th erp-sort="solicitante">Solicitante</th>
            <th erp-sort="orden">O/C</th><th erp-sort="guia">Guía</th><th erp-sort="documento">Documento</th><th erp-sort="observacion">Observación</th><th class="listing-options">Opciones</th>
        </tr></thead><tbody>
            @if (Model.Items.Count == 0) { <tr><td colspan="15" class="text-center text-muted py-4">@(Model.Consultada ? "No se encontraron movimientos para los filtros seleccionados." : "Seleccione almacén, transacción y período para consultar.")</td></tr> }
            @foreach (var item in Model.Items)
            {
                <tr><td class="text-nowrap">@item.Fecha.ToString("dd/MM/yyyy")</td><td class="font-monospace">@item.Operacion</td><td>@item.TipoMovimiento</td><td class="font-monospace">@item.Codigo</td><td>@item.Producto</td><td>@item.Unidad</td><td class="text-end">@item.Cantidad.ToString("N4")</td><td class="text-end">@item.ValorUnitario.ToString("N4")</td>
                    <td>@item.Tercero</td><td>@item.Solicitante</td><td>@item.OrdenCompra</td><td>@item.Guia</td><td>@item.Documento</td><td class="text-truncate" style="max-width:240px" title="@item.Observacion">@item.Observacion</td>
                    <td class="listing-options"><button type="button" class="btn btn-sm btn-outline-primary js-report-movement" data-id="@item.MovimientoId" title="Consultar cabecera y productos"><i class="bi bi-eye"></i></button></td>
                </tr>
            }
        </tbody>
    </table></div><partial name="_ListadoPaginacion" model="Model" /></div>
</div></div>
<partial name="_ReporteModal" />
@section Scripts { <partial name="_ReporteScript" model="Model" /> }
