@model SaldoConsultaPageModel
@{ ViewData["Title"] = Model.Titulo; }
<partial name="_ReporteCabecera" model="Model" />
<div class="app-content py-4 erp-listing"><div class="container-fluid">
    <partial name="_ReporteFiltros" model="Model" />
    <p class="small text-muted mb-3">Disponible = físico − reserva. Las columnas de almacén muestran cantidades físicas; el detalle incluye los almacenes inactivos que tengan saldos.</p>
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="table-responsive table-scroll"><table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
        <thead class="table-header-custom bg-body-tertiary border-bottom"><tr>
            <th erp-sort="codigo">Código</th><th erp-sort="descripcion">Descripción</th><th erp-sort="referencia">Referencia</th><th erp-sort="unidad">U.M.</th>
            <th erp-sort="disponible" erp-numeric="true" class="text-end">Disponible</th><th erp-sort="reserva" erp-numeric="true" class="text-end">Reserva</th><th erp-sort="fisico" erp-numeric="true" class="text-end">Físico</th>
            @foreach (var warehouse in Model.Almacenes) { <th erp-sort="@("almacen_" + warehouse.Id)" erp-numeric="true" class="text-end" title="@warehouse.Nombre">@(string.IsNullOrWhiteSpace(warehouse.Codigo) ? warehouse.Nombre : warehouse.Codigo)</th> }
            <th class="listing-options">Opciones</th>
        </tr></thead><tbody>
            @if (Model.Items.Count == 0) { <tr><td colspan="@(8 + Model.Almacenes.Count)" class="text-center text-muted py-4">No se encontraron saldos para los filtros seleccionados.</td></tr> }
            @foreach (var item in Model.Items)
            {
                <tr><td class="font-monospace text-muted">@item.Codigo</td><td class="fw-semibold">@item.Descripcion</td><td>@item.Referencia</td><td>@item.Unidad</td>
                    <td class="text-end fw-semibold @(item.Disponible < 0 ? "text-danger" : "")">@item.Disponible.ToString("N4")</td><td class="text-end">@item.Reserva.ToString("N4")</td><td class="text-end">@item.Fisico.ToString("N4")</td>
                    @foreach (var warehouse in Model.Almacenes) { <td class="text-end">@item.PorAlmacen.GetValueOrDefault(warehouse.Id).ToString("N4")</td> }
                    <td class="listing-options"><button type="button" class="btn btn-sm btn-outline-primary js-report-saldo" data-product-id="@item.ProductoId" data-label="@item.Codigo · @item.Descripcion" title="Ver composición por almacén"><i class="bi bi-list-ul"></i></button></td>
                </tr>
            }
        </tbody>
    </table></div><partial name="_ListadoPaginacion" model="Model" /></div>
</div></div>
<partial name="_ReporteModal" />
@section Scripts { <partial name="_ReporteScript" model="Model" /> }
