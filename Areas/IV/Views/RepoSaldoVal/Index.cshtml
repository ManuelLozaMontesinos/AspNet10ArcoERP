@model SaldoValoradoPageModel
@{ ViewData["Title"] = Model.Titulo; }
<partial name="_ReporteCabecera" model="Model" />
<div class="app-content py-4 erp-listing"><div class="container-fluid">
    <partial name="_SaldoFiltros" model="Model" />
    <p class="small text-muted">Valores consolidados registrados por sede, para todas las sedes de la empresa. Saldo disponible = anterior + ingresos − salidas − reserva. Los costos unitarios se muestran con ocho decimales. Esta consulta no ejecuta una valorización.</p>
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="table-responsive table-scroll"><table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
        <thead class="table-header-custom bg-body-tertiary border-bottom"><tr><th erp-sort="sede">Sede</th><th erp-sort="codigo">Código</th><th erp-sort="producto">Producto</th><th erp-sort="unidad">U.M.</th><th erp-sort="anterior" erp-numeric="true" class="text-end">Anterior</th><th erp-sort="valoranterior" erp-numeric="true" class="text-end">Valor unit. anterior</th><th erp-sort="ingreso" erp-numeric="true" class="text-end">Ingresos</th><th erp-sort="salida" erp-numeric="true" class="text-end">Salidas</th><th erp-sort="reserva" erp-numeric="true" class="text-end">Reserva</th><th erp-sort="saldo" erp-numeric="true" class="text-end">Saldo disponible</th><th erp-sort="valor" erp-numeric="true" class="text-end">Valor unitario</th><th erp-sort="importe" erp-numeric="true" class="text-end">Importe del saldo</th><th class="listing-options">Opciones</th></tr></thead><tbody>
            @if (Model.Items.Count == 0) { <tr><td colspan="13" class="text-center text-muted py-4">@(Model.Consultada ? "No se encontraron saldos valorizados para los filtros seleccionados." : "Seleccione un mes contable y consulte los valores registrados.")</td></tr> }
            @foreach (var item in Model.Items) { <tr><td>@item.Sede</td><td class="font-monospace text-muted">@item.Codigo</td><td class="fw-semibold">@item.Producto</td><td>@item.Unidad</td><td class="text-end">@item.Anterior.ToString("N4")</td><td class="text-end">@item.ValorUnitarioAnterior.ToString("N8")</td><td class="text-end">@item.Ingreso.ToString("N4")</td><td class="text-end">@item.Salida.ToString("N4")</td><td class="text-end">@item.Reserva.ToString("N4")</td><td class="text-end">@item.Saldo.ToString("N4")</td><td class="text-end">@item.ValorUnitario.ToString("N8")</td><td class="text-end fw-semibold">@item.Importe.ToString("N4")</td><td class="listing-options"><button type="button" class="btn btn-sm btn-outline-primary" data-report-value="@item.Id" title="Consultar saldo y costos"><i class="bi bi-eye"></i></button></td></tr> }
        </tbody></table></div><partial name="_ListadoPaginacion" model="Model" /></div>
</div></div>
<partial name="_ReporteModal" />
@section Scripts { <partial name="_ReporteScript" model="Model" /> }
