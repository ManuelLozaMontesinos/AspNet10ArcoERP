@model InventarioReporteModel
<div class="card border-0 shadow-sm rounded-3 mb-3"><div class="card-body py-2 px-3 erp-filter-bar"><div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
    <form method="get" id="inventory-report-filters" class="d-flex flex-wrap align-items-center gap-2 m-0">
        <input type="hidden" name="consultar" value="true" /><input type="hidden" name="top" value="@Model.PageSize" /><input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="dir" value="@Model.Dir" />
        <div class="input-group input-group-sm listing-search"><span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span><input name="search" value="@Model.Filtro.Search" class="form-control border-start-0" maxlength="150" placeholder="Producto o código..." aria-label="Buscar por producto o código" /></div>
        @if (Model.Tipo == "saldo-unidades")
        {
            <select name="variante" id="report-variant" class="form-select form-select-sm w-auto" aria-label="Modalidad del reporte"><option value="detalle" selected="@(Model.Filtro.Variante == "detalle")">Detallado por almacén</option><option value="general" selected="@(Model.Filtro.Variante == "general")">Consolidado general</option><option value="almacenes" selected="@(Model.Filtro.Variante == "almacenes")">Consolidado por almacenes</option></select>
            <div class="input-group input-group-sm w-auto" data-unit-warehouse><span class="input-group-text bg-body-tertiary"><i class="bi bi-building"></i></span><select name="almacenId" id="report-warehouse" class="form-select" aria-label="Almacén" style="max-width:280px"><option value="">Seleccione almacén</option>@foreach (var item in Model.Almacenes) { <option value="@item.Id" selected="@(item.Id == Model.Filtro.AlmacenId)">@item.Nombre</option> }</select></div>
            <select name="modo" id="report-mode" class="form-select form-select-sm w-auto" aria-label="Periodicidad" data-unit-detail><option value="mes" selected="@(Model.Filtro.Modo == "mes")">Por mes</option><option value="dia" selected="@(Model.Filtro.Modo == "dia")">Al día</option></select>
            <select name="incluirReserva" id="report-reserve" class="form-select form-select-sm w-auto" aria-label="Tratamiento de reservas" data-unit-reserve><option value="true" selected="@(Model.Filtro.IncluirReserva == true)">Descontar reservas</option><option value="false" selected="@(Model.Filtro.IncluirReserva != true)">Sin descontar reservas</option></select>
        }
        else { <input type="hidden" name="modo" value="mes" /> }
        <div class="input-group input-group-sm w-auto" data-report-month><span class="input-group-text bg-body-tertiary"><i class="bi bi-calendar-month"></i></span><select name="mes" id="report-month" class="form-select" aria-label="Mes contable">@foreach (var item in Model.Meses) { <option value="@item.Id" selected="@(item.Id == Model.Filtro.Mes)">@item.Nombre</option> }</select></div>
        @if (Model.Tipo == "saldo-unidades") { <div class="input-group input-group-sm w-auto" data-report-date><span class="input-group-text bg-body-tertiary"><i class="bi bi-calendar3"></i></span><input type="date" name="fecha" id="report-date" value="@Model.Filtro.Fecha?.ToString("yyyy-MM-dd")" class="form-control" min="1900-01-01" max="9998-12-31" aria-label="Fecha del corte" /></div> }
        <input type="hidden" name="productoId" id="report-producto-id" value="@Model.Filtro.ProductoId" /><div class="input-group input-group-sm listing-search"><span class="input-group-text bg-body-tertiary"><i class="bi bi-box-seam"></i></span><input id="report-producto-name" value="@Model.ProductoNombre" class="form-control" placeholder="Todos los productos" aria-label="Producto seleccionado" readonly /><button type="button" class="btn btn-outline-primary" data-report-picker="producto" title="Buscar producto"><i class="bi bi-search"></i></button><button type="button" class="btn btn-outline-secondary" data-report-clear="producto" title="Limpiar producto"><i class="bi bi-x-lg"></i></button></div>
        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i>Consultar</button><a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
    </form><partial name="_ListadoControles" model="Model" />
</div></div></div>
@if (Model.Errores.Count > 0) { <div class="alert alert-warning" role="alert"><ul class="mb-0">@foreach (var error in Model.Errores) { <li>@error</li> }</ul></div> }
