@model InventarioProcesoPageModel
@{ bool write = ViewBag.PuedeEscribir == true; }
<div class="app-content-header py-3 border-bottom"><div class="container-fluid"><div class="row align-items-center g-3">
    <div class="col"><h3 class="mb-0 fw-bold d-flex align-items-center"><i class="bi @(Model.Tipo == "reproceso" ? "bi-arrow-repeat" : "bi-calendar-check") text-primary me-2"></i>@Model.Titulo</h3><small class="text-muted" data-erp-list-summary>@Model.Resumen</small></div>
    <div class="col-auto" data-erp-list-actions>
        @if (write && Model.Tipo == "reproceso")
        { <button type="button" class="btn btn-primary shadow-sm" data-inv-process="anual" disabled="@(!Model.AlmacenId.HasValue || Model.Errores.Count > 0)"><i class="bi bi-calendar-range me-1"></i>Reproceso anual</button> }
    </div>
</div></div></div>
<div class="app-content py-4 erp-listing"><div class="container-fluid">
    @if (Model.Errores.Count > 0) { <div class="alert alert-warning" role="alert">@foreach (var error in Model.Errores) { <p class="mb-0">@error</p> }</div> }
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="card-body py-2 px-3 erp-filter-bar"><div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <form method="get" id="inventory-process-filters" class="d-flex flex-wrap align-items-center gap-2 m-0">
            <input type="hidden" name="top" value="@Model.PageSize" /><input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="dir" value="@Model.Dir" />
            <div class="input-group input-group-sm listing-search"><span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span><input name="search" value="@Model.Search" maxlength="150" class="form-control border-start-0" placeholder="Buscar por mes..." aria-label="Buscar por mes contable" /></div>
            <div class="input-group input-group-sm w-auto"><span class="input-group-text bg-body-tertiary"><i class="bi bi-building"></i></span><select name="almacenId" class="form-select" aria-label="Almacén" required style="max-width:280px"><option value="">Seleccione almacén</option>
                @foreach (var warehouse in Model.Almacenes) { <option value="@warehouse.Id" selected="@(warehouse.Id == Model.AlmacenId)">@warehouse.Nombre</option> }
            </select></div>
            <select name="estado" class="form-select form-select-sm w-auto" aria-label="Estado del mes"><option value="">Todos los estados</option><option value="A" selected="@(Model.Estado == "A")">Abierto</option><option value="C" selected="@(Model.Estado == "C")">Cerrado</option></select>
            <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i>Buscar</button><a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
        </form><partial name="_ListadoControles" model="Model" />
    </div></div></div>
    @if (Model.Tipo == "reproceso") { <p class="small text-muted">El reproceso anual comprende enero hasta el mes actual. Confirme el almacén, ejercicio y meses en la preparación de la operación.</p> }
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="table-responsive table-scroll"><table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
        <thead class="table-header-custom bg-body-tertiary border-bottom"><tr><th erp-sort="mes">Mes contable</th><th erp-sort="fecha">Fecha de cierre</th><th erp-sort="estado">Estado</th><th erp-sort="posterior">Movimientos posteriores al cierre</th><th class="listing-options">Opciones</th></tr></thead><tbody>
            @if (Model.Items.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">@(Model.AlmacenId.HasValue ? "No se encontraron meses para los filtros seleccionados." : "Seleccione un almacén de la sede de trabajo para consultar sus meses.")</td></tr> }
            @foreach (var item in Model.Items)
            {
                <tr><td class="fw-semibold"><span class="font-monospace text-muted me-2">@item.MesCodigo</span>@item.MesNombre</td><td>@(item.FechaCierre?.ToString("dd/MM/yyyy") ?? "—")</td><td><span class="badge @(item.Estado == "A" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-body-secondary")">@item.EstadoNombre</span></td>
                    <td>@if (item.MovimientoPostCierre == "S") { <span class="badge bg-warning-subtle text-warning-emphasis">Sí · revisar saldos</span> } else { <span class="text-muted">No</span> }</td>
                    <td class="listing-options"><button type="button" class="btn btn-sm btn-outline-secondary" data-inv-process-detail="@item.Id" title="Consultar mes"><i class="bi bi-eye"></i></button>
                    @if (write)
                    {
                        if (Model.Tipo == "reproceso") { <button type="button" class="btn btn-sm btn-outline-primary" data-inv-process="reproceso" data-month="@item.MesContableId" disabled="@(!item.AdmiteReproceso)" title="@(item.AdmiteReproceso ? "Preparar reproceso mensual" : "El mes de cierre anual (13) no está disponible para este proceso")"><i class="bi bi-arrow-repeat"></i></button> }
                        else if (item.Estado != "A") { <button type="button" class="btn btn-sm btn-outline-success" data-inv-process="apertura" data-month="@item.MesContableId" title="Preparar apertura"><i class="bi bi-unlock"></i></button> }
                        else { <button type="button" class="btn btn-sm btn-outline-primary" data-inv-process="cierre" data-month="@item.MesContableId" disabled="@(!item.AdmiteReproceso)" title="@(item.AdmiteReproceso ? "Preparar cierre mensual" : "El mes de cierre anual (13) no está disponible para este proceso")"><i class="bi bi-lock"></i></button> }
                    }</td>
                </tr>
            }
        </tbody></table></div><partial name="_ListadoPaginacion" model="Model" /></div>
</div></div>
