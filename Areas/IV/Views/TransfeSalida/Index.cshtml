@model TransfeSalidaPageModel
@{
    ViewData["Title"] = "Transferencias de salida";
    bool canWrite = ViewBag.PuedeEscribir == true;
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-arrow-left-right text-primary me-2"></i>Transferencias entre Almacenes (Salidas)
                </h3>
                <small class="text-muted" data-erp-list-summary>Envíos físicos de existencias y control de tránsito · @ViewBag.SedeNombre</small>
            </div>
            <div class="col-auto d-flex align-items-center gap-2">
                <a asp-area="IV" asp-controller="TransfeIngreso" asp-action="Index" class="btn btn-outline-secondary btn-sm shadow-sm" title="Ver recepciones de transferencias">
                    <i class="bi bi-box-arrow-in-down me-1"></i>Recepcionar Transferencias
                </a>
                @if (canWrite)
                {
                    <button type="button" class="btn btn-primary btn-sm shadow-sm js-tsal-new">
                        <i class="bi bi-plus-lg me-1"></i>Nueva Transferencia
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4 erp-listing">
    <div class="container-fluid">
        @if (Model.Errores.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                <ul class="mb-0">
                    @foreach (var error in Model.Errores)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3 erp-filter-bar">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <form method="get" id="tsal-filters" class="d-flex flex-wrap align-items-center gap-2 m-0">
                        <input type="hidden" name="top" value="@Model.PageSize" />
                        <input type="hidden" name="sort" value="@Model.Sort" />
                        <input type="hidden" name="dir" value="@Model.Dir" />

                        <div class="input-group input-group-sm listing-search">
                            <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input name="search" value="@Model.Search" class="form-control border-start-0" maxlength="150" placeholder="N° Operación, G/R, almacén..." aria-label="Buscar transferencia" />
                        </div>

                        <select name="almacenId" class="form-select form-select-sm w-auto" aria-label="Almacén Origen">
                            <option value="">Origen: Todos</option>
                            @foreach (var alm in Model.Almacenes)
                            {
                                <option value="@alm.Id" selected="@(Model.AlmacenId == alm.Id)">@alm.Nombre</option>
                            }
                        </select>

                        <select name="almacenDestinoId" class="form-select form-select-sm w-auto" aria-label="Almacén Destino">
                            <option value="">Destino: Todos</option>
                            @foreach (var alm in Model.AlmacenesDestino)
                            {
                                <option value="@alm.Id" selected="@(Model.AlmacenDestinoId == alm.Id)">@alm.Nombre</option>
                            }
                        </select>

                        <select name="estadoMovimientoAlmacenId" class="form-select form-select-sm w-auto" aria-label="Estado">
                            <option value="">Todos los estados</option>
                            @foreach (var em in Model.EstadosMovimiento)
                            {
                                <option value="@em.Id" selected="@(Model.EstadoMovimientoAlmacenId == em.Id)">@em.Nombre</option>
                            }
                        </select>

                        <div class="d-flex align-items-center gap-1">
                            <span class="small text-muted">Desde:</span>
                            <input type="date" name="fechaDesde" value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm w-auto" />
                            <span class="small text-muted">Hasta:</span>
                            <input type="date" name="fechaHasta" value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm w-auto" />
                        </div>

                        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i>Buscar</button>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
                    </form>
                    <partial name="_ListadoControles" model="Model" />
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="table-responsive table-scroll">
                <table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
                    <thead class="table-header-custom bg-body-tertiary border-bottom">
                        <tr>
                            <th erp-sort="codigo" style="width: 110px;">N° Operación</th>
                            <th erp-sort="fecha" style="width: 105px;">Fecha</th>
                            <th erp-sort="almacen" style="width: 180px;">Almacén Origen</th>
                            <th erp-sort="destino" style="width: 180px;">Almacén Destino</th>
                            <th style="width: 140px;">Doc. Referencia</th>
                            <th class="text-center" style="width: 65px;" title="Items">Items</th>
                            <th erp-sort="total" class="text-end" style="width: 110px;">Total</th>
                            <th erp-sort="estado" class="text-center" style="width: 120px;">Estado</th>
                            <th class="listing-options">Opciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">No se encontraron transferencias con los filtros aplicados.</td>
                            </tr>
                        }
                        @foreach (var row in Model.Items)
                        {
                            <tr class="@(row.EsAnulado ? "text-decoration-line-through text-muted" : "")">
                                <td class="font-monospace fw-bold text-primary">
                                    <i class="bi bi-tag me-1"></i>@row.Codigo
                                </td>
                                <td>@row.FechaTexto</td>
                                <td>
                                    <div class="fw-semibold">@row.AlmacenNombre</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-info">
                                        <i class="bi bi-arrow-right-short"></i>@row.AlmacenDestinoNombre
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(row.NumeroGuiaRemision))
                                    {
                                        <div class="small"><span class="text-muted">G/R:</span> <strong class="font-monospace">@row.NumeroGuiaRemision</strong></div>
                                    }
                                    @if (!string.IsNullOrEmpty(row.DocumentoReferencialCompleto))
                                    {
                                        <div class="small text-muted font-monospace">Doc: @row.DocumentoReferencialCompleto</div>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-body-secondary text-body fw-bold">@row.CantidadItems</span>
                                </td>
                                <td class="text-end font-monospace fw-semibold">
                                    @row.MontoTotalTexto
                                </td>
                                <td class="text-center">
                                    @if (row.EsTransito)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                            <i class="bi bi-truck me-1"></i>EN TRÁNSITO
                                        </span>
                                    }
                                    else if (row.EsRecepcionado)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check2-circle me-1"></i>ENTREGADA
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">ANULADA</span>
                                    }
                                </td>
                                <td class="listing-options">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Exportar" asp-route-id="@row.Id" class="btn btn-outline-success" title="Descargar Excel">
                                            <i class="bi bi-file-earmark-excel"></i>
                                        </a>
                                        @if (canWrite && row.EsTransito)
                                        {
                                            <button type="button" class="btn btn-outline-primary js-tsal-edit" data-id="@row.Id" title="Editar transferencia">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger js-tsal-anular" data-id="@row.Id" data-codigo="@row.Codigo" data-revision="@row.Revision" data-contexto="@row.PeriodoEmpresaSedeId" title="Anular transferencia">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_ListadoPaginacion" model="Model" />
        </div>
    </div>
</div>

<!-- Modal Principal Transferencia Salida -->
<div class="modal fade" id="tsal-modal" tabindex="-1" aria-labelledby="tsal-modal-title" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-body-tertiary">
                <div>
                    <h5 class="modal-title fw-bold" id="tsal-modal-title">Transferencia entre Almacenes</h5>
                    <small id="tsal-modal-subtitle" class="text-muted"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-0">
                <ul class="nav nav-tabs px-3 pt-2 bg-body-tertiary border-bottom" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold" id="tab-tsal-hdr" data-bs-toggle="tab" data-bs-target="#panel-tsal-hdr" type="button" role="tab">
                            <i class="bi bi-info-circle me-1"></i>Datos de Envío
                        </button>
                    </li>
                    <li class="nav-item js-tsal-tab-detail" role="presentation">
                        <button class="nav-link fw-semibold" id="tab-tsal-items" data-bs-toggle="tab" data-bs-target="#panel-tsal-items" type="button" role="tab">
                            <i class="bi bi-boxes me-1"></i>Productos a Transferir
                        </button>
                    </li>
                </ul>

                <div class="tab-content p-3">
                    <!-- Panel 1: Cabecera -->
                    <div class="tab-pane fade show active" id="panel-tsal-hdr" role="tabpanel">
                        <form id="tsal-form" class="row g-3">
                            <input type="hidden" name="Id" id="tsal-id" value="0" />
                            <input type="hidden" name="ContextoId" id="tsal-contexto-id" value="@ViewBag.PeriodoEmpresaSedeId" />
                            <input type="hidden" name="Revision" id="tsal-revision" value="" />

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">N° Operación</label>
                                <input type="text" id="tsal-codigo" class="form-control form-control-sm font-monospace fw-bold bg-body-tertiary" readonly placeholder="[Autogenerado]" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold required">Fecha de Salida</label>
                                <input type="date" name="Fecha" id="tsal-fecha" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold required">Almacén Origen</label>
                                <select name="AlmacenId" id="tsal-almacen-id" class="form-select form-select-sm" required>
                                    <option value="">-- Seleccionar --</option>
                                    @foreach (var alm in Model.Almacenes)
                                    {
                                        <option value="@alm.Id">@alm.Nombre</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold required">Almacén Destino</label>
                                <select name="AlmacenDestinoId" id="tsal-almacen-dest-id" class="form-select form-select-sm" required>
                                    <option value="">-- Seleccionar --</option>
                                    @foreach (var alm in Model.AlmacenesDestino)
                                    {
                                        <option value="@alm.Id">@alm.Nombre</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">N° Guía de Remisión</label>
                                <input type="text" name="NumeroGuiaRemision" id="tsal-num-gr" class="form-control form-control-sm font-monospace" maxlength="20" placeholder="Ej: T001-000123" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Serie Doc. Ref.</label>
                                <input type="text" name="SerieDocumento" id="tsal-serie-doc" class="form-control form-control-sm text-uppercase" maxlength="4" placeholder="F001" />
                            </div>

                            <div class="col-md-5">
                                <label class="form-label small fw-semibold">Número Doc. Ref.</label>
                                <input type="text" name="NumeroDocumento" id="tsal-num-doc" class="form-control form-control-sm" maxlength="50" placeholder="00012345" />
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-semibold">Observación</label>
                                <textarea name="Observacion" id="tsal-obs" class="form-control form-control-sm" rows="2" maxlength="400" placeholder="Motivo del traslado entre almacenes..."></textarea>
                            </div>

                            <div class="col-12 text-end pt-2 border-top">
                                <button type="button" class="btn btn-outline-secondary btn-sm me-2" data-bs-dismiss="modal">Cerrar</button>
                                @if (canWrite)
                                {
                                    <button type="submit" class="btn btn-primary btn-sm shadow-sm" id="btn-save-tsal-hdr">
                                        <i class="bi bi-save me-1"></i>Guardar y Continuar a Items
                                    </button>
                                }
                            </div>
                        </form>
                    </div>

                    <!-- Panel 2: Detalle de Productos -->
                    <div class="tab-pane fade" id="panel-tsal-items" role="tabpanel">
                        @if (canWrite)
                        {
                            <div class="card bg-body-tertiary border-0 rounded-3 p-3 mb-3">
                                <form id="tsal-item-form" class="row g-2 align-items-end">
                                    <input type="hidden" name="Id" id="tsal-item-id" value="0" />
                                    <input type="hidden" name="MovimientoAlmacenId" id="tsal-item-mov-id" value="0" />
                                    <input type="hidden" name="ContextoId" id="tsal-item-contexto-id" value="@ViewBag.PeriodoEmpresaSedeId" />
                                    <input type="hidden" name="ProductoId" id="tsal-item-prd-id" value="" />

                                    <div class="col-md-5 position-relative">
                                        <label class="form-label small fw-semibold required">Producto / Insumo</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                                            <input type="text" id="tsal-item-prd-search" class="form-control" placeholder="Buscar código o descripción..." autocomplete="off" />
                                        </div>
                                        <div id="tsal-item-prd-results" class="list-group position-absolute shadow-lg d-none mt-1" style="z-index: 1060; width: 100%; max-height: 220px; overflow-y: auto;"></div>
                                        <div id="tsal-item-prd-selected" class="mt-1 p-2 bg-white border rounded d-none">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <div>
                                                    <span class="badge bg-secondary font-monospace me-1" id="tsal-item-prd-badge"></span>
                                                    <strong class="small" id="tsal-item-prd-name"></strong>
                                                    <span class="text-muted small ms-1" id="tsal-item-prd-um"></span>
                                                </div>
                                                <button type="button" class="btn btn-sm btn-link text-danger p-0 js-tsal-clear-item-prd">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-2">
                                        <label class="form-label small fw-semibold required">Cantidad</label>
                                        <input type="number" step="0.01" min="0.01" name="Cantidad" id="tsal-item-cant" class="form-control form-control-sm text-end fw-bold" placeholder="0.00" required />
                                    </div>

                                    <div class="col-md-2">
                                        <label class="form-label small fw-semibold">Cant. Doc.</label>
                                        <input type="number" step="0.01" min="0" name="CantidadDocumento" id="tsal-item-cant-doc" class="form-control form-control-sm text-end" placeholder="0.00" />
                                    </div>

                                    <div class="col-md-2">
                                        <label class="form-label small fw-semibold">Valor Unit.</label>
                                        <input type="number" step="0.0001" min="0" name="ValorUnitario" id="tsal-item-val-u" class="form-control form-control-sm text-end" placeholder="0.0000" />
                                    </div>

                                    <div class="col-md-1">
                                        <button type="submit" class="btn btn-primary btn-sm w-100 shadow-sm" id="btn-save-tsal-item" title="Agregar item">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        }

                        <div class="table-responsive border rounded-3 mb-2" style="max-height: 340px;">
                            <table class="table table-sm table-hover align-middle mb-0" id="tsal-items-table">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 120px;">Código</th>
                                        <th>Descripción</th>
                                        <th class="text-center" style="width: 70px;">U.M.</th>
                                        <th class="text-end" style="width: 100px;">Cant. Doc.</th>
                                        <th class="text-end" style="width: 100px;">Cantidad</th>
                                        <th class="text-end" style="width: 100px;">Valor Unit.</th>
                                        <th class="text-end" style="width: 110px;">Total</th>
                                        <th class="text-end" style="width: 60px;"></th>
                                    </tr>
                                </thead>
                                <tbody id="tsal-items-tbody">
                                    <tr><td colspan="8" class="text-center text-muted py-3">No hay productos registrados en esta transferencia.</td></tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded border">
                            <span class="text-muted small">Total de items: <strong id="tsal-items-count">0</strong></span>
                            <div class="fw-bold">
                                <span>Total Transferencia: </span>
                                <span class="text-primary font-monospace fs-6" id="tsal-items-total">S/ 0.00</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-body-tertiary">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/transfe-salida.js" asp-append-version="true"></script>
}

