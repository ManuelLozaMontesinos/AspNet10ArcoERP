@model TransaccionAlmacenPageModel
@{
    ViewData["Title"] = "Transacciones de almacén";
    bool canWrite = ViewBag.PuedeEscribir is true;
    string search = ViewBag.Search as string ?? "";
    int? movement = ViewBag.TipoMovimientoId as int?;
    string state = ViewBag.Estado as string ?? "";
}
<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid"><div class="row align-items-center g-3">
        <div class="col"><h3 class="mb-0 fw-bold d-flex align-items-center"><i class="bi bi-arrow-left-right text-primary me-2"></i>Transacciones de almacén</h3>
            <small class="text-muted">Tipos de operación para los ingresos y salidas de inventario.</small></div>
        @if (canWrite) { <div class="col-auto"><button type="button" class="btn btn-primary shadow-sm" id="inv-new"><i class="bi bi-plus-circle-fill me-1"></i>Nueva transacción</button></div> }
    </div></div>
</div>
<div class="app-content py-4 erp-listing"><div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="card-body py-2 px-3 erp-filter-bar">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <form method="get" class="d-flex flex-wrap align-items-center gap-2 m-0">
                <input type="hidden" name="top" value="@Model.PageSize" /><input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="dir" value="@Model.Dir" />
                <div class="input-group input-group-sm listing-search">
                    <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input name="search" value="@search" maxlength="100" class="form-control border-start-0" placeholder="Buscar por código o nombre..." aria-label="Buscar transacciones" />
                    <button type="submit" class="btn btn-outline-primary">Buscar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
                </div>
                <div class="input-group input-group-sm w-auto"><span class="input-group-text bg-body-tertiary"><i class="bi bi-arrow-down-up"></i></span>
                    <select name="tipoMovimientoId" class="form-select" aria-label="Tipo de movimiento">
                        <option value="">Todos los movimientos</option>
                        @foreach (var item in Model.TiposMovimiento) { <option value="@item.Id" selected="@(movement == item.Id)">@item.Nombre</option> }
                    </select></div>
                <div class="input-group input-group-sm w-auto"><span class="input-group-text bg-body-tertiary"><i class="bi bi-toggle-on"></i></span>
                    <select name="estado" class="form-select" aria-label="Estado"><option value="">Todos los estados</option><option value="A" selected="@(state == "A")">Activas</option><option value="I" selected="@(state == "I")">Anuladas</option></select></div>
            </form>
            <partial name="_ListadoControles" model="Model" />
        </div>
    </div></div>
    <div class="card border-0 shadow-sm rounded-3 mb-3">
        <div class="table-responsive table-scroll"><table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
            <thead class="table-header-custom bg-body-tertiary border-bottom"><tr>
                <th erp-sort="codigo">Código</th><th erp-sort="nombre">Nombre</th><th erp-sort="movimiento">Movimiento</th><th erp-sort="operacion">Operación</th><th erp-sort="compra">Compra</th><th erp-sort="estado">Estado</th><th class="listing-options">Opciones</th>
            </tr></thead>
            <tbody>
                @if (Model.Items.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">No se encontraron transacciones.</td></tr> }
                @foreach (var item in Model.Items)
                {
                    <tr><td class="font-monospace text-muted">@item.Codigo</td><td class="fw-semibold">@item.Nombre</td><td>@item.TipoMovimientoNombre</td><td>@item.TipoOperacionNombre</td><td>@(item.EsCompra ? "Sí" : "No")</td>
                        <td><span class="badge @(item.Estado == "A" ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-body-secondary border")">@(item.Estado == "A" ? "Activa" : "Anulada")</span></td>
                        <td class="listing-options"><button type="button" class="btn btn-sm btn-outline-primary js-inv-edit" data-id="@item.Id" title="@(canWrite && item.Estado == "A" ? "Editar transacción" : "Consultar transacción")"><i class="bi @(canWrite && item.Estado == "A" ? "bi-pencil" : "bi-eye")"></i></button>
                            @if (canWrite && item.Estado == "A") { <button type="button" class="btn btn-sm btn-outline-danger js-inv-cancel" data-id="@item.Id" title="Anular transacción"><i class="bi bi-trash"></i></button> }
                        </td></tr>
                }
            </tbody>
        </table></div>
        <partial name="_ListadoPaginacion" model="Model" />
    </div>
</div></div>
<div class="modal fade" id="inv-modal" tabindex="-1" aria-labelledby="inv-modal-title" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <form id="inv-form" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header sticky-top bg-body-tertiary"><h5 class="modal-title" id="inv-modal-title">Transacción de almacén</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
            <div class="modal-body">
                <input type="hidden" id="inv-id" name="Id" value="0" />
                <div class="mb-3"><label for="inv-code" class="form-label">Código</label><input id="inv-code" class="form-control bg-body-tertiary" placeholder="Se genera al guardar" readonly /></div>
                <div class="mb-3"><label for="inv-name" class="form-label">Nombre <span class="text-danger">*</span></label><input id="inv-name" name="Nombre" class="form-control" required maxlength="100" /></div>
                <div class="mb-3"><label for="inv-movement" class="form-label">Tipo de movimiento</label><select id="inv-movement" name="TipoMovimientoId" class="form-select">
                    <option value="">Sin especificar</option>@foreach (var item in Model.TiposMovimiento) { <option value="@item.Id">@item.Nombre</option> }
                </select><div class="form-text">Se conserva después de crear la transacción.</div></div>
                <div class="mb-3"><label for="inv-operation" class="form-label">Tipo de operación</label><select id="inv-operation" name="TipoOperacionId" class="form-select">
                    <option value="">Sin especificar</option>@foreach (var item in Model.TiposOperacion) { <option value="@item.Id">@item.Nombre</option> }
                </select></div>
                <div class="form-check form-switch"><input type="checkbox" class="form-check-input" id="inv-purchase" name="EsCompra" value="true" /><label class="form-check-label" for="inv-purchase">Es compra</label></div>
            </div>
            <div class="modal-footer sticky-bottom bg-body-tertiary"><button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                @if (canWrite) { <button type="submit" class="btn btn-sm btn-primary" id="inv-save"><i class="bi bi-save me-1"></i>Guardar</button> }
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <script id="inventario-config" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        kind = "transaccion", canWrite,
        urls = new { obtener = Url.Action("Obtener"), guardar = Url.Action("Guardar"), anular = Url.Action("Anular") }
    }))</script>
    <script src="~/js/inventario.js" asp-append-version="true"></script>
}
