@model VolumenExistenciaPageModel
@{ ViewData["Title"] = Model.Titulo; bool write = ViewBag.PuedeEscribir == true; bool ready = Model.Consultada && Model.Errores.Count == 0; }
<div class="app-content-header py-3 border-bottom"><div class="container-fluid"><div class="row align-items-center g-3"><div class="col"><h3 class="mb-0 fw-bold d-flex align-items-center"><i class="bi bi-box-arrow-in-down text-primary me-2"></i>@Model.Titulo</h3><small class="text-muted" data-erp-list-summary>@Model.Resumen · Configuración del stock mínimo por sede</small></div><div class="col-auto d-flex flex-wrap gap-2" data-erp-list-actions>
    @if (ready) { <a asp-action="Exportar" asp-route-sedeId="@Model.EmpresaSedeId" asp-route-search="@Model.Filtro.Search" asp-route-sort="@Model.Sort" asp-route-dir="@Model.Dir" class="btn btn-outline-success shadow-sm" data-full-navigation><i class="bi bi-file-earmark-excel me-1"></i>Excel</a><a asp-action="Plantilla" asp-route-sedeId="@Model.EmpresaSedeId" class="btn btn-outline-secondary shadow-sm" data-full-navigation><i class="bi bi-download me-1"></i>Plantilla</a> }
    @if (write) { <button type="button" class="btn btn-primary shadow-sm" id="minimum-import" disabled="@(!ready)"><i class="bi bi-upload me-1"></i>Importar Excel</button> }
</div></div></div></div>
<div class="app-content py-4 erp-listing"><div class="container-fluid">
    @if (Model.Errores.Count>0) { <div class="alert alert-warning" role="alert">@foreach(var error in Model.Errores) { <p class="mb-0">@error</p> }</div> }
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="card-body py-2 px-3 erp-filter-bar"><div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <form method="get" id="minimum-filters" class="d-flex flex-wrap align-items-center gap-2 m-0"><input type="hidden" name="top" value="@Model.PageSize" /><input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="dir" value="@Model.Dir" />
            <div class="input-group input-group-sm listing-search"><span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span><input name="search" value="@Model.Filtro.Search" class="form-control border-start-0" maxlength="150" placeholder="Buscar producto o código..." aria-label="Buscar producto" /></div>
            <div class="input-group input-group-sm w-auto"><span class="input-group-text bg-body-tertiary"><i class="bi bi-building"></i></span><select name="sedeId" class="form-select" aria-label="Sede" required><option value="">Seleccione sede</option>@foreach(var site in Model.Sedes) { <option value="@site.Id" selected="@(site.Id == Model.EmpresaSedeId)">@site.Nombre</option> }</select></div>
            <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i>Buscar</button><a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
        </form><partial name="_ListadoControles" model="Model" />
    </div></div></div>
    <p class="small text-muted">Catálogo sin combos, vigente en el ejercicio seleccionado. El Excel exporta los productos activos, como el formato anterior. El mínimo se configura por sede; no modifica las existencias físicas.</p>
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="table-responsive table-scroll"><table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
        <thead class="table-header-custom bg-body-tertiary border-bottom"><tr><th erp-sort="codigo">Código</th><th erp-sort="producto">Producto</th><th erp-sort="unidad">U.M.</th><th erp-sort="minimo" erp-numeric="true" class="text-end">Stock mínimo</th><th class="listing-options">Opciones</th></tr></thead><tbody>
            @if(Model.Items.Count==0) { <tr><td colspan="5" class="text-center text-muted py-4">@(Model.Consultada ? "No se encontraron productos para los filtros seleccionados." : "Seleccione una sede de la empresa para consultar sus mínimos.")</td></tr> }
            @foreach(var item in Model.Items) { <tr><td class="font-monospace text-muted">@item.Codigo</td><td class="fw-semibold">@item.Producto @if(item.EstadoProducto == "I") { <span class="badge bg-secondary-subtle text-body-secondary ms-1">Inactivo</span> }</td><td>@item.Unidad</td><td class="text-end">@item.StockMinimo.ToString("N4")</td><td class="listing-options"><button type="button" class="btn btn-sm @(write ? "btn-outline-warning" : "btn-outline-primary")" data-minimum-product="@item.ProductoId" title="@(write ? "Editar mínimo" : "Consultar mínimo")"><i class="bi @(write ? "bi-pencil-square" : "bi-eye")"></i></button></td></tr> }
        </tbody></table></div><partial name="_ListadoPaginacion" model="Model" /></div>
</div></div>
<div class="modal fade" id="minimum-modal" tabindex="-1" aria-labelledby="minimum-title" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><form class="modal-content" id="minimum-form" method="post">
    @Html.AntiForgeryToken()
    <div class="modal-header sticky-top bg-body-tertiary"><h5 class="modal-title" id="minimum-title">Stock mínimo</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body" id="minimum-body"></div><div class="modal-footer sticky-bottom bg-body-tertiary"><button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>@if(write) { <button type="submit" class="btn btn-sm btn-primary d-none" id="minimum-save"><i class="bi bi-check2 me-1"></i>Guardar</button> }</div>
</form></div></div>
@section Scripts {
    <script type="application/json" id="minimum-config">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { contextoId=Model.Contexto.PeriodoEmpresaSedeId,sedeId=Model.EmpresaSedeId,sede=Model.SedeSeleccionada,anio=Model.Contexto.Anio,write, urls=new { obtener=Url.Action("Obtener"),guardar=Url.Action("Guardar"),preparar=Url.Action("PrepararImportacion"),confirmar=Url.Action("ConfirmarImportacion") } }))</script>
    <script src="~/js/inventario-minimos.js" asp-append-version="true"></script>
}
