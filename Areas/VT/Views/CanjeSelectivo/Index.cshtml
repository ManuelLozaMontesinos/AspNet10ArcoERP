@model CanjeDocuPageModel
@{
    ViewData["Title"] = "Canje Selectivo de Documentos";
    bool canWrite = ViewBag.PuedeEscribir == true;
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-check2-square text-success me-2"></i>Canje Selectivo de Documentos
                </h3>
                <small class="text-muted" data-erp-list-summary>Selección y canje múltiple de notas/documentos temporales a comprobantes definitivos · @ViewBag.SedeNombre</small>
            </div>
            <div class="col-auto d-flex align-items-center gap-2">
                @if (canWrite)
                {
                    <button type="button" class="btn btn-success btn-sm shadow-sm" id="btnCanjearSeleccionados" disabled>
                        <i class="bi bi-arrow-repeat me-1"></i>Canjear Seleccionados (<span id="cantSeleccionados">0</span>)
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4 erp-listing">
    <div class="container-fluid">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-sm">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 40px;">
                                <input type="checkbox" class="form-check-input" id="chkTodos" />
                            </th>
                            <th>Tipo Origen</th>
                            <th>Documento</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th class="text-end">Monto Total</th>
                            <th class="text-center">Moneda</th>
                            <th class="text-end pe-3">Acción Individual</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-1"></i>No hay documentos pendientes para canje selectivo.
                                </td>
                            </tr>
                        }
                        @foreach (var doc in Model.Items)
                        {
                            <tr>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input chk-item" value="@doc.ComprobanteId" data-cliente="@doc.ClienteRazonSocial" data-monto="@doc.MontoTotal" />
                                </td>
                                <td><span class="badge bg-secondary">@doc.TipoDocumentoComercialNombre</span></td>
                                <td class="fw-bold text-primary">@doc.SerieNumero</td>
                                <td>@doc.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="fw-semibold">@doc.ClienteRazonSocial</td>
                                <td class="text-end fw-bold">@doc.MontoTotal.ToString("N2")</td>
                                <td class="text-center"><span class="badge bg-light text-dark border">@doc.Moneda</span></td>
                                <td class="text-end pe-3">
                                    @if (canWrite)
                                    {
                                        <button type="button" class="btn btn-outline-success btn-sm btn-canje-uno" data-id="@doc.ComprobanteId" data-num="@doc.SerieNumero">
                                            <i class="bi bi-arrow-right-short"></i>Canjear
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.PageCount > 1)
            {
                <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center py-2">
                    <small class="text-muted">Mostrando @Model.Items.Count de @Model.Total registros</small>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int p = 1; p <= Model.PageCount; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = p, top = Model.PageSize, sort = Model.Sort, dir = Model.Dir })">@p</a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const chkTodos = document.getElementById('chkTodos');
            const chks = document.querySelectorAll('.chk-item');
            const btnCanjear = document.getElementById('btnCanjearSeleccionados');
            const cantSpan = document.getElementById('cantSeleccionados');

            function actualizarSeleccion() {
                const seleccionados = document.querySelectorAll('.chk-item:checked');
                cantSpan.textContent = seleccionados.length;
                btnCanjear.disabled = seleccionados.length === 0;
            }

            if (chkTodos) {
                chkTodos.addEventListener('change', function () {
                    chks.forEach(c => c.checked = chkTodos.checked);
                    actualizarSeleccion();
                });
            }

            chks.forEach(c => c.addEventListener('change', actualizarSeleccion));

            if (btnCanjear) {
                btnCanjear.addEventListener('click', async function () {
                    const seleccionados = Array.from(document.querySelectorAll('.chk-item:checked')).map(c => parseInt(c.value));
                    if (seleccionados.length === 0) return;

                    const tipoDestino = prompt('Seleccione tipo de comprobante destino: (1 = Factura, 2 = Boleta)', '1');
                    if (!tipoDestino) return;

                    for (const id of seleccionados) {
                        await fetch('/VT/CanjeSelectivo/Procesar', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                comprobanteOrigenId: id,
                                tipoDocumentoDestinoId: tipoDestino === '1' ? 1 : 2
                            })
                        });
                    }
                    alert('Canje procesado exitosamente.');
                    location.reload();
                });
            }

            document.querySelectorAll('.btn-canje-uno').forEach(b => {
                b.addEventListener('click', async function () {
                    const id = parseInt(this.getAttribute('data-id'));
                    const num = this.getAttribute('data-num');
                    if (!confirm(`¿Desea canjear el documento ${num}?`)) return;

                    const resp = await fetch('/VT/CanjeSelectivo/Procesar', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            comprobanteOrigenId: id,
                            tipoDocumentoDestinoId: 1
                        })
                    });
                    const res = await resp.json();
                    if (res.success) {
                        alert(res.message || 'Canje realizado.');
                        location.reload();
                    } else {
                        alert(res.message || 'Error en el canje.');
                    }
                });
            });
        });
    </script>
}
