@model ComprobantePageModel
@{
    ViewData["Title"] = "Autorización de Comprobantes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2 align-items-center">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark fw-bold">
                    <i class="bi bi-shield-check text-warning me-2"></i>Autorización de Comprobantes
                </h1>
            </div>
            <div class="col-sm-6 text-end">
                <span class="badge bg-info-subtle text-info border border-info px-3 py-2">
                    <i class="bi bi-info-circle me-1"></i> Bandeja de Control y Liberación
                </span>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        <div class="card shadow-sm">
            <div class="card-header bg-light py-2">
                <h3 class="card-title text-secondary fw-bold mb-0">Comprobantes Pendientes de Liberación / Emisión</h3>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover table-striped align-middle mb-0 text-nowrap">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">Tipo</th>
                            <th>Documento</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Vendedor</th>
                            <th class="text-end">Total</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center pe-3">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items == null || Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bi bi-check-all fs-2 d-block mb-2 text-success"></i>
                                    No hay comprobantes pendientes de autorización.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var c in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3"><span class="badge bg-primary">@c.TipoDocumentoComercial</span></td>
                                    <td class="fw-bold">@c.SerieNumero</td>
                                    <td>@c.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@c.ClienteRazonSocial</td>
                                    <td><small>@c.VendedorNombre</small></td>
                                    <td class="text-end fw-bold">@c.Moneda @c.MontoTotal.ToString("N2")</td>
                                    <td class="text-center"><span class="badge bg-warning text-dark">Pendiente</span></td>
                                    <td class="text-center pe-3">
                                        <button type="button" class="btn btn-sm btn-success" onclick="autorizarComprobante(@c.ComprobanteId)">
                                            <i class="bi bi-check2-circle me-1"></i> Autorizar y Emitir
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function autorizarComprobante(id) {
            const confirm = await Swal.fire({
                title: '¿Autorizar comprobante?',
                text: 'Se autorizará y emitirá ante el servicio SUNAT BETA.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, autorizar',
                cancelButtonText: 'Cancelar'
            });

            if (!confirm.isConfirmed) return;

            try {
                Swal.fire({ title: 'Autorizando...', didOpen: () => Swal.showLoading() });
                const resp = await fetch('/VT/ComproAutoriza/Autorizar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ comprobanteId: id, envioEnLinea: 'S' })
                });
                const res = await resp.json();
                if (res.success) {
                    Swal.fire('Autorizado', res.message, 'success').then(() => location.reload());
                } else {
                    Swal.fire('Error', res.message, 'error');
                }
            } catch (e) {
                Swal.fire('Error', 'Fallo de red.', 'error');
            }
        }
    </script>
}

