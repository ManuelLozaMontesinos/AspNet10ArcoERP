@model VentaProductoPageModel
@addTagHelper *, AspNet10ArcoERP
@{ViewData["Title"]=Model.Titulo;var query=Model.Filtro.Query(Model.Sort,Model.Dir);var columns=VentaProductoPageModel.Columnas;bool ready=Model.Consultada&&Model.Errores.Count==0;}
<div class="app-content-header py-3 border-bottom"><div class="container-fluid"><div class="row align-items-center g-3">
    <div class="col"><h3 class="mb-0 fw-bold d-flex align-items-center"><i class="bi bi-box-seam text-primary me-2"></i>@Model.Titulo</h3><small class="text-muted" data-erp-list-summary>@Model.Resumen</small></div>
    <div class="col-auto d-flex gap-2" data-erp-list-actions>
        @if(ready){<a asp-action="Exportar" asp-all-route-data="query" class="btn btn-sm btn-outline-success" data-full-navigation><i class="bi bi-file-earmark-excel me-1"></i>Excel</a><a asp-action="Imprimir" asp-all-route-data="query" class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener" data-full-navigation><i class="bi bi-printer me-1"></i>Imprimir / PDF</a>}
        else{<button type="button" class="btn btn-sm btn-outline-success" disabled>Excel</button><button type="button" class="btn btn-sm btn-outline-secondary" disabled>Imprimir / PDF</button>}
    </div>
</div></div></div>
<div class="app-content py-4 erp-listing"><div class="container-fluid">
    @if(Model.Errores.Count>0){<div class="alert alert-warning" role="alert"><ul class="mb-0">@foreach(var error in Model.Errores){<li>@error</li>}</ul></div>}
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="card-body py-2 px-3 erp-filter-bar"><div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <form method="get" id="vr-filters" class="d-flex flex-wrap align-items-center gap-2 m-0">
            <input type="hidden" name="consultar" value="true" /><input type="hidden" name="top" value="@Model.PageSize" /><input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="dir" value="@Model.Dir" />
            <div class="input-group input-group-sm listing-search"><span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span><input name="search" value="@Model.Filtro.Search" maxlength="150" class="form-control border-start-0" placeholder="Código, producto o clasificación..." aria-label="Buscar producto en ventas" /></div>
            <select id="vr-mode" name="modo" class="form-select form-select-sm w-auto" aria-label="Período de consulta"><option value="mes" selected="@(Model.Filtro.Modo=="mes")">Mensual</option><option value="rango" selected="@(Model.Filtro.Modo=="rango")">Rango de fechas</option></select>
            <div class="input-group input-group-sm w-auto" data-vr-month hidden="@(Model.Filtro.Modo=="rango")"><span class="input-group-text bg-body-tertiary"><i class="bi bi-calendar-month"></i></span><select name="mes" class="form-select" aria-label="Mes calendario" required disabled="@(Model.Filtro.Modo=="rango")">@foreach(var item in Model.Meses){<option value="@item.Id" selected="@(Model.Filtro.Mes==item.Id)">@item.Nombre</option>}</select></div>
            <div class="input-group input-group-sm w-auto" data-vr-dates hidden="@(Model.Filtro.Modo!="rango")"><span class="input-group-text bg-body-tertiary">Desde</span><input type="date" name="desde" class="form-control" value="@Model.Filtro.Desde?.ToString("yyyy-MM-dd")" min="1900-01-01" max="9998-12-31" required disabled="@(Model.Filtro.Modo!="rango")" aria-label="Fecha inicial" /></div>
            <div class="input-group input-group-sm w-auto" data-vr-dates hidden="@(Model.Filtro.Modo!="rango")"><span class="input-group-text bg-body-tertiary">Hasta</span><input type="date" name="hasta" class="form-control" value="@Model.Filtro.Hasta?.ToString("yyyy-MM-dd")" min="1900-01-01" max="9998-12-31" required disabled="@(Model.Filtro.Modo!="rango")" aria-label="Fecha final" /></div>
            <div class="form-check form-check-inline m-0"><input id="vp-internal" name="incluirInterno" class="form-check-input" type="checkbox" value="true" checked="@Model.Filtro.IncluirInterno" /><label for="vp-internal" class="form-check-label small">Incluir internos</label></div>
            <div class="form-check form-check-inline m-0"><input id="vp-gift" name="excluirObsequio" class="form-check-input" type="checkbox" value="true" checked="@Model.Filtro.ExcluirObsequio" /><label for="vp-gift" class="form-check-label small">Excluir obsequios</label></div>
            <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i>Consultar</button><a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
        </form><partial name="_ListadoControles" model="Model" />
    </div></div></div>
    <div class="small text-muted mb-3" data-erp-list-summary>@Model.Nota</div>
    @if(ready){<div class="d-flex flex-wrap gap-3 mb-3 small"><span>Totales filtrados en moneda local:</span><span>Bruto <strong>@Model.Bruto.ToString("N4")</strong></span><span>IGV <strong>@Model.Igv.ToString("N4")</strong></span><span>Total <strong>@Model.Importe.ToString("N4")</strong></span></div>}
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="table-responsive table-scroll"><table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
        <thead class="table-header-custom bg-body-tertiary border-bottom"><tr>@foreach(var column in columns){<th erp-sort="@column.Campo" erp-numeric="@column.Numero" class="@(column.Numero?"text-end":null)">@column.Titulo</th>}<th class="listing-options">Opciones</th></tr></thead>
        <tbody>@if(Model.Items.Count==0){<tr><td colspan="@(columns.Count+1)" class="text-center text-muted py-4">@(Model.Consultada?"No se encontraron productos para los filtros seleccionados.":"Seleccione los filtros y pulse Consultar.")</td></tr>}
        @foreach(var row in Model.Items){<tr>@foreach(var column in columns){<td class="@(column.Numero?"text-end":null)">@VentaProductoPageModel.Format(column,row)</td>}<td class="listing-options"><button type="button" class="btn btn-sm btn-outline-primary js-vr-row" data-row="@System.Text.Json.JsonSerializer.Serialize(columns.ToDictionary(c=>c.Campo,c=>c.Valor(row) switch {decimal d=>d.ToString("G29",System.Globalization.CultureInfo.InvariantCulture),var value=>value?.ToString()??""}))" title="Consultar producto" aria-label="Consultar producto"><i class="bi bi-eye"></i></button></td></tr>}
        </tbody>
    </table></div><partial name="_ListadoPaginacion" model="Model" /></div>
</div></div>
<div class="modal fade" id="vr-modal" tabindex="-1" aria-labelledby="vr-title" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header sticky-top bg-body-tertiary"><h5 class="modal-title" id="vr-title">Consulta de ventas del producto</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
    <div class="modal-body"><p id="vr-note" class="small text-muted"></p><dl id="vr-detail" class="row mb-0"></dl></div><div class="modal-footer sticky-bottom bg-body-tertiary"><button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button></div>
</div></div></div>
@section Scripts {
    <script id="ventas-reporte-config" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new{columns=columns.Select(c=>new{campo=c.Campo,titulo=c.Titulo,numero=c.Numero&&c.Campo!="tickets",fecha=false}),nota=Model.ResumenSalida}))</script>
    <script src="~/js/ventas-reportes.js" asp-append-version="true"></script>
}
