@model VentaReportePageModel
@{ ViewData["Title"] = Model.Titulo; }
<partial name="_VentaReporte" model="Model" />
@section Scripts {
    <script id="ventas-reporte-config" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { columns = Model.Columnas.Select(c => new { campo = c.Campo, titulo = c.Titulo, numero = c.Numero, fecha = c.Fecha }) }))</script>
    <script src="~/js/ventas-reportes.js" asp-append-version="true"></script>
}