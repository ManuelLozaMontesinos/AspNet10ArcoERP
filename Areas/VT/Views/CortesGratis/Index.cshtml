@model CortesGratisPageModel
@{ViewData["Title"]="Cortes gratis";bool canWrite=ViewBag.PuedeEscribir==true;}
<div class="app-content-header py-3 border-bottom"><div class="container-fluid"><div class="row align-items-center g-3"><div class="col"><h3 class="mb-0 fw-bold d-flex align-items-center"><i class="bi bi-scissors text-primary me-2"></i>Cortes gratis</h3><small class="text-muted" data-erp-list-summary>Cantidades por producto y sede · @ViewBag.SedeNombre</small></div></div></div></div>
<div class="app-content py-4 erp-listing"><div class="container-fluid">
    @if(Model.Errores.Count>0){<div class="alert alert-warning" role="alert"><ul class="mb-0">@foreach(var error in Model.Errores){<li>@error</li>}</ul></div>}
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="card-body py-2 px-3 erp-filter-bar"><div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <form method="get" id="cg-filters" class="d-flex flex-wrap align-items-center gap-2 m-0"><input type="hidden" name="top" value="@Model.PageSize" /><input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="dir" value="@Model.Dir" />
            <div class="input-group input-group-sm listing-search"><span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span><input name="search" value="@Model.Search" class="form-control border-start-0" maxlength="150" placeholder="Código o nombre de clase..." aria-label="Buscar clase" /></div>
            <select name="estado" class="form-select form-select-sm w-auto" aria-label="Estado de clase"><option value="">Todos los estados</option><option value="A" selected="@(Model.Estado=="A")">Activos</option><option value="I" selected="@(Model.Estado=="I")">Inactivos</option></select>
            <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i>Buscar</button><a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
        </form><partial name="_ListadoControles" model="Model" />
    </div></div></div>
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="table-responsive table-scroll"><table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
        <thead class="table-header-custom bg-body-tertiary border-bottom"><tr><th erp-sort="codigo">Código</th><th erp-sort="nombre">Clase</th><th erp-sort="estado">Estado</th><th class="listing-options">Opciones</th></tr></thead>
        <tbody>@if(Model.Items.Count==0){<tr><td colspan="4" class="text-center text-muted py-4">No se encontraron clases.</td></tr>}
        @foreach(var item in Model.Items){<tr><td>@item.Codigo</td><td>@item.Nombre</td><td><span class="badge @(item.Estado=="A"?"bg-success-subtle text-success":"bg-secondary-subtle text-body-secondary")">@(item.Estado=="A"?"Activo":"Inactivo")</span></td><td class="listing-options"><button type="button" class="btn btn-sm btn-outline-primary js-cg-open" data-id="@item.Id" title="Consultar productos" aria-label="Consultar productos"><i class="bi bi-eye"></i></button>@if(canWrite&&item.Estado=="A"){<button type="button" class="btn btn-sm btn-outline-primary js-cg-open" data-id="@item.Id" data-edit="true" title="Editar cantidades" aria-label="Editar cantidades"><i class="bi bi-pencil-square"></i></button>}</td></tr>}
        </tbody></table></div><partial name="_ListadoPaginacion" model="Model" /></div>
</div></div>
<div class="modal fade" id="cg-modal" tabindex="-1" aria-labelledby="cg-title" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><form id="cg-form" class="modal-content" method="post" asp-action="Guardar">
    <div class="modal-header sticky-top bg-body-tertiary"><h5 class="modal-title" id="cg-title">Cortes gratis por producto</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
    <div class="modal-body">@Html.AntiForgeryToken()<input type="hidden" name="ContextoId" value="@ViewBag.ContextoId" /><input type="hidden" name="ClaseId" /><input type="hidden" name="ProductoId" /><input type="hidden" name="Id" /><input type="hidden" name="Revision" />
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3"><div><strong id="cg-class"></strong><small id="cg-site" class="d-block text-muted"></small></div><span id="cg-mode" class="badge bg-primary-subtle text-primary"></span></div>
        <div class="d-flex flex-wrap align-items-center gap-2 erp-filter-bar mb-3"><div class="input-group input-group-sm listing-search"><span class="input-group-text bg-body-tertiary"><i class="bi bi-search"></i></span><input id="cg-search" class="form-control" maxlength="150" placeholder="Producto, código o familia..." aria-label="Buscar producto" /><button id="cg-find" type="button" class="btn btn-outline-primary">Buscar</button><button id="cg-clear" type="button" class="btn btn-outline-secondary" title="Limpiar búsqueda"><i class="bi bi-x-lg"></i></button></div><select id="cg-family" class="form-select form-select-sm w-auto" aria-label="Familia de productos"></select><select id="cg-size" class="form-select form-select-sm w-auto ms-auto" aria-label="Mostrar registros del detalle">@foreach(var size in new[]{25,50,100,500}){<option value="@size">@size registros</option>}</select></div>
        <div id="cg-editor" class="border rounded-3 p-3 mb-3 bg-body-tertiary" hidden><strong id="cg-product" class="d-block mb-2"></strong><label for="cg-quantity" class="form-label">Cantidad de cortes gratis</label><div class="input-group"><input id="cg-quantity" name="Cantidad" type="number" min="-99999999.99" max="99999999.99" step="0.01" class="form-control" required disabled />@if(canWrite){<button id="cg-save" type="submit" class="btn btn-primary">Guardar cantidad</button>}<button id="cg-discard" type="button" class="btn btn-outline-secondary">Cerrar detalle</button></div></div>
        <div class="small text-muted mb-2">Se muestran las configuraciones existentes de esta sede, incluidos productos inactivos. Cada cantidad se guarda por separado.</div>
        <div class="table-responsive table-scroll border rounded-3"><table class="table table-striped table-hover align-middle mb-0" data-erp-grid="details" data-erp-options><thead id="cg-head" class="table-header-custom bg-body-tertiary"></thead><tbody id="cg-rows"></tbody></table></div>
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pt-3"><small id="cg-range" class="text-muted" aria-live="polite"></small><nav aria-label="Páginas de productos"><div class="btn-group btn-group-sm"><button id="cg-prev" type="button" class="btn btn-outline-secondary">Anterior</button><button id="cg-next" type="button" class="btn btn-outline-secondary">Siguiente</button></div></nav></div>
    </div><div class="modal-footer sticky-bottom bg-body-tertiary"><button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button></div>
</form></div></div>
@section Scripts {
    <script id="cortes-gratis-config" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new{canWrite,contextoId=ViewBag.ContextoId,urls=new{obtener=Url.Action("Obtener"),productos=Url.Action("Productos"),guardar=Url.Action("Guardar")}}))</script>
    <script src="~/js/cortes-gratis.js" asp-append-version="true"></script>
}
