@model CotizaAutorizaPageModel
@{
    ViewData["Title"] = "Autorizaciones de cotizaciones y pedidos";
    bool canWrite = ViewBag.PuedeEscribir == true;
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-shield-check text-warning me-2"></i>Autorizaciones de Cotización y Pedido
                </h3>
                <small class="text-muted" data-erp-list-summary>Bandeja comercial de aprobaciones de descuentos y condiciones especiales · @ViewBag.SedeNombre</small>
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4 erp-listing">
    <div class="container-fluid">
        @if (Model.Errores.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                <ul class="mb-0">
                    @foreach (var error in Model.Errores)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3 erp-filter-bar">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <form method="get" id="auth-filters" class="d-flex flex-wrap align-items-center gap-2 m-0">
                        <input type="hidden" name="top" value="@Model.PageSize" />
                        <input type="hidden" name="sort" value="@Model.Sort" />
                        <input type="hidden" name="dir" value="@Model.Dir" />

                        <div class="input-group input-group-sm listing-search">
                            <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input name="search" value="@Model.Search" class="form-control border-start-0" maxlength="150" placeholder="Cliente, número o vendedor..." aria-label="Buscar en autorizaciones" />
                        </div>

                        <select name="estadoAprobacionId" class="form-select form-select-sm w-auto" aria-label="Estado de aprobación">
                            <option value="">Todos los estados</option>
                            @foreach (var ea in Model.EstadosAprobacion)
                            {
                                <option value="@ea.Id" selected="@(Model.EstadoAprobacionId == ea.Id)">@ea.Nombre</option>
                            }
                        </select>

                        <div class="d-flex align-items-center gap-1">
                            <span class="small text-muted">Desde:</span>
                            <input type="date" name="fechaDesde" value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm w-auto" />
                            <span class="small text-muted">Hasta:</span>
                            <input type="date" name="fechaHasta" value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm w-auto" />
                        </div>

                        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i>Buscar</button>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
                    </form>
                    <partial name="_ListadoControles" model="Model" />
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="table-responsive table-scroll">
                <table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
                    <thead class="table-header-custom bg-body-tertiary border-bottom">
                        <tr>
                            <th erp-sort="codigo" style="width: 110px;">N° Cotiz.</th>
                            <th erp-sort="tipo" style="width: 170px;">Tipo Autorización</th>
                            <th erp-sort="fecha" style="width: 105px;">Fecha</th>
                            <th erp-sort="cliente">Cliente</th>
                            <th erp-sort="vendedor">Vendedor</th>
                            <th erp-sort="total" class="text-end" style="width: 130px;">Total</th>
                            <th erp-sort="estado" class="text-center" style="width: 140px;">Estado Aprob.</th>
                            <th class="listing-options">Opciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr><td colspan="8" class="text-center text-muted py-4">No se encontraron solicitudes de autorización pendientes.</td></tr>
                        }
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="font-monospace fw-bold text-primary">@item.Codigo</td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-dark border">@item.TipoAutorizacionNombre</span>
                                </td>
                                <td>@item.FechaTexto</td>
                                <td>
                                    <div class="fw-semibold">@item.ClienteNombre</div>
                                    @if (!string.IsNullOrEmpty(item.ClienteDocumento))
                                    {
                                        <small class="text-muted font-monospace"><i class="bi bi-card-text me-1"></i>@item.ClienteDocumento</small>
                                    }
                                </td>
                                <td><small>@item.VendedorNombre</small></td>
                                <td class="text-end font-monospace fw-bold">
                                    <span class="text-secondary small">@item.MonedaSimbolo</span> @item.MontoTotalTexto
                                </td>
                                <td class="text-center">
                                    @{
                                        string badgeClass = item.EstadoAprobacionId switch
                                        {
                                            1 => "bg-warning-subtle text-warning border border-warning-subtle", // Pendiente
                                            2 => "bg-success-subtle text-success border border-success-subtle", // Aprobada
                                            3 => "bg-danger-subtle text-danger border border-danger-subtle",   // Desaprobada
                                            4 => "bg-secondary-subtle text-muted border border-secondary-subtle", // Cancelada
                                            _ => "bg-info-subtle text-info border border-info-subtle"
                                        };
                                    }
                                    <span class="badge @badgeClass">@item.EstadoAprobacionNombre</span>
                                </td>
                                <td class="listing-options">
                                    <button type="button" class="btn btn-sm btn-outline-primary js-auth-open" data-id="@item.Id" title="Revisar Solicitud" aria-label="Revisar Solicitud">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_ListadoPaginacion" model="Model" />
        </div>
    </div>
</div>

<!-- Modal Extendido de Revisión de Autorización -->
<div class="modal fade" id="auth-modal" tabindex="-1" aria-labelledby="auth-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-body-tertiary">
                <div>
                    <h5 class="modal-title fw-bold" id="auth-modal-title">Revisión de Solicitud de Autorización</h5>
                    <small id="auth-modal-subtitle" class="text-muted"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <!-- Quotation Header Info Card -->
                <div class="card border rounded-3 p-3 mb-3 bg-body-tertiary">
                    <div class="row g-3">
                        <div class="col-md-2">
                            <small class="text-muted d-block">N° Documento</small>
                            <span id="auth-view-codigo" class="font-monospace fw-bold fs-6 text-primary"></span>
                        </div>
                        <div class="col-md-2">
                            <small class="text-muted d-block">Fecha</small>
                            <span id="auth-view-fecha" class="fw-semibold"></span>
                        </div>
                        <div class="col-md-5">
                            <small class="text-muted d-block">Cliente</small>
                            <strong id="auth-view-cliente"></strong>
                            <small id="auth-view-doc" class="text-muted font-monospace d-block"></small>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">Vendedor</small>
                            <span id="auth-view-vendedor" class="fw-semibold"></span>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">Lista de Precios</small>
                            <span id="auth-view-lista"></span>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">Condición de Pago</small>
                            <span id="auth-view-condicion"></span>
                        </div>
                        <div class="col-md-2">
                            <small class="text-muted d-block">Moneda</small>
                            <span id="auth-view-moneda"></span>
                        </div>
                        <div class="col-md-2">
                            <small class="text-muted d-block">Tipo de Cambio</small>
                            <span id="auth-view-tc" class="font-monospace"></span>
                        </div>
                        <div class="col-md-2">
                            <small class="text-muted d-block">Tasa IGV</small>
                            <span id="auth-view-tasa" class="font-monospace"></span>
                        </div>
                        <div class="col-12" id="auth-view-obs-wrapper" style="display: none;">
                            <small class="text-muted d-block">Observaciones de la Cotización</small>
                            <span id="auth-view-obs" class="small fst-italic"></span>
                        </div>
                    </div>
                </div>

                <!-- Products Table -->
                <h6 class="fw-bold mb-2 d-flex align-items-center">
                    <i class="bi bi-cart3 text-primary me-2"></i>Productos y Precios para Autorización
                </h6>
                <div class="table-responsive border rounded-3 mb-3">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-header-custom bg-body-tertiary">
                            <tr>
                                <th style="width: 100px;">Código</th>
                                <th>Descripción de Producto</th>
                                <th style="width: 60px;">U.M.</th>
                                <th class="text-end" style="width: 90px;">Cantidad</th>
                                <th class="text-end" style="width: 110px;">P.U. Lista</th>
                                <th class="text-end" style="width: 110px;">P.U. Solicitado</th>
                                <th class="text-end" style="width: 130px;">P.U. Autorizado</th>
                                <th class="text-end" style="width: 120px;">Total</th>
                            </tr>
                        </thead>
                        <tbody id="auth-items-rows">
                            <tr><td colspan="8" class="text-center text-muted py-3">Cargando ítems...</td></tr>
                        </tbody>
                    </table>
                </div>

                <!-- Totals Summary Card -->
                <div class="card bg-body-tertiary border-0 p-3 rounded-3">
                    <div class="row g-2 text-center">
                        <div class="col-md-3 border-end">
                            <small class="text-muted d-block">Subtotal Bruto</small>
                            <strong id="auth-tot-bruto" class="fs-6 font-monospace">0.00</strong>
                        </div>
                        <div class="col-md-3 border-end">
                            <small class="text-muted d-block">Descuento</small>
                            <strong id="auth-tot-dcto" class="fs-6 font-monospace text-danger">0.00</strong>
                        </div>
                        <div class="col-md-3 border-end">
                            <small class="text-muted d-block">IGV</small>
                            <strong id="auth-tot-igv" class="fs-6 font-monospace">0.00</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">Total Cotización</small>
                            <strong id="auth-tot-total" class="fs-5 font-monospace text-success">0.00</strong>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-body-tertiary py-2 justify-content-between">
                <div>
                    @if (canWrite)
                    {
                        <div id="auth-action-buttons" style="display: none;">
                            <button type="button" id="auth-btn-aprobar" class="btn btn-sm btn-success px-3 me-2">
                                <i class="bi bi-check-circle me-1"></i>Aprobar Solicitud
                            </button>
                            <button type="button" id="auth-btn-desaprobar" class="btn btn-sm btn-outline-danger px-3">
                                <i class="bi bi-x-circle me-1"></i>Desaprobar
                            </button>
                        </div>
                    }
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script id="cotiza-autoriza-config" type="application/json">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            canWrite,
            contextoId = ViewBag.ContextoId,
            urls = new
            {
                obtener = Url.Action("Obtener"),
                aprobar = Url.Action("Aprobar"),
                desaprobar = Url.Action("Desaprobar")
            }
        }))
    </script>
    <script src="~/js/cotiza-autoriza.js" asp-append-version="true"></script>
}

