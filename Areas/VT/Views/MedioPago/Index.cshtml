@model MedioPagoPageModel
@{
    ViewData["Title"] = "Medios de pago";
    bool canWrite = ViewBag.PuedeEscribir is true;

}
<div class="app-content-header py-3 border-bottom"><div class="container-fluid"><div class="row align-items-center g-3"><div class="col"><h3 class="mb-0 fw-bold d-flex align-items-center"><i class="bi bi-credit-card text-primary me-2"></i>Medios de pago</h3><small class="text-muted">Formas de pago y comisiones de tarjeta de la empresa.</small></div><div class="col-auto" data-erp-list-actions>@if(canWrite){<button type="button" class="btn btn-primary shadow-sm js-me-new"><i class="bi bi-plus-circle-fill me-1"></i>Nuevo medio de pago</button>}</div></div></div></div>
<div class="app-content py-4 erp-listing"><div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="card-body py-2 px-3 erp-filter-bar"><div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <form method="get" class="d-flex flex-wrap align-items-center gap-2 m-0">
            <input type="hidden" name="top" value="@Model.PageSize" /><input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="dir" value="@Model.Dir" />
            <div class="input-group input-group-sm listing-search"><span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span><input name="search" value="@Model.Search" maxlength="150" class="form-control border-start-0" placeholder="Buscar..." aria-label="Buscar Medios de pago" /><button type="submit" class="btn btn-outline-primary">Buscar</button><a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a></div>

            <div class="input-group input-group-sm w-auto"><span class="input-group-text bg-body-tertiary"><i class="bi bi-toggle-on"></i></span><select name="estado" class="form-select" aria-label="Estado"><option value="">Todos los estados</option><option value="A" selected="@(Model.Estado == "A")">Activos</option><option value="I" selected="@(Model.Estado == "I")">Anulados</option></select></div>
        </form><partial name="_ListadoControles" model="Model" />
    </div></div></div>
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="table-responsive table-scroll"><table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
        <thead class="table-header-custom bg-body-tertiary border-bottom"><tr><th erp-sort="codigo">Código</th><th erp-sort="nombre">Nombre</th><th erp-sort="abreviatura">Abreviatura</th><th erp-sort="comision" class="text-end">Comisión (%)</th><th erp-sort="estado">Estado</th><th class="listing-options">Opciones</th></tr></thead><tbody>
        @if(Model.Items.Count == 0){<tr><td colspan="6" class="text-center text-muted py-4">No se encontraron registros.</td></tr>}
        @foreach(var item in Model.Items)
        {
            <tr><td>@item.Codigo</td><td class="fw-semibold">@item.Nombre</td><td>@item.Abreviatura</td><td class="text-end">@item.PorcentajeTarjeta.ToString("N4")</td><td><span class="badge @(item.Estado == "A" ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-body-secondary border")">@(item.Estado == "A" ? "Activo" : "Anulado")</span></td><td class="listing-options"><button type="button" class="btn btn-sm btn-outline-primary js-me-edit" data-id="@item.Id" title="@(canWrite && item.Estado == "A" ? "Editar" : "Consultar")"><i class="bi @(canWrite && item.Estado == "A" ? "bi-pencil" : "bi-eye")"></i></button>@if(canWrite && item.Estado == "A"){<button type="button" class="btn btn-sm btn-outline-danger js-me-cancel" data-id="@item.Id" data-revision="@item.Revision" title="Anular"><i class="bi bi-trash"></i></button>}</td></tr>
        }
        </tbody></table></div><partial name="_ListadoPaginacion" model="Model" /></div>
</div></div>
<partial name="_MaestroEmpresaModal" model='@("medio")' />
@section Scripts {
    <script id="empresa-maestro-config" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        kind = "medio", canWrite, contextoId = ViewBag.ContextoId,

        urls = new { obtener = Url.Action("Obtener"), guardar = Url.Action("Guardar"), anular = Url.Action("Anular"),  }
    }))</script>
    <script src="~/js/maestros-empresa.js" asp-append-version="true"></script>
}