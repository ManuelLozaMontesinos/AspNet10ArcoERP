@model CotizacionPageModel
@{
    ViewData["Title"] = "Cotizaciones de venta";
    bool canWrite = ViewBag.PuedeEscribir == true;
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-file-earmark-text text-primary me-2"></i>Cotizaciones de venta
                </h3>
                <small class="text-muted" data-erp-list-summary>Propuestas comerciales y cotizaciones a clientes · @ViewBag.SedeNombre</small>
            </div>
            @if (canWrite)
            {
                <div class="col-auto">
                    <button type="button" class="btn btn-primary btn-sm shadow-sm js-cot-new">
                        <i class="bi bi-plus-lg me-1"></i>Nueva Cotización
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<div class="app-content py-4 erp-listing">
    <div class="container-fluid">
        @if (Model.Errores.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                <ul class="mb-0">
                    @foreach (var error in Model.Errores)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3 erp-filter-bar">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <form method="get" id="cot-filters" class="d-flex flex-wrap align-items-center gap-2 m-0">
                        <input type="hidden" name="top" value="@Model.PageSize" />
                        <input type="hidden" name="sort" value="@Model.Sort" />
                        <input type="hidden" name="dir" value="@Model.Dir" />

                        <div class="input-group input-group-sm listing-search">
                            <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input name="search" value="@Model.Search" class="form-control border-start-0" maxlength="150" placeholder="Cliente, RUC o número..." aria-label="Buscar cotización" />
                        </div>

                        <select name="vendedorId" class="form-select form-select-sm w-auto" aria-label="Vendedor">
                            <option value="">Todos los vendedores</option>
                            @foreach (var v in Model.Vendedores)
                            {
                                <option value="@v.Id" selected="@(Model.VendedorId == v.Id)">@v.Nombre</option>
                            }
                        </select>

                        <select name="estadoCotizacionId" class="form-select form-select-sm w-auto" aria-label="Estado">
                            <option value="">Todos los estados</option>
                            @foreach (var ec in Model.EstadosCotizacion)
                            {
                                <option value="@ec.Id" selected="@(Model.EstadoCotizacionId == ec.Id)">@ec.Nombre</option>
                            }
                        </select>

                        <div class="d-flex align-items-center gap-1">
                            <span class="small text-muted">Desde:</span>
                            <input type="date" name="fechaDesde" value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm w-auto" />
                            <span class="small text-muted">Hasta:</span>
                            <input type="date" name="fechaHasta" value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm w-auto" />
                        </div>

                        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i>Buscar</button>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
                    </form>
                    <partial name="_ListadoControles" model="Model" />
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="table-responsive table-scroll">
                <table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
                    <thead class="table-header-custom bg-body-tertiary border-bottom">
                        <tr>
                            <th erp-sort="codigo" style="width: 110px;">N° Cotiz.</th>
                            <th erp-sort="fecha" style="width: 105px;">Fecha</th>
                            <th erp-sort="cliente">Cliente</th>
                            <th erp-sort="vendedor">Vendedor</th>
                            <th erp-sort="total" class="text-end" style="width: 130px;">Total</th>
                            <th class="text-center" style="width: 75px;">Ítems</th>
                            <th erp-sort="estado" class="text-center" style="width: 120px;">Estado</th>
                            <th class="listing-options">Opciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr><td colspan="8" class="text-center text-muted py-4">No se encontraron cotizaciones con los filtros aplicados.</td></tr>
                        }
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="font-monospace fw-bold text-primary">@item.Codigo</td>
                                <td>@item.FechaTexto</td>
                                <td>
                                    <div class="fw-semibold">@item.ClienteNombre</div>
                                    @if (!string.IsNullOrEmpty(item.ClienteDocumento))
                                    {
                                        <small class="text-muted font-monospace"><i class="bi bi-card-text me-1"></i>@item.ClienteDocumento</small>
                                    }
                                </td>
                                <td><small>@item.VendedorNombre</small></td>
                                <td class="text-end font-monospace fw-bold">
                                    <span class="text-secondary small">@item.MonedaSimbolo</span> @item.MontoTotalTexto
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@item.CantidadItems</span>
                                </td>
                                <td class="text-center">
                                    @{
                                        string badgeClass = item.EstadoCotizacionCodigo switch
                                        {
                                            "01" => "bg-info-subtle text-info border border-info-subtle",
                                            "02" => "bg-primary-subtle text-primary border border-primary-subtle",
                                            "03" => "bg-success-subtle text-success border border-success-subtle",
                                            "04" => "bg-warning-subtle text-warning border border-warning-subtle",
                                            _ => "bg-danger-subtle text-danger border border-danger-subtle"
                                        };
                                    }
                                    <span class="badge @badgeClass">@item.EstadoCotizacionNombre</span>
                                </td>
                                <td class="listing-options">
                                    <button type="button" class="btn btn-sm btn-outline-primary js-cot-open" data-id="@item.Id" title="Consultar / Editar" aria-label="Consultar / Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <a asp-action="Exportar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success" title="Descargar Excel">
                                        <i class="bi bi-file-earmark-excel"></i>
                                    </a>
                                    @if (canWrite && item.EstadoCotizacionCodigo == "01" && item.Estado == "A")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-warning js-cot-to-pedido" data-id="@item.Id" data-code="@item.Codigo" title="Generar Pedido de Venta">
                                            <i class="bi bi-bag-check"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger js-cot-delete" data-id="@item.Id" data-revision="@item.Revision" data-code="@item.Codigo" title="Anular cotización">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_ListadoPaginacion" model="Model" />
        </div>
    </div>
</div>

<!-- Modal Extendido para Cotización -->
<div class="modal fade" id="cot-modal" tabindex="-1" aria-labelledby="cot-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-body-tertiary">
                <div>
                    <h5 class="modal-title fw-bold" id="cot-modal-title">Cotización</h5>
                    <small id="cot-modal-subtitle" class="text-muted"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-0">
                <!-- Tabs -->
                <ul class="nav nav-tabs px-3 pt-2 bg-body-tertiary border-bottom" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold" id="tab-cot-hdr" data-bs-toggle="tab" data-bs-target="#panel-cot-hdr" type="button" role="tab">
                            <i class="bi bi-info-circle me-1"></i>Datos Generales
                        </button>
                    </li>
                    <li class="nav-item js-cot-tab-detail" role="presentation">
                        <button class="nav-link fw-semibold" id="tab-cot-items" data-bs-toggle="tab" data-bs-target="#panel-cot-items" type="button" role="tab">
                            <i class="bi bi-cart3 me-1"></i>Productos y Servicios
                        </button>
                    </li>
                </ul>

                <div class="tab-content p-3">
                    <!-- Panel 1: Cabecera -->
                    <div class="tab-pane fade show active" id="panel-cot-hdr" role="tabpanel">
                        <form id="cot-header-form" method="post" asp-action="Guardar">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ContextoId" value="@ViewBag.ContextoId" />
                            <input type="hidden" name="Id" id="cot-hdr-id" value="0" />
                            <input type="hidden" name="Revision" id="cot-hdr-rev" value="" />

                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold">N° Cotización</label>
                                    <input type="text" id="cot-hdr-codigo" class="form-control form-control-sm font-monospace fw-bold bg-body-secondary" readonly placeholder="Autogenerado" />
                                </div>
                                <div class="col-md-3">
                                    <label for="cot-hdr-fecha" class="form-label small fw-bold">Fecha <span class="text-danger">*</span></label>
                                    <input type="date" name="Fecha" id="cot-hdr-fecha" class="form-control form-control-sm" required value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="col-md-6">
                                    <label for="cot-hdr-vendedor" class="form-label small fw-bold">Vendedor <span class="text-danger">*</span></label>
                                    <select name="VendedorId" id="cot-hdr-vendedor" class="form-select form-select-sm" required>
                                        <option value="">Seleccione vendedor...</option>
                                        @foreach (var v in Model.Vendedores)
                                        {
                                            <option value="@v.Id">@v.Nombre</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Cliente <span class="text-danger">*</span></label>
                                    <input type="hidden" name="ClienteId" id="cot-hdr-cliente-id" required />
                                    <div class="input-group input-group-sm">
                                        <input type="text" id="cot-hdr-cliente-search" class="form-control" placeholder="Buscar por RUC, DNI o razón social..." autocomplete="off" />
                                        <button type="button" id="cot-btn-find-client" class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
                                    </div>
                                    <div id="cot-client-results" class="list-group position-absolute shadow-sm" style="z-index: 1050; max-height: 200px; overflow-y: auto; display: none;"></div>
                                    <small id="cot-client-selected-label" class="text-primary fw-semibold d-block mt-1"></small>
                                </div>

                                <div class="col-md-3">
                                    <label for="cot-hdr-moneda" class="form-label small fw-bold">Moneda <span class="text-danger">*</span></label>
                                    <select name="MonedaId" id="cot-hdr-moneda" class="form-select form-select-sm" required>
                                        <option value="">Seleccione moneda...</option>
                                        @foreach (var m in Model.Monedas)
                                        {
                                            <option value="@m.Id">@m.Nombre (@m.Codigo)</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label for="cot-hdr-condicion" class="form-label small fw-bold">Condición de Pago <span class="text-danger">*</span></label>
                                    <select name="TipoCondicionPagoId" id="cot-hdr-condicion" class="form-select form-select-sm" required>
                                        <option value="">Seleccione condición...</option>
                                        @foreach (var cp in Model.CondicionesPago)
                                        {
                                            <option value="@cp.Id">@cp.Nombre</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label for="cot-hdr-lista" class="form-label small fw-bold">Lista de Precios <span class="text-danger">*</span></label>
                                    <select name="ListaPrecioId" id="cot-hdr-lista" class="form-select form-select-sm" required>
                                        <option value="">Seleccione lista de precios...</option>
                                        @foreach (var lp in Model.ListasPrecio)
                                        {
                                            <option value="@lp.Id">@lp.Nombre</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label for="cot-hdr-obs" class="form-label small fw-bold">Observaciones</label>
                                    <input type="text" name="Observacion" id="cot-hdr-obs" class="form-control form-control-sm" maxlength="400" placeholder="Notas, dirección de entrega u observaciones..." />
                                </div>
                            </div>

                            <!-- Totales Card -->
                            <div class="card bg-body-tertiary border-0 mt-3 p-3 rounded-3">
                                <div class="row g-2 text-center">
                                    <div class="col-md-3 border-end">
                                        <small class="text-muted d-block">Subtotal Bruto</small>
                                        <strong id="cot-tot-bruto" class="fs-6 font-monospace">0.00</strong>
                                    </div>
                                    <div class="col-md-3 border-end">
                                        <small class="text-muted d-block">Descuento</small>
                                        <strong id="cot-tot-dcto" class="fs-6 font-monospace text-danger">0.00</strong>
                                    </div>
                                    <div class="col-md-3 border-end">
                                        <small class="text-muted d-block">IGV</small>
                                        <strong id="cot-tot-igv" class="fs-6 font-monospace">0.00</strong>
                                    </div>
                                    <div class="col-md-3">
                                        <small class="text-muted d-block">Total</small>
                                        <strong id="cot-tot-total" class="fs-5 font-monospace text-success">0.00</strong>
                                    </div>
                                </div>
                            </div>

                            @if (canWrite)
                            {
                                <div class="mt-3 text-end">
                                    <button type="submit" id="cot-btn-save-hdr" class="btn btn-primary btn-sm px-4">
                                        <i class="bi bi-save me-1"></i>Guardar Cabecera
                                    </button>
                                </div>
                            }
                        </form>
                    </div>

                    <!-- Panel 2: Productos -->
                    <div class="tab-pane fade" id="panel-cot-items" role="tabpanel">
                        @if (canWrite)
                        {
                            <!-- Item Add Form -->
                            <div id="cot-add-item-card" class="card border rounded-3 p-3 mb-3 bg-body-tertiary">
                                <form id="cot-item-form" method="post" asp-action="GuardarProducto">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ContextoId" value="@ViewBag.ContextoId" />
                                    <input type="hidden" name="CotizacionId" id="cot-item-cotid" />
                                    <input type="hidden" name="ProductoId" id="cot-item-pid" />
                                    <input type="hidden" name="Descripcion" id="cot-item-desc" />
                                    <input type="hidden" name="PermiteDescuento" id="cot-item-permdcto" value="N" />

                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-5">
                                            <label class="form-label small fw-bold">Buscar Producto en Lista de Precios <span class="text-danger">*</span></label>
                                            <div class="input-group input-group-sm">
                                                <input type="text" id="cot-item-search" class="form-control" placeholder="Escriba código o nombre de producto..." autocomplete="off" />
                                                <button type="button" id="cot-btn-find-prod" class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
                                            </div>
                                            <div id="cot-prod-results" class="list-group position-absolute shadow-sm" style="z-index: 1050; max-height: 200px; overflow-y: auto; display: none;"></div>
                                            <small id="cot-prod-selected-label" class="text-primary fw-semibold d-block mt-1"></small>
                                        </div>
                                        <div class="col-md-2">
                                            <label for="cot-item-cant" class="form-label small fw-bold">Cantidad</label>
                                            <input type="number" step="0.01" min="0.01" max="999999" name="Cantidad" id="cot-item-cant" class="form-control form-control-sm text-end" value="1.00" required />
                                        </div>
                                        <div class="col-md-2">
                                            <label for="cot-item-pre" class="form-label small fw-bold">Precio Unit. (IGV)</label>
                                            <input type="number" step="0.0001" min="0" max="9999999" name="PrecioUnitario" id="cot-item-pre" class="form-control form-control-sm text-end font-monospace" required />
                                            <input type="hidden" name="ValorUnitario" id="cot-item-val" />
                                        </div>
                                        <div class="col-md-1">
                                            <label for="cot-item-dcto" class="form-label small fw-bold">Dcto %</label>
                                            <input type="number" step="0.01" min="0" max="100" name="PorcentajeDescuento" id="cot-item-dcto" class="form-control form-control-sm text-end" value="0.00" />
                                        </div>
                                        <div class="col-md-2 text-end">
                                            <button type="submit" id="cot-btn-add-item" class="btn btn-primary btn-sm w-100" disabled>
                                                <i class="bi bi-plus-lg me-1"></i>Agregar
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        }

                        <!-- Items Grid -->
                        <div class="table-responsive border rounded-3 mb-2">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead class="table-header-custom bg-body-tertiary">
                                    <tr>
                                        <th style="width: 120px;">Código</th>
                                        <th>Descripción de Producto</th>
                                        <th style="width: 70px;">Und.</th>
                                        <th class="text-end" style="width: 100px;">Cantidad</th>
                                        <th class="text-end" style="width: 120px;">Precio Unit.</th>
                                        <th class="text-end" style="width: 90px;">Dcto %</th>
                                        <th class="text-end" style="width: 130px;">Total</th>
                                        <th class="text-center" style="width: 70px;">Acción</th>
                                    </tr>
                                </thead>
                                <tbody id="cot-items-rows">
                                    <tr><td colspan="8" class="text-center text-muted py-4">No hay productos agregados a esta cotización.</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-body-tertiary py-2 justify-content-between">
                <div>
                    @if (canWrite)
                    {
                        <button type="button" id="cot-btn-modal-pedido" class="btn btn-sm btn-outline-warning" style="display: none;">
                            <i class="bi bi-bag-check me-1"></i>Generar Pedido de Venta
                        </button>
                    }
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Generar Pedido -->
<div class="modal fade" id="cot-pedido-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <form id="cot-pedido-form" class="modal-content border-0 shadow" method="post" asp-action="GenerarPedido">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ContextoId" value="@ViewBag.ContextoId" />
            <input type="hidden" name="CotizacionId" id="cot-ped-id" />
            <div class="modal-header bg-warning-subtle py-2">
                <h6 class="modal-title fw-bold text-dark"><i class="bi bi-bag-check me-1"></i>Generar Pedido</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-2">Se creará un Pedido de Venta a partir de la cotización <strong id="cot-ped-code"></strong>.</p>
                <div class="mb-3">
                    <label for="cot-ped-fecha-ent" class="form-label small fw-bold">Fecha de Entrega Estimada</label>
                    <input type="date" name="FechaEntrega" id="cot-ped-fecha-ent" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-sm btn-warning fw-bold">Confirmar Pedido</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script id="cotizacion-config" type="application/json">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            canWrite,
            contextoId = ViewBag.ContextoId,
            urls = new
            {
                obtener = Url.Action("Obtener"),
                guardar = Url.Action("Guardar"),
                anular = Url.Action("Anular"),
                productos = Url.Action("Productos"),
                guardarProducto = Url.Action("GuardarProducto"),
                eliminarProducto = Url.Action("EliminarProducto"),
                generarPedido = Url.Action("GenerarPedido"),
                buscarClientes = Url.Action("BuscarClientes"),
                buscarProductos = Url.Action("BuscarProductos")
            }
        }))
    </script>
    <script src="~/js/cotizacion.js" asp-append-version="true"></script>
}

