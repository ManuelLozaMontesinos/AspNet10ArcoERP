@model ComprobantePageModel
@{
    ViewData["Title"] = "Cambio de Boletas";
    bool canWrite = ViewBag.PuedeEscribir == true;
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-arrow-repeat text-primary me-2"></i>Cambio de Tipo en Boletas
                </h3>
                <small class="text-muted" data-erp-list-summary>Gestión y cambio de modalidad (Normal / Temporal) de boletas emitidas · @ViewBag.SedeNombre</small>
            </div>
            <div class="col-auto d-flex align-items-center gap-2">
                <a asp-area="VT" asp-controller="Comprobante" asp-action="Index" class="btn btn-outline-secondary btn-sm shadow-sm">
                    <i class="bi bi-receipt me-1"></i>Todos los Comprobantes
                </a>
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4 erp-listing">
    <div class="container-fluid">
        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3 erp-filter-bar">
                <form method="get" class="row g-2 align-items-end">
                    <input type="hidden" name="sort" value="@Model.Sort" />
                    <input type="hidden" name="dir" value="@Model.Dir" />
                    <input type="hidden" name="top" value="@Model.PageSize" />

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-secondary mb-1">Buscar</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" class="form-control border-start-0" name="search" value="@Model.Search" placeholder="Serie, número o cliente..." />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold text-secondary mb-1">Desde</label>
                        <input type="date" class="form-control form-control-sm" name="fechaDesde" value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold text-secondary mb-1">Hasta</label>
                        <input type="date" class="form-control form-control-sm" name="fechaHasta" value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-2 d-flex gap-1">
                        <button type="submit" class="btn btn-primary btn-sm w-100" title="Filtrar">
                            <i class="bi bi-funnel-fill me-1"></i>Filtrar
                        </button>
                        <a asp-action="Index" class="btn btn-light btn-sm border" title="Limpiar"><i class="bi bi-arrow-counterclockwise"></i></a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-sm">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Comprobante</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Documento</th>
                            <th class="text-end">Monto Total</th>
                            <th class="text-center">Modalidad Actual</th>
                            <th>Estado</th>
                            <th class="text-end pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-1"></i>No se encontraron boletas de venta.
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model.Items)
                        {
                            bool esNormal = item.TipoComprobante == "1" || item.TipoComprobante == "NORMAL";
                            <tr>
                                <td class="ps-3 fw-bold text-primary">@item.SerieNumero</td>
                                <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="fw-semibold">@item.ClienteRazonSocial</td>
                                <td><small class="text-muted">@item.ClienteNumeroDocumento</small></td>
                                <td class="text-end fw-bold">S/ @item.MontoTotal.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge @(esNormal ? "bg-primary" : "bg-warning text-dark")">
                                        @(esNormal ? "Normal" : "Temporal")
                                    </span>
                                </td>
                                <td><span class="badge bg-success">@item.EstadoComprobanteNombre</span></td>
                                <td class="text-end pe-3">
                                    @if (canWrite)
                                    {
                                        <button type="button" class="btn btn-outline-primary btn-sm btn-cambiar-tipo" data-id="@item.ComprobanteId" data-tipo="@(esNormal ? "2" : "1")" data-nombre="@(esNormal ? "Temporal" : "Normal")">
                                            <i class="bi bi-arrow-repeat me-1"></i>Cambiar a @(esNormal ? "Temporal" : "Normal")
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.PageCount > 1)
            {
                <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center py-2">
                    <small class="text-muted">Mostrando @Model.Items.Count de @Model.Total registros</small>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int p = 1; p <= Model.PageCount; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = p, top = Model.PageSize, search = Model.Search, fechaDesde = Model.FechaDesde?.ToString("yyyy-MM-dd"), fechaHasta = Model.FechaHasta?.ToString("yyyy-MM-dd"), sort = Model.Sort, dir = Model.Dir })">@p</a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.btn-cambiar-tipo').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const id = this.getAttribute('data-id');
                    const nuevoTipoId = this.getAttribute('data-tipo');
                    const nombre = this.getAttribute('data-nombre');

                    if (!confirm(`¿Confirma cambiar la modalidad de la boleta a ${nombre}?`)) return;

                    try {
                        const res = await fetch(`/VT/CambioBoleta/CambiarTipo?comprobanteId=${id}&nuevoTipoId=${nuevoTipoId}`, {
                            method: 'POST'
                        });
                        const json = await res.json();
                        if (json.success) {
                            alert(json.message || 'Modalidad actualizada con éxito.');
                            location.reload();
                        } else {
                            alert(json.message || 'Error al cambiar la modalidad.');
                        }
                    } catch (e) {
                        console.error(e);
                        alert('Error de conexión.');
                    }
                });
            });
        });
    </script>
}
