@model ListaPrecioPageModel
@{
    ViewData["Title"] = "Listas de precios";
    bool canWrite = ViewBag.PuedeEscribir == true;
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-tags text-primary me-2"></i>Listas de precios
                </h3>
                <small class="text-muted" data-erp-list-summary>Políticas de precios por sede, moneda y productos · @ViewBag.SedeNombre</small>
            </div>
            @if (canWrite)
            {
                <div class="col-auto">
                    <button type="button" class="btn btn-primary btn-sm shadow-sm js-lp-new">
                        <i class="bi bi-plus-lg me-1"></i>Nueva Lista
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<div class="app-content py-4 erp-listing">
    <div class="container-fluid">
        @if (Model.Errores.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                <ul class="mb-0">
                    @foreach (var error in Model.Errores)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3 erp-filter-bar">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <form method="get" id="lp-filters" class="d-flex flex-wrap align-items-center gap-2 m-0">
                        <input type="hidden" name="top" value="@Model.PageSize" />
                        <input type="hidden" name="sort" value="@Model.Sort" />
                        <input type="hidden" name="dir" value="@Model.Dir" />

                        <div class="input-group input-group-sm listing-search">
                            <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input name="search" value="@Model.Search" class="form-control border-start-0" maxlength="100" placeholder="Nombre de lista..." aria-label="Buscar lista" />
                        </div>

                        <select name="sedeId" class="form-select form-select-sm w-auto" aria-label="Filtrar por sede">
                            <option value="">Todas las sedes</option>
                            @foreach (var s in Model.Sedes)
                            {
                                <option value="@s.Id" selected="@(Model.SedeId == s.Id)">@s.Nombre</option>
                            }
                        </select>

                        <select name="monedaId" class="form-select form-select-sm w-auto" aria-label="Filtrar por moneda">
                            <option value="">Todas las monedas</option>
                            @foreach (var m in Model.Monedas)
                            {
                                <option value="@m.Id" selected="@(Model.MonedaId == m.Id)">@m.Nombre (@m.Codigo)</option>
                            }
                        </select>

                        <select name="estado" class="form-select form-select-sm w-auto" aria-label="Filtrar por estado">
                            <option value="">Todos los estados</option>
                            <option value="A" selected="@(Model.Estado == "A")">Activos</option>
                            <option value="I" selected="@(Model.Estado == "I")">Inactivos</option>
                        </select>

                        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i>Buscar</button>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
                    </form>
                    <partial name="_ListadoControles" model="Model" />
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="table-responsive table-scroll">
                <table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
                    <thead class="table-header-custom bg-body-tertiary border-bottom">
                        <tr>
                            <th erp-sort="nombre">Nombre de Lista</th>
                            <th erp-sort="sede">Sede</th>
                            <th erp-sort="moneda">Moneda</th>
                            <th erp-sort="tasa">Afectación</th>
                            <th class="text-center">Productos</th>
                            <th class="text-center">Grupos</th>
                            <th erp-sort="estado" class="text-center">Estado</th>
                            <th class="listing-options">Opciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr><td colspan="8" class="text-center text-muted py-4">No se encontraron listas de precios.</td></tr>
                        }
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td>@item.SedeNombre</td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@item.Simbolo</span> @item.MonedaNombre</td>
                                <td><small class="text-muted">@item.ImpuestoNombre</small> <span class="badge bg-info-subtle text-info">@item.Tasa.ToString("N2")%</span></td>
                                <td class="text-center"><span class="badge bg-light text-dark border">@item.CantidadProductos</span></td>
                                <td class="text-center"><span class="badge bg-light text-dark border">@item.CantidadGrupos</span></td>
                                <td class="text-center">
                                    <span class="badge @(item.Estado == "A" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-body-secondary")">
                                        @(item.Estado == "A" ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="listing-options">
                                    <button type="button" class="btn btn-sm btn-outline-primary js-lp-open" data-id="@item.Id" title="Administrar lista" aria-label="Administrar lista">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <a asp-action="Exportar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success" title="Descargar Excel">
                                        <i class="bi bi-file-earmark-excel"></i>
                                    </a>
                                    @if (canWrite && item.Estado == "A")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger js-lp-delete" data-id="@item.Id" data-revision="@item.Revision" title="Anular lista" aria-label="Anular lista">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_ListadoPaginacion" model="Model" />
        </div>
    </div>
</div>

<!-- Modal Principal Extendido para Lista de Precios -->
<div class="modal fade" id="lp-modal" tabindex="-1" aria-labelledby="lp-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-body-tertiary">
                <div>
                    <h5 class="modal-title fw-bold" id="lp-modal-title">Lista de Precios</h5>
                    <small id="lp-modal-subtitle" class="text-muted"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-0">
                <!-- Tabs -->
                <ul class="nav nav-tabs px-3 pt-2 bg-body-tertiary border-bottom" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold" id="tab-lp-header" data-bs-toggle="tab" data-bs-target="#panel-lp-header" type="button" role="tab">
                            <i class="bi bi-info-circle me-1"></i>Datos Generales
                        </button>
                    </li>
                    <li class="nav-item js-lp-tab-detail" role="presentation">
                        <button class="nav-link fw-semibold" id="tab-lp-products" data-bs-toggle="tab" data-bs-target="#panel-lp-products" type="button" role="tab">
                            <i class="bi bi-box-seam me-1"></i>Productos y Precios
                        </button>
                    </li>
                    <li class="nav-item js-lp-tab-detail" role="presentation">
                        <button class="nav-link fw-semibold" id="tab-lp-groups" data-bs-toggle="tab" data-bs-target="#panel-lp-groups" type="button" role="tab">
                            <i class="bi bi-people me-1"></i>Grupos de Clientes
                        </button>
                    </li>
                    <li class="nav-item js-lp-tab-detail" role="presentation">
                        <button class="nav-link fw-semibold" id="tab-lp-group-products" data-bs-toggle="tab" data-bs-target="#panel-lp-group-products" type="button" role="tab">
                            <i class="bi bi-percent me-1"></i>Precios por Grupo
                        </button>
                    </li>
                </ul>

                <div class="tab-content p-3">
                    <!-- Panel 1: Datos Generales -->
                    <div class="tab-pane fade show active" id="panel-lp-header" role="tabpanel">
                        <form id="lp-header-form" method="post" asp-action="Guardar">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ContextoId" value="@ViewBag.ContextoId" />
                            <input type="hidden" name="Id" id="lp-hdr-id" value="0" />
                            <input type="hidden" name="Revision" id="lp-hdr-rev" value="" />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="lp-hdr-sede" class="form-label small fw-bold">Sede <span class="text-danger">*</span></label>
                                    <select name="EmpresaSedeId" id="lp-hdr-sede" class="form-select form-select-sm" required>
                                        <option value="">Seleccione sede...</option>
                                        @foreach (var s in Model.Sedes)
                                        {
                                            <option value="@s.Id">@s.Nombre</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="lp-hdr-nombre" class="form-label small fw-bold">Nombre de Lista <span class="text-danger">*</span></label>
                                    <input type="text" name="Nombre" id="lp-hdr-nombre" class="form-control form-control-sm" maxlength="100" required placeholder="Ej. LISTA ARCO SOLES 2026" />
                                </div>
                                <div class="col-md-6">
                                    <label for="lp-hdr-tasa" class="form-label small fw-bold">Afectación de Impuesto <span class="text-danger">*</span></label>
                                    <select name="ImpuestoTasaId" id="lp-hdr-tasa" class="form-select form-select-sm" required>
                                        <option value="">Seleccione tipo de afectación...</option>
                                        @foreach (var t in Model.Tasas)
                                        {
                                            <option value="@t.Id" data-tasa="@t.Codigo">@t.Nombre</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="lp-hdr-moneda" class="form-label small fw-bold">Moneda <span class="text-danger">*</span></label>
                                    <select name="MonedaId" id="lp-hdr-moneda" class="form-select form-select-sm" required>
                                        <option value="">Seleccione moneda...</option>
                                        @foreach (var m in Model.Monedas)
                                        {
                                            <option value="@m.Id">@m.Nombre (@m.Codigo)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            @if (canWrite)
                            {
                                <div class="mt-4 text-end">
                                    <button type="submit" class="btn btn-primary btn-sm px-4">
                                        <i class="bi bi-save me-1"></i>Guardar Cabecera
                                    </button>
                                </div>
                            }
                        </form>
                    </div>

                    <!-- Panel 2: Productos y Precios -->
                    <div class="tab-pane fade" id="panel-lp-products" role="tabpanel">
                        <!-- Quick Editor Panel -->
                        <div id="lp-prod-editor" class="border rounded-3 p-3 mb-3 bg-body-tertiary" hidden>
                            <form id="lp-prod-form" method="post" asp-action="GuardarProducto">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ContextoId" value="@ViewBag.ContextoId" />
                                <input type="hidden" name="Id" id="lp-prd-id" />
                                <input type="hidden" name="ListaPrecioId" id="lp-prd-lpid" />
                                <input type="hidden" name="ProductoId" id="lp-prd-pid" />
                                <input type="hidden" name="Revision" id="lp-prd-rev" />

                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong id="lp-prd-title" class="text-primary">Editar Precio de Producto</strong>
                                    <button type="button" class="btn-close js-lp-prod-cancel" aria-label="Cancelar"></button>
                                </div>
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-3">
                                        <label for="lp-prd-val" class="form-label small fw-semibold">Valor Unitario (sin IGV)</label>
                                        <input type="number" step="0.0001" min="0" max="999999999.9999" name="ValorUnitario" id="lp-prd-val" class="form-control form-control-sm text-end" required />
                                    </div>
                                    <div class="col-md-3">
                                        <label for="lp-prd-pre" class="form-label small fw-semibold">Precio Unitario (con IGV)</label>
                                        <input type="number" step="0.0001" min="0" max="999999999.9999" name="PrecioUnitario" id="lp-prd-pre" class="form-control form-control-sm text-end fw-bold text-success" required />
                                    </div>
                                    <div class="col-md-2">
                                        <label for="lp-prd-dcto" class="form-label small fw-semibold">Permite Dcto.</label>
                                        <select name="PermiteDescuento" id="lp-prd-dcto" class="form-select form-select-sm">
                                            <option value="S">Sí</option>
                                            <option value="N">No</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label for="lp-prd-est" class="form-label small fw-semibold">Estado</label>
                                        <select name="Estado" id="lp-prd-est" class="form-select form-select-sm">
                                            <option value="A">Activo</option>
                                            <option value="I">Inactivo</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2 text-end">
                                        @if (canWrite)
                                        {
                                            <button type="submit" class="btn btn-primary btn-sm w-100">
                                                <i class="bi bi-check-lg me-1"></i>Guardar
                                            </button>
                                        }
                                    </div>
                                </div>
                            </form>
                        </div>

                        <!-- Product Filters -->
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                            <div class="input-group input-group-sm listing-search">
                                <span class="input-group-text bg-body-tertiary"><i class="bi bi-search"></i></span>
                                <input id="lp-prod-search" class="form-control" maxlength="150" placeholder="Código o descripción..." />
                                <button type="button" id="lp-prod-btn-search" class="btn btn-outline-primary">Buscar</button>
                                <button type="button" id="lp-prod-btn-clear" class="btn btn-outline-secondary" title="Limpiar"><i class="bi bi-x-lg"></i></button>
                            </div>
                            <select id="lp-prod-status" class="form-select form-select-sm w-auto">
                                <option value="">Todos los estados</option>
                                <option value="A" selected>Solo activos</option>
                                <option value="I">Solo inactivos</option>
                            </select>
                            <select id="lp-prod-size" class="form-select form-select-sm w-auto ms-auto">
                                <option value="25">25 registros</option>
                                <option value="50">50 registros</option>
                                <option value="100">100 registros</option>
                                <option value="500">500 registros</option>
                            </select>
                        </div>

                        <!-- Product Grid -->
                        <div class="table-responsive table-scroll border rounded-3 mb-2">
                            <table class="table table-striped table-hover align-middle mb-0" data-erp-grid="products">
                                <thead class="table-header-custom bg-body-tertiary">
                                    <tr>
                                        <th style="width: 120px;">Código</th>
                                        <th>Descripción de Producto</th>
                                        <th>Familia</th>
                                        <th class="text-end" style="width: 130px;">Valor Unit.</th>
                                        <th class="text-end" style="width: 130px;">Precio Unit.</th>
                                        <th class="text-center" style="width: 90px;">Dcto.</th>
                                        <th class="text-center" style="width: 80px;">Estado</th>
                                        <th class="text-center" style="width: 70px;">Acción</th>
                                    </tr>
                                </thead>
                                <tbody id="lp-prod-rows">
                                    <tr><td colspan="8" class="text-center text-muted py-4">Cargando productos...</td></tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Product Pagination -->
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-2">
                            <small id="lp-prod-range" class="text-muted"></small>
                            <div class="btn-group btn-group-sm">
                                <button type="button" id="lp-prod-prev" class="btn btn-outline-secondary">Anterior</button>
                                <button type="button" id="lp-prod-next" class="btn btn-outline-secondary">Siguiente</button>
                            </div>
                        </div>
                    </div>

                    <!-- Panel 3: Grupos de Clientes -->
                    <div class="tab-pane fade" id="panel-lp-groups" role="tabpanel">
                        @if (canWrite)
                        {
                            <div class="card bg-body-tertiary border-0 mb-3 p-3">
                                <form id="lp-group-add-form" class="row g-2 align-items-end" method="post" asp-action="GuardarGrupo">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ContextoId" value="@ViewBag.ContextoId" />
                                    <input type="hidden" name="ListaPrecioId" id="lp-grp-lpid" />
                                    <div class="col-md-8">
                                        <label for="lp-grp-select" class="form-label small fw-bold">Asignar Grupo de Clientes</label>
                                        <select name="GrupoProveId" id="lp-grp-select" class="form-select form-select-sm" required>
                                            <option value="">Seleccione un grupo de clientes disponible...</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <button type="submit" class="btn btn-primary btn-sm w-100">
                                            <i class="bi bi-plus-lg me-1"></i>Asignar a la Lista
                                        </button>
                                    </div>
                                </form>
                            </div>
                        }

                        <div class="table-responsive border rounded-3">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead class="table-header-custom bg-body-tertiary">
                                    <tr>
                                        <th>Grupo de Clientes</th>
                                        <th class="text-center">Descuentos Especiales</th>
                                        <th class="text-center">Estado</th>
                                        <th class="text-center" style="width: 120px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="lp-groups-rows">
                                    <tr><td colspan="4" class="text-center text-muted py-4">No hay grupos asignados a esta lista.</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Panel 4: Precios por Grupo -->
                    <div class="tab-pane fade" id="panel-lp-group-products" role="tabpanel">
                        <div class="row g-2 align-items-center mb-3">
                            <div class="col-md-6">
                                <label for="lp-gp-group-filter" class="form-label small fw-bold">Grupo de Clientes Seleccionado</label>
                                <select id="lp-gp-group-filter" class="form-select form-select-sm">
                                    <option value="">Seleccione grupo para ver/configurar precios...</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label for="lp-gp-search" class="form-label small fw-bold">Buscar Producto</label>
                                <div class="input-group input-group-sm">
                                    <input id="lp-gp-search" class="form-control" placeholder="Buscar en productos con precio especial..." />
                                    <button type="button" id="lp-gp-btn-find" class="btn btn-outline-primary">Buscar</button>
                                </div>
                            </div>
                        </div>

                        <!-- Editor de porcentaje para grupo -->
                        <div id="lp-gp-editor" class="border rounded-3 p-3 mb-3 bg-body-tertiary" hidden>
                            <form id="lp-gp-form" method="post" asp-action="GuardarGrupoProducto">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ContextoId" value="@ViewBag.ContextoId" />
                                <input type="hidden" name="Id" id="lp-gp-id" value="0" />
                                <input type="hidden" name="ListaPProveId" id="lp-gp-lpproveid" />
                                <input type="hidden" name="ListaPProdId" id="lp-gp-lpprodid" />

                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong id="lp-gp-title" class="text-primary">Configurar Porcentaje de Precio Base</strong>
                                    <button type="button" class="btn-close js-lp-gp-cancel" aria-label="Cancelar"></button>
                                </div>
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-4">
                                        <label for="lp-gp-porc" class="form-label small fw-semibold">% Precio Base (-100% a +1000%)</label>
                                        <input type="number" step="0.01" min="-100" max="1000" name="PorcentajePrecioBase" id="lp-gp-porc" class="form-control form-control-sm text-end" required />
                                    </div>
                                    <div class="col-md-4">
                                        <button type="submit" class="btn btn-primary btn-sm w-100">
                                            <i class="bi bi-save me-1"></i>Guardar Descuento
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>

                        <div class="table-responsive table-scroll border rounded-3 mb-2">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead class="table-header-custom bg-body-tertiary">
                                    <tr>
                                        <th style="width: 120px;">Código</th>
                                        <th>Descripción</th>
                                        <th class="text-end" style="width: 130px;">Precio Lista</th>
                                        <th class="text-end" style="width: 130px;">% Precio Base</th>
                                        <th class="text-center" style="width: 90px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="lp-gp-rows">
                                    <tr><td colspan="5" class="text-center text-muted py-4">Seleccione un grupo para ver sus productos.</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-body-tertiary py-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script id="lista-precio-config" type="application/json">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            canWrite,
            contextoId = ViewBag.ContextoId,
            urls = new
            {
                obtener = Url.Action("Obtener"),
                guardar = Url.Action("Guardar"),
                anular = Url.Action("Anular"),
                productos = Url.Action("Productos"),
                guardarProducto = Url.Action("GuardarProducto"),
                grupos = Url.Action("Grupos"),
                gruposDisponibles = Url.Action("GruposDisponibles"),
                guardarGrupo = Url.Action("GuardarGrupo"),
                quitarGrupo = Url.Action("QuitarGrupo"),
                grupoProductos = Url.Action("GrupoProductos"),
                guardarGrupoProducto = Url.Action("GuardarGrupoProducto"),
                quitarGrupoProducto = Url.Action("QuitarGrupoProducto")
            }
        }))
    </script>
    <script src="~/js/lista-precio.js" asp-append-version="true"></script>
}

