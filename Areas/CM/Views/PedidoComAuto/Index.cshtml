@model PedidoComAutoPageModel
@{
    ViewData["Title"] = "Autorización de requerimientos de compra";
    bool canWrite = ViewBag.PuedeEscribir == true;
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-shield-check text-warning me-2"></i>Autorización de Requerimientos de Compra
                </h3>
                <small class="text-muted" data-erp-list-summary>Bandeja de revisión y aprobación de pedidos internos para adquisición · @ViewBag.SedeNombre</small>
            </div>
            <div class="col-auto">
                <a asp-area="CM" asp-controller="PedidoCompra" asp-action="Index" class="btn btn-outline-secondary btn-sm shadow-sm" title="Ir al listado de requerimientos">
                    <i class="bi bi-arrow-left me-1"></i>Listado de Requerimientos
                </a>
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4 erp-listing">
    <div class="container-fluid">
        @if (Model.Errores.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                <ul class="mb-0">
                    @foreach (var error in Model.Errores)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3 erp-filter-bar">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <form method="get" id="comauto-filters" class="d-flex flex-wrap align-items-center gap-2 m-0">
                        <input type="hidden" name="top" value="@Model.PageSize" />
                        <input type="hidden" name="sort" value="@Model.Sort" />
                        <input type="hidden" name="dir" value="@Model.Dir" />

                        <div class="input-group input-group-sm listing-search">
                            <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input name="search" value="@Model.Search" class="form-control border-start-0" maxlength="150" placeholder="N° Req, proveedor o RUC..." aria-label="Buscar en autorizaciones" />
                        </div>

                        <select name="estadoAprobacionId" class="form-select form-select-sm w-auto" aria-label="Estado de aprobación">
                            <option value="">Todos los estados</option>
                            @foreach (var ea in Model.EstadosAprobacion)
                            {
                                <option value="@ea.Id" selected="@(Model.EstadoAprobacionId == ea.Id)">@ea.Nombre</option>
                            }
                        </select>

                        <select name="tipoProductoId" class="form-select form-select-sm w-auto" aria-label="Tipo de producto">
                            <option value="">Todos los tipos</option>
                            @foreach (var tp in Model.TiposProducto)
                            {
                                <option value="@tp.Id" selected="@(Model.TipoProductoId == tp.Id)">@tp.Nombre</option>
                            }
                        </select>

                        <div class="d-flex align-items-center gap-1">
                            <span class="small text-muted">Desde:</span>
                            <input type="date" name="fechaDesde" value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm w-auto" />
                            <span class="small text-muted">Hasta:</span>
                            <input type="date" name="fechaHasta" value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm w-auto" />
                        </div>

                        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i>Buscar</button>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
                    </form>
                    <partial name="_ListadoControles" model="Model" />
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="table-responsive table-scroll">
                <table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
                    <thead class="table-header-custom bg-body-tertiary border-bottom">
                        <tr>
                            <th erp-sort="codigo" style="width: 105px;">N° Req.</th>
                            <th erp-sort="fecha" style="width: 110px;">Fecha</th>
                            <th erp-sort="tipo" style="width: 130px;">Tipo Prod.</th>
                            <th erp-sort="proveedor">Proveedor</th>
                            <th class="text-center" style="width: 75px;" title="Items">Items</th>
                            <th class="text-center" style="width: 75px;" title="Modificado">Modif.</th>
                            <th erp-sort="aprobacion" class="text-center" style="width: 140px;">Estado Aprob.</th>
                            <th erp-sort="estado" class="text-center" style="width: 130px;">Estado Pedido</th>
                            <th class="listing-options">Opciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr><td colspan="9" class="text-center text-muted py-4">No se encontraron requerimientos para autorización con los filtros aplicados.</td></tr>
                        }
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="font-monospace fw-bold text-primary">@item.Codigo</td>
                                <td>@item.FechaTexto</td>
                                <td><span class="badge bg-light text-dark border">@item.TipoProductoNombre</span></td>
                                <td>
                                    <div class="fw-semibold">@item.ProveedorNombre</div>
                                    @if (!string.IsNullOrEmpty(item.ProveedorDocumento))
                                    {
                                        <small class="text-muted font-monospace"><i class="bi bi-card-text me-1"></i>@item.ProveedorDocumento</small>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-body-secondary text-body fw-bold">@item.CantidadItems</span>
                                </td>
                                <td class="text-center">
                                    @if (item.EsModificacion == "S")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle" title="Modificado">SÍ</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @{
                                        string badgeClass = item.EstadoAprobacionId switch
                                        {
                                            1 => "bg-warning-subtle text-warning border border-warning-subtle", // Pendiente
                                            2 => "bg-success-subtle text-success border border-success-subtle", // Aprobada
                                            3 => "bg-danger-subtle text-danger border border-danger-subtle",   // Desaprobada
                                            _ => "bg-secondary-subtle text-muted border border-secondary-subtle"
                                        };
                                    }
                                    <span class="badge @badgeClass">@(item.EstadoAprobacionNombre ?? "PENDIENTE")</span>
                                </td>
                                <td class="text-center">
                                    @{
                                        string estadoBadge = item.EstadoPedidoCompraCodigo switch
                                        {
                                            "01" => "bg-secondary-subtle text-muted border border-secondary-subtle",
                                            "02" => "bg-info-subtle text-info border border-info-subtle",
                                            "03" => "bg-success-subtle text-success border border-success-subtle",
                                            "04" => "bg-danger-subtle text-danger border border-danger-subtle",
                                            "05" => "bg-warning-subtle text-warning border border-warning-subtle",
                                            _ => "bg-light text-dark border"
                                        };
                                    }
                                    <span class="badge @estadoBadge">@item.EstadoPedidoCompraNombre</span>
                                </td>
                                <td class="listing-options">
                                    <button type="button" class="btn btn-sm btn-outline-primary js-comauto-open" data-id="@item.Id" title="Revisar Solicitud" aria-label="Revisar Solicitud">
                                        <i class="bi bi-shield-check me-1"></i>Revisar
                                    </button>
                                    <a asp-area="CM" asp-controller="PedidoCompra" asp-action="Exportar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success" title="Descargar Excel">
                                        <i class="bi bi-file-earmark-excel"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_ListadoPaginacion" model="Model" />
        </div>
    </div>
</div>

<!-- Modal de Revisión y Autorización -->
<div class="modal fade" id="comauto-modal" tabindex="-1" aria-labelledby="comauto-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-body-tertiary">
                <div>
                    <h5 class="modal-title fw-bold" id="comauto-modal-title">Autorización de Requerimiento de Compra</h5>
                    <small id="comauto-modal-subtitle" class="text-muted"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <!-- Info Card -->
                <div class="card border rounded-3 p-3 mb-3 bg-body-tertiary">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <small class="text-muted d-block">N° Requerimiento</small>
                            <span id="comauto-view-codigo" class="font-monospace fw-bold fs-5 text-primary"></span>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">Fecha de Emisión</small>
                            <span id="comauto-view-fecha" class="fw-semibold"></span>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">Tipo de Producto</small>
                            <span id="comauto-view-tipo" class="badge bg-light text-dark border"></span>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">Estado Aprobación</small>
                            <span id="comauto-view-aprob-badge" class="badge"></span>
                        </div>
                        <div class="col-md-8">
                            <small class="text-muted d-block">Proveedor Asignado</small>
                            <strong id="comauto-view-prov" class="fs-6"></strong>
                            <small id="comauto-view-doc" class="text-muted font-monospace d-block"></small>
                        </div>
                        <div class="col-md-4">
                            <small class="text-muted d-block">Estado Pedido</small>
                            <span id="comauto-view-estado-badge" class="badge"></span>
                        </div>
                        <div class="col-12" id="comauto-view-obs-wrapper">
                            <small class="text-muted d-block">Observaciones / Justificación</small>
                            <span id="comauto-view-obs" class="small fst-italic"></span>
                        </div>
                    </div>
                </div>

                <!-- Products Table -->
                <h6 class="fw-bold mb-2 d-flex align-items-center">
                    <i class="bi bi-box-seam text-primary me-2"></i>Items / Insumos del Requerimiento
                </h6>
                <div class="table-responsive border rounded-3 mb-2">
                    <table class="table table-sm table-striped align-middle mb-0" id="comauto-items-table">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 40px;">#</th>
                                <th style="width: 120px;">Código</th>
                                <th>Descripción</th>
                                <th style="width: 80px;">U.M.</th>
                                <th class="text-end" style="width: 100px;">Cantidad</th>
                                <th class="text-end" style="width: 100px;">P. Neto (kg)</th>
                                <th class="text-end" style="width: 100px;">P. Bruto (kg)</th>
                                <th class="text-center" style="width: 90px;">Stock Prov.</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="8" class="text-center text-muted py-3">Cargando productos...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-body-tertiary">
                <input type="hidden" id="comauto-modal-id" value="0" />
                <input type="hidden" id="comauto-modal-rev" value="" />
                <input type="hidden" id="comauto-modal-contexto" value="@ViewBag.PeriodoEmpresaSedeId" />

                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                @if (canWrite)
                {
                    <button type="button" class="btn btn-outline-danger btn-sm js-comauto-reject">
                        <i class="bi bi-x-circle me-1"></i>Desaprobar
                    </button>
                    <button type="button" class="btn btn-success btn-sm js-comauto-approve">
                        <i class="bi bi-check2-circle me-1"></i>Aprobar Requerimiento
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<form id="comauto-token-form">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/pedido-com-auto.js" asp-append-version="true"></script>
}

