@model PedidoCompraPageModel
@{
    ViewData["Title"] = "Requerimientos de compra";
    bool canWrite = ViewBag.PuedeEscribir == true;
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-cart-check text-primary me-2"></i>Requerimientos de compra
                </h3>
                <small class="text-muted" data-erp-list-summary>Gestión y aprobación de pedidos internos para adquisición · @ViewBag.SedeNombre</small>
            </div>
            <div class="col-auto d-flex align-items-center gap-2">
                <a asp-area="CM" asp-controller="PuntoPedido" asp-action="Index" class="btn btn-outline-secondary btn-sm shadow-sm" title="Revisar stock mínimo y punto de pedido">
                    <i class="bi bi-box-seam me-1"></i>Punto de Pedido
                </a>
                @if (canWrite)
                {
                    <button type="button" class="btn btn-primary btn-sm shadow-sm js-pedco-new">
                        <i class="bi bi-plus-lg me-1"></i>Nuevo Requerimiento
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4 erp-listing">
    <div class="container-fluid">
        @if (Model.Errores.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                <ul class="mb-0">
                    @foreach (var error in Model.Errores)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3 erp-filter-bar">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <form method="get" id="pedco-filters" class="d-flex flex-wrap align-items-center gap-2 m-0">
                        <input type="hidden" name="top" value="@Model.PageSize" />
                        <input type="hidden" name="sort" value="@Model.Sort" />
                        <input type="hidden" name="dir" value="@Model.Dir" />

                        <div class="input-group input-group-sm listing-search">
                            <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input name="search" value="@Model.Search" class="form-control border-start-0" maxlength="150" placeholder="N° Req, proveedor, RUC..." aria-label="Buscar requerimiento" />
                        </div>

                        <select name="tipoProductoId" class="form-select form-select-sm w-auto" aria-label="Tipo de Producto">
                            <option value="">Todos los tipos</option>
                            @foreach (var tp in Model.TiposProducto)
                            {
                                <option value="@tp.Id" selected="@(Model.TipoProductoId == tp.Id)">@tp.Descripcion</option>
                            }
                        </select>

                        <select name="estadoPedidoCompraId" class="form-select form-select-sm w-auto" aria-label="Estado Pedido">
                            <option value="">Todos los estados</option>
                            @foreach (var ep in Model.EstadosPedidoCompra)
                            {
                                <option value="@ep.Id" selected="@(Model.EstadoPedidoCompraId == ep.Id)">@ep.Descripcion</option>
                            }
                        </select>

                        <select name="estadoAprobacionId" class="form-select form-select-sm w-auto" aria-label="Estado Aprobación">
                            <option value="">Toda aprobación</option>
                            @foreach (var ea in Model.EstadosAprobacion)
                            {
                                <option value="@ea.Id" selected="@(Model.EstadoAprobacionId == ea.Id)">@ea.Descripcion</option>
                            }
                        </select>

                        <div class="d-flex align-items-center gap-1">
                            <span class="small text-muted">Desde:</span>
                            <input type="date" name="fechaDesde" value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm w-auto" />
                            <span class="small text-muted">Hasta:</span>
                            <input type="date" name="fechaHasta" value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm w-auto" />
                        </div>

                        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i>Buscar</button>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
                    </form>
                    <partial name="_ListadoControles" model="Model" />
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="table-responsive table-scroll">
                <table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
                    <thead class="table-header-custom bg-body-tertiary border-bottom">
                        <tr>
                            <th erp-sort="codigo" style="width: 105px;">N° Req.</th>
                            <th erp-sort="fecha" style="width: 110px;">Fecha</th>
                            <th erp-sort="tipo" style="width: 130px;">Tipo Prod.</th>
                            <th erp-sort="proveedor">Proveedor</th>
                            <th class="text-center" style="width: 75px;" title="Cantidad de items registrados">Items</th>
                            <th class="text-center" style="width: 75px;" title="Indica si es una solicitud modificada">Modif.</th>
                            <th erp-sort="aprobacion" class="text-center" style="width: 130px;">Aprobación</th>
                            <th erp-sort="estado" class="text-center" style="width: 130px;">Estado</th>
                            <th class="listing-options">Opciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr><td colspan="9" class="text-center text-muted py-4">No se encontraron requerimientos de compra con los filtros aplicados.</td></tr>
                        }
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="font-monospace fw-bold text-primary">@item.Codigo</td>
                                <td>@item.FechaTexto</td>
                                <td><span class="badge bg-light text-dark border">@item.TipoProductoNombre</span></td>
                                <td>
                                    <div class="fw-semibold">@item.ProveedorNombre</div>
                                    @if (!string.IsNullOrEmpty(item.ProveedorDocumento))
                                    {
                                        <small class="text-muted font-monospace"><i class="bi bi-card-text me-1"></i>@item.ProveedorDocumento</small>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-body-secondary text-body fw-bold">@item.CantidadItems</span>
                                </td>
                                <td class="text-center">
                                    @if (item.EsModificacion == "S")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle" title="Modificado">SÍ</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @{
                                        string authBadge = item.EstadoAprobacionCodigo switch
                                        {
                                            "02" => "bg-success-subtle text-success border border-success-subtle", // Aprobado
                                            "03" => "bg-danger-subtle text-danger border border-danger-subtle",   // Desaprobado
                                            "01" => "bg-warning-subtle text-warning border border-warning-subtle", // Pendiente
                                            _ => "bg-secondary-subtle text-muted border border-secondary-subtle"
                                        };
                                        string authText = !string.IsNullOrEmpty(item.EstadoAprobacionNombre) ? item.EstadoAprobacionNombre : "SIN SOLICITAR";
                                    }
                                    <span class="badge @authBadge">@authText</span>
                                </td>
                                <td class="text-center">
                                    @{
                                        string estadoBadge = item.EstadoPedidoCompraCodigo switch
                                        {
                                            "01" => "bg-secondary-subtle text-muted border border-secondary-subtle",  // En edición
                                            "02" => "bg-info-subtle text-info border border-info-subtle",             // Pedido
                                            "03" => "bg-success-subtle text-success border border-success-subtle",    // Con orden de compra
                                            "04" => "bg-danger-subtle text-danger border border-danger-subtle",       // Anulado
                                            "05" => "bg-warning-subtle text-warning border border-warning-subtle",    // Modificación
                                            _ => "bg-light text-dark border"
                                        };
                                    }
                                    <span class="badge @estadoBadge">@item.EstadoPedidoCompraNombre</span>
                                </td>
                                <td class="listing-options">
                                    <button type="button" class="btn btn-sm btn-outline-primary js-pedco-open" data-id="@item.Id" title="Consultar / Editar" aria-label="Consultar / Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <a asp-action="Exportar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success" title="Descargar Excel">
                                        <i class="bi bi-file-earmark-excel"></i>
                                    </a>
                                    @if (canWrite)
                                    {
                                        @if (item.EstadoPedidoCompraCodigo == "01" || item.EstadoAprobacionCodigo == "03")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-info js-pedco-send-auth" data-id="@item.Id" data-revision="@item.Revision" data-code="@item.Codigo" title="Solicitar Aprobación">
                                                <i class="bi bi-send-check"></i>
                                            </button>
                                        }
                                        @if (item.EstadoPedidoCompraCodigo is "01" or "02")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger js-pedco-delete" data-id="@item.Id" data-revision="@item.Revision" data-code="@item.Codigo" title="Anular Requerimiento">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_ListadoPaginacion" model="Model" />
        </div>
    </div>
</div>

<!-- Modal Extendido para Pedido de Compra -->
<div class="modal fade" id="pedco-modal" tabindex="-1" aria-labelledby="pedco-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-body-tertiary">
                <div>
                    <h5 class="modal-title fw-bold" id="pedco-modal-title">Requerimiento de Compra</h5>
                    <small id="pedco-modal-subtitle" class="text-muted"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-0">
                <!-- Tabs -->
                <ul class="nav nav-tabs px-3 pt-2 bg-body-tertiary border-bottom" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold" id="tab-pedco-hdr" data-bs-toggle="tab" data-bs-target="#panel-pedco-hdr" type="button" role="tab">
                            <i class="bi bi-info-circle me-1"></i>Datos Generales
                        </button>
                    </li>
                    <li class="nav-item js-pedco-tab-detail" role="presentation">
                        <button class="nav-link fw-semibold" id="tab-pedco-items" data-bs-toggle="tab" data-bs-target="#panel-pedco-items" type="button" role="tab">
                            <i class="bi bi-box-seam me-1"></i>Productos del Requerimiento
                        </button>
                    </li>
                </ul>

                <div class="tab-content p-3">
                    <!-- Panel 1: Cabecera -->
                    <div class="tab-pane fade show active" id="panel-pedco-hdr" role="tabpanel">
                        <form id="pedco-form" class="row g-3">
                            <input type="hidden" name="Id" id="pedco-id" value="0" />
                            <input type="hidden" name="ContextoId" id="pedco-contexto-id" value="@ViewBag.PeriodoEmpresaSedeId" />
                            <input type="hidden" name="Revision" id="pedco-revision" value="" />

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Número de Requerimiento</label>
                                <input type="text" id="pedco-codigo" class="form-control form-control-sm font-monospace fw-bold bg-body-tertiary" readonly placeholder="[Autogenerado]" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold required">Fecha de Emisión</label>
                                <input type="date" name="Fecha" id="pedco-fecha" class="form-control form-control-sm" required />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold required">Tipo de Producto</label>
                                <select name="TipoProductoId" id="pedco-tipo-prod" class="form-select form-select-sm" required>
                                    <option value="">Seleccione...</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Estado Actual</label>
                                <div>
                                    <span id="pedco-estado-badge" class="badge bg-secondary-subtle text-muted border">En Edición</span>
                                    <span id="pedco-aprob-badge" class="badge bg-light text-dark border ms-1">Sin Enviar</span>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label small fw-semibold required">Proveedor Sugerido / Asignado</label>
                                <div class="input-group input-group-sm">
                                    <input type="hidden" name="ProveedorId" id="pedco-prov-id" required />
                                    <input type="text" id="pedco-prov-text" class="form-control" placeholder="Buscar proveedor por razón social o RUC..." autocomplete="off" />
                                    <button class="btn btn-outline-secondary js-pedco-search-prov" type="button" title="Buscar proveedor"><i class="bi bi-search"></i></button>
                                </div>
                                <div id="pedco-prov-results" class="list-group position-absolute shadow-sm d-none mt-1" style="z-index: 1055; max-height: 200px; overflow-y: auto; width: 60%;"></div>
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-semibold">Observaciones / Justificación</label>
                                <textarea name="Observacion" id="pedco-observa" class="form-control form-control-sm" rows="3" maxlength="400" placeholder="Motivo del requerimiento o detalles para el área de compras..."></textarea>
                            </div>

                            <div class="col-12 text-end border-top pt-3">
                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                                @if (canWrite)
                                {
                                    <button type="submit" class="btn btn-primary btn-sm ms-2" id="pedco-save-btn">
                                        <i class="bi bi-check-lg me-1"></i>Guardar Cabecera
                                    </button>
                                    <button type="button" class="btn btn-info btn-sm ms-2 d-none" id="pedco-btn-request-auth">
                                        <i class="bi bi-send-check me-1"></i>Solicitar Aprobación
                                    </button>
                                }
                            </div>
                        </form>
                    </div>

                    <!-- Panel 2: Detalle de Productos -->
                    <div class="tab-pane fade" id="panel-pedco-items" role="tabpanel">
                        @if (canWrite)
                        {
                            <div class="card border mb-3 bg-light-subtle js-pedco-item-editor">
                                <div class="card-body p-3">
                                    <form id="pedco-item-form" class="row g-2 align-items-end">
                                        <input type="hidden" name="Id" id="pedco-item-id" value="0" />
                                        <input type="hidden" name="PedidoCompraId" id="pedco-item-ped-id" value="0" />
                                        <input type="hidden" name="ContextoId" value="@ViewBag.PeriodoEmpresaSedeId" />
                                        <input type="hidden" name="ProductoId" id="pedco-item-prod-id" value="" />

                                        <div class="col-md-5 position-relative">
                                            <label class="form-label small fw-semibold required">Producto / Insumo</label>
                                            <input type="text" id="pedco-item-prod-search" class="form-control form-control-sm" placeholder="Buscar código o descripción..." autocomplete="off" />
                                            <div id="pedco-item-prod-results" class="list-group position-absolute shadow-sm d-none mt-1 w-100" style="z-index: 1056; max-height: 200px; overflow-y: auto;"></div>
                                        </div>

                                        <div class="col-md-7">
                                            <label class="form-label small fw-semibold required">Descripción en el Requerimiento</label>
                                            <input type="text" name="Descripcion" id="pedco-item-desc" class="form-control form-control-sm" maxlength="100" required />
                                        </div>

                                        <div class="col-md-2">
                                            <label class="form-label small fw-semibold required">Cantidad</label>
                                            <input type="number" name="Cantidad" id="pedco-item-cant" step="0.0001" min="0.0001" class="form-control form-control-sm text-end" value="1.0000" required />
                                        </div>

                                        <div class="col-md-2">
                                            <label class="form-label small fw-semibold">Peso Neto (kg)</label>
                                            <input type="number" name="PesoNeto" id="pedco-item-pneto" step="0.0001" min="0" class="form-control form-control-sm text-end" value="0.0000" />
                                        </div>

                                        <div class="col-md-2">
                                            <label class="form-label small fw-semibold">Peso Bruto (kg)</label>
                                            <input type="number" name="PesoBruto" id="pedco-item-pbruto" step="0.0001" min="0" class="form-control form-control-sm text-end" value="0.0000" />
                                        </div>

                                        <div class="col-md-3">
                                            <div class="form-check pt-4">
                                                <input class="form-check-input" type="checkbox" name="StockEnProveedor" value="S" id="pedco-item-stock-prov" />
                                                <label class="form-check-label small" for="pedco-item-stock-prov">Stock en Proveedor</label>
                                            </div>
                                        </div>

                                        <div class="col-md-3 text-end">
                                            <button type="submit" class="btn btn-sm btn-primary">
                                                <i class="bi bi-plus-lg me-1"></i><span id="pedco-item-submit-lbl">Agregar Producto</span>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary js-pedco-cancel-item d-none">Cancelar</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        }

                        <div class="table-responsive border rounded">
                            <table class="table table-sm table-striped align-middle mb-0" id="pedco-items-table">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 40px;">#</th>
                                        <th style="width: 120px;">Código</th>
                                        <th>Descripción</th>
                                        <th style="width: 70px;">U.M.</th>
                                        <th class="text-end" style="width: 90px;">Cantidad</th>
                                        <th class="text-end" style="width: 90px;">P. Neto</th>
                                        <th class="text-end" style="width: 90px;">P. Bruto</th>
                                        <th class="text-center" style="width: 90px;">Stock Prov.</th>
                                        <th class="text-center" style="width: 80px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr><td colspan="9" class="text-center text-muted py-3">No hay productos agregados.</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<form id="pedco-token-form">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/pedido-compra.js" asp-append-version="true"></script>
}

