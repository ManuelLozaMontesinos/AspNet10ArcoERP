@model ValorizaCompraPageModel
@{
    ViewData["Title"] = "Valorización de compras";
    bool canWrite = ViewBag.PuedeEscribir == true;
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-receipt text-primary me-2"></i>Valorización de Compras
                </h3>
                <small class="text-muted" data-erp-list-summary>Comprobantes tributarios de compras vinculados a órdenes de compra · @ViewBag.SedeNombre</small>
            </div>
            <div class="col-auto d-flex align-items-center gap-2">
                <a asp-area="CM" asp-controller="OrdenCompra" asp-action="Index" class="btn btn-outline-secondary btn-sm shadow-sm" title="Ir a órdenes de compra">
                    <i class="bi bi-file-earmark-check me-1"></i>Órdenes de Compra
                </a>
                @if (canWrite)
                {
                    <button type="button" class="btn btn-primary btn-sm shadow-sm js-valco-new">
                        <i class="bi bi-plus-lg me-1"></i>Nuevo Comprobante
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4 erp-listing">
    <div class="container-fluid">
        @if (Model.Errores.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                <ul class="mb-0">
                    @foreach (var error in Model.Errores)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3 erp-filter-bar">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <form method="get" id="valco-filters" class="d-flex flex-wrap align-items-center gap-2 m-0">
                        <input type="hidden" name="top" value="@Model.PageSize" />
                        <input type="hidden" name="sort" value="@Model.Sort" />
                        <input type="hidden" name="dir" value="@Model.Dir" />

                        <div class="input-group input-group-sm listing-search">
                            <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input name="search" value="@Model.Search" class="form-control border-start-0" maxlength="150" placeholder="O/C, proveedor, RUC, serie..." aria-label="Buscar comprobante" />
                        </div>

                        <select name="tipoDocumentoComercialId" class="form-select form-select-sm w-auto" aria-label="Tipo Comprobante">
                            <option value="">Todos los tipos</option>
                            @foreach (var tdc in Model.TiposDocumentoComercial)
                            {
                                <option value="@tdc.Id" selected="@(Model.TipoDocumentoComercialId == tdc.Id)">@tdc.Nombre</option>
                            }
                        </select>

                        <select name="condicionPagoId" class="form-select form-select-sm w-auto" aria-label="Condición de Pago">
                            <option value="">Todas las condiciones</option>
                            @foreach (var cp in Model.CondicionesPago)
                            {
                                <option value="@cp.Id" selected="@(Model.CondicionPagoId == cp.Id)">@cp.Nombre</option>
                            }
                        </select>

                        <div class="d-flex align-items-center gap-1">
                            <span class="small text-muted">Desde:</span>
                            <input type="date" name="fechaDesde" value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm w-auto" />
                            <span class="small text-muted">Hasta:</span>
                            <input type="date" name="fechaHasta" value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm w-auto" />
                        </div>

                        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i>Buscar</button>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
                    </form>
                    <partial name="_ListadoControles" model="Model" />
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="table-responsive table-scroll">
                <table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
                    <thead class="table-header-custom bg-body-tertiary border-bottom">
                        <tr>
                            <th erp-sort="codigo" style="width: 105px;">O/C</th>
                            <th erp-sort="documento" style="width: 150px;">Comprobante</th>
                            <th erp-sort="proveedor">Proveedor</th>
                            <th erp-sort="fecha" style="width: 110px;">Fecha Emisión</th>
                            <th style="width: 110px;">Fecha Vcto.</th>
                            <th style="width: 140px;">Condición</th>
                            <th erp-sort="total" class="text-end" style="width: 130px;">Total</th>
                            <th class="listing-options">Opciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">No se encontraron comprobantes de compras con los filtros aplicados.</td>
                            </tr>
                        }
                        @foreach (var row in Model.Items)
                        {
                            <tr>
                                <td class="font-monospace fw-bold text-primary">
                                    <i class="bi bi-file-earmark-check me-1"></i>@row.OrdenCompraCodigo
                                </td>
                                <td>
                                    <div class="fw-semibold">
                                        <span class="badge bg-secondary-subtle text-secondary me-1">@row.TipoDocumentoComercialAbrev</span>
                                        @row.DocumentoCompleto
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold">@row.ProveedorNombre</div>
                                    <small class="text-muted font-monospace"><i class="bi bi-card-text me-1"></i>@row.ProveedorDocumento</small>
                                </td>
                                <td>@row.FechaTexto</td>
                                <td>@(row.FechaVencimientoTexto ?? "-")</td>
                                <td>@(string.IsNullOrWhiteSpace(row.CondicionPagoNombre) ? "-" : row.CondicionPagoNombre)</td>
                                <td class="text-end font-monospace fw-bold">
                                    <span class="text-secondary small">@row.MonedaSimbolo</span> @row.MontoTotalTexto
                                </td>
                                <td class="listing-options">
                                    @if (canWrite)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary js-valco-edit" data-id="@row.Id" title="Editar comprobante">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger js-valco-del" data-id="@row.Id" data-doc="@row.DocumentoCompleto" data-contexto="@row.PeriodoEmpresaSedeId" title="Eliminar comprobante">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_ListadoPaginacion" model="Model" />
        </div>
    </div>
</div>

<!-- Modal Comprobante Compra -->
<div class="modal fade" id="valco-modal" tabindex="-1" aria-labelledby="valcoModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="valcoModalLabel">
                    <i class="bi bi-receipt me-2"></i>Registrar Comprobante de Compra
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="valco-form" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="valco-id" value="0" />
                <input type="hidden" name="ContextoId" id="valco-contexto-id" value="@ViewBag.PeriodoEmpresaSedeId" />
                <input type="hidden" name="Revision" id="valco-revision" />
                <input type="hidden" name="OrdenCompraId" id="valco-oc-id" />

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12" id="valco-oc-section">
                            <label class="form-label fw-semibold">Orden de Compra <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-file-earmark-check"></i></span>
                                <input type="text" class="form-control" id="valco-oc-search" placeholder="Escriba el número de O/C o nombre de proveedor..." autocomplete="off" />
                            </div>
                            <div id="valco-oc-results" class="list-group position-absolute shadow-lg d-none mt-1" style="z-index: 1055; width: 90%; max-height: 220px; overflow-y: auto;"></div>
                            <div id="valco-oc-selected" class="mt-2 p-2 bg-light border rounded-3 d-none">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <span class="badge bg-primary me-2" id="valco-oc-codigo-badge">O/C: -</span>
                                        <strong id="valco-oc-proveedor-text">Proveedor</strong>
                                        <span class="text-muted ms-2" id="valco-oc-monto-text"></span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-link text-danger p-0 js-valco-clear-oc" title="Cambiar orden">
                                        <i class="bi bi-x-circle fs-5"></i>
                                    </button>
                                </div>
                            </div>
                            <small class="text-muted">El comprobante debe estar vinculado obligatoriamente a una orden de compra registrada.</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tipo Comprobante <span class="text-danger">*</span></label>
                            <select name="TipoDocumentoComercialId" id="valco-tipo-doc" class="form-select" required>
                                <option value="">-- Seleccione tipo --</option>
                                @foreach (var tdc in Model.TiposDocumentoComercial)
                                {
                                    <option value="@tdc.Id">@tdc.Nombre</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Serie <span class="text-danger">*</span></label>
                            <input type="text" name="Serie" id="valco-serie" class="form-control text-uppercase" maxlength="4" placeholder="F001" required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Número <span class="text-danger">*</span></label>
                            <input type="text" name="Numero" id="valco-numero" class="form-control" maxlength="8" placeholder="00012345" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Fecha Emisión <span class="text-danger">*</span></label>
                            <input type="date" name="Fecha" id="valco-fecha" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Fecha Vencimiento</label>
                            <input type="date" name="FechaVencimiento" id="valco-fecha-vcto" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Condición de Pago</label>
                            <select name="CondicionPagoId" id="valco-cond-pago" class="form-select">
                                <option value="">-- Seleccione --</option>
                                @foreach (var cp in Model.CondicionesPago)
                                {
                                    <option value="@cp.Id">@cp.Nombre</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Monto Total <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light fw-bold" id="valco-moneda-simbolo">S/</span>
                                <input type="number" step="0.01" min="0.01" name="MontoTotal" id="valco-monto-total" class="form-control text-end fw-bold fs-5" placeholder="0.00" required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card border bg-light p-2 h-100 justify-content-center">
                                <div class="d-flex justify-content-between small text-muted">
                                    <span>Subtotal estimado:</span>
                                    <span id="valco-subtotal-calc">S/ 0.00</span>
                                </div>
                                <div class="d-flex justify-content-between small text-muted">
                                    <span>I.G.V. (18%):</span>
                                    <span id="valco-igv-calc">S/ 0.00</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i>Cancelar
                    </button>
                    @if (canWrite)
                    {
                        <button type="submit" class="btn btn-primary shadow-sm" id="valco-btn-save">
                            <i class="bi bi-check-lg me-1"></i>Guardar Comprobante
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/valoriza-compra.js" asp-append-version="true"></script>
}
