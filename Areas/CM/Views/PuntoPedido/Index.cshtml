@model PuntoPedidoPageModel
@{
    ViewData["Title"] = "Punto de pedido";
    var query = Model.Filtro.Query(Model.Sort,Model.Dir);
    bool ready = Model.Consultada && Model.Contexto.Errores.Count==0;
    var detailColumns = new[] { new { campo="codigo",titulo="Código",numero=false },new { campo="producto",titulo="Producto",numero=false },new { campo="unidad",titulo="U.M.",numero=false },new { campo="proveedor",titulo="Proveedor",numero=false },new { campo="documento",titulo="Documento",numero=false },new { campo="minimo",titulo="Stock mínimo",numero=true },new { campo="saldo",titulo="Saldo disponible",numero=true },new { campo="pesoNeto",titulo="Peso neto",numero=true },new { campo="pesoBruto",titulo="Peso bruto",numero=true },new { campo="masterPack",titulo="Master pack",numero=true } };
    string N(decimal value)=>value.ToString("G29",System.Globalization.CultureInfo.InvariantCulture);
}
<div class="app-content-header py-3 border-bottom"><div class="container-fluid"><div class="row align-items-center g-3">
    <div class="col"><h3 class="mb-0 fw-bold d-flex align-items-center"><i class="bi bi-cart-plus text-primary me-2"></i>Punto de pedido</h3><small class="text-muted" data-erp-list-summary>@Model.Resumen</small></div>
    <div class="col-auto" data-erp-list-actions>@if(ready){<a asp-action="Exportar" asp-all-route-data="query" class="btn btn-sm btn-outline-success" data-full-navigation><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>}else{<button type="button" class="btn btn-sm btn-outline-success" disabled>Excel</button>}</div>
</div></div></div>
<div class="app-content py-4 erp-listing"><div class="container-fluid">
    @if(Model.Contexto.Errores.Count>0){<div class="alert alert-warning" role="alert"><ul class="mb-0">@foreach(var error in Model.Contexto.Errores){<li>@error</li>}</ul></div>}
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="card-body py-2 px-3 erp-filter-bar"><div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <form method="get" id="pp-filters" class="d-flex flex-wrap align-items-center gap-2 m-0">
            <input type="hidden" name="top" value="@Model.PageSize" /><input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="dir" value="@Model.Dir" />
            <div class="input-group input-group-sm listing-search"><span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span><input class="form-control border-start-0" name="search" value="@Model.Filtro.Search" maxlength="150" placeholder="Producto o proveedor..." aria-label="Buscar producto o proveedor" /></div>
            <select name="consultaId" class="form-select form-select-sm w-auto" aria-label="Sede de consulta"><option value="">Seleccione una sede</option>@foreach(var item in Model.Contexto.Sedes){<option value="@item.Id" selected="@(Model.Filtro.ConsultaId==item.Id)">@item.Nombre</option>}</select>
            <input class="form-control form-control-sm w-auto" name="codigo" value="@Model.Filtro.Codigo" maxlength="12" placeholder="Código de producto" aria-label="Código de producto" />
            <input class="form-control form-control-sm w-auto" name="documento" value="@Model.Filtro.Documento" maxlength="35" placeholder="Documento exacto" aria-label="Documento del proveedor" />
            <input class="form-control form-control-sm w-auto" name="razonSocial" value="@Model.Filtro.RazonSocial" maxlength="150" placeholder="Razón social del proveedor" aria-label="Razón social del proveedor" />
            <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i>Buscar</button><a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
        </form><partial name="_ListadoControles" model="Model" />
    </div></div></div>
    <p class="small text-muted">Saldos disponibles de los meses de almacén abiertos, descontando reservas. Una fila por relación producto–proveedor; el saldo y mínimo se repiten si hay varios proveedores.</p>
    <div class="card border-0 shadow-sm rounded-3 mb-3"><div class="table-responsive table-scroll"><table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
        <thead class="table-header-custom bg-body-tertiary border-bottom"><tr><th erp-sort="codigo">Código</th><th erp-sort="producto">Producto</th><th erp-sort="unidad">U.M.</th><th erp-sort="proveedor">Proveedor</th><th erp-sort="documento">Documento</th><th erp-sort="minimo" erp-numeric="true" class="text-end">Stock mínimo</th><th erp-sort="saldo" erp-numeric="true" class="text-end">Saldo disponible</th><th class="listing-options">Opciones</th></tr></thead>
        <tbody>@if(Model.Items.Count==0){<tr><td colspan="8" class="text-center text-muted py-4">@(Model.Consultada?"No se encontraron productos bajo mínimo para los filtros seleccionados.":"Seleccione una sede para consultar.")</td></tr>}
        @foreach(var row in Model.Items){<tr><td>@row.Codigo</td><td>@row.Producto</td><td>@row.Unidad</td><td>@row.Proveedor</td><td>@row.Documento</td><td class="text-end">@row.StockMinimo.ToString("N4")</td><td class="text-end">@row.Saldo.ToString("N4")</td><td class="listing-options"><button type="button" class="btn btn-sm btn-outline-primary js-vr-row" title="Consultar registro" data-row="@System.Text.Json.JsonSerializer.Serialize(new{codigo=row.Codigo,producto=row.Producto,unidad=row.Unidad,proveedor=row.Proveedor,documento=row.Documento,minimo=N(row.StockMinimo),saldo=N(row.Saldo),pesoNeto=N(row.PesoNeto),pesoBruto=N(row.PesoBruto),masterPack=row.MasterPack.ToString(System.Globalization.CultureInfo.InvariantCulture)})"><i class="bi bi-eye"></i></button></td></tr>}
        </tbody></table></div><partial name="_ListadoPaginacion" model="Model" /></div>
</div></div>
<div class="modal fade" id="vr-modal" tabindex="-1" aria-labelledby="vr-title" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header sticky-top bg-body-tertiary"><h5 class="modal-title" id="vr-title">Producto y proveedor</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
    <div class="modal-body"><dl id="vr-detail" class="row mb-0"></dl></div><div class="modal-footer sticky-bottom bg-body-tertiary"><button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button></div>
</div></div></div>
@section Scripts {
    <script id="ventas-reporte-config" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new{columns=detailColumns.Select(c=>new{c.campo,c.titulo,c.numero,fecha=false})}))</script>
    <script src="~/js/ventas-reportes.js" asp-append-version="true"></script>
}
