@model OrdenCompraPageModel
@{
    ViewData["Title"] = "Órdenes de compra";
    bool canWrite = ViewBag.PuedeEscribir == true;
}

<div class="app-content-header py-3 border-bottom">
    <div class="container-fluid">
        <div class="row align-items-center g-3">
            <div class="col">
                <h3 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-file-earmark-check text-primary me-2"></i>Órdenes de Compra
                </h3>
                <small class="text-muted" data-erp-list-summary>Órdenes comerciales a proveedores y suministros · @ViewBag.SedeNombre</small>
            </div>
            <div class="col-auto d-flex align-items-center gap-2">
                <a asp-area="CM" asp-controller="PedidoCompra" asp-action="Index" class="btn btn-outline-secondary btn-sm shadow-sm" title="Ver requerimientos de compra">
                    <i class="bi bi-cart-check me-1"></i>Requerimientos
                </a>
                @if (canWrite)
                {
                    <button type="button" class="btn btn-primary btn-sm shadow-sm js-oc-new">
                        <i class="bi bi-plus-lg me-1"></i>Nueva Orden de Compra
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<div class="app-content py-4 erp-listing">
    <div class="container-fluid">
        @if (Model.Errores.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                <ul class="mb-0">
                    @foreach (var error in Model.Errores)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body py-2 px-3 erp-filter-bar">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <form method="get" id="oc-filters" class="d-flex flex-wrap align-items-center gap-2 m-0">
                        <input type="hidden" name="top" value="@Model.PageSize" />
                        <input type="hidden" name="sort" value="@Model.Sort" />
                        <input type="hidden" name="dir" value="@Model.Dir" />

                        <div class="input-group input-group-sm listing-search">
                            <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input name="search" value="@Model.Search" class="form-control border-start-0" maxlength="150" placeholder="N° Orden, proveedor o RUC..." aria-label="Buscar orden de compra" />
                        </div>

                        <select name="tipoProductoId" class="form-select form-select-sm w-auto" aria-label="Tipo de Producto">
                            <option value="">Todos los tipos</option>
                            @foreach (var tp in Model.TiposProducto)
                            {
                                <option value="@tp.Id" selected="@(Model.TipoProductoId == tp.Id)">@tp.Nombre</option>
                            }
                        </select>

                        <select name="estadoOrdenCompraId" class="form-select form-select-sm w-auto" aria-label="Estado Orden">
                            <option value="">Todos los estados</option>
                            @foreach (var eo in Model.EstadosOrdenCompra)
                            {
                                <option value="@eo.Id" selected="@(Model.EstadoOrdenCompraId == eo.Id)">@eo.Nombre</option>
                            }
                        </select>

                        <select name="estadoAprobacionId" class="form-select form-select-sm w-auto" aria-label="Estado Aprobación">
                            <option value="">Toda aprobación</option>
                            @foreach (var ea in Model.EstadosAprobacion)
                            {
                                <option value="@ea.Id" selected="@(Model.EstadoAprobacionId == ea.Id)">@ea.Nombre</option>
                            }
                        </select>

                        <div class="d-flex align-items-center gap-1">
                            <span class="small text-muted">Desde:</span>
                            <input type="date" name="fechaDesde" value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm w-auto" />
                            <span class="small text-muted">Hasta:</span>
                            <input type="date" name="fechaHasta" value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm w-auto" />
                        </div>

                        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i>Buscar</button>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
                    </form>
                    <partial name="_ListadoControles" model="Model" />
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="table-responsive table-scroll">
                <table class="table table-striped table-hover align-middle mb-0" data-erp-grid="main" data-erp-options>
                    <thead class="table-header-custom bg-body-tertiary border-bottom">
                        <tr>
                            <th erp-sort="codigo" style="width: 105px;">N° Orden</th>
                            <th erp-sort="fecha" style="width: 110px;">Fecha</th>
                            <th erp-sort="tipo" style="width: 120px;">Tipo Prod.</th>
                            <th erp-sort="proveedor">Proveedor</th>
                            <th erp-sort="total" class="text-end" style="width: 130px;">Total</th>
                            <th class="text-center" style="width: 65px;" title="Items">Items</th>
                            <th erp-sort="aprobacion" class="text-center" style="width: 130px;">Aprobación</th>
                            <th erp-sort="estado" class="text-center" style="width: 130px;">Estado</th>
                            <th class="listing-options">Opciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr><td colspan="9" class="text-center text-muted py-4">No se encontraron órdenes de compra con los filtros aplicados.</td></tr>
                        }
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="font-monospace fw-bold text-primary">@item.Codigo</td>
                                <td>
                                    <div>@item.FechaTexto</div>
                                    @if (item.FechaEntrega.HasValue)
                                    {
                                        <small class="text-muted"><i class="bi bi-truck me-1"></i>@item.FechaEntregaTexto</small>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@item.TipoProductoNombre</span></td>
                                <td>
                                    <div class="fw-semibold">@item.ProveedorNombre</div>
                                    @if (!string.IsNullOrEmpty(item.ProveedorDocumento))
                                    {
                                        <small class="text-muted font-monospace"><i class="bi bi-card-text me-1"></i>@item.ProveedorDocumento</small>
                                    }
                                </td>
                                <td class="text-end font-monospace fw-bold">
                                    <span class="text-secondary small">@item.MonedaSimbolo</span> @item.MontoTotalTexto
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-body-secondary text-body fw-bold">@item.CantidadItems</span>
                                </td>
                                <td class="text-center">
                                    @{
                                        string authBadge = item.EstadoAprobacionCodigo switch
                                        {
                                            "02" => "bg-success-subtle text-success border border-success-subtle",
                                            "03" => "bg-danger-subtle text-danger border border-danger-subtle",
                                            "01" => "bg-warning-subtle text-warning border border-warning-subtle",
                                            _ => "bg-secondary-subtle text-muted border border-secondary-subtle"
                                        };
                                        string authText = !string.IsNullOrEmpty(item.EstadoAprobacionNombre) ? item.EstadoAprobacionNombre : "SIN SOLICITAR";
                                    }
                                    <span class="badge @authBadge">@authText</span>
                                </td>
                                <td class="text-center">
                                    @{
                                        string estadoBadge = item.EstadoOrdenCompraCodigo switch
                                        {
                                            "01" => "bg-secondary-subtle text-muted border border-secondary-subtle", // En edición
                                            "02" => "bg-info-subtle text-info border border-info-subtle",            // Orden
                                            "03" => "bg-success-subtle text-success border border-success-subtle",   // Atendida
                                            "04" => "bg-danger-subtle text-danger border border-danger-subtle",      // Anulada
                                            _ => "bg-light text-dark border"
                                        };
                                    }
                                    <span class="badge @estadoBadge">@item.EstadoOrdenCompraNombre</span>
                                </td>
                                <td class="listing-options">
                                    <button type="button" class="btn btn-sm btn-outline-primary js-oc-open" data-id="@item.Id" title="Consultar / Editar" aria-label="Consultar / Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <a asp-action="Exportar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success" title="Descargar Excel">
                                        <i class="bi bi-file-earmark-excel"></i>
                                    </a>
                                    @if (canWrite)
                                    {
                                        @if (item.EstadoOrdenCompraCodigo == "01" || item.EstadoAprobacionCodigo == "03")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-info js-oc-send-auth" data-id="@item.Id" data-revision="@item.Revision" data-code="@item.Codigo" title="Solicitar Aprobación">
                                                <i class="bi bi-send-check"></i>
                                            </button>
                                        }
                                        @if (item.EstadoOrdenCompraCodigo is "01" or "02")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary js-oc-change-status" data-id="@item.Id" data-revision="@item.Revision" data-code="@item.Codigo" data-status="@item.EstadoOrdenCompraId" title="Cambiar Estado">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger js-oc-delete" data-id="@item.Id" data-revision="@item.Revision" data-code="@item.Codigo" title="Anular Orden">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_ListadoPaginacion" model="Model" />
        </div>
    </div>
</div>

<!-- Modal Principal para Orden de Compra -->
<div class="modal fade" id="oc-modal" tabindex="-1" aria-labelledby="oc-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-body-tertiary">
                <div>
                    <h5 class="modal-title fw-bold" id="oc-modal-title">Orden de Compra</h5>
                    <small id="oc-modal-subtitle" class="text-muted"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-0">
                <ul class="nav nav-tabs px-3 pt-2 bg-body-tertiary border-bottom" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold" id="tab-oc-hdr" data-bs-toggle="tab" data-bs-target="#panel-oc-hdr" type="button" role="tab">
                            <i class="bi bi-info-circle me-1"></i>Datos Generales
                        </button>
                    </li>
                    <li class="nav-item js-oc-tab-detail" role="presentation">
                        <button class="nav-link fw-semibold" id="tab-oc-items" data-bs-toggle="tab" data-bs-target="#panel-oc-items" type="button" role="tab">
                            <i class="bi bi-cart3 me-1"></i>Productos y Montos
                        </button>
                    </li>
                </ul>

                <div class="tab-content p-3">
                    <!-- Panel 1: Cabecera -->
                    <div class="tab-pane fade show active" id="panel-oc-hdr" role="tabpanel">
                        <form id="oc-form" class="row g-3">
                            <input type="hidden" name="Id" id="oc-id" value="0" />
                            <input type="hidden" name="ContextoId" id="oc-contexto-id" value="@ViewBag.PeriodoEmpresaSedeId" />
                            <input type="hidden" name="Revision" id="oc-revision" value="" />
                            <input type="hidden" name="PedidoCompraId" id="oc-ped-id" value="" />

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Número de Orden</label>
                                <input type="text" id="oc-codigo" class="form-control form-control-sm font-monospace fw-bold bg-body-tertiary" readonly placeholder="[Autogenerado]" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold required">Fecha de Emisión</label>
                                <input type="date" name="Fecha" id="oc-fecha" class="form-control form-control-sm" required />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold required">Tipo de Producto</label>
                                <select name="TipoProductoId" id="oc-tipo-prod" class="form-select form-select-sm" required>
                                    <option value="">Seleccione...</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Estado y Aprobación</label>
                                <div>
                                    <span id="oc-estado-badge" class="badge bg-secondary-subtle text-muted border">En Edición</span>
                                    <span id="oc-aprob-badge" class="badge bg-light text-dark border ms-1">Sin Enviar</span>
                                </div>
                            </div>

                            <div class="col-md-8">
                                <label class="form-label small fw-semibold required">Proveedor</label>
                                <div class="input-group input-group-sm">
                                    <input type="hidden" name="ProveedorId" id="oc-prov-id" required />
                                    <input type="text" id="oc-prov-text" class="form-control" placeholder="Buscar proveedor por razón social o RUC..." autocomplete="off" />
                                    <button class="btn btn-outline-secondary js-oc-search-prov" type="button" title="Buscar proveedor"><i class="bi bi-search"></i></button>
                                </div>
                                <div id="oc-prov-results" class="list-group position-absolute shadow-sm d-none mt-1" style="z-index: 1055; max-height: 200px; overflow-y: auto; width: 60%;"></div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Fecha Prometida de Entrega</label>
                                <input type="date" name="FechaEntrega" id="oc-fecha-entrega" class="form-control form-control-sm" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold required">Moneda</label>
                                <select name="MonedaId" id="oc-moneda" class="form-select form-select-sm" required>
                                    <option value="">Seleccione...</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold required">Tipo de Cambio</label>
                                <input type="number" name="TipoCambio" id="oc-tc" step="0.0001" min="0.0001" class="form-control form-control-sm text-end" value="1.0000" required />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold required">Tasa IGV / Impuesto</label>
                                <select name="ImpuestoTasaId" id="oc-tasa" class="form-select form-select-sm" required>
                                    <option value="">Seleccione...</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold required">Condición de Pago</label>
                                <select name="CondicionPagoId" id="oc-condicion" class="form-select form-select-sm" required>
                                    <option value="">Seleccione...</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Plazo de Entrega</label>
                                <input type="text" name="PlazoEntrega" id="oc-plazo" class="form-control form-control-sm" maxlength="100" placeholder="Ej. 15 días calendario..." />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Lugar de Entrega</label>
                                <input type="text" name="LugarEntrega" id="oc-lugar" class="form-control form-control-sm" maxlength="200" placeholder="Ej. Almacén Central..." />
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-semibold">Observaciones</label>
                                <textarea name="Observacion" id="oc-observa" class="form-control form-control-sm" rows="2" maxlength="400" placeholder="Observaciones o notas adicionales..."></textarea>
                            </div>

                            <div class="col-12 text-end border-top pt-3">
                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                                @if (canWrite)
                                {
                                    <button type="submit" class="btn btn-primary btn-sm ms-2" id="oc-save-btn">
                                        <i class="bi bi-check-lg me-1"></i>Guardar Cabecera
                                    </button>
                                    <button type="button" class="btn btn-info btn-sm ms-2 d-none" id="oc-btn-request-auth">
                                        <i class="bi bi-send-check me-1"></i>Solicitar Aprobación
                                    </button>
                                }
                            </div>
                        </form>
                    </div>

                    <!-- Panel 2: Detalle de Productos -->
                    <div class="tab-pane fade" id="panel-oc-items" role="tabpanel">
                        @if (canWrite)
                        {
                            <div class="card border mb-3 bg-light-subtle js-oc-item-editor">
                                <div class="card-body p-3">
                                    <form id="oc-item-form" class="row g-2 align-items-end">
                                        <input type="hidden" name="Id" id="oc-item-id" value="0" />
                                        <input type="hidden" name="OrdenCompraId" id="oc-item-oc-id" value="0" />
                                        <input type="hidden" name="ContextoId" value="@ViewBag.PeriodoEmpresaSedeId" />
                                        <input type="hidden" name="ProductoId" id="oc-item-prod-id" value="" />

                                        <div class="col-md-4 position-relative">
                                            <label class="form-label small fw-semibold required">Producto / Insumo</label>
                                            <input type="text" id="oc-item-prod-search" class="form-control form-control-sm" placeholder="Buscar código o descripción..." autocomplete="off" />
                                            <div id="oc-item-prod-results" class="list-group position-absolute shadow-sm d-none mt-1 w-100" style="z-index: 1056; max-height: 200px; overflow-y: auto;"></div>
                                        </div>

                                        <div class="col-md-5">
                                            <label class="form-label small fw-semibold required">Descripción en la Orden</label>
                                            <input type="text" name="Descripcion" id="oc-item-desc" class="form-control form-control-sm" maxlength="2000" required />
                                        </div>

                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold required">Cantidad</label>
                                            <input type="number" name="Cantidad" id="oc-item-cant" step="0.0001" min="0.0001" class="form-control form-control-sm text-end" value="1.0000" required />
                                        </div>

                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold">Valor Unitario (sin IGV)</label>
                                            <input type="number" name="ValorUnitario" id="oc-item-val" step="0.0001" min="0" class="form-control form-control-sm text-end" value="0.0000" />
                                        </div>

                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold required">Precio Unitario (con IGV)</label>
                                            <input type="number" name="PrecioUnitario" id="oc-item-pre" step="0.0001" min="0.0001" class="form-control form-control-sm text-end" value="0.0000" required />
                                        </div>

                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold">Subtotal Estimado</label>
                                            <input type="text" id="oc-item-subtotal-calc" class="form-control form-control-sm font-monospace text-end bg-body-tertiary" readonly value="0.00" />
                                        </div>

                                        <div class="col-md-3 text-end">
                                            <button type="submit" class="btn btn-sm btn-primary">
                                                <i class="bi bi-plus-lg me-1"></i><span id="oc-item-submit-lbl">Agregar Producto</span>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary js-oc-cancel-item d-none">Cancelar</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        }

                        <div class="table-responsive border rounded mb-3">
                            <table class="table table-sm table-striped align-middle mb-0" id="oc-items-table">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 40px;">#</th>
                                        <th style="width: 120px;">Código</th>
                                        <th>Descripción</th>
                                        <th style="width: 70px;">U.M.</th>
                                        <th class="text-end" style="width: 90px;">Cantidad</th>
                                        <th class="text-end" style="width: 100px;">Val. Unit.</th>
                                        <th class="text-end" style="width: 100px;">Prec. Unit.</th>
                                        <th class="text-end" style="width: 100px;">Total</th>
                                        <th class="text-center" style="width: 80px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr><td colspan="9" class="text-center text-muted py-3">No hay productos en esta orden.</td></tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Resumen de Totales -->
                        <div class="row justify-content-end">
                            <div class="col-md-4">
                                <div class="card border bg-light-subtle">
                                    <div class="card-body p-2">
                                        <div class="d-flex justify-content-between py-1 small">
                                            <span class="text-muted">Monto Bruto:</span>
                                            <strong class="font-monospace" id="oc-tot-bruto">0.00</strong>
                                        </div>
                                        <div class="d-flex justify-content-between py-1 small">
                                            <span class="text-muted">IGV:</span>
                                            <strong class="font-monospace" id="oc-tot-igv">0.00</strong>
                                        </div>
                                        <div class="d-flex justify-content-between py-1 border-top fw-bold text-primary">
                                            <span>Monto Total:</span>
                                            <span class="font-monospace fs-6" id="oc-tot-total">0.00</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Cambio de Estado de la Orden -->
<div class="modal fade" id="oc-status-modal" tabindex="-1" aria-labelledby="oc-status-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-body-tertiary">
                <h5 class="modal-title fw-bold" id="oc-status-title">Cambiar Estado de la Orden</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="oc-status-form">
                <div class="modal-body">
                    <input type="hidden" name="Id" id="oc-status-id" />
                    <input type="hidden" name="Revision" id="oc-status-rev" />
                    <input type="hidden" name="ContextoId" value="@ViewBag.PeriodoEmpresaSedeId" />

                    <p class="small text-muted mb-3">Actualice el estado comercial de la orden de compra <strong id="oc-status-code" class="text-primary font-monospace"></strong>:</p>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold required">Nuevo Estado</label>
                        <select name="EstadoOrdenCompraId" id="oc-status-sel" class="form-select form-select-sm" required>
                            @foreach (var eo in Model.EstadosOrdenCompra)
                            {
                                <option value="@eo.Id">@eo.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-body-tertiary">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check-lg me-1"></i>Actualizar Estado</button>
                </div>
            </form>
        </div>
    </div>
</div>

<form id="oc-token-form">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/orden-compra.js" asp-append-version="true"></script>
}

