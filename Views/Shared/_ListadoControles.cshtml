@model AspNet10ArcoERP.Models.ListadoPaginadoModel
<div class="d-flex flex-wrap align-items-center gap-3 ms-auto">
    <span class="small text-muted text-nowrap">Total: <strong class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6">@Model.Total</strong> registros</span>
    <div class="dropdown flex-shrink-0">
        <button class="btn btn-sm btn-outline-primary dropdown-toggle shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Cantidad de registros por página">
            <i class="bi bi-funnel-fill me-1"></i>Mostrando: <strong class="badge text-bg-primary ms-1">@Model.PageSize</strong>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
            <li class="dropdown-header text-uppercase small fw-bold">Registros por página</li>
            @foreach (var size in new[] { 25, 50, 100, 500 })
            {
                <li>
                    <a href="@AspNet10ArcoERP.TagHelpers.ListadoEnlaces.Url(Context.Request, ("top", size.ToString()), ("page", "1"), ("sort", Model.Sort), ("dir", Model.Dir))"
                       class="dropdown-item d-flex justify-content-between align-items-center @(size == Model.PageSize ? "active" : "")" aria-current="@(size == Model.PageSize ? "true" : null)">
                        <span>@size registros</span>
                        @if (size == Model.PageSize) { <i class="bi bi-check-lg ms-2"></i> }
                    </a>
                </li>
            }
        </ul>
    </div>
</div>
