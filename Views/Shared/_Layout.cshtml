                                    <a asp-area="MK" asp-controller="LeadSource" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "LeadSource" ? "active" : "")">
                                        <i class="nav-icon bi bi-diagram-3"></i>
                                        <p>Origen de prospectos</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="MK" asp-controller="TipoProfesion" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TipoProfesion" ? "active" : "")">
