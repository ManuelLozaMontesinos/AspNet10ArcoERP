                                <p>
                                    Maestros
                                    <i class="nav-arrow bi bi-chevron-right"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview ps-2">
                                <!-- 1. Cliente/Proveedor -->
                                <li class="nav-item">
                                    <a asp-area="MG" asp-controller="Proveedor" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Proveedor" ? "active" : "")">
                                        <i class="nav-icon bi bi-person-lines-fill"></i>
                                        <p>Cliente/Proveedor</p>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a asp-area="MG" asp-controller="Transportista" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transportista" ? "active" : "")">
                                        <i class="nav-icon bi bi-truck"></i>
                                        <p>Transportistas</p>
                                    </a>
                                </li>

                                <!-- 2. R.M.V. -->
                                <li class="nav-item">
                                    <a asp-area="MG" asp-controller="RemMinVital" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "RemMinVital" ? "active" : "")">
                                        <i class="nav-icon bi bi-cash-stack"></i>
                                        <p>R.M.V.</p>
                                    </a>
                                </li>

                                <!-- 3. UIT -->
                                <li class="nav-item">
                                    <a asp-area="MG" asp-controller="Uit" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Uit" ? "active" : "")">
                                        <i class="nav-icon bi bi-calculator-fill"></i>
                                        <p>UIT</p>
                                    </a>
                                </li>

                                <!-- 4. Centro de Costo -->
                                <li class="nav-item">
                                    <a asp-area="MG" asp-controller="CentroCosto" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CentroCosto" ? "active" : "")">
                                        <i class="nav-icon bi bi-diagram-3-fill"></i>
                                        <p>Centro de Costo</p>
                                    </a>
                                </li>

                                <!-- 5. Tipo de Cambio -->
                                <li class="nav-item">
                                    <a asp-area="MG" asp-controller="TipoCambio" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TipoCambio" ? "active" : "")">
                                        <i class="nav-icon bi bi-currency-exchange"></i>
                                        <p>Tipo de Cambio</p>
                                    </a>
                                </li>

                                <!-- 6. Submenú Productos -->
                                <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() is "Producto" or "FamiliaProducto" or "ComboProducto" ? "menu-open" : "")">
                                    <a href="#" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() is "Producto" or "FamiliaProducto" or "ComboProducto" ? "active" : "")">
                                        <i class="nav-icon bi bi-box-seam-fill text-info"></i>
                                        <p>
                                            Productos
                                            <i class="nav-arrow bi bi-chevron-right"></i>
                                        </p>
                                    </a>
                                    <ul class="nav nav-treeview ps-3">
                                        <li class="nav-item">
                                            <a asp-area="MG" asp-controller="FamiliaProducto" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "FamiliaProducto" ? "active" : "")">
                                                <i class="nav-icon bi bi-folder2-open"></i>
                                                <p>Grupo/Clase/Familia</p>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a asp-area="MG" asp-controller="Producto" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Producto" ? "active" : "")">
                                                <i class="nav-icon bi bi-box"></i>
                                                <p>Productos</p>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a asp-area="MG" asp-controller="ComboProducto" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ComboProducto" ? "active" : "")">
                                                <i class="nav-icon bi bi-collection-fill"></i>
                                                <p>Combos de Productos</p>
                                            </a>
                                        </li>
                                    </ul>
                                </li>

                                <!-- 7. Condición de Pago -->
                                <li class="nav-item">
                                    <a asp-area="MG" asp-controller="CondPago" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CondPago" ? "active" : "")">
                                        <i class="nav-icon bi bi-credit-card-2-front-fill"></i>
                                        <p>Condición de Pago</p>
                                    </a>
                                </li>

                                <!-- 8. Color -->
                                <li class="nav-item">
                                    <a asp-area="MG" asp-controller="Color" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Color" ? "active" : "")">
                                        <i class="nav-icon bi bi-palette-fill"></i>
                                        <p>Color</p>
                                    </a>
                                </li>

                                <!-- 9. Tablas Generales -->
                                <li class="nav-item">
                                    <a asp-area="MG" asp-controller="TablaGeneral" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TablaGeneral" ? "active" : "")">
                                        <i class="nav-icon bi bi-table"></i>
                                        <p>Tablas Generales</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item @(ViewContext.RouteData.Values["area"]?.ToString() == "TS" ? "menu-open" : "")">
                            <a href="#" class="nav-link @(ViewContext.RouteData.Values["area"]?.ToString() == "TS" ? "active" : "")">
                                <i class="nav-icon bi bi-bank text-success"></i>
