                                    Tesorería
                                    <i class="nav-arrow bi bi-chevron-right"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview ps-2">
                                <li class="nav-item">
                                    <a asp-area="TS" asp-controller="CuentaBanco" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CuentaBanco" ? "active" : "")">
