                                    <a href="#" class="nav-link">
                                        <i class="nav-icon bi bi-person-badge-fill text-warning"></i>
                                        <p>
                                            Maestros
                                            <i class="nav-arrow bi bi-chevron-right"></i>
                                        </p>
                                    </a>
                                    <ul class="nav nav-treeview ps-3">
