                                        <p>Cuentas bancarias</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item @(ViewContext.RouteData.Values["area"]?.ToString() == "MK" ? "menu-open" : "")">
                            <a href="#" class="nav-link @(ViewContext.RouteData.Values["area"]?.ToString() == "MK" ? "active" : "")">
