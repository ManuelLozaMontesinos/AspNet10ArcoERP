                                        </li>
                                        <li class="nav-item">
                                            <a asp-area="RH" asp-controller="HoraRemunerativa" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "HoraRemunerativa" ? "active" : "")">
                                                <i class="nav-icon bi bi-hourglass-split"></i>
                                                <p>Horas</p>
                                            </a>
