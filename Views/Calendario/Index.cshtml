<!-- Modal Registrar / Editar Evento -->
<div class="modal fade" id="modal-evento-calendario" tabindex="-1" role="dialog" aria-labelledby="modalEventoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg border-0" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="modalEventoLabel">
                    <i class="far fa-calendar-plus me-2" id="modal-icon"></i>
                    <span id="modal-title-text">Registrar Evento</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="form-evento-calendario" onsubmit="return false;">
                <input type="hidden" id="evento-id" value="0" />
                <div class="modal-body p-4">

                    <!-- Área asignada -->
                    <div class="mb-3 p-2 rounded bg-light border d-flex align-items-center justify-content-between">
                        <div>
                            <i class="fas fa-layer-group text-primary me-1"></i>
                            <span class="small text-muted fw-bold">Área:</span>
                            <span id="lbl-modal-area-nombre" class="fw-bold text-primary ms-1">Administración</span>
                        </div>
                        <span class="badge bg-secondary py-1 px-2 fw-normal small">Calendario del Área</span>
                    </div>

                    <!-- Fecha seleccionada -->
                    <div class="form-group mb-3">
                        <label class="fw-bold text-muted small mb-1">
                            <i class="far fa-calendar-alt me-1 text-primary"></i> Fecha Seleccionada <span class="text-danger">*</span>
                        </label>
                        <input type="date" class="form-control" id="evento-fecha-inicio" required />
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input type="checkbox" class="form-check-input" id="evento-todo-el-dia">
                        <label class="form-check-label" for="evento-todo-el-dia">Evento de todo el día</label>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold text-muted small mb-1" for="evento-hora-inicio">
                                <i class="far fa-clock me-1 text-primary"></i> Hora de inicio <span class="text-danger">*</span>
                            </label>
                            <input type="time" class="form-control" id="evento-hora-inicio" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold text-muted small mb-1" for="evento-fecha-fin">
                                <i class="far fa-clock me-1 text-primary"></i> Fecha y hora de fin
                            </label>
                            <input type="datetime-local" class="form-control" id="evento-fecha-fin" />
                        </div>
                    </div>
                    <small class="form-text text-muted mb-3 d-block">El recordatorio se enviará a los miembros del área, 15 minutos antes. Los eventos de todo el día no generan recordatorio.</small>

                    <!-- Título del Evento -->
                    <div class="form-group mb-3">
                        <label class="fw-bold text-muted small mb-1">
                            <i class="fas fa-heading me-1 text-primary"></i> Título del Evento <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control" id="evento-titulo" placeholder="Ej. Reunión de coordinación / Supervisión de avance" maxlength="150" required />
                        <small class="form-text text-muted">Escribe un título descriptivo para la actividad.</small>
                    </div>

                    <!-- Contexto de la actividad -->
                    <div class="form-group mb-3">
                        <label class="fw-bold text-muted small mb-1">
                            <i class="fas fa-align-left me-1 text-primary"></i> Contexto / Descripción de la actividad
                        </label>
                        <textarea class="form-control" id="evento-contexto" rows="4" placeholder="Escribe el contexto detallado, temas a tratar, objetivos o detalles necesarios..."></textarea>
                        <small class="form-text text-muted">Detalla las actividades o contexto necesario.</small>
                    </div>

                    <!-- Selector de color o categoría -->
                    <div class="form-group mb-3">
                        <label class="fw-bold text-muted small mb-2 d-block">
                            <i class="fas fa-palette me-1 text-primary"></i> Color / Categoría
                        </label>
                        <div class="d-flex align-items-center" id="color-palette-group" style="gap: 12px;">
                            <label class="color-pill" style="background:#0d6efd;" title="Azul">
                                <input type="radio" name="evento-color" value="#0d6efd" checked />
                                <i class="fas fa-check"></i>
                            </label>
                            <label class="color-pill" style="background:#198754;" title="Verde">
                                <input type="radio" name="evento-color" value="#198754" />
                                <i class="fas fa-check"></i>
                            </label>
                            <label class="color-pill" style="background:#ffc107;" title="Amarillo">
                                <input type="radio" name="evento-color" value="#ffc107" />
                                <i class="fas fa-check" style="color: #212529;"></i>
                            </label>
                            <label class="color-pill" style="background:#0dcaf0;" title="Celeste">
                                <input type="radio" name="evento-color" value="#0dcaf0" />
                                <i class="fas fa-check"></i>
                            </label>
                            <label class="color-pill" style="background:#dc3545;" title="Rojo">
                                <input type="radio" name="evento-color" value="#dc3545" />
                                <i class="fas fa-check"></i>
                            </label>
                            <label class="color-pill" style="background:#6f42c1;" title="Morado">
                                <input type="radio" name="evento-color" value="#6f42c1" />
                                <i class="fas fa-check"></i>
                            </label>
                        </div>
                    </div>

                    <!-- Meta info (cuando se edita un evento existente) -->
                    <div id="evento-info-meta" class="alert alert-light border small text-muted mb-0" style="display: none;">
                        <div class="d-flex justify-content-between">
                            <span><i class="far fa-user me-1"></i> Registrado por: <strong id="evento-meta-usuario">-</strong></span>
                            <span><i class="far fa-clock me-1"></i> <span id="evento-meta-fecha">-</span></span>
                        </div>
                    </div>

                </div>
                <div class="modal-footer bg-light py-2 px-3 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-danger btn-sm" id="btn-eliminar-evento" style="display: none;">
                        <i class="fas fa-trash-alt me-1"></i> Eliminar Evento
                    </button>
                    <div class="ms-auto">
                        <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal" data-dismiss="modal">
                            Cancelar
                        </button>
                        <button type="button" class="btn btn-primary btn-sm fw-bold px-3 shadow-sm" id="btn-guardar-evento">
                            <i class="fas fa-save me-1"></i> Guardar Evento
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar Etiqueta Arrastrable -->
<div class="modal fade" id="modal-editar-etiqueta" tabindex="-1" role="dialog" aria-labelledby="modalEtiquetaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content shadow-lg border-0" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title fw-bold mb-0" id="modalEtiquetaLabel">
                    <i class="fas fa-pencil-alt me-1"></i> Editar Etiqueta Arrastrable
                    <span class="badge bg-light text-primary ms-1 small" id="lbl-etiqueta-area-badge"></span>
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="form-editar-etiqueta" onsubmit="return false;">
                <input type="hidden" id="etiqueta-slot-index" value="0" />
                <div class="modal-body p-3">
                    
                    <!-- Previsualización -->
                    <label class="fw-bold text-muted small mb-1">Previsualización:</label>
                    <div id="etiqueta-preview" class="badge p-2 mb-3 d-flex align-items-center justify-content-between text-start w-100" 
                         style="background-color: #0d6efd; color:#fff; font-size: 0.88rem; border-radius: 6px;">
                        <div class="d-flex align-items-center text-truncate me-1">
                            <i class="fas fa-grip-vertical me-2 opacity-50"></i>
                            <span id="etiqueta-preview-text" class="fst-italic opacity-75">(Vacío - Clic para editar)</span>
                        </div>
                    </div>

                    <!-- Texto de la Etiqueta -->
                    <div class="form-group mb-3">
                        <label class="fw-bold text-muted small mb-1" for="etiqueta-input-texto">
                            Texto de la Etiqueta:
                        </label>
                        <input type="text" class="form-control form-control-sm" id="etiqueta-input-texto" 
                               placeholder="Ej. Reunión con Cliente, Revisión..." maxlength="60" />
                        <small class="form-text text-muted">Escribe el título predeterminado que llevará esta etiqueta al arrastrarla.</small>
                    </div>

                    <!-- Color de la Etiqueta -->
                    <div class="form-group mb-2">
                        <label class="fw-bold text-muted small mb-2 d-block">Color:</label>
                        <div class="d-flex align-items-center justify-content-between" id="etiqueta-color-picker">
                            <label class="color-pill" style="background:#0d6efd; width:28px; height:28px;" title="Azul">
                                <input type="radio" name="etiqueta-color" value="#0d6efd" checked />
                                <i class="fas fa-check" style="font-size:11px;"></i>
                            </label>
                            <label class="color-pill" style="background:#198754; width:28px; height:28px;" title="Verde">
                                <input type="radio" name="etiqueta-color" value="#198754" />
                                <i class="fas fa-check" style="font-size:11px;"></i>
                            </label>
                            <label class="color-pill" style="background:#ffc107; width:28px; height:28px;" title="Amarillo">
                                <input type="radio" name="etiqueta-color" value="#ffc107" />
                                <i class="fas fa-check" style="font-size:11px; color:#212529;"></i>
                            </label>
                            <label class="color-pill" style="background:#0dcaf0; width:28px; height:28px;" title="Celeste">
                                <input type="radio" name="etiqueta-color" value="#0dcaf0" />
                                <i class="fas fa-check" style="font-size:11px;"></i>
                            </label>
                            <label class="color-pill" style="background:#dc3545; width:28px; height:28px;" title="Rojo">
                                <input type="radio" name="etiqueta-color" value="#dc3545" />
                                <i class="fas fa-check" style="font-size:11px;"></i>
                            </label>
                            <label class="color-pill" style="background:#6f42c1; width:28px; height:28px;" title="Morado">
                                <input type="radio" name="etiqueta-color" value="#6f42c1" />
                                <i class="fas fa-check" style="font-size:11px;"></i>
                            </label>
                        </div>
                    </div>

                </div>
                <div class="modal-footer bg-light py-2 px-3 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-limpiar-etiqueta" title="Dejar sin texto">
                        <i class="fas fa-eraser me-1"></i> Vaciar
                    </button>
                    <div>
                        <button type="button" class="btn btn-secondary btn-sm me-1" data-bs-dismiss="modal" data-dismiss="modal">
                            Cancelar
                        </button>
                        <button type="button" class="btn btn-primary btn-sm fw-bold px-3 shadow-sm" id="btn-guardar-etiqueta">
                            <i class="fas fa-save me-1"></i> Guardar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

