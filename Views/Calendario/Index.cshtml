                                    </div>
                                </div>
                            </div>

                            <!-- Formulario para Asignar Usuario a esta Área -->
                            <div class="card shadow-sm border mb-3" style="border-radius: 10px; border-left: 4px solid #17a2b8 !important;">
                                <div class="card-header bg-white py-2 px-3">
                                    <h6 class="mb-0 fw-bold text-info">
                                        <i class="fas fa-user-plus me-1"></i> Asignar Usuario al Área Seleccionada
                                    </h6>
                                </div>
                                <div class="card-body p-3 bg-light">
                                    <div class="row align-items-end">
                                        <div class="col-md-7 mb-2 mb-md-0">
                                            <label for="select-admin-nuevo-usuario" class="small fw-bold text-muted mb-1">
                                                Seleccionar Usuario Disponible (Activo)
                                            </label>
                                            <select class="form-select form-select-sm fw-bold" id="select-admin-nuevo-usuario">
                                                <option value="">-- Elige un usuario del ERP --</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3 mb-2 mb-md-0 d-flex align-items-center pt-md-3">
                                            <div class="form-check form-switch">
                                                <input type="checkbox" class="form-check-input" id="check-usuario-es-principal">
                                                <label class="form-check-label small fw-bold" for="check-usuario-es-principal" title="Si se activa, el usuario entrará directamente a este calendario">
                                                    Área Principal
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-2 mb-0">
                                            <button type="button" class="btn btn-info text-white btn-sm fw-bold w-100 shadow-sm" id="btn-asignar-usuario-area" style="border-radius: 6px;">
                                                <i class="fas fa-check-circle me-1"></i> Asignar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Tabla de Usuarios Asignados al Área -->
                            <div class="card shadow-sm border" style="border-radius: 10px; overflow: hidden;">
                                <div class="card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0 fw-bold text-dark">
                                        <i class="fas fa-users me-1 text-primary"></i> Miembros Asignados a esta Área
                                    </h6>
                                    <div class="input-group input-group-sm" style="max-width: 250px;">
                                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                                        <input type="text" id="buscar-admin-usuario-asignado" class="form-control border-start-0" placeholder="Filtrar por nombre o logon...">
                                    </div>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-hover table-striped align-middle mb-0" id="tabla-admin-usuarios-asignados" style="font-size: 0.88rem;">
                                        <thead class="bg-light text-muted border-bottom">
                                            <tr>
                                                <th style="min-width: 140px;">Usuario (Logon)</th>
                                                <th style="min-width: 180px;">Nombre Completo</th>
                                                <th>Rol(es) en el Sistema</th>
                                                <th class="text-center" style="width: 130px;">Área Principal</th>
                                                <th class="text-center" style="width: 120px;">Fecha Asignación</th>
                                                <th class="text-center" style="width: 100px;">Acción</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbody-admin-usuarios-asignados">
                                            <tr>
                                                <td colspan="6" class="text-center py-4 text-muted">
                                                    Selecciona un área arriba para visualizar y gestionar sus miembros.
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>

                <div class="modal-footer bg-light py-2 px-3 d-flex justify-content-between">
                    <span class="text-muted small">
                        <i class="fas fa-info-circle me-1"></i> Los cambios en áreas y miembros se reflejan de inmediato en los calendarios y alertas del sistema.
                    </span>
                    <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal" data-dismiss="modal">
                        <i class="fas fa-times me-1"></i> Cerrar
                    </button>
                </div>

            </div>
        </div>
    </div>
}

<script type="text/javascript">
(function() {
    var esSoloLectura = @(esSoloLectura ? "true" : "false");

    function initFullCalendarModule() {
        var calendarEl = document.getElementById('calendar');
        var externalEl = document.getElementById('external-events');
        var eventoPuedeEditar = true;

        if (!calendarEl) return;

        // Helper para obtener el ID de Área actual
        function obtenerAreaIdActual() {
            var $sel = $('#select-area-calendario');
            if ($sel.length > 0) {
                var parsed = parseInt($sel.val());
                if (!isNaN(parsed) && parsed > 0) {
                    return parsed;
                }
            }
            var fallback = parseInt('@(ViewBag.AreaSeleccionadaId ?? 1)');
            return (!isNaN(fallback) && fallback > 0) ? fallback : 1;
        }

        // Helper para obtener el nombre del Área actual
        function obtenerAreaNombreActual() {
            var $sel = $('#select-area-calendario');
            if ($sel.is('select') && $sel.find('option:selected').length > 0) {
                return $sel.find('option:selected').text().trim();
            }
            return '@(ViewBag.AreaSeleccionadaNombre ?? "General")';
        }

        function actualizarNombreAreaModal() {
            var areaNombre = obtenerAreaNombreActual();
            $('#lbl-modal-area-nombre').text(areaNombre);
            $('#lbl-sidebar-area-nombre').text(areaNombre);
            $('#lbl-sidebar-area-inline').text(areaNombre);
            $('#lbl-etiqueta-area-badge').text(areaNombre);
        }

        // Slots predeterminados
        var defaultSlots = {
            0: { titulo: '', color: '#0d6efd' },
            1: { titulo: '', color: '#198754' },
            2: { titulo: '', color: '#ffc107' },
            3: { titulo: '', color: '#0dcaf0' },
            4: { titulo: '', color: '#dc3545' },
            5: { titulo: '', color: '#6f42c1' }
        };

        var etiquetasPersonalizadas = {};

        function cargarEtiquetasPersonalizadas(areaId) {
            var idArea = areaId || obtenerAreaIdActual();
            etiquetasPersonalizadas = {};

            try {
                var storageKey = 'erp_calendario_etiquetas_area_' + idArea;
                var guardadas = localStorage.getItem(storageKey);
                if (guardadas) {
                    etiquetasPersonalizadas = JSON.parse(guardadas);
                }
            } catch (e) {
                console.warn('No se pudo leer localStorage para etiquetas:', e);
            }

            aplicarEtiquetasEnDOM();

            $.ajax({
                url: '@Url.Action("ObtenerEtiquetas", "Calendario")',
                type: 'GET',
                data: { areaId: idArea },
                success: function(res) {
                    if (res && res.success) {
                        etiquetasPersonalizadas = {};
                        if (Array.isArray(res.data)) {
                            res.data.forEach(function(item) {
                                etiquetasPersonalizadas[item.slotIndex] = {
                                    titulo: item.titulo || '',
                                    color: item.color || (defaultSlots[item.slotIndex] ? defaultSlots[item.slotIndex].color : '#0d6efd')
                                };
                            });
                        }
                        try {
                            localStorage.setItem('erp_calendario_etiquetas_area_' + idArea, JSON.stringify(etiquetasPersonalizadas));
                        } catch (e) {}
                        aplicarEtiquetasEnDOM();
                    }
                }
            });
        }

        function aplicarEtiquetasEnDOM() {
            $('.draggable-event').each(function() {
                var slot = $(this).data('slot');
                var def = defaultSlots[slot] || { titulo: '', color: '#0d6efd' };
                var config = etiquetasPersonalizadas[slot];

                var tituloFinal = (config && config.titulo && config.titulo.trim() !== '') 
                    ? config.titulo.trim() 
                    : '';
                var colorFinal = (config && config.color) 
                    ? config.color 
                    : def.color;

                var $texto = $(this).find('.etiqueta-texto');

                if (tituloFinal !== '') {
                    $(this).attr('data-custom-text', tituloFinal);
                    $texto.text(tituloFinal).removeClass('fst-italic opacity-75').addClass('fw-bold');
                } else {
                    $(this).attr('data-custom-text', '');
                    $texto.text('(Vacío - Clic para editar)').addClass('fst-italic opacity-75').removeClass('fw-bold');
                }

                $(this).attr('data-color', colorFinal);
                $(this).css('background-color', colorFinal);
                if (colorFinal === '#ffc107') {
                    $(this).css('color', '#212529');
                    $(this).find('i.fa-pencil-alt').removeClass('text-white-50').addClass('text-dark opacity-50');
                } else {
                    $(this).css('color', '#fff');
                    $(this).find('i.fa-pencil-alt').removeClass('text-dark opacity-50').addClass('text-white-50');
                }
            });
        }

        actualizarNombreAreaModal();
        cargarEtiquetasPersonalizadas(obtenerAreaIdActual());

        // Modal de Edición de Etiqueta Arrastrable
        var $modalEtiqueta = $('#modal-editar-etiqueta');
        var $previewBadge = $('#etiqueta-preview');
        var $previewText = $('#etiqueta-preview-text');

        function actualizarPreviewEtiqueta() {
            var txt = $('#etiqueta-input-texto').val().trim();
            var color = $('input[name="etiqueta-color"]:checked').val() || '#0d6efd';

            if (txt) {
                $previewText.text(txt).removeClass('fst-italic opacity-75').addClass('fw-bold');
            } else {
                $previewText.text('(Vacío - Clic para editar)').addClass('fst-italic opacity-75').removeClass('fw-bold');
            }

            $previewBadge.css('background-color', color);
            if (color === '#ffc107') {
                $previewBadge.css('color', '#212529');
            } else {
                $previewBadge.css('color', '#fff');
            }

            $('#etiqueta-color-picker .color-pill').each(function() {
                var $radio = $(this).find('input[type="radio"]');
                if ($radio.val() === color) {
                    $(this).addClass('active');
                } else {
                    $(this).removeClass('active');
                }
            });
        }

        $('#etiqueta-input-texto').on('input', actualizarPreviewEtiqueta);
        $('input[name="etiqueta-color"]').on('change', actualizarPreviewEtiqueta);

        $('#external-events').on('click', '.draggable-event', function(e) {
            if (esSoloLectura) return;
            actualizarNombreAreaModal();
            var slot = $(this).data('slot');
            var customText = $(this).attr('data-custom-text') || '';
            var color = $(this).attr('data-color') || '#0d6efd';

            $('#etiqueta-slot-index').val(slot);
            $('#etiqueta-input-texto').val(customText);

            var $radio = $('input[name="etiqueta-color"][value="' + color + '"]');
            if ($radio.length > 0) {
                $radio.prop('checked', true);
            } else {
                $('input[name="etiqueta-color"][value="#0d6efd"]').prop('checked', true);
            }

            actualizarPreviewEtiqueta();
            if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                bootstrap.Modal.getOrCreateInstance($modalEtiqueta[0]).show();
            } else {
                $modalEtiqueta.modal('show');
            }
            setTimeout(function() {
                $('#etiqueta-input-texto').focus().select();
            }, 350);
        });

        $('#btn-guardar-etiqueta').off('click').on('click', function() {
            if (esSoloLectura) return;
            var areaId = obtenerAreaIdActual();
            var slot = parseInt($('#etiqueta-slot-index').val()) || 0;
            var texto = $('#etiqueta-input-texto').val().trim();
            var color = $('input[name="etiqueta-color"]:checked').val() || '#0d6efd';

            etiquetasPersonalizadas[slot] = {
                titulo: texto,
                color: color
            };

            try {
                localStorage.setItem('erp_calendario_etiquetas_area_' + areaId, JSON.stringify(etiquetasPersonalizadas));
            } catch (e) {}

            aplicarEtiquetasEnDOM();
            if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                bootstrap.Modal.getOrCreateInstance($modalEtiqueta[0]).hide();
            } else {
                $modalEtiqueta.modal('hide');
            }

            $.ajax({
                url: '@Url.Action("GuardarEtiqueta", "Calendario")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    areaId: areaId,
                    slotIndex: slot,
                    titulo: texto,
                    color: color
                }),
                success: function(res) {
                    if (res && res.success) {
                        if (window.alertify) alertify.success('Evento arrastrable guardado para ' + obtenerAreaNombreActual());
                    } else {
                        if (window.alertify) alertify.error(res && res.message ? res.message : 'Error al guardar');
                    }
                },
                error: function() {
                    if (window.alertify) alertify.error('Error al comunicarse con el servidor al guardar evento arrastrable.');
                }
            });
        });

        $('#btn-limpiar-etiqueta').off('click').on('click', function() {
            $('#etiqueta-input-texto').val('');
            actualizarPreviewEtiqueta();
            $('#btn-guardar-etiqueta').trigger('click');
        });

        // Inicialización de Arrastrables con FullCalendar Draggable
        if (!esSoloLectura && externalEl && window.FullCalendar && FullCalendar.Draggable) {
            new FullCalendar.Draggable(externalEl, {
                itemSelector: '.draggable-event',
                eventData: function(eventEl) {
                    var customText = eventEl.getAttribute('data-custom-text') || '';
                    var color = eventEl.getAttribute('data-color') || '#0d6efd';

                    return {
                        title: customText,
                        backgroundColor: color,
                        borderColor: color,
                        create: true
                    };
                }
            });
        }

        // Inicialización del Calendario Principal (FullCalendar 6)
        var calendar = new FullCalendar.Calendar(calendarEl, {
            locale: 'es',
            initialView: 'dayGridMonth',
            headerToolbar: {
                start: 'prev,next today',
                center: 'title',
                end: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
            },
            buttonText: {
                today: 'Hoy',
                month: 'Mes',
                week: 'Semana',
                day: 'Día',
                list: 'Agenda'
            },
            height: 'auto',
            editable: !esSoloLectura,
            droppable: !esSoloLectura,
            dayMaxEvents: 3,
            eventDisplay: 'block',
            eventTimeFormat: {
                hour: '2-digit',
                minute: '2-digit',
                hour12: false
            },
            eventDidMount: function(info) {
                if (info.view && info.view.type && info.view.type.startsWith('list')) {
                    return;
                }
                var color = info.event.backgroundColor || info.event.borderColor;
                if (color) {
                    info.el.style.setProperty('background-color', color, 'important');
                    info.el.style.setProperty('border-color', color, 'important');
                    var isYellow = (color || '').toLowerCase() === '#ffc107';
                    var textColor = isYellow ? '#212529' : '#ffffff';
                    info.el.style.setProperty('color', textColor, 'important');
                    var timeEl = info.el.querySelector('.fc-event-time');
                    var titleEl = info.el.querySelector('.fc-event-title');
                    var mainEl = info.el.querySelector('.fc-event-main');
                    if (timeEl) timeEl.style.setProperty('color', textColor, 'important');
                    if (titleEl) titleEl.style.setProperty('color', textColor, 'important');
                    if (mainEl) mainEl.style.setProperty('color', textColor, 'important');
                }
            },
            events: function(info, successCallback, failureCallback) {
                var areaId = obtenerAreaIdActual();
                $.ajax({
                    url: '@Url.Action("ObtenerEventos", "Calendario")',
                    type: 'GET',
                    data: { areaId: areaId },
                    success: function(data) {
                        if (Array.isArray(data)) {
                            successCallback(data);
                        } else if (data && data.data && Array.isArray(data.data)) {
                            successCallback(data.data);
                        } else {
                            successCallback([]);
                        }
                    },
                    error: function(err) {
                        if (window.alertify) alertify.error('Error al cargar eventos del calendario');
                        failureCallback(err);
                    }
                });
            },
            eventReceive: function(info) {
                if (esSoloLectura) {
                    info.revert();
                    return;
                }
                var droppedEvent = info.event;
                var titulo = (droppedEvent.title || '').trim();
                var color = droppedEvent.backgroundColor || '#0d6efd';
                var fechaInicio = droppedEvent.startStr;
                var areaId = obtenerAreaIdActual();

                if (!titulo) {
                    info.revert();
                    abrirModalNuevoEventoConColor(fechaInicio, color);
                    if (window.alertify) alertify.message('Ingresa el título para el nuevo evento');
                    return;
                }

                $.ajax({
                    url: '@Url.Action("GuardarEvento", "Calendario")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        id: 0,
                        areaId: areaId,
                        titulo: titulo,
                        contexto: 'Registrado desde evento arrastrable (' + obtenerAreaNombreActual() + ')',
                        fechaInicio: fechaInicio,
                        todoElDia: droppedEvent.allDay,
                        color: color
                    }),
                    success: function(res) {
                        if (res.success) {
                            info.revert();
                            calendar.refetchEvents();
                            if (window.alertify) alertify.success('Evento programado exitosamente');
                        } else {
                            info.revert();
                            if (window.alertify) alertify.error(res.message);
                        }
                    },
                    error: function() {
                        info.revert();
                        if (window.alertify) alertify.error('Error al guardar el evento arrastrado');
                    }
                });
            },
            dateClick: function(info) {
                if (esSoloLectura) return;
                abrirModalNuevoEvento(info.dateStr);
            },
            eventClick: function(info) {
                abrirModalEditarEvento(info.event);
            },
            eventDrop: function(info) {
                if (esSoloLectura) { info.revert(); return; }
                actualizarFechaEvento(info.event);
            },
            eventResize: function(info) {
                if (esSoloLectura) { info.revert(); return; }
                actualizarFechaEvento(info.event);
            }
        });

        calendar.render();
        window._activeCalendarInstance = calendar;

        $('#select-area-calendario').off('change').on('change', function() {
            var areaId = obtenerAreaIdActual();
            var areaNombre = obtenerAreaNombreActual();
            actualizarNombreAreaModal();
            calendar.refetchEvents();
            cargarEtiquetasPersonalizadas(areaId);
            if (window.alertify) alertify.success('Mostrando calendario de: ' + areaNombre);
        });

        function fechaLocalActual() {
            var now = new Date();
            var month = String(now.getMonth() + 1).padStart(2, '0');
            var day = String(now.getDate()).padStart(2, '0');
            return now.getFullYear() + '-' + month + '-' + day;
        }

        function horaLocalActual() {
            var now = new Date();
            return String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');
        }

        function actualizarControlesHorario() {
            var todoElDia = $('#evento-todo-el-dia').is(':checked');
            $('#evento-todo-el-dia').prop('disabled', !eventoPuedeEditar);
            $('#evento-hora-inicio').prop('disabled', !eventoPuedeEditar || todoElDia).prop('required', !todoElDia);
            $('#evento-fecha-fin').prop('disabled', !eventoPuedeEditar || todoElDia);
        }

        function actualizarPermisosEdicion(puedeEditar) {
            eventoPuedeEditar = puedeEditar;
            $('#evento-titulo, #evento-contexto').prop('readonly', !puedeEditar);
            $('#evento-fecha-inicio').prop('disabled', !puedeEditar);
            $('input[name="evento-color"]').prop('disabled', !puedeEditar);
            $('#btn-guardar-evento').prop('disabled', !puedeEditar).toggle(puedeEditar).css('pointer-events', puedeEditar ? 'auto' : 'none');
            $('#btn-eliminar-evento').prop('disabled', !puedeEditar).toggle(puedeEditar && (parseInt($('#evento-id').val()) || 0) > 0).css('pointer-events', puedeEditar ? 'auto' : 'none');
            $('#btn-crear-evento-manual').prop('disabled', false).css('pointer-events', 'auto');
            actualizarControlesHorario();
        }

        $('#evento-todo-el-dia').off('change').on('change', actualizarControlesHorario);

        function abrirModalNuevoEvento(fechaStr) {
            abrirModalNuevoEventoConColor(fechaStr, '#0d6efd');
        }

        function abrirModalNuevoEventoConColor(fechaStr, colorPredeterminado) {
            if (esSoloLectura) return;
            actualizarNombreAreaModal();
            $('#evento-id').val(0);
            var fechaSeleccionada = fechaStr || fechaLocalActual();
            $('#evento-fecha-inicio').val(fechaSeleccionada.slice(0, 10));
            $('#evento-hora-inicio').val(fechaSeleccionada.length > 10 ? fechaSeleccionada.slice(11, 16) : horaLocalActual());
            $('#evento-fecha-fin').val('');
            $('#evento-todo-el-dia').prop('checked', false);
            actualizarPermisosEdicion(true);
            $('#evento-titulo').val('');
            $('#evento-contexto').val('');

            var color = colorPredeterminado || '#0d6efd';
            var $radio = $('input[name="evento-color"][value="' + color + '"]');
            if ($radio.length > 0) {
                $radio.prop('checked', true);
            } else {
                $('input[name="evento-color"][value="#0d6efd"]').prop('checked', true);
            }
            actualizarEstiloColorPills(color);

            $('#modalEventoLabel #modal-icon').attr('class', 'far fa-calendar-plus me-2');
            $('#modalEventoLabel #modal-title-text').text('Registrar Evento (' + obtenerAreaNombreActual() + ')');
            $('#btn-eliminar-evento').hide();
            $('#evento-info-meta').hide();

            var mEl = document.getElementById('modal-evento-calendario');
            if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                bootstrap.Modal.getOrCreateInstance(mEl).show();
            } else {
                $('#modal-evento-calendario').modal('show');
            }
            setTimeout(function() { $('#evento-titulo').focus(); }, 400);
        }

        function abrirModalEditarEvento(event) {
            actualizarNombreAreaModal();
            $('#evento-id').val(event.id);
            var fInicio = event.startStr ? event.startStr.slice(0, 10) : '';
            $('#evento-fecha-inicio').val(fInicio);
            $('#evento-hora-inicio').val(!event.allDay && event.startStr.length > 10 ? event.startStr.slice(11, 16) : '');
            $('#evento-fecha-fin').val(!event.allDay && event.endStr && event.endStr.length > 10 ? event.endStr.slice(0, 16) : '');
            $('#evento-todo-el-dia').prop('checked', event.allDay);
            actualizarControlesHorario();
            $('#evento-titulo').val(event.title);

            var ext = event.extendedProps || {};
            $('#evento-contexto').val(ext.contexto || '');
            if (ext.areaNombre) {
                $('#lbl-modal-area-nombre').text(ext.areaNombre);
            }
            actualizarPermisosEdicion(!esSoloLectura && ext.puedeEditar === true);

            var color = event.backgroundColor || '#0d6efd';
            var $radio = $('input[name="evento-color"][value="' + color + '"]');
            if ($radio.length > 0) {
                $radio.prop('checked', true);
                actualizarEstiloColorPills(color);
            } else {
                $('input[name="evento-color"][value="#0d6efd"]').prop('checked', true);
                actualizarEstiloColorPills('#0d6efd');
            }

            $('#modalEventoLabel #modal-icon').attr('class', 'fas fa-edit me-2');
            $('#modalEventoLabel #modal-title-text').text('Editar Evento');

            if (ext.usuario) {
                $('#evento-meta-usuario').text(ext.usuario);
                $('#evento-meta-fecha').text(ext.fechaCreacion || '');
                $('#evento-info-meta').show();
            } else {
                $('#evento-info-meta').hide();
            }

            $('#btn-eliminar-evento').toggle(ext.puedeEditar === true);

            var mEl = document.getElementById('modal-evento-calendario');
            if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                bootstrap.Modal.getOrCreateInstance(mEl).show();
            } else {
                $('#modal-evento-calendario').modal('show');
            }
        }

        function actualizarEstiloColorPills(colorSeleccionado) {
            var col = (colorSeleccionado || '#0d6efd').toLowerCase();
            $('#color-palette-group .color-pill').each(function() {
                var $radio = $(this).find('input[type="radio"]');
                var val = ($radio.val() || '').toLowerCase();
                if (val === col) {
                    $(this).addClass('active');
                    $radio.prop('checked', true);
                } else {
                    $(this).removeClass('active');
                }
            });
        }

        $(document).on('click', '#color-palette-group .color-pill', function() {
            var $radio = $(this).find('input[type="radio"]');
            $radio.prop('checked', true);
            actualizarEstiloColorPills($radio.val());
        });

        $('input[name="evento-color"]').on('change', function() {
            actualizarEstiloColorPills($(this).val());
        });

        $('#btn-crear-evento-manual').off('click').on('click', function() {
            if (esSoloLectura) return;
            abrirModalNuevoEvento(fechaLocalActual());
        });

        $('#btn-guardar-evento').off('click').on('click', function() {
            if (esSoloLectura) return;
            var id = parseInt($('#evento-id').val()) || 0;
            var areaId = obtenerAreaIdActual();
            var titulo = $('#evento-titulo').val().trim();
            var contexto = $('#evento-contexto').val().trim();
            var fecha = $('#evento-fecha-inicio').val();
            var horaInicio = $('#evento-hora-inicio').val();
            var todoElDia = $('#evento-todo-el-dia').is(':checked');
            var fechaInicio = todoElDia ? fecha : fecha + 'T' + horaInicio;
            var fechaFin = !todoElDia ? $('#evento-fecha-fin').val() : '';
            var color = $('input[name="evento-color"]:checked').val() || '#0d6efd';

            if (!titulo) {
                if (window.alertify) alertify.warning('Por favor ingresa el título del evento.');
                $('#evento-titulo').focus();
                return;
            }

            if (!fecha || (!todoElDia && !horaInicio)) {
                if (window.alertify) alertify.warning('Selecciona una fecha y una hora de inicio válida.');
                $('#evento-fecha-inicio').focus();
                return;
            }

            if (fechaFin && fechaFin <= fechaInicio) {
                if (window.alertify) alertify.warning('La fecha y hora de fin debe ser posterior al inicio.');
                $('#evento-fecha-fin').focus();
                return;
            }

            var payload = {
                id: id,
                areaId: areaId,
                titulo: titulo,
                contexto: contexto,
                fechaInicio: fechaInicio,
                fechaFin: fechaFin || null,
                todoElDia: todoElDia,
                color: color
            };

            var $btn = $(this);
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Guardando...');

            $.ajax({
                url: '@Url.Action("GuardarEvento", "Calendario")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(res) {
                    $btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i> Guardar Evento');
                    if (res.success) {
                        var mEl = document.getElementById('modal-evento-calendario');
                        if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                            bootstrap.Modal.getOrCreateInstance(mEl).hide();
                        } else {
                            $('#modal-evento-calendario').modal('hide');
                        }
                        calendar.refetchEvents();
                        if (window.alertify) alertify.success(res.message || 'Evento guardado exitosamente');
                    } else {
                        if (window.alertify) alertify.error(res.message || 'Error al guardar el evento');
                    }
                },
                error: function() {
                    $btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i> Guardar Evento');
                    if (window.alertify) alertify.error('Error al comunicarse con el servidor.');
                }
            });
        });

        $('#btn-eliminar-evento').off('click').on('click', function() {
            if (esSoloLectura) return;
            var id = parseInt($('#evento-id').val()) || 0;
            if (id <= 0) return;

            var darkMode = document.body.classList.contains('dark-mode');
            var dialog = window.Swal
                ? Swal.fire({
                    title: '¿Eliminar este evento?',
                    text: '"' + ($('#evento-titulo').val() || 'Evento') + '" se eliminará del calendario.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Conservar',
                    reverseButtons: true,
                    background: darkMode ? '#202833' : '#ffffff',
                    color: darkMode ? '#edf2f7' : '#1e293b',
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: darkMode ? '#556273' : '#64748b'
                })
                : Promise.resolve({ isConfirmed: window.confirm('¿Estás seguro de que deseas eliminar este evento?') });

            dialog.then(function(result) {
                if (!result.isConfirmed) return;

                var $btn = $(this);
                $btn.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("EliminarEvento", "Calendario")',
                    type: 'POST',
                    data: { id: id },
                    success: function(res) {
                        $btn.prop('disabled', false);
                        if (res.success) {
                            var mEl = document.getElementById('modal-evento-calendario');
                            if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                                bootstrap.Modal.getOrCreateInstance(mEl).hide();
                            } else {
                                $('#modal-evento-calendario').modal('hide');
                            }
                            calendar.refetchEvents();
                            if (window.alertify) alertify.success('Evento eliminado correctamente');
                        } else {
                            if (window.alertify) alertify.error(res.message || 'Error al eliminar el evento');
                        }
                    },
                    error: function() {
                        $btn.prop('disabled', false);
                        if (window.alertify) alertify.error('Error al comunicarse con el servidor.');
                    }
                });
            }.bind(this));
        });

        function actualizarFechaEvento(event) {
            if (esSoloLectura) {
                calendar.refetchEvents();
                return;
            }
            var payload = {
                id: parseInt(event.id),
                areaId: obtenerAreaIdActual(),
                titulo: event.title,
                contexto: event.extendedProps ? (event.extendedProps.contexto || '') : '',
                fechaInicio: event.startStr,
                fechaFin: event.endStr || null,
                todoElDia: event.allDay,
                color: event.backgroundColor || '#0d6efd'
            };

            $.ajax({
                url: '@Url.Action("GuardarEvento", "Calendario")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(res) {
                    if (res.success) {
                        if (window.alertify) alertify.success('Fecha actualizada');
                    } else {
                        if (window.alertify) alertify.error(res.message);
                        calendar.refetchEvents();
                    }
                },
                error: function() {
                    if (window.alertify) alertify.error('Error al actualizar fecha del evento');
                    calendar.refetchEvents();
                }
            });
        }

        // =====================================================================
        // MÓDULO DE ADMINISTRACIÓN DE ÁREAS Y USUARIOS (SOLO ADMINISTRADORES)
        // =====================================================================
        var esAdminModulo = @(esAdmin ? "true" : "false");
        if (esAdminModulo) {
            var adminAreasCache = [];
            var adminAreaSeleccionadaId = 0;

            function confirmarAccionAdmin(titulo, texto, confirmBtnText, esPeligroso) {
                var darkMode = document.body.classList.contains('dark-mode');
                if (window.Swal) {
                    return Swal.fire({
                        title: titulo,
                        text: texto,
                        icon: esPeligroso ? 'warning' : 'question',
                        showCancelButton: true,
                        confirmButtonText: confirmBtnText || 'Sí, continuar',
                        cancelButtonText: 'Cancelar',
                        reverseButtons: true,
                        background: darkMode ? '#202833' : '#ffffff',
                        color: darkMode ? '#edf2f7' : '#1e293b',
                        confirmButtonColor: esPeligroso ? '#dc3545' : '#0d6efd',
                        cancelButtonColor: darkMode ? '#556273' : '#64748b'
                    }).then(function(r) { return r.isConfirmed; });
                }
                return Promise.resolve(window.confirm(texto || titulo));
            }

            function sincronizarSelectPrincipalAreas(areas) {
                var $selPrincipal = $('#select-area-calendario');
                if ($selPrincipal.is('select')) {
                    var valorActual = parseInt($selPrincipal.val()) || 0;
                    $selPrincipal.empty();
                    var encontroActual = false;
                    (areas || []).forEach(function(a) {
                        if (a.estado === 'A') {
                            var $opt = $('<option></option>').val(a.areaId).text(a.nombre);
                            if (a.areaId === valorActual) {
                                $opt.prop('selected', true);
                                encontroActual = true;
                            }
                            $selPrincipal.append($opt);
                        }
                    });
                    if (!encontroActual && areas && areas.length > 0) {
                        var primeraActiva = areas.find(function(x) { return x.estado === 'A'; });
                        if (primeraActiva) {
                            $selPrincipal.val(primeraActiva.areaId);
                        }
                    }
                }
            }

            function cargarAdminAreas(callback) {
                var $tbody = $('#tbody-admin-areas');
                $tbody.html('<tr><td colspan="7" class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin me-2"></i> Cargando áreas...</td></tr>');

                $.ajax({
                    url: '@Url.Action("AdminObtenerAreas", "Calendario")',
                    type: 'GET',
                    success: function(res) {
                        if (res.success && res.data) {
                            adminAreasCache = res.data;
                            $('#badge-total-areas').text(adminAreasCache.length);
                            renderizarTablaAdminAreas(adminAreasCache);
                            poblarSelectAdminUsuariosArea(adminAreasCache);
                            sincronizarSelectPrincipalAreas(adminAreasCache);
                            if (typeof callback === 'function') callback();
                        } else {
                            $tbody.html('<tr><td colspan="7" class="text-center py-4 text-danger"><i class="fas fa-exclamation-triangle me-1"></i> ' + (res.message || 'Error al cargar áreas') + '</td></tr>');
                        }
                    },
                    error: function() {
                        $tbody.html('<tr><td colspan="7" class="text-center py-4 text-danger"><i class="fas fa-exclamation-triangle me-1"></i> Error al conectar con el servidor</td></tr>');
                    }
                });
            }

            function renderizarTablaAdminAreas(areas) {
                var $tbody = $('#tbody-admin-areas');
                $tbody.empty();

                if (!areas || areas.length === 0) {
                    $tbody.html('<tr><td colspan="7" class="text-center py-4 text-muted">No se encontraron áreas registradas.</td></tr>');
                    return;
                }

                var busqueda = ($('#buscar-admin-area').val() || '').toLowerCase().trim();
                var areasFiltradas = areas.filter(function(a) {
                    if (!busqueda) return true;
                    return (a.nombre || '').toLowerCase().indexOf(busqueda) >= 0 ||
                           (a.descripcion || '').toLowerCase().indexOf(busqueda) >= 0;
                });

                if (areasFiltradas.length === 0) {
                    $tbody.html('<tr><td colspan="7" class="text-center py-4 text-muted">No hay áreas que coincidan con la búsqueda.</td></tr>');
                    return;
                }

                areasFiltradas.forEach(function(a) {
                    var esActiva = a.estado === 'A';
                    var badgeEstado = esActiva
                        ? '<span class="badge bg-success px-2 py-1"><i class="fas fa-check-circle me-1"></i> Activo</span>'
                        : '<span class="badge bg-secondary px-2 py-1"><i class="fas fa-ban me-1"></i> Inactivo</span>';

                    var btnToggleEstado = esActiva
                        ? '<button type="button" class="btn btn-outline-warning btn-sm btn-toggle-estado-area me-1" data-id="' + a.areaId + '" data-estado="I" title="Desactivar área"><i class="fas fa-eye-slash"></i></button>'
                        : '<button type="button" class="btn btn-outline-success btn-sm btn-toggle-estado-area me-1" data-id="' + a.areaId + '" data-estado="A" title="Activar área"><i class="fas fa-eye"></i></button>';

                    var tr = $('<tr></tr>');
                    tr.html(
                        '<td class="text-center fw-bold text-muted" style="width: 50px;">' + a.orden + '</td>' +
                        '<td>' +
                            '<div class="d-flex align-items-center">' +
                                '<span class="rounded-circle me-2 d-inline-block shadow-sm" style="width: 14px; height: 14px; background-color:' + (a.color || '#0d6efd') + '; flex-shrink: 0;"></span>' +
                                '<span class="fw-bold text-dark">' + escapeHtml(a.nombre) + '</span>' +
                            '</div>' +
                        '</td>' +
                        '<td class="text-muted small">' + (a.descripcion ? escapeHtml(a.descripcion) : '<em class="text-black-50">Sin descripción</em>') + '</td>' +
                        '<td class="text-center">' +
                            '<span class="badge bg-light border text-dark fw-bold px-2 py-1" style="font-size: 0.82rem;">' +
                                '<i class="fas fa-users text-primary me-1"></i> ' + a.totalUsuarios +
                            '</span>' +
                        '</td>' +
                        '<td class="text-center">' +
                            '<span class="badge bg-light border text-dark fw-bold px-2 py-1" style="font-size: 0.82rem;">' +
                                '<i class="far fa-calendar-check text-info me-1"></i> ' + a.totalEventos +
                            '</span>' +
                        '</td>' +
                        '<td class="text-center">' + badgeEstado + '</td>' +
                        '<td class="text-center">' +
                            '<div class="btn-group btn-group-sm" role="group">' +
                                '<button type="button" class="btn btn-outline-primary btn-sm btn-editar-area me-1" data-id="' + a.areaId + '" title="Editar área"><i class="fas fa-edit"></i></button>' +
                                '<button type="button" class="btn btn-outline-info btn-sm btn-ver-usuarios-area me-1" data-id="' + a.areaId + '" title="Administrar usuarios de esta área"><i class="fas fa-user-plus"></i></button>' +
                                btnToggleEstado +
                                '<button type="button" class="btn btn-outline-danger btn-sm btn-eliminar-area" data-id="' + a.areaId + '" data-eventos="' + a.totalEventos + '" data-nombre="' + escapeHtml(a.nombre) + '" title="Eliminar área"><i class="fas fa-trash-alt"></i></button>' +
                            '</div>' +
                        '</td>'
                    );
                    $tbody.append(tr);
                });
            }

            function poblarSelectAdminUsuariosArea(areas) {
                var $sel = $('#select-admin-usuarios-area');
                var valSeleccionado = adminAreaSeleccionadaId || parseInt($sel.val()) || 0;
                $sel.empty();

                if (!areas || areas.length === 0) {
                    $sel.append('<option value="">No hay áreas disponibles</option>');
                    return;
                }

                areas.forEach(function(a) {
                    var sufijoEstado = a.estado === 'I' ? ' (Inactivo)' : '';
                    var opt = $('<option></option>')
                        .val(a.areaId)
                        .text(a.nombre + sufijoEstado)
                        .attr('data-color', a.color || '#0d6efd')
                        .attr('data-usuarios', a.totalUsuarios);
                    if (a.areaId === valSeleccionado) {
                        opt.prop('selected', true);
                    }
                    $sel.append(opt);
                });

                if (!valSeleccionado || !$sel.val()) {
                    var primera = areas[0];
                    if (primera) {
                        $sel.val(primera.areaId);
                        adminAreaSeleccionadaId = primera.areaId;
                    }
                }

                actualizarIndicadorAreaUsuarios();
            }

            function actualizarIndicadorAreaUsuarios() {
                var $sel = $('#select-admin-usuarios-area');
                var $opt = $sel.find('option:selected');
                var color = $opt.attr('data-color') || '#0d6efd';
                $('#indicador-color-area-seleccionada').css('background-color', color);
            }

            $('#buscar-admin-area').on('input', function() {
                renderizarTablaAdminAreas(adminAreasCache);
            });

            $('#btn-recargar-admin-areas').on('click', function() {
                cargarAdminAreas();
            });

            function resetFormArea() {
                $('#form-area-id').val('0');
                $('#form-area-nombre').val('');
                $('#form-area-descripcion').val('');
                $('#form-area-color').val('#0D6EFD');
                $('#form-area-color-picker').val('#0d6efd');
                $('#form-area-orden').val('1');
                $('#form-area-estado').val('A');
                $('#lbl-form-area-title').html('<i class="fas fa-plus-circle me-1 text-success"></i> Registrar Nueva Área');
                $('#preset-colors-area .area-color-dot').removeClass('active');
                $('#preset-colors-area .area-color-dot[data-color="#0d6efd"]').addClass('active');
            }

            function abrirFormArea() {
                $('#card-form-admin-area').slideDown(200);
                setTimeout(function() { $('#form-area-nombre').focus(); }, 250);
            }

            function cerrarFormArea() {
                $('#card-form-admin-area').slideUp(200);
                resetFormArea();
            }

            $('#btn-nueva-area').on('click', function() {
                resetFormArea();
                var proximoOrden = (adminAreasCache && adminAreasCache.length > 0)
                    ? Math.max.apply(Math, adminAreasCache.map(function(o) { return o.orden; })) + 1
                    : 1;
                $('#form-area-orden').val(proximoOrden);
                abrirFormArea();
            });

            $('#btn-cerrar-form-area, #btn-cancelar-form-area').on('click', function() {
                cerrarFormArea();
            });

            $('#preset-colors-area').on('click', '.area-color-dot', function() {
                var color = $(this).attr('data-color');
                $('#preset-colors-area .area-color-dot').removeClass('active');
                $(this).addClass('active');
                $('#form-area-color').val(color.toUpperCase());
                $('#form-area-color-picker').val(color);
            });

            $('#form-area-color-picker').on('input change', function() {
                var color = $(this).val();
                $('#form-area-color').val(color.toUpperCase());
                $('#preset-colors-area .area-color-dot').removeClass('active');
                $('#preset-colors-area .area-color-dot[data-color="' + color.toLowerCase() + '"]').addClass('active');
            });

            $('#form-area-color').on('input', function() {
                var val = $(this).val().trim();
                if (/^#[0-9A-F]{6}$/i.test(val)) {
                    $('#form-area-color-picker').val(val);
                    $('#preset-colors-area .area-color-dot').removeClass('active');
                    $('#preset-colors-area .area-color-dot[data-color="' + val.toLowerCase() + '"]').addClass('active');
                }
            });

            $('#tbody-admin-areas').on('click', '.btn-editar-area', function() {
                var areaId = parseInt($(this).attr('data-id')) || 0;
                var area = adminAreasCache.find(function(a) { return a.areaId === areaId; });
                if (!area) return;

                $('#form-area-id').val(area.areaId);
                $('#form-area-nombre').val(area.nombre);
                $('#form-area-descripcion').val(area.descripcion || '');
                $('#form-area-color').val((area.color || '#0d6efd').toUpperCase());
                $('#form-area-color-picker').val(area.color || '#0d6efd');
                $('#form-area-orden').val(area.orden);
                $('#form-area-estado').val(area.estado);

                $('#preset-colors-area .area-color-dot').removeClass('active');
                $('#preset-colors-area .area-color-dot[data-color="' + (area.color || '#0d6efd').toLowerCase() + '"]').addClass('active');

                $('#lbl-form-area-title').html('<i class="fas fa-edit me-1 text-primary"></i> Modificar Área: ' + escapeHtml(area.nombre));
                abrirFormArea();
            });

            $('#btn-guardar-admin-area').on('click', function() {
                var nombre = ($('#form-area-nombre').val() || '').trim();
                if (!nombre) {
                    if (window.alertify) alertify.error('El nombre del área es obligatorio.');
                    $('#form-area-nombre').focus();
                    return;
                }

                var color = ($('#form-area-color').val() || '#0d6efd').trim();
                if (!/^#[0-9A-F]{6}$/i.test(color)) {
                    color = '#0d6efd';
                }

                var payload = {
                    AreaId: parseInt($('#form-area-id').val()) || 0,
                    Nombre: nombre,
                    Descripcion: ($('#form-area-descripcion').val() || '').trim(),
                    Color: color,
                    Orden: parseInt($('#form-area-orden').val()) || 1,
                    Estado: $('#form-area-estado').val() || 'A'
                };

                var $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Guardando...');

                $.ajax({
                    url: '@Url.Action("AdminGuardarArea", "Calendario")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(res) {
                        $btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i> Guardar Área');
                        if (res.success) {
                            if (window.alertify) alertify.success(res.message || 'Área guardada con éxito.');
                            cerrarFormArea();
                            cargarAdminAreas();
                        } else {
                            if (window.alertify) alertify.error(res.message || 'Error al guardar área.');
                        }
                    },
                    error: function() {
                        $btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i> Guardar Área');
                        if (window.alertify) alertify.error('Error de comunicación con el servidor.');
                    }
                });
            });

            $('#tbody-admin-areas').on('click', '.btn-toggle-estado-area', function() {
                var areaId = parseInt($(this).attr('data-id')) || 0;
                var nuevoEstado = $(this).attr('data-estado');
                var area = adminAreasCache.find(function(a) { return a.areaId === areaId; });
                var nombre = area ? area.nombre : 'esta área';

                var accionTexto = (nuevoEstado === 'A') ? 'activar' : 'desactivar';
                confirmarAccionAdmin(
                    '¿' + (nuevoEstado === 'A' ? 'Activar' : 'Desactivar') + ' área?',
                    '¿Estás seguro de ' + accionTexto + ' el área "' + nombre + '"? Los usuarios no podrán seleccionarla mientras esté inactiva.',
                    'Sí, ' + accionTexto,
                    (nuevoEstado === 'I')
                ).then(function(ok) {
                    if (!ok) return;

                    $.ajax({
                        url: '@Url.Action("AdminCambiarEstadoArea", "Calendario")',
                        type: 'POST',
                        data: { areaId: areaId, estado: nuevoEstado },
                        success: function(res) {
                            if (res.success) {
                                if (window.alertify) alertify.success(res.message);
                                cargarAdminAreas();
                            } else {
                                if (window.alertify) alertify.error(res.message);
                            }
                        },
                        error: function() {
                            if (window.alertify) alertify.error('Error al cambiar estado del área.');
                        }
                    });
                });
            });

            $('#tbody-admin-areas').on('click', '.btn-eliminar-area', function() {
                var areaId = parseInt($(this).attr('data-id')) || 0;
                var nombre = $(this).attr('data-nombre') || 'esta área';
                var eventos = parseInt($(this).attr('data-eventos')) || 0;

                if (eventos > 0) {
                    confirmarAccionAdmin(
                        'Área con eventos registrados',
                        'El área "' + nombre + '" tiene ' + eventos + ' evento(s) activo(s). No puede eliminarse para no perder el histórico. Puedes desactivarla para que no aparezca a los usuarios.',
                        'Entendido',
                        false
                    );
                    return;
                }

                confirmarAccionAdmin(
                    '¿Eliminar área permanentemente?',
                    'Se eliminará el área "' + nombre + '" y se removerán las asignaciones de sus usuarios. Esta acción no se puede deshacer.',
                    'Sí, eliminar permanentemente',
                    true
                ).then(function(ok) {
                    if (!ok) return;

                    $.ajax({
                        url: '@Url.Action("AdminEliminarArea", "Calendario")',
                        type: 'POST',
                        data: { areaId: areaId },
                        success: function(res) {
                            if (res.success) {
                                if (window.alertify) alertify.success(res.message);
                                cargarAdminAreas();
                            } else {
                                if (window.alertify) alertify.error(res.message);
                            }
                        },
                        error: function() {
                            if (window.alertify) alertify.error('Error al eliminar área.');
                        }
                    });
                });
            });

            $('#tbody-admin-areas').on('click', '.btn-ver-usuarios-area', function() {
                var areaId = parseInt($(this).attr('data-id')) || 0;
                adminAreaSeleccionadaId = areaId;
                $('#select-admin-usuarios-area').val(areaId);
                actualizarIndicadorAreaUsuarios();
                
                var triggerTab = document.querySelector('#tab-admin-usuarios-link');
                if (typeof bootstrap !== 'undefined' && bootstrap.Tab) {
                    bootstrap.Tab.getOrCreateInstance(triggerTab).show();
                } else {
                    $('#tab-admin-usuarios-link').tab('show');
                }
                cargarAdminUsuarios(areaId);
            });

            // 3. GESTIÓN DE USUARIOS POR ÁREA (TAB 2)
            var usuariosAsignadosCache = [];

            function cargarAdminUsuarios(areaId) {
                var aid = areaId || parseInt($('#select-admin-usuarios-area').val()) || 0;
                var $tbody = $('#tbody-admin-usuarios-asignados');
                var $selDisp = $('#select-admin-nuevo-usuario');

                if (aid <= 0) {
                    $tbody.html('<tr><td colspan="6" class="text-center py-4 text-muted">Selecciona un área para ver los usuarios asignados.</td></tr>');
                    $selDisp.empty().append('<option value="">-- Selecciona un área primero --</option>');
                    $('#badge-usuarios-area-count').text('0 miembros');
                    $('#badge-total-usuarios-area').text('0');
                    return;
                }

                $tbody.html('<tr><td colspan="6" class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin me-2"></i> Cargando miembros del área...</td></tr>');
                $selDisp.empty().append('<option value="">Cargando usuarios disponibles...</option>');

                $.ajax({
                    url: '@Url.Action("AdminObtenerUsuariosPorArea", "Calendario")',
                    type: 'GET',
                    data: { areaId: aid },
                    success: function(res) {
                        if (res.success) {
                            usuariosAsignadosCache = res.asignados || [];
                            $('#badge-usuarios-area-count').text(usuariosAsignadosCache.length + ' miembros');
                            $('#badge-total-usuarios-area').text(usuariosAsignadosCache.length);
                            if (res.areaColor) {
                                $('#indicador-color-area-seleccionada').css('background-color', res.areaColor);
                            }

                            $selDisp.empty();
                            if (res.disponibles && res.disponibles.length > 0) {
                                $selDisp.append('<option value="">-- Elige un usuario del ERP (' + res.disponibles.length + ' disponibles) --</option>');
                                res.disponibles.forEach(function(u) {
                                    $selDisp.append(
                                        $('<option></option>')
                                            .val(u.usuarioId)
                                            .text(u.nombreCompleto + ' (' + u.usuarioLogon + ') - [' + u.roles + ']')
                                    );
                                });
                            } else {
                                $selDisp.append('<option value="">Todos los usuarios activos ya están asignados a esta área</option>');
                            }

                            renderizarTablaUsuariosAsignados(usuariosAsignadosCache, aid);
                        } else {
                            $tbody.html('<tr><td colspan="6" class="text-center py-4 text-danger">' + (res.message || 'Error al obtener usuarios') + '</td></tr>');
                        }
                    },
                    error: function() {
                        $tbody.html('<tr><td colspan="6" class="text-center py-4 text-danger">Error de conexión al cargar usuarios</td></tr>');
                    }
                });
            }

            function renderizarTablaUsuariosAsignados(usuarios, areaId) {
                var $tbody = $('#tbody-admin-usuarios-asignados');
                $tbody.empty();

                if (!usuarios || usuarios.length === 0) {
                    $tbody.html('<tr><td colspan="6" class="text-center py-4 text-muted"><i class="fas fa-user-slash me-1"></i> No hay usuarios asignados a esta área actualmente.</td></tr>');
                    return;
                }

                var busqueda = ($('#buscar-admin-usuario-asignado').val() || '').toLowerCase().trim();
                var filtrados = usuarios.filter(function(u) {
                    if (!busqueda) return true;
                    return (u.nombreCompleto || '').toLowerCase().indexOf(busqueda) >= 0 ||
                           (u.usuarioLogon || '').toLowerCase().indexOf(busqueda) >= 0 ||
                           (u.roles || '').toLowerCase().indexOf(busqueda) >= 0;
                });

                if (filtrados.length === 0) {
                    $tbody.html('<tr><td colspan="6" class="text-center py-4 text-muted">No se encontraron miembros con el filtro ingresado.</td></tr>');
                    return;
                }

                filtrados.forEach(function(u) {
                    var badgePrincipal = u.esPrincipal
                        ? '<span class="badge bg-success px-2 py-1 shadow-sm" title="Esta es su área principal"><i class="fas fa-star me-1 text-warning"></i> Principal</span>'
                        : '<button type="button" class="btn btn-outline-secondary btn-sm btn-hacer-principal" data-usuario-id="' + u.usuarioId + '" data-area-id="' + areaId + '" title="Convertir en su área principal"><i class="far fa-star me-1"></i> Establecer Principal</button>';

                    var tr = $('<tr></tr>');
                    tr.html(
                        '<td>' +
                            '<span class="badge bg-light border text-dark fw-bold px-2 py-1">' +
                                '<i class="fas fa-user text-muted me-1"></i> ' + escapeHtml(u.usuarioLogon) +
                            '</span>' +
                        '</td>' +
                        '<td class="fw-bold text-dark">' + escapeHtml(u.nombreCompleto) + '</td>' +
                        '<td><span class="badge bg-secondary fw-normal px-2 py-1">' + escapeHtml(u.roles) + '</span></td>' +
                        '<td class="text-center">' + badgePrincipal + '</td>' +
                        '<td class="text-center text-muted small">' + u.fechaCreacion + '</td>' +
                        '<td class="text-center">' +
                            '<button type="button" class="btn btn-outline-danger btn-sm btn-remover-usuario-area" data-usuario-id="' + u.usuarioId + '" data-area-id="' + areaId + '" data-nombre="' + escapeHtml(u.nombreCompleto) + '" title="Remover de esta área">' +
                                '<i class="fas fa-user-minus"></i>' +
                            '</button>' +
                        '</td>'
                    );
                    $tbody.append(tr);
                });
            }

            $('#select-admin-usuarios-area').on('change', function() {
                var aid = parseInt($(this).val()) || 0;
                adminAreaSeleccionadaId = aid;
                actualizarIndicadorAreaUsuarios();
                cargarAdminUsuarios(aid);
            });

            $('#buscar-admin-usuario-asignado').on('input', function() {
                renderizarTablaUsuariosAsignados(usuariosAsignadosCache, parseInt($('#select-admin-usuarios-area').val()) || 0);
            });

            $('#btn-asignar-usuario-area').on('click', function() {
                var areaId = parseInt($('#select-admin-usuarios-area').val()) || 0;
                var usuarioId = parseInt($('#select-admin-nuevo-usuario').val()) || 0;
                var esPrincipal = $('#check-usuario-es-principal').is(':checked');

                if (areaId <= 0) {
                    if (window.alertify) alertify.error('Por favor, selecciona un área.');
                    return;
                }
                if (usuarioId <= 0) {
                    if (window.alertify) alertify.error('Por favor, selecciona un usuario disponible para asignar.');
                    $('#select-admin-nuevo-usuario').focus();
                    return;
                }

                var $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Asignando...');

                $.ajax({
                    url: '@Url.Action("AdminAsignarUsuarioArea", "Calendario")',
                    type: 'POST',
                    data: {
                        usuarioId: usuarioId,
                        areaId: areaId,
                        esPrincipal: esPrincipal
                    },
                    success: function(res) {
                        $btn.prop('disabled', false).html('<i class="fas fa-check-circle me-1"></i> Asignar');
                        if (res.success) {
                            if (window.alertify) alertify.success(res.message);
                            $('#check-usuario-es-principal').prop('checked', false);
                            cargarAdminUsuarios(areaId);
                            cargarAdminAreas();
                        } else {
                            if (window.alertify) alertify.error(res.message);
                        }
                    },
                    error: function() {
                        $btn.prop('disabled', false).html('<i class="fas fa-check-circle me-1"></i> Asignar');
                        if (window.alertify) alertify.error('Error al asignar usuario al área.');
                    }
                });
            });

            $('#tbody-admin-usuarios-asignados').on('click', '.btn-hacer-principal', function() {
                var uid = parseInt($(this).attr('data-usuario-id')) || 0;
                var aid = parseInt($(this).attr('data-area-id')) || 0;
                if (uid <= 0 || aid <= 0) return;

                $.ajax({
                    url: '@Url.Action("AdminToggleUsuarioPrincipal", "Calendario")',
                    type: 'POST',
                    data: { usuarioId: uid, areaId: aid },
                    success: function(res) {
                        if (res.success) {
                            if (window.alertify) alertify.success(res.message);
                            cargarAdminUsuarios(aid);
                        } else {
                            if (window.alertify) alertify.error(res.message);
                        }
                    },
                    error: function() {
                        if (window.alertify) alertify.error('Error al actualizar área principal.');
                    }
                });
            });

            $('#tbody-admin-usuarios-asignados').on('click', '.btn-remover-usuario-area', function() {
                var uid = parseInt($(this).attr('data-usuario-id')) || 0;
                var aid = parseInt($(this).attr('data-area-id')) || 0;
                var nombre = $(this).attr('data-nombre') || 'este usuario';
                var nombreArea = $('#select-admin-usuarios-area option:selected').text();

                confirmarAccionAdmin(
                    '¿Remover usuario del área?',
                    '¿Deseas remover a ' + nombre + ' de ' + nombreArea + '? Ya no tendrá acceso ni notificaciones de los eventos de esta área.',
                    'Sí, remover',
                    true
                ).then(function(ok) {
                    if (!ok) return;

                    $.ajax({
                        url: '@Url.Action("AdminRemoverUsuarioArea", "Calendario")',
                        type: 'POST',
                        data: { usuarioId: uid, areaId: aid },
                        success: function(res) {
                            if (res.success) {
                                if (window.alertify) alertify.success(res.message);
                                cargarAdminUsuarios(aid);
                                cargarAdminAreas();
                            } else {
                                if (window.alertify) alertify.error(res.message);
                            }
                        },
                        error: function() {
                            if (window.alertify) alertify.error('Error al remover usuario del área.');
                        }
                    });
                });
            });

            $('#modal-admin-areas').on('show.bs.modal', function() {
                cargarAdminAreas(function() {
                    var areaIdActual = obtenerAreaIdActual();
                    if (areaIdActual > 0) {
                        adminAreaSeleccionadaId = areaIdActual;
                        $('#select-admin-usuarios-area').val(areaIdActual);
                        actualizarIndicadorAreaUsuarios();
                        cargarAdminUsuarios(areaIdActual);
                    }
                });
            });

            $('#pills-admin-tab button[data-bs-toggle="pill"], #pills-admin-tab a[data-toggle="pill"]').on('shown.bs.tab', function(e) {
                if ($(e.target).attr('id') === 'tab-admin-usuarios-link') {
                    var aid = parseInt($('#select-admin-usuarios-area').val()) || adminAreaSeleccionadaId || obtenerAreaIdActual();
                    if (aid > 0) {
                        $('#select-admin-usuarios-area').val(aid);
                        actualizarIndicadorAreaUsuarios();
                        cargarAdminUsuarios(aid);
                    }
                }
            });

            function escapeHtml(text) {
                if (!text) return '';
                return $('<div>').text(text).html();
            }
        }
    }

    if (window.FullCalendar) {
        initFullCalendarModule();
    } else {
        var scriptIndex = document.createElement('script');
        scriptIndex.src = '@Url.Content("~/plugins/fullcalendar/index.global.min.js")';
        scriptIndex.onload = function() {
            var scriptEs = document.createElement('script');
            scriptEs.src = '@Url.Content("~/plugins/fullcalendar/es.global.min.js")';
            scriptEs.onload = function() {
                initFullCalendarModule();
            };
            document.head.appendChild(scriptEs);
        };
        document.head.appendChild(scriptIndex);
    }
})();
</script>

