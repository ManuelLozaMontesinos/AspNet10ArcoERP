                    <div class="card-header bg-body border-bottom py-2 px-3 d-flex justify-content-between align-items-center">
                        <h3 class="card-title fw-bold m-0 fs-6">
                            <i class="bi bi-database-check text-success me-2"></i>Base de Datos en Tiempo Real
                        </h3>
