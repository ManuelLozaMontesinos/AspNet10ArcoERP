<!--begin::App Content-->
<div class="app-content py-3">
    <div class="container-fluid">

        <!-- ======================================================== -->
        <!-- 1. FILA DE TARJETAS KPI (6 SMALL-BOXES ADMINLTE 4)       -->
        <!-- ======================================================== -->
        <div class="row g-3 mb-4" id="v2-row-kpis">
            <!-- 1. Facturación del Mes -->
            <div class="col-xl-2 col-lg-4 col-md-6 col-12" id="v2-card-kpi-facturacion">
