        <!-- ======================================================== -->
        <!-- 5. SECCIÓN: TOP 10 PEDIDOS & CLIENTES INACTIVOS          -->
        <!-- ======================================================== -->
        <div class="row g-4 mb-4" id="v2-row-tablas">
            <!-- Top Pedidos del Día -->
            <div class="col-12 col-lg-6" id="v2-area-top-pedidos">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-body border-bottom py-2 px-3 d-flex justify-content-between align-items-center flex-wrap" style="gap: 8px;">
                        <h3 class="card-title fw-bold m-0 fs-6">
                            <i class="bi bi-trophy-fill text-warning me-2"></i>Top Pedidos del Día (<span id="v2-label-top-pedidos">Top 5</span>)
                        </h3>
                        <div class="card-tools d-flex align-items-center" style="gap: 6px;">
                            <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" id="v2-btn-toggle-top-pedidos" onclick="alternarTopPedidosV2();" style="font-size: 0.8rem; height: 28px;">
                                <i class="bi bi-chevron-down me-1"></i>Ver Top 10
                            </button>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                <i class="bi bi-calendar3 me-1"></i>@(Model?.TopPedidosFecha ?? DateTime.Today.ToString("dd/MM/yyyy"))
                            </span>
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse">
                                <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                                <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                            </button>
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-maximize">
                                <i data-lte-icon="maximize" class="bi bi-arrows-fullscreen"></i>
                                <i data-lte-icon="minimize" class="bi bi-fullscreen-exit"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0 table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0" id="v2-tabla-top-pedidos">
                            <thead class="table-header-custom-v2 border-bottom">
                                <tr>
                                    <th style="width: 20%;" class="text-center">Código</th>
                                    <th style="width: 55%;">Cliente</th>
                                    <th style="width: 25%;" class="text-end pe-3">Monto Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model?.TopPedidos != null && Model.TopPedidos.Count > 0)
                                {
                                    int ranking = 1;
                                    foreach (var p in Model.TopPedidos)
                                    {
                                        string rankClass = ranking == 1 ? "badge-rank-1" : (ranking == 2 ? "badge-rank-2" : (ranking == 3 ? "badge-rank-3" : "badge bg-secondary-subtle text-secondary"));
                                        <tr class="dashboard-drilldown-row @(ranking > 5 ? "d-none v2-fila-top-extra" : "")" onclick="mostrarEnDesarrollo('Detalle del Pedido #@p.Codigo');" title="Clic para ver detalle">
                                            <td class="text-center py-2">
                                                <span class="badge @rankClass rounded-pill px-2 py-1 me-1">#@ranking</span>
                                                <span class="font-monospace fw-bold text-primary">@p.Codigo</span>
                                            </td>
                                            <td class="py-2">
                                                <span class="fw-semibold text-body">@p.Cliente</span>
                                            </td>
                                            <td class="text-end font-monospace fw-bold text-success py-2 pe-3 text-nowrap">
                                                @p.MontoFormateado
                                            </td>
                                        </tr>
                                        ranking++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-4">
                                            <i class="bi bi-info-circle me-1"></i> No se registran pedidos el @(Model?.TopPedidosFecha ?? DateTime.Today.ToString("dd/MM/yyyy"))
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer bg-body border-top py-2 px-3 d-flex justify-content-between align-items-center">
                        <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Ranking automático por mayor monto</small>
                        <a href="javascript:void(0);" onclick="mostrarEnDesarrollo('Listado General de Pedidos');" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.8rem;">
                            <i class="bi bi-list-ul me-1"></i>Ver Todos los Pedidos
                        </a>
                    </div>
                </div>
            </div>

            <!-- Clientes sin Compras Recientes -->
            <div class="col-12 col-lg-6" id="v2-area-clientes-inactivos">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-body border-bottom py-2 px-3 d-flex justify-content-between align-items-center flex-wrap" style="gap: 8px;">
                        <h3 class="card-title fw-bold m-0 fs-6">
                            <i class="bi bi-person-x-fill text-warning me-2"></i>Clientes sin Compras (<span id="v2-label-meses-inactivos">&ge; 5 Meses</span>)
                        </h3>
                        <div class="card-tools d-inline-flex flex-wrap align-items-center" style="gap: 6px;">
                            <select id="v2-select-meses-inactivos" class="form-select form-select-sm" style="width: auto; height: 28px; padding: 2px 8px; font-size: 0.8rem;" onchange="cambiarFiltroInactivosV2();">
                                <option value="3">&ge; 3 Meses</option>
                                <option value="4">&ge; 4 Meses</option>
                                <option value="5" selected>&ge; 5 Meses</option>
                                <option value="6">&ge; 6 Meses</option>
                            </select>
                            @if (Model?.PuedeFiltrarVendedorClientes == true)
                            {
                                <select id="v2-select-vendedor-inactivos" class="form-select form-select-sm" style="width: 150px; height: 28px; padding: 2px 8px; font-size: 0.8rem;" onchange="cambiarFiltroInactivosV2();">
                                    <option value="" selected>Todos los Vendedores</option>
                                    @foreach (var v in listaVendedores.OrderBy(x => x.Nombre))
                                    {
                                        <option value="@v.Id">@v.Nombre</option>
                                    }
                                </select>
                            }
                            <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" id="v2-btn-ver-mas-clientes" onclick="alternarVerMasClientesInactivosV2();" style="height: 28px; font-size: 0.8rem;">
                                <i class="bi bi-chevron-down me-1"></i>Ver más (10)
                            </button>
                            <span class="badge bg-warning-subtle text-warning-emphasis border px-2 py-1">Inactivos</span>
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse">
                                <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                                <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                            </button>
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-maximize">
                                <i data-lte-icon="maximize" class="bi bi-arrows-fullscreen"></i>
                                <i data-lte-icon="minimize" class="bi bi-fullscreen-exit"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0 table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0" id="v2-tabla-clientes-inactivos">
                            <thead class="table-header-custom-v2 border-bottom">
                                <tr>
                                    <th style="width: 65%;">Cliente</th>
                                    <th style="width: 35%;" class="text-end pe-3">Última Compra</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model?.ClientesInactivos != null && Model.ClientesInactivos.Count > 0)
                                {
                                    int idx = 0;
                                    foreach (var c in Model.ClientesInactivos)
                                    {
                                        idx++;
                                        <tr class="dashboard-drilldown-row @(idx > 5 ? "d-none v2-fila-inactivo-extra" : "")" onclick="mostrarEnDesarrollo('Ficha del Cliente: @c.Cliente');" title="Clic para ver ficha">
                                            <td class="py-2">
                                                <span class="fw-semibold text-body d-block">@c.Cliente</span>
                                                <small class="text-muted"><i class="bi bi-person me-1"></i>@c.Vendedor</small>
                                            </td>
                                            <td class="text-end py-2 pe-3 text-nowrap">
                                                <span class="badge bg-warning-subtle text-warning-emphasis border px-2 py-1 fw-bold">
                                                    <i class="bi bi-calendar-x me-1"></i>@c.FechaFormateada
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="2" class="text-center text-muted py-4">
                                            <i class="bi bi-check-circle-fill text-success me-1"></i> No se encontraron clientes inactivos
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer bg-body border-top py-2 px-3">
                        <small class="text-muted"><i class="bi bi-exclamation-triangle text-warning me-1"></i>Alerta temprana para reactivación comercial</small>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<!--end::App Content-->

