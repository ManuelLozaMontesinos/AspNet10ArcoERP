@section Scripts {
<!-- Chart.js 4.5.1 Oficial de AdminLTE 4 -->
<script src="~/plugins/chart.js/chart.umd.min.js" asp-append-version="true"></script>

<!-- begin::Chart.js theme preset oficial de AdminLTE 4 -->
<script>
    // ========================================================
    // MOTOR DE TEMA OFICIAL ADMINLTE 4 PARA CHART.JS
    // https://adminlte.io/themes/v4/charts/chartjs.html
    // ========================================================
    (() => {
        'use strict';
        const { Chart } = globalThis;
        if (!Chart) return;

        const root = document.documentElement;
        const cssVar = (name, fallback = '') =>
            getComputedStyle(root).getPropertyValue(name).trim() || fallback;

        const alpha = (color, opacity) => {
            let hex = String(color).trim().replace(/^#/, '');
            if (!/^[\da-f]{3}([\da-f]{3})?$/i.test(hex)) {
                return color;
            }
            if (hex.length === 3) {
                hex = [...hex].map((c) => c + c).join('');
            }
            const [r, g, b] = [0, 2, 4].map((i) => Number.parseInt(hex.slice(i, i + 2), 16));
            return `rgba(${r}, ${g}, ${b}, ${opacity})`;
        };

        const areaFill = (color, from = 0.35, to = 0) => (context) => {
            const { ctx, chartArea } = context.chart;
            if (!chartArea) {
                return alpha(color, from);
            }
            const gradient = ctx.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
            gradient.addColorStop(0, alpha(color, from));
            gradient.addColorStop(1, alpha(color, to));
            return gradient;
        };

        let applied = [];

        const apply = () => {
            const text = cssVar('--bs-secondary-color', '#6c757d');
            const body = cssVar('--bs-body-color', '#212529');
            const surface = cssVar('--bs-body-bg', '#fff');
            const grid = `rgba(${cssVar('--bs-emphasis-color-rgb', '0, 0, 0')}, 0.08)`;
            const rtl = root.getAttribute('dir') === 'rtl';
            const d = Chart.defaults;
            applied = [text, grid];

            d.font.family = cssVar('--bs-body-font-family', d.font.family);
            d.font.size = 12;
            d.color = text;
            d.borderColor = grid;
            d.maintainAspectRatio = false;

            d.scale.grid.color = grid;
            d.scale.border.color = grid;
            d.scale.ticks.padding = 8;
            d.set('scales.linear', { border: { display: false } });
            d.set('scales.category', { grid: { display: false } });

            d.elements.line.borderWidth = 2;
            d.elements.point.radius = 0;
            d.elements.point.hoverRadius = 5;
            d.elements.point.hitRadius = 8;
            d.elements.point.hoverBorderWidth = 2;
            d.elements.point.borderColor = surface;
            d.elements.bar.borderRadius = 4;
            d.elements.arc.borderColor = surface;
            d.elements.arc.borderWidth = 2;

            const { legend, tooltip } = d.plugins;
            legend.position = 'bottom';
            legend.rtl = rtl;
            Object.assign(legend.labels, {
                color: body,
                usePointStyle: true,
                pointStyle: 'circle',
                boxWidth: 8,
                boxHeight: 8,
                padding: 16,
            });

            Object.assign(tooltip, {
                rtl,
                backgroundColor: surface,
                borderColor: cssVar('--bs-border-color', '#dee2e6'),
                borderWidth: 1,
                titleColor: cssVar('--bs-emphasis-color', '#000'),
                bodyColor: body,
                titleFont: { weight: '600' },
                padding: 10,
                cornerRadius: 6,
                caretSize: 5,
                boxPadding: 4,
                usePointStyle: true,
            });

            for (const type of ['line', 'bar']) {
                Chart.overrides[type].interaction = { mode: 'index', intersect: false };
            }
        };

        const forgetThemeColors = (options, stale) => {
            for (const [key, value] of Object.entries(options)) {
                if (value && typeof value === 'object' && !Array.isArray(value)) {
                    forgetThemeColors(value, stale);
                } else if (/color$/i.test(key) && stale.includes(value)) {
                    delete options[key];
                }
            }
        };

        const refresh = () => {
            const stale = applied;
            apply();
            for (const chart of Object.values(Chart.instances)) {
                forgetThemeColors(chart.config.options.scales || {}, stale);
                chart.update('none');
            }
        };

        apply();
        new MutationObserver(refresh).observe(root, {
            attributes: true,
            attributeFilter: ['data-bs-theme', 'dir'],
        });
        document.fonts?.addEventListener('loadingdone', refresh);

        globalThis.lteChartTheme = { cssVar, alpha, areaFill, refresh };
    })();
</script>
<!-- end::Chart.js theme preset -->

<script>
    // ========================================================
    // ALERTA VISUAL: MÓDULO EN DESARROLLO
    // ========================================================
    function mostrarEnDesarrollo(modulo) {
        Swal.fire({
            icon: 'info',
            title: 'Módulo en Desarrollo',
            html: '<p class="mb-2">El módulo <strong>' + modulo + '</strong> se encuentra actualmente en proceso de migración para ASP.NET Core 10.</p><small class="text-muted">Pronto estará disponible con todas sus funcionalidades conectadas a la base de datos en tiempo real.</small>',
            confirmButtonText: '<i class="bi bi-check2-circle me-1"></i>Entendido',
            confirmButtonColor: '#0d6efd',
            customClass: {
                popup: 'rounded-4 shadow'
            }
        });
    }

    // Funciones utilitarias para formateo
    const { cssVar, alpha, areaFill } = globalThis.lteChartTheme;
    const thousands = (value) => 'S/ ' + Math.round(value) + 'k';
    const dollars = (context) => ' ' + context.dataset.label + ': S/ ' + context.parsed.y.toLocaleString('es-PE');

    // ========================================================
    // DATOS DE MODELO (CONEXIÓN BD REAL)
    // ========================================================
    var allMesesVentas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.MesesVentas ?? Array.Empty<string>()));
    var allVentasAnterior = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.VentasAnterior ?? Array.Empty<double>()));
    var allVentasActual = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.VentasActual ?? Array.Empty<double>()));

    var allStackedLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.StackedLabels ?? new List<string>()));
    var allDsCentral = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.DsCentral ?? Array.Empty<double>()));
    var allDsIlo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.DsIlo ?? Array.Empty<double>()));

    var allVendedorLabels = [];
    var allVendedorCantidades = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.VendedorCantidades ?? new List<int>()));
    var allVendedorMontos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.VendedorMontos ?? new List<double>()));

    var prodLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.ProdLabels ?? Array.Empty<string>()));
    var prodValores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.ProdValores ?? Array.Empty<int>()));

    // Instancias de Gráficos V2
    var areaChartInstance = null;
    var columnChartInstance = null;
    var donutChartInstance = null;
    var radialChartInstance = null;
    var mixedChartInstance = null;
    var lineChartInstance = null;

    var ventasMesesActuales = 12;
    var vendedorDiasActuales = 12;
    var stackedDiasActuales = 12;
    var sedeActiva = 'vs';
    var verTop10Pedidos = false;
    var ver10ClientesInactivos = false;

    // Actualizar reloj en vivo
    function actualizarRelojEnVivo() {
        const ahora = new Date();
        const horaStr = ahora.toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        $('#v2-last-sync-time').text(horaStr);
    }

    // ========================================================
    // 1. RENDER AREA CHART (AdminLTE 4)
    // ========================================================
    function renderAreaChart(labels, actual, anterior) {
        const canvas = document.querySelector('#area-chart');
        if (!canvas) return;
        if (areaChartInstance) areaChartInstance.destroy();

        areaChartInstance = new Chart(canvas, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Periodo Actual',
                        data: actual,
                        borderColor: '#0d6efd',
                        backgroundColor: areaFill('#0d6efd', 0.4, 0),
                        pointBackgroundColor: '#0d6efd',
                        pointBorderColor: cssVar('--bs-body-bg', '#fff'),
                        pointHoverRadius: 6,
                        fill: true,
                        tension: 0.4
                    },
                    {
                        label: 'Periodo Anterior',
                        data: anterior,
                        borderColor: '#20c997',
                        backgroundColor: areaFill('#20c997', 0.3, 0),
                        pointBackgroundColor: '#20c997',
                        pointBorderColor: cssVar('--bs-body-bg', '#fff'),
                        pointHoverRadius: 6,
                        fill: true,
                        tension: 0.4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                return ctx.dataset.label + ': S/ ' + (ctx.parsed.y * 1000).toLocaleString('es-PE') + ' (' + ctx.parsed.y + 'k)';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { callback: thousands }
                    }
                }
            }
        });
    }

    function setVentasMesesV2(n) {
        ventasMesesActuales = n;
        $('[id^="v2-btn-ventas-"]').removeClass('btn-primary active').addClass('btn-outline-secondary');
        $('#v2-btn-ventas-' + n).removeClass('btn-outline-secondary').addClass('btn-primary active');
        $('#v2-badge-meses-ventas').html('<i class="bi bi-calendar3 me-1"></i>' + n + ' Meses Móviles');

        const labels = (allMesesVentas || []).slice(-n);
        const actual = (allVentasActual || []).slice(-n);
        const anterior = (allVentasAnterior || []).slice(-n);
        renderAreaChart(labels, actual, anterior);
    }

    // ========================================================
    // 2. RENDER COLUMN CHART (AdminLTE 4) - Grouped Bars
    // ========================================================
    function renderColumnChart(labels, central, ilo) {
        const canvas = document.querySelector('#column-chart');
        if (!canvas) return;
        if (columnChartInstance) columnChartInstance.destroy();

        const datasets = [];
        if (sedeActiva === 'vs' || sedeActiva === 'central') {
            datasets.push({
                label: 'Central',
                data: central,
                backgroundColor: '#6f42c1',
                borderRadius: 4
            });
        }
        if (sedeActiva === 'vs' || sedeActiva === 'ilo') {
            datasets.push({
                label: 'Ilo',
                data: ilo,
                backgroundColor: '#20c997',
                borderRadius: 4
            });
        }

        columnChartInstance = new Chart(canvas, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: datasets
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                datasets: {
                    bar: { categoryPercentage: 0.55, barPercentage: 0.9 }
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                return ctx.dataset.label + ': S/ ' + (ctx.parsed.y * 1000).toLocaleString('es-PE') + ' (' + ctx.parsed.y + 'k)';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        ticks: { callback: thousands }
                    }
                }
            }
        });
    }

    function setStackedDiasV2(n) {
        stackedDiasActuales = n;
        $('[id^="v2-btn-stacked-"]').removeClass('btn-primary active').addClass('btn-outline-secondary');
        $('#v2-btn-stacked-' + n).removeClass('btn-outline-secondary').addClass('btn-primary active');

        const labels = (allStackedLabels || []).slice(-n);
        const central = (allDsCentral || []).slice(-n);
        const ilo = (allDsIlo || []).slice(-n);
        renderColumnChart(labels, central, ilo);
    }

    function toggleSedeFilterV2(modo) {
        sedeActiva = modo;
        $('#v2-filter-central, #v2-filter-ilo, #v2-filter-vs').removeClass('btn-primary active').addClass('btn-outline-secondary');
        $('#v2-filter-' + modo).removeClass('btn-outline-secondary').addClass('btn-primary active');
        setStackedDiasV2(stackedDiasActuales);
    }

    // ========================================================
    // 3. RENDER DONUT CHART (AdminLTE 4)
    // ========================================================
    function renderDonutChart(labels, valores) {
        const canvas = document.querySelector('#donut-chart');
        if (!canvas) return;
        if (donutChartInstance) donutChartInstance.destroy();

        const total = (valores || []).reduce((a, b) => a + b, 0);
        if (total === 0) {
            $('#v2-productionEmpty').removeClass('d-none');
            $(canvas).addClass('d-none');
            return;
        } else {
            $('#v2-productionEmpty').addClass('d-none');
            $(canvas).removeClass('d-none');
        }

        const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
        const sliceBorder = isDark ? '#212529' : '#ffffff';

        donutChartInstance = new Chart(canvas, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Órdenes',
                        data: valores,
                        backgroundColor: ['#0d6efd', '#20c997', '#ffc107', '#dc3545', '#6f42c1'],
                        borderColor: sliceBorder,
                        borderWidth: 2
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '65%',
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            usePointStyle: true,
                            boxWidth: 8,
                            padding: 14
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                const val = ctx.parsed;
                                const pct = total > 0 ? ((val / total) * 100).toFixed(1) : 0;
                                return ' ' + ctx.label + ': ' + val + ' (' + pct + '%)';
                            }
                        }
                    }
                }
            }
        });
    }

    // ========================================================
    // 4. RENDER RADIAL BAR CHART (AdminLTE 4) - Center Text Plugin
    // ========================================================
    function renderRadialBarChart() {
        const canvas = document.querySelector('#radialbar-chart');
        if (!canvas) return;
        if (radialChartInstance) radialChartInstance.destroy();

        const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
        const sliceBorder = isDark ? '#212529' : '#ffffff';
        const radial_values = [82, 74, 68];
        const radial_labels = ['Facturación', 'Pedidos', 'Planta'];
        const radial_colors = ['#0d6efd', '#20c997', '#ffc107'];
        const radial_track = () => isDark ? 'rgba(255, 255, 255, 0.12)' : cssVar('--bs-secondary-bg', '#e9ecef');

        const centerText = {
            id: 'centerTextV2',
            afterDatasetsDraw(chart, args, options) {
                const { ctx, chartArea } = chart;
                const x = (chartArea.left + chartArea.right) / 2;
                const y = (chartArea.top + chartArea.bottom) / 2;
                const currentDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
                ctx.save();
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillStyle = currentDark ? '#94a3b8' : cssVar('--bs-secondary-color', '#6c757d');
                ctx.font = `14px ${Chart.defaults.font.family}`;
                ctx.fillText(options.label || 'Eficiencia', x, y - 14);
                ctx.fillStyle = currentDark ? '#f8fafc' : cssVar('--bs-emphasis-color', '#212529');
                ctx.font = `600 24px ${Chart.defaults.font.family}`;
                ctx.fillText(options.value || '75%', x, y + 12);
                ctx.restore();
            }
        };

        radialChartInstance = new Chart(canvas, {
            type: 'doughnut',
            data: {
                labels: ['Cumplido', 'Restante'],
                datasets: radial_values.map((value, index) => ({
                    label: radial_labels[index],
                    data: [value, 100 - value],
                    backgroundColor: (ctx) => ctx.dataIndex === 0 ? radial_colors[index] : radial_track(),
                    hoverBackgroundColor: (ctx) => ctx.dataIndex === 0 ? radial_colors[index] : radial_track(),
                    borderColor: sliceBorder,
                    borderWidth: 4,
                    hoverBorderWidth: 4
                }))
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '50%',
                plugins: {
                    legend: { display: false },
                    centerTextV2: {
                        label: 'Eficiencia',
                        value: `${Math.round(radial_values.reduce((s, v) => s + v, 0) / radial_values.length)}%`
                    },
                    tooltip: {
                        filter: (item) => item.dataIndex === 0,
                        callbacks: {
                            title: () => '',
                            label: (item) => ` ${item.dataset.label}: ${item.raw}% de cumplimiento`,
                            labelColor: (item) => ({
                                backgroundColor: radial_colors[item.datasetIndex],
                                borderColor: radial_colors[item.datasetIndex]
                            })
                        }
                    }
                }
            },
            plugins: [centerText]
        });
    }

    // ========================================================
    // 5. RENDER MIXED CHART (AdminLTE 4) - Dual Y Axes
    // ========================================================
    function renderMixedChart(labels, cantidades, montos, totalPedidos, totalMonto) {
        const canvas = document.querySelector('#mixed-chart');
        if (!canvas) return;
        if (mixedChartInstance) mixedChartInstance.destroy();

        $('#v2-vendedor-total-pedidos').text((totalPedidos || 0) + ' pedidos en el periodo');
        $('#v2-vendedor-total-monto').text('Total: ' + (totalMonto || 'S/ 0.00'));

        mixedChartInstance = new Chart(canvas, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        type: 'bar',
                        label: 'Pedidos',
                        data: cantidades,
                        backgroundColor: alpha('#20c997', 0.85),
                        hoverBackgroundColor: '#20c997',
                        borderRadius: 4,
                        categoryPercentage: 0.55,
                        yAxisID: 'y',
                        order: 1
                    },
                    {
                        type: 'line',
                        label: 'Facturación S/',
                        data: montos,
                        borderColor: '#0d6efd',
                        backgroundColor: '#0d6efd',
                        borderWidth: 3,
                        pointRadius: 4,
                        tension: 0.4,
                        yAxisID: 'y1',
                        order: 0
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            sort: (a, b) => a.datasetIndex - b.datasetIndex
                        }
                    },
                    tooltip: {
                        itemSort: (a, b) => a.datasetIndex - b.datasetIndex,
                        callbacks: {
                            label: function(ctx) {
                                if (ctx.dataset.yAxisID === 'y1') {
                                    return 'Facturación: S/ ' + ctx.parsed.y.toLocaleString('es-PE', { minimumFractionDigits: 2 });
                                }
                                return 'Pedidos: ' + ctx.parsed.y;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        position: 'left',
                        title: { display: true, text: 'Pedidos' },
                        ticks: { stepSize: 1 }
                    },
                    y1: {
                        position: 'right',
                        title: { display: true, text: 'Monto Total' },
                        grid: { drawOnChartArea: false },
                        ticks: {
                            callback: function(v) { return 'S/ ' + (v >= 1000 ? (v / 1000).toFixed(1) + 'k' : v); }
                        }
                    }
                }
            }
        });
    }

    function setVendedorDiasV2(n) {
        vendedorDiasActuales = n;
        $('[id^="v2-btn-vendedor-"]').removeClass('btn-primary active').addClass('btn-outline-secondary');
        $('#v2-btn-vendedor-' + n).removeClass('btn-outline-secondary').addClass('btn-primary active');

        const vid = $('#v2-select-vendedor-chart').val() || @(Model?.PrimerVendedorId ?? 50);
        cargarDatosVendedorV2(vid, n);
    }

    function cambiarVendedorChartV2() {
        const vid = $('#v2-select-vendedor-chart').val() || @(Model?.PrimerVendedorId ?? 50);
        cargarDatosVendedorV2(vid, vendedorDiasActuales);
    }

    function cargarDatosVendedorV2(vid, dias) {
        $.ajax({
            url: '@Url.Action("ObtenerPedidosVendedor", "Home")',
            type: 'GET',
            data: { vendedorId: vid, dias: dias },
            success: function(res) {
                if (res && res.success) {
                    allVendedorLabels = res.labels;
                    allVendedorCantidades = res.cantidades;
                    allVendedorMontos = res.montos;
                    renderMixedChart(res.labels, res.cantidades, res.montos, res.totalPedidos, res.totalMonto);
                }
            }
        });
    }

    // ========================================================
    // 6. RENDER LINE CHART (AdminLTE 4)
    // ========================================================
    function renderLineChart() {
        const canvas = document.querySelector('#line-chart');
        if (!canvas) return;
        if (lineChartInstance) lineChartInstance.destroy();

        lineChartInstance = new Chart(canvas, {
            type: 'line',
            data: {
                labels: allMesesVentas.slice(-10),
                datasets: [
                    {
                        label: 'Ingresos Acumulados',
                        data: (allVentasActual || []).slice(-10),
                        borderColor: '#0d6efd',
                        backgroundColor: '#0d6efd',
                        borderWidth: 3,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        tension: 0.3
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                return ' Ingresos: S/ ' + (ctx.parsed.y * 1000).toLocaleString('es-PE');
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        ticks: { callback: thousands }
                    }
                }
            }
        });
    }

    // ========================================================
    // 7. TABLAS DE DETALLE & ACCIONES INTERACTIVAS
    // ========================================================
    function alternarTopPedidosV2() {
        verTop10Pedidos = !verTop10Pedidos;
        if (verTop10Pedidos) {
            $('.v2-fila-top-extra').removeClass('d-none');
            $('#v2-label-top-pedidos').text('Top 10');
            $('#v2-btn-toggle-top-pedidos').html('<i class="bi bi-chevron-up me-1"></i>Ver Top 5');
        } else {
            $('.v2-fila-top-extra').addClass('d-none');
            $('#v2-label-top-pedidos').text('Top 5');
            $('#v2-btn-toggle-top-pedidos').html('<i class="bi bi-chevron-down me-1"></i>Ver Top 10');
        }
    }

    function alternarVerMasClientesInactivosV2() {
        ver10ClientesInactivos = !ver10ClientesInactivos;
        if (ver10ClientesInactivos) {
            $('.v2-fila-inactivo-extra').removeClass('d-none');
            $('#v2-btn-ver-mas-clientes').html('<i class="bi bi-chevron-up me-1"></i>Ver menos (5)');
        } else {
            $('.v2-fila-inactivo-extra').addClass('d-none');
            $('#v2-btn-ver-mas-clientes').html('<i class="bi bi-chevron-down me-1"></i>Ver más (10)');
        }
    }

    function cambiarFiltroInactivosV2() {
        const meses = parseInt($('#v2-select-meses-inactivos').val()) || 5;
        const vid = $('#v2-select-vendedor-inactivos').val();
        $('#v2-label-meses-inactivos').html('&ge; ' + meses + ' Meses');

        $.ajax({
            url: '@Url.Action("ObtenerClientesInactivos", "Home")',
            type: 'GET',
            data: { meses: meses, vendedorId: vid ? parseInt(vid) : null },
            success: function(res) {
                if (res && res.success && res.data) {
                    const $tbody = $('#v2-tabla-clientes-inactivos tbody').empty();
                    if (res.data.length === 0) {
                        $tbody.append('<tr><td colspan="2" class="text-center text-muted py-4"><i class="bi bi-check-circle-fill text-success me-1"></i> No se encontraron clientes inactivos</td></tr>');
                    } else {
                        $.each(res.data, function(i, c) {
                            const isExtra = (i >= 5 && !ver10ClientesInactivos) ? 'd-none v2-fila-inactivo-extra' : '';
                            const row = '<tr class="dashboard-drilldown-row ' + isExtra + '" onclick="mostrarEnDesarrollo(\'Ficha del Cliente: ' + (c.cliente || '') + '\');" title="Clic para ver ficha">' +
                                '<td class="py-2"><span class="fw-semibold text-body d-block">' + (c.cliente || 'Sin Nombre') + '</span><small class="text-muted"><i class="bi bi-person me-1"></i>' + (c.vendedor || 'Sin vendedor') + '</small></td>' +
                                '<td class="text-end py-2 pe-3 text-nowrap"><span class="badge bg-warning-subtle text-warning-emphasis border px-2 py-1 fw-bold"><i class="bi bi-calendar-x me-1"></i>' + (c.fechaFormateada || '') + '</span></td>' +
                                '</tr>';
                            $tbody.append(row);
                        });
                    }
                }
            }
        });
    }

    // ========================================================
    // 8. SINCRONIZACIÓN EN TIEMPO REAL V2
    // ========================================================
    function sincronizarDashboardV2() {
        const $icon = $('#icon-sync-v2').addClass('bi-spin fa-spin');
        const vid = $('#v2-select-vendedor-chart').val();
        const meses = $('#v2-select-meses-inactivos').val() || 5;

        $.ajax({
            url: '@Url.Action("ObtenerMetricas", "Home")',
            type: 'GET',
            data: { vendedorId: vid, mesesInactivos: meses },
            success: function(res) {
                $icon.removeClass('bi-spin fa-spin');
                actualizarRelojEnVivo();
                if (res && res.success) {
                    $('#v2-kpi-ventas').text(res.kpis.facturacionMes);
                    $('#v2-kpi-pedidos').text(res.kpis.pedidosActivos);
                    $('#v2-kpi-cotizaciones').text(res.kpis.cotizacionesActivas);
                    $('#v2-kpi-produccion').text(res.kpis.ordenesProduccionMes);
                    $('#v2-kpi-compras').text(res.kpis.ordenesCompraMes);
                    $('#v2-kpi-pedidos-cantidad').text(res.kpis.pedidosMesCantidad.toLocaleString());
                    $('#v2-kpi-pedidos-monto-footer').text('Total: ' + res.kpis.pedidosMesMonto);

                    allMesesVentas = res.graficoVentas.meses;
                    allVentasActual = res.graficoVentas.ventasActual;
                    allVentasAnterior = res.graficoVentas.ventasAnterior;

                    allStackedLabels = res.graficoStackedBar.labels;
                    allDsCentral = res.graficoStackedBar.datasets[0].data;
                    allDsIlo = res.graficoStackedBar.datasets[1].data;

                    prodLabels = res.graficoProduccion.labels;
                    prodValores = res.graficoProduccion.valores;

                    setVentasMesesV2(ventasMesesActuales);
                    setStackedDiasV2(stackedDiasActuales);
                    renderDonutChart(prodLabels, prodValores);
                    renderRadialBarChart();
                    renderLineChart();
                }
            },
            error: function() {
                $icon.removeClass('bi-spin fa-spin');
            }
        });
    }

    // ========================================================
    // 9. GESTIÓN DE ÁREAS V2
    // ========================================================
    function aplicarPreferenciasV2() {
        const prefs = {};
        $('.chk-v2-area').each(function() {
            prefs[$(this).data('area')] = $(this).is(':checked');
        });
        localStorage.setItem('arco_dashboard_v2_pref', JSON.stringify(prefs));
        ejecutarVisibilidadV2(prefs);
    }

    function ejecutarVisibilidadV2(prefs) {
        if (!prefs) return;
        if (prefs['kpis'] === false) $('#v2-row-kpis').addClass('d-none'); else $('#v2-row-kpis').removeClass('d-none');
        if (prefs['infoboxes'] === false) $('#v2-row-infoboxes').addClass('d-none'); else $('#v2-row-infoboxes').removeClass('d-none');
        if (prefs['area-chart'] === false) $('#v2-area-chart-container').addClass('d-none'); else $('#v2-area-chart-container').removeClass('d-none');
        if (prefs['column-chart'] === false) $('#v2-column-chart-container').addClass('d-none'); else $('#v2-column-chart-container').removeClass('d-none');
        if (prefs['donut-chart'] === false) $('#v2-donut-chart-container').addClass('d-none'); else $('#v2-donut-chart-container').removeClass('d-none');
        if (prefs['radialbar-chart'] === false) $('#v2-radialbar-chart-container').addClass('d-none'); else $('#v2-radialbar-chart-container').removeClass('d-none');
        if (prefs['mixed-chart'] === false) $('#v2-mixed-chart-container').addClass('d-none'); else $('#v2-mixed-chart-container').removeClass('d-none');
        if (prefs['line-chart'] === false) $('#v2-line-chart-container').addClass('d-none'); else $('#v2-line-chart-container').removeClass('d-none');
        if (prefs['apps'] === false) $('#v2-row-apps').addClass('d-none'); else $('#v2-row-apps').removeClass('d-none');
        if (prefs['tablas'] === false) $('#v2-row-tablas').addClass('d-none'); else $('#v2-row-tablas').removeClass('d-none');
    }

    function cargarPreferenciasV2() {
        const saved = localStorage.getItem('arco_dashboard_v2_pref');
        if (saved) {
            const prefs = JSON.parse(saved);
            $('.chk-v2-area').each(function() {
                const a = $(this).data('area');
                if (prefs[a] !== undefined) $(this).prop('checked', prefs[a]);
            });
            ejecutarVisibilidadV2(prefs);
        }
    }

    // ========================================================
    // INICIALIZACIÓN
    // ========================================================
    $(document).ready(function() {
        actualizarRelojEnVivo();
        cargarPreferenciasV2();

        // Renderizar los 6 gráficos oficiales de AdminLTE 4
        setVentasMesesV2(12);
        setStackedDiasV2(12);
        renderDonutChart(prodLabels, prodValores);
        renderRadialBarChart();
        setVendedorDiasV2(12);
        renderLineChart();

        // Escuchar cambio dinámico de tema Claro / Oscuro
        $(document).on('themeChanged', function() {
            setTimeout(function() {
                renderDonutChart(prodLabels, prodValores);
                renderRadialBarChart();
            }, 50);
        });

        // Polling cada 30 segundos
        setInterval(sincronizarDashboardV2, 30000);
        setInterval(actualizarRelojEnVivo, 1000);
    });
</script>
}
