    // ========================================================
    // 10. SINCRONIZACIÓN EN TIEMPO REAL (POLLING)
    // ========================================================
    function sincronizarDashboard() {
        var $icon = $('#icon-sync').addClass('fa-spin bi-spin');
        var vid = $('#select-vendedor-chart').val();
        var sede = sedeGlobalSeleccionada > 0 ? sedeGlobalSeleccionada : null;

        $.ajax({
            url: '@Url.Action("ObtenerKpisPorSede", "Home")',
            type: 'GET',
            data: { sedeId: sede, vendedorId: vid },
            success: function(res) {
                $icon.removeClass('fa-spin bi-spin');
                if (res && res.success) {
                    if (res.facturacionMes) $('#kpi-ventas').text(res.facturacionMes);
                    if (res.pedidosActivos) $('#kpi-pedidos').text(res.pedidosActivos);
                    if (res.cotizacionesActivas) $('#kpi-cotizaciones').text(res.cotizacionesActivas);
                    if (res.ordenesProduccionMes) $('#kpi-produccion').text(res.ordenesProduccionMes);
                    if (res.ordenesCompraMes) $('#kpi-compras').text(res.ordenesCompraMes);
                    if (res.pedidosMesCantidad !== undefined) $('#kpi-pedidos-cantidad').text(Number(res.pedidosMesCantidad).toLocaleString());
                    if (res.pedidosMesMonto) $('#kpi-pedidos-monto-footer').text('Total: ' + res.pedidosMesMonto);
                    if (res.consumoInternoMes !== undefined) $('#kpi-consumo-interno').text(res.consumoInternoMes);
                    if (res.ingresosMermaMes !== undefined && res.salidasMermaMes !== undefined) {
                        $('#kpi-mermas').html('<span>' + res.ingresosMermaMes + '</span><span class="fs-4 opacity-75">' + res.salidasMermaMes + '</span>');
                    }
                    if (res.guiasRemisionMes !== undefined) $('#kpi-guias-remision').text(res.guiasRemisionMes);
                }
            },
            error: function() {
                $icon.removeClass('fa-spin bi-spin');
            }
        });
    }

    // ========================================================
    // 11. GESTIÓN DEL DASHBOARD (PERSONALIZACIÓN USUARIO)
    // ========================================================
    var STORAGE_PREF_KEY = 'arco_dashboard_pref_' + ('@(userSession?.UsuarioLogon ?? "admin")');

    function aplicarPreferenciasDashboard() {
        var prefs = {};
        $('.chk-dashboard-area').each(function() {
            var area = $(this).data('area');
            prefs[area] = $(this).is(':checked');
        });

        var kpiPrefs = {};
        $('.chk-sub-kpi').each(function() {
            var kpi = $(this).data('kpi');
            kpiPrefs[kpi] = $(this).is(':checked');
        });
        prefs['sub_kpis'] = kpiPrefs;

        localStorage.setItem(STORAGE_PREF_KEY, JSON.stringify(prefs));
        ejecutarVisibilidadAreas(prefs);
    }

    function ejecutarVisibilidadAreas(prefs) {
        if (!prefs) return;

        // Tarjetas KPIs
        if (prefs['kpis'] === false) {
            $('#row-kpis-metricas').addClass('d-none');
        } else {
            $('#row-kpis-metricas').removeClass('d-none');
            if (prefs['sub_kpis']) {
                $.each(prefs['sub_kpis'], function(kpi, visible) {
                    var $card = $('#card-kpi-' + kpi);
                    if (visible === false) $card.addClass('d-none');
                    else $card.removeClass('d-none');
                });
            }
        }

        // Demás áreas
        var areasMap = {
            'evolucion-ventas': '#area-evolucion-ventas',
            'distribucion-sede': '#area-distribucion-sede',
            'cotizaciones-vendedor': '#area-cotizaciones-vendedor',
            'pedidos-vendedor': '#area-pedidos-vendedor',
            'accesos-rapidos': '#area-accesos-rapidos',
            'estado-produccion': '#area-estado-produccion',
            'agenda-calendario': '#area-agenda-calendario',
            'db-tiempo-real': '#area-db-tiempo-real',
            'top-pedidos': '#area-top-pedidos',
            'clientes-inactivos': '#area-clientes-inactivos',
            'stock-insumos': '#row-stock-insumos',
            'top-menor-stock': '#row-top-menor-stock'
        };

        var activas = 0;
        $.each(areasMap, function(k, sel) {
            if (prefs[k] === false) {
                $(sel).addClass('d-none');
            } else {
                $(sel).removeClass('d-none');
                activas++;
            }
        });
        if (prefs['kpis'] !== false) activas++;
        $('#modal-conteo-areas-activas').text(activas);

        if (activas === 0) {
            $('#dashboard-empty-state').removeClass('d-none');
        } else {
            $('#dashboard-empty-state').addClass('d-none');
        }
    }

    function cargarPreferenciasDashboard() {
        var saved = localStorage.getItem(STORAGE_PREF_KEY);
        var prefs = saved ? JSON.parse(saved) : null;
        if (prefs) {
            $('.chk-dashboard-area').each(function() {
                var area = $(this).data('area');
                if (prefs[area] !== undefined) {
                    $(this).prop('checked', prefs[area]);
                }
            });
            if (prefs['sub_kpis']) {
                $('.chk-sub-kpi').each(function() {
                    var kpi = $(this).data('kpi');
                    if (prefs['sub_kpis'][kpi] !== undefined) {
                        $(this).prop('checked', prefs['sub_kpis'][kpi]);
                    }
                });
            }
            ejecutarVisibilidadAreas(prefs);
        }
    }

    $('#chk-area-kpis').on('change', function() {
        if ($(this).is(':checked')) {
            $('#sub-kpis-container').slideDown(200);
        } else {
            $('#sub-kpis-container').slideUp(200);
        }
    });

    $('#btn-modal-marcar-todos').on('click', function() {
        $('.chk-dashboard-area, .chk-sub-kpi').prop('checked', true);
        $('#sub-kpis-container').slideDown(200);
    });

    $('#btn-modal-desmarcar-todos').on('click', function() {
        $('.chk-dashboard-area, .chk-sub-kpi').prop('checked', false);
        $('#sub-kpis-container').slideUp(200);
    });

    $('#btn-modal-restablecer').on('click', function() {
        localStorage.removeItem(STORAGE_PREF_KEY);
        $('.chk-dashboard-area, .chk-sub-kpi').prop('checked', true);
        $('#sub-kpis-container').hide();
        aplicarPreferenciasDashboard();
    });

    // ========================================================
    // 12. GESTIÓN POR ROL (ADMINISTRADOR EN BD)
    // ========================================================
    function cargarPermisosRol() {
        var rol = $('#select-rol-dashboard').val();
        var rolConfigStr = rolesConfigBd[rol];
        var rolPrefs = null;

        if (rolConfigStr) {
            try {
                rolPrefs = typeof rolConfigStr === 'string' ? JSON.parse(rolConfigStr) : rolConfigStr;
            } catch(e) {}
        }

        if (rolPrefs) {
            $('.chk-dashboard-rol-area').each(function() {
                var area = $(this).data('area');
                $(this).prop('checked', rolPrefs[area] !== false);
            });
        } else {
            $('.chk-dashboard-rol-area').prop('checked', true);
        }
        contarAreasRol();
    }

    function contarAreasRol() {
        var checked = $('.chk-dashboard-rol-area:checked').length;
        $('#modal-rol-conteo-areas-activas').text(checked);
    }

    $('.chk-dashboard-rol-area').on('change', contarAreasRol);

    function guardarPermisosRol() {
        var rol = $('#select-rol-dashboard').val();
        var prefs = {};
        $('.chk-dashboard-rol-area').each(function() {
            var area = $(this).data('area');
            prefs[area] = $(this).is(':checked');
        });

        var jsonStr = JSON.stringify(prefs);
        rolesConfigBd[rol] = jsonStr;

        $.ajax({
            url: '@Url.Action("GuardarConfiguracionDashboardRol", "Home")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ rolCodigo: rol, configJson: jsonStr }),
            success: function(res) {
                if (res && res.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Permisos de Rol Guardados',
                        text: 'Las áreas del dashboard para el rol ' + rol + ' se han actualizado en la base de datos.',
                        timer: 1600,
                        showConfirmButton: false
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: res.message || 'No se pudo guardar la configuración.'
                    });
                }
            }
        });
    }

    function simularVistaRol() {
        var rol = $('#select-rol-dashboard').val();
        var rolConfigStr = rolesConfigBd[rol];
        var prefs = {};
        if (rolConfigStr) {
            try {
                prefs = typeof rolConfigStr === 'string' ? JSON.parse(rolConfigStr) : rolConfigStr;
            } catch(e) {}
        }
        ejecutarVisibilidadAreas(prefs);
        bootstrap.Modal.getInstance(document.getElementById('modal-gestionar-dashboard-rol')).hide();

        Swal.fire({
            icon: 'info',
            title: 'Simulando Vista de Rol',
            text: 'Visualizando el dashboard con los permisos asignados a ' + rol + '.',
            timer: 2000,
            showConfirmButton: false
        });
    }

    $('#btn-modal-rol-marcar-todos').on('click', function() {
        $('.chk-dashboard-rol-area').prop('checked', true);
        contarAreasRol();
    });

    $('#btn-modal-rol-desmarcar-todos').on('click', function() {
        $('.chk-dashboard-rol-area').prop('checked', false);
        contarAreasRol();
    });

    $('#btn-modal-rol-restablecer').on('click', function() {
        $('.chk-dashboard-rol-area').prop('checked', true);
        contarAreasRol();
    });

    // ========================================================
    // MOTOR DE DRAG & DROP Y PERSONALIZACIÓN DE DASHBOARD
    // ========================================================
    var currentProporcionColumnas = '7-5';
    var draggedCardElement = null;
    var dashboardDropPlaceholder = null;

    function getStorageLayoutKey() {
        var u = (currentUsername || 'default_user').toLowerCase().trim();
        var r = (currentRoleCode || 'default_role').toLowerCase().trim();
        return 'arco_dashboard_layout_u_' + u + '_r_' + r + '_v1';
    }

    function findWidgetElement(widgetKey) {
        var $el = $('[data-widget-id="' + widgetKey + '"]');
        if ($el.length) return $el;
        return $('#area-' + widgetKey).length ? $('#area-' + widgetKey) : $('#row-' + widgetKey);
    }

    function redimensionarTodosLosGraficos() {
        try {
            if (salesChartInstance) salesChartInstance.resize();
            if (stackedChartInstance) stackedChartInstance.resize();
            if (vendedorChartInstance) vendedorChartInstance.resize();
            if (cotizacionChartInstance) cotizacionChartInstance.resize();
            if (productionChartInstance) productionChartInstance.resize();
        } catch (e) { }
        window.dispatchEvent(new Event('resize'));
    }

    function aplicarProporcionColumnas(ratio, save) {
        currentProporcionColumnas = ratio || '7-5';
        var $colLeft = $('#col-main-left');
        var $colRight = $('#col-main-right');
        var labelText = 'Columnas: 7:5';

        $colLeft.removeClass('col-lg-5 col-lg-6 col-lg-7 col-lg-8 col-lg-12');
        $colRight.removeClass('col-lg-5 col-lg-6 col-lg-7 col-lg-4 col-lg-12');

        if (ratio === '6-6') {
            $colLeft.addClass('col-lg-6');
            $colRight.addClass('col-lg-6');
            labelText = 'Columnas: 6:6';
        } else if (ratio === '5-7') {
            $colLeft.addClass('col-lg-5');
            $colRight.addClass('col-lg-7');
            labelText = 'Columnas: 5:7';
        } else if (ratio === '12-12') {
            $colLeft.addClass('col-lg-12');
            $colRight.addClass('col-lg-12');
            labelText = 'Columnas: 100%';
        } else {
            $colLeft.addClass('col-lg-7');
            $colRight.addClass('col-lg-5');
            labelText = 'Columnas: 7:5';
        }

        $('#label-proporcion-actual').text(labelText);

        if (save !== false) {
            guardarLayoutDashboard();
        }

        setTimeout(function() {
            redimensionarTodosLosGraficos();
        }, 80);
    }

    function adaptCardToZone(cardEl, zoneName) {
        var $c = $(cardEl);
        var isCard = $c.hasClass('card');

        if (zoneName === 'full-top' || zoneName === 'full-bottom') {
            if (isCard) {
                $c.addClass('col-12 mb-3');
            } else {
                $c.addClass('col-12 mb-3').removeClass('col-lg-6');
            }
        } else {
            if (isCard) {
                $c.removeClass('col-12');
            } else {
                $c.removeClass('col-12 col-lg-6');
            }
            $c.addClass('mb-3');
        }
    }

    function aplicarAlturaWidget($card, heightPx, notify) {
        var h = parseInt(heightPx, 10);
        if (isNaN(h) || h < 120) return;

        var $target = $card.find('#diferencia-chart-container, #vendedor-chart-container, #cotizacion-vendedor-chart-container, #lista-eventos-agenda, .table-responsive').first();
        if (!$target.length) {
            $target = $card.find('.position-relative').first();
        }
        if (!$target.length) {
            $target = $card.find('.card-body').first();
        }

        if ($target.length) {
            $target.css({ 'height': h + 'px', 'max-height': h + 'px' });
            $card.attr('data-custom-height', h);
            redimensionarTodosLosGraficos();
        }
    }

    function guardarLayoutDashboard() {
        try {
            var layout = {
                proporcion: currentProporcionColumnas || '7-5',
                kpis: [],
                fullTop: [],
                colLeft: [],
                colRight: [],
                fullBottom: [],
                heights: {}
            };

            // Guardar orden de KPIs
            $('#row-kpis-metricas .kpi-draggable-card').each(function() {
                layout.kpis.push($(this).attr('data-kpi-id') || this.id);
            });

            // Guardar orden por zonas
            $('#zone-full-top .dashboard-draggable-card').each(function() {
                var k = $(this).attr('data-widget-id');
                if (k) layout.fullTop.push(k);
            });

            $('#col-main-left .dashboard-draggable-card').each(function() {
                var k = $(this).attr('data-widget-id');
                if (k) layout.colLeft.push(k);
            });

            $('#col-main-right .dashboard-draggable-card').each(function() {
                var k = $(this).attr('data-widget-id');
                if (k) layout.colRight.push(k);
            });

            $('#zone-full-bottom .dashboard-draggable-card').each(function() {
                var k = $(this).attr('data-widget-id');
                if (k) layout.fullBottom.push(k);
            });

            // Guardar alturas personalizadas
            $('.dashboard-draggable-card').each(function() {
                var k = $(this).attr('data-widget-id');
                var h = $(this).attr('data-custom-height');
                if (k && h) {
                    layout.heights[k] = h;
                }
            });

            localStorage.setItem(getStorageLayoutKey(), JSON.stringify(layout));
        } catch (e) {
            console.warn('Error guardando layout de dashboard:', e);
        }
    }

    function restaurarLayoutDashboard() {
        try {
            var raw = localStorage.getItem(getStorageLayoutKey());
            if (!raw) return;
            var layout = JSON.parse(raw);
            if (!layout) return;

            // 1. Proporción de columnas
            if (layout.proporcion) {
                aplicarProporcionColumnas(layout.proporcion, false);
            }

            // 2. Orden de KPIs
            if (layout.kpis && layout.kpis.length > 0) {
                var $kpiRow = $('#row-kpis-metricas');
                layout.kpis.forEach(function(kId) {
                    var $kCard = $('#' + kId);
                    if ($kCard.length) {
                        $kpiRow.append($kCard);
                    }
                });
            }

            function placeWidget(wKey, $targetZone, zoneName) {
                var $w = findWidgetElement(wKey);
                if ($w && $w.length) {
                    adaptCardToZone($w[0], zoneName);
                    $targetZone.append($w);
                }
            }

            // 3. Zonas
            if (layout.fullTop && layout.fullTop.length) {
                var $zTop = $('#zone-full-top');
                layout.fullTop.forEach(function(k) { placeWidget(k, $zTop, 'full-top'); });
            }
            if (layout.colLeft && layout.colLeft.length) {
                var $zLeft = $('#col-main-left');
                layout.colLeft.forEach(function(k) { placeWidget(k, $zLeft, 'left'); });
            }
            if (layout.colRight && layout.colRight.length) {
                var $zRight = $('#col-main-right');
                layout.colRight.forEach(function(k) { placeWidget(k, $zRight, 'right'); });
            }
            if (layout.fullBottom && layout.fullBottom.length) {
                var $zBottom = $('#zone-full-bottom');
                layout.fullBottom.forEach(function(k) { placeWidget(k, $zBottom, 'full-bottom'); });
            }

            // 4. Alturas
            if (layout.heights) {
                for (var hKey in layout.heights) {
                    var $item = findWidgetElement(hKey);
                    if ($item && $item.length) {
                        aplicarAlturaWidget($item, layout.heights[hKey], false);
                    }
                }
            }

            setTimeout(function() {
                redimensionarTodosLosGraficos();
            }, 120);
        } catch (e) {
            console.warn('Error restaurando layout de dashboard:', e);
        }
    }

    function getDragAfterElement(container, y) {
        var draggableElements = Array.prototype.slice.call(container.querySelectorAll('.dashboard-draggable-card:not(.is-dragging)'));
        return draggableElements.reduce(function(closest, child) {
            var box = child.getBoundingClientRect();
            var offset = y - box.top - box.height / 2;
            if (offset < 0 && offset > closest.offset) {
                return { offset: offset, element: child };
            } else {
                return closest;
            }
        }, { offset: Number.NEGATIVE_INFINITY }).element;
    }

    function getKpiDragAfterElement(container, x, y) {
        var draggableElements = Array.prototype.slice.call(container.querySelectorAll('.kpi-draggable-card:not(.is-dragging)'));
        return draggableElements.reduce(function(closest, child) {
            var box = child.getBoundingClientRect();
            var offsetX = x - (box.left + box.width / 2);
            var offsetY = y - (box.top + box.height / 2);
            var dist = Math.sqrt(offsetX * offsetX + offsetY * offsetY);
            if (x < box.left + box.width / 2 && y < box.bottom) {
                if (dist < closest.dist) {
                    return { dist: dist, element: child };
                }
            }
            return closest;
        }, { dist: Number.POSITIVE_INFINITY }).element;
    }

    function initDashboardDragAndDrop() {
        if (!dashboardDropPlaceholder) {
            dashboardDropPlaceholder = document.createElement('div');
            dashboardDropPlaceholder.className = 'dashboard-drop-placeholder';
            dashboardDropPlaceholder.innerHTML = '<div class="placeholder-inner"><i class="fas fa-arrows-alt me-2"></i>Soltar widget aquí</div>';
        }

        // Drag & Drop de Widgets del Dashboard
        $(document).on('mousedown', '.widget-drag-handle', function() {
            var card = $(this).closest('.dashboard-draggable-card')[0];
            if (card) {
                card.setAttribute('draggable', 'true');
            }
        });

        $(document).on('mouseup', function() {
            $('.dashboard-draggable-card[draggable="true"]').removeAttr('draggable');
        });

        $('.dashboard-draggable-card').each(function() {
            var card = this;

            card.addEventListener('dragstart', function(e) {
                var tag = (e.target.tagName || '').toLowerCase();
                if (tag === 'select' || tag === 'input' || tag === 'button' || tag === 'a' || tag === 'option') {
                    e.preventDefault();
                    return false;
                }
                if ($(e.target).closest('select, input, button, a, .btn, .btn-group, .dropdown-menu').length > 0) {
                    e.preventDefault();
                    return false;
                }

                draggedCardElement = card;
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', $(card).attr('data-widget-id') || card.id);

                setTimeout(function() {
                    $(card).addClass('is-dragging');
                    $('.dashboard-dropzone').addClass('drag-active');
                }, 0);
            });

            card.addEventListener('dragend', function() {
                $(card).removeAttr('draggable').removeClass('is-dragging');
                $('.dashboard-dropzone').removeClass('drag-active');
                if (dashboardDropPlaceholder && dashboardDropPlaceholder.parentNode) {
                    dashboardDropPlaceholder.parentNode.removeChild(dashboardDropPlaceholder);
                }
                draggedCardElement = null;
                guardarLayoutDashboard();
                setTimeout(function() {
                    redimensionarTodosLosGraficos();
                }, 60);
            });
        });

        // Zonas de soltado
        var dropzones = document.querySelectorAll('.dashboard-dropzone');
        dropzones.forEach(function(zone) {
            zone.addEventListener('dragover', function(e) {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'move';
                if (!draggedCardElement) return;

                var afterElement = getDragAfterElement(zone, e.clientY);
                if (!afterElement) {
                    zone.appendChild(dashboardDropPlaceholder);
                } else {
                    zone.insertBefore(dashboardDropPlaceholder, afterElement);
                }
            });

            zone.addEventListener('drop', function(e) {
                e.preventDefault();
                if (!draggedCardElement || !dashboardDropPlaceholder) return;

                var zoneName = $(zone).attr('data-zone') || '';
                adaptCardToZone(draggedCardElement, zoneName);

                zone.insertBefore(draggedCardElement, dashboardDropPlaceholder);
                if (dashboardDropPlaceholder.parentNode) {
                    dashboardDropPlaceholder.parentNode.removeChild(dashboardDropPlaceholder);
                }

                guardarLayoutDashboard();
                setTimeout(function() {
                    redimensionarTodosLosGraficos();
                }, 60);
            });
        });

        // Drag & Drop de tarjetas KPI
        var kpiRow = document.getElementById('row-kpis-metricas');
        if (kpiRow) {
            var $kpis = $(kpiRow).find('.kpi-draggable-card');
            $kpis.each(function() {
                var kpi = this;
                kpi.setAttribute('draggable', 'true');

                kpi.addEventListener('dragstart', function(e) {
                    draggedCardElement = kpi;
                    e.dataTransfer.effectAllowed = 'move';
                    e.dataTransfer.setData('text/plain', kpi.id);
                    setTimeout(function() {
                        $(kpi).addClass('is-dragging');
                    }, 0);
                });

                kpi.addEventListener('dragend', function() {
                    $(kpi).removeClass('is-dragging');
                    draggedCardElement = null;
                    guardarLayoutDashboard();
                });
            });

            kpiRow.addEventListener('dragover', function(e) {
                e.preventDefault();
                if (!draggedCardElement || !draggedCardElement.classList.contains('kpi-draggable-card')) return;
                var afterEl = getKpiDragAfterElement(kpiRow, e.clientX, e.clientY);
                if (!afterEl) {
                    kpiRow.appendChild(draggedCardElement);
                } else {
                    kpiRow.insertBefore(draggedCardElement, afterEl);
                }
            });
        }

        // Click en posición de widget
        $(document).on('click', '.btn-widget-pos', function(e) {
            e.preventDefault();
            var $btn = $(this);
            var zoneName = $btn.data('zone');
            var $card = $btn.closest('.dashboard-draggable-card');
            if (!$card.length) return;

            var $targetZone = $('#zone-' + zoneName);
            if (zoneName === 'left') $targetZone = $('#col-main-left');
            if (zoneName === 'right') $targetZone = $('#col-main-right');
            if (zoneName === 'full-top') $targetZone = $('#zone-full-top');
            if (zoneName === 'full-bottom') $targetZone = $('#zone-full-bottom');

            if ($targetZone.length) {
                adaptCardToZone($card[0], zoneName);
                $targetZone.prepend($card);
                guardarLayoutDashboard();
                redimensionarTodosLosGraficos();
            }
        });

        // Click en altura de widget
        $(document).on('click', '.btn-widget-height', function(e) {
            e.preventDefault();
            var h = $(this).data('height');
            var $card = $(this).closest('.dashboard-draggable-card');
            if ($card.length && h) {
                aplicarAlturaWidget($card, h, true);
                guardarLayoutDashboard();
            }
        });

        // Click en proporción de columnas
        $(document).on('click', '.item-proporcion-col', function(e) {
            e.preventDefault();
            var ratio = $(this).data('ratio');
            aplicarProporcionColumnas(ratio, true);
        });

        // Click en restablecer layout
        $(document).on('click', '#btn-restablecer-layout', function(e) {
            e.preventDefault();
            if (window.Swal) {
                Swal.fire({
                    title: '¿Restablecer diseño?',
                    text: 'Se restablecerá la ubicación, orden y tamaños predeterminados de todos los widgets del dashboard.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#0d6efd',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="bi bi-arrow-counterclockwise me-1"></i> Sí, restablecer',
                    cancelButtonText: 'Cancelar'
                }).then(function(result) {
                    if (result.isConfirmed) {
                        localStorage.removeItem(getStorageLayoutKey());
                        setTimeout(function() {
                            location.reload();
                        }, 200);
                    }
                });
            } else if (confirm('¿Deseas restablecer el diseño y tamaños predeterminados del dashboard?')) {
                localStorage.removeItem(getStorageLayoutKey());
                location.reload();
            }
        });

        // Redimensionamiento vertical arrastrable (Resize bar)
        $(document).on('mousedown', '.dashboard-card-resize-bar', function(e) {
            e.preventDefault();
            var $bar = $(this);
            var $card = $bar.closest('.dashboard-draggable-card');

            var $target = $card.find('#diferencia-chart-container, #vendedor-chart-container, #cotizacion-vendedor-chart-container, #lista-eventos-agenda, .table-responsive').first();
            if (!$target.length) {
                $target = $card.find('.position-relative').first();
            }
            if (!$target.length) {
                $target = $card.find('.card-body').first();
            }
            if (!$target.length) return;

            var startY = e.clientY;
            var startHeight = $target.outerHeight() || 250;

            $bar.addClass('is-resizing');
            $('body').css('cursor', 'ns-resize');

            function onMouseMove(moveEvt) {
                var deltaY = moveEvt.clientY - startY;
                var newH = Math.max(140, Math.min(850, startHeight + deltaY));
                $target.css({ 'height': newH + 'px', 'max-height': newH + 'px' });
                $card.attr('data-custom-height', newH);
                redimensionarTodosLosGraficos();
            }

            function onMouseUp() {
                $(document).off('mousemove', onMouseMove);
                $(document).off('mouseup', onMouseUp);
                $bar.removeClass('is-resizing');
                $('body').css('cursor', '');
                guardarLayoutDashboard();
                setTimeout(function() {
                    redimensionarTodosLosGraficos();
                }, 50);
            }

            $(document).on('mousemove', onMouseMove);
            $(document).on('mouseup', onMouseUp);
        });

        // Soporte rueda de ratón en gráficos de vendedor y cotización
        $('#cotizacion-vendedor-chart-container, #vendedor-chart-container, #diferencia-chart-container').on('wheel', function(e) {
            e.preventDefault();
            var delta = e.originalEvent.deltaY;
            var isCotiz = $(this).attr('id') === 'cotizacion-vendedor-chart-container';
            var isVend = $(this).attr('id') === 'vendedor-chart-container';
            var diasArr = [6, 8, 10, 12];

            if (isCotiz) {
                var cIdx = diasArr.indexOf(cotizacionDiasActuales);
                if (delta > 0 && cIdx < diasArr.length - 1) {
                    setCotizacionDias(diasArr[cIdx + 1]);
                } else if (delta < 0 && cIdx > 0) {
                    setCotizacionDias(diasArr[cIdx - 1]);
                }
            } else if (isVend) {
                var vIdx = diasArr.indexOf(vendedorDiasActuales);
                if (delta > 0 && vIdx < diasArr.length - 1) {
                    setVendedorDias(diasArr[vIdx + 1]);
                } else if (delta < 0 && vIdx > 0) {
                    setVendedorDias(diasArr[vIdx - 1]);
                }
            }
        });
    }

    // ========================================================
    // INICIALIZACIÓN DOCUMENT READY
    // ========================================================
    $(document).ready(function() {
        // Cargar preferencias guardadas
        cargarPreferenciasDashboard();

        // Inicializar texto semanal de agenda de eventos
        actualizarTextoRangoSemanal();

        // Render inicial de gráficos
        setVentasMeses(12);
        setStackedDias(12);
        setVendedorDias(12);
        setCotizacionDias(12);
        renderProductionChart(prodLabels, prodValores);

        // Inicializar motor de Drag & Drop y restaurar layout guardado
        initDashboardDragAndDrop();
        restaurarLayoutDashboard();

        // Actualizar gráficos al cambiar tema claro/oscuro
        $(document).on('themeChanged', function() {
            setVentasMeses(ventasMesesActuales);
            setStackedDias(stackedDiasActuales);
            setVendedorDias(vendedorDiasActuales);
            setCotizacionDias(cotizacionDiasActuales);
            renderProductionChart(prodLabels, prodValores);
        });

        // Polling en tiempo real cada 30 segundos
        setInterval(sincronizarDashboard, 30000);
    });
</script>
