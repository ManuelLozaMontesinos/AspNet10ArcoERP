@section Scripts {
<script>
    // ========================================================
    // ALERTA VISUAL: MÓDULO EN DESARROLLO (Solicitud del Usuario)
    // ========================================================
    function mostrarEnDesarrollo(modulo) {
        Swal.fire({
            icon: 'info',
            title: 'Módulo en Desarrollo',
            html: '<p class="mb-2">El módulo <strong>' + modulo + '</strong> se encuentra actualmente en proceso de migración para ASP.NET Core 10.</p><small class="text-muted">Pronto estará disponible con todas sus funcionalidades conectadas a la base de datos en tiempo real.</small>',
            confirmButtonText: '<i class="bi bi-check2-circle me-1"></i>Entendido',
            confirmButtonColor: '#0d6efd',
            customClass: {
                popup: 'rounded-4 shadow'
            }
        });
    }

    // ========================================================
    // VARIABLES GLOBALES Y DATOS DE MODELO
    // ========================================================
    var allMesesVentas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.MesesVentas ?? Array.Empty<string>()));
    var allVentasAnterior = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.VentasAnterior ?? Array.Empty<double>()));
    var allVentasActual = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.VentasActual ?? Array.Empty<double>()));
    var allVentasBarra = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.VentasBarraActual ?? Array.Empty<double?>()));

    var allStackedLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.StackedLabels ?? new List<string>()));
    var allDsCentral = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.DsCentral ?? Array.Empty<double>()));
    var allDsIlo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.DsIlo ?? Array.Empty<double>()));

    var allVendedorLabels = [];
    var allVendedorCantidades = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.VendedorCantidades ?? new List<int>()));
    var allVendedorMontos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.VendedorMontos ?? new List<double>()));

    var prodLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.ProdLabels ?? Array.Empty<string>()));
    var prodValores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.ProdValores ?? Array.Empty<int>()));

    // Instancias de Gráficos
    var salesChartInstance = null;
    var stackedChartInstance = null;
    var vendedorChartInstance = null;
    var productionChartInstance = null;

    // Estados de filtros
    var ventasMesesActuales = 12;
    var stackedDiasActuales = 12;
    var sedeActiva = 'vs'; // 'vs', 'central', 'ilo'
    var vendedorDiasActuales = 12;
    var verTop10Pedidos = false;
    var ver10ClientesInactivos = false;

    // Helper Formato Moneda
    function formatMonedaPeruana(num) {
        var n = Number(num) || 0;
        return 'S/ ' + n.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    // Configuración de Tema Claro/Oscuro
    function getThemeConfig() {
        var isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
        return {
            isDark: isDark,
            textColor: isDark ? '#adb5bd' : '#495057',
            gridColor: isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.06)',
            barCurrent: isDark ? '#3b82f6' : '#0d6efd',
            linePrev: isDark ? '#64748b' : '#adb5bd'
        };
    }

    // ========================================================
    // 1. RENDER GRÁFICO: EVOLUCIÓN DE VENTAS
    // ========================================================
    function renderSalesChart(meses, actual, anterior) {
        var canvas = document.getElementById('salesChart');
        if (!canvas) return;
        if (salesChartInstance) salesChartInstance.destroy();

        var theme = getThemeConfig();
        salesChartInstance = new Chart(canvas.getContext('2d'), {
            type: 'bar',
            data: {
                labels: meses,
                datasets: [
                    {
                        type: 'line',
                        label: 'Periodo Anterior',
                        data: anterior,
                        borderColor: theme.linePrev,
                        backgroundColor: 'transparent',
                        borderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        pointBackgroundColor: theme.linePrev,
                        tension: 0.3,
                        order: 0
                    },
                    {
                        type: 'bar',
                        label: 'Periodo Actual',
                        data: actual,
                        backgroundColor: theme.barCurrent,
                        borderColor: theme.barCurrent,
                        borderRadius: 4,
                        order: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                        callbacks: {
                            label: function(ctx) {
                                return ctx.dataset.label + ': S/ ' + (ctx.parsed.y * 1000).toLocaleString('es-PE') + ' (' + ctx.parsed.y + 'k)';
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: theme.textColor, font: { size: 11 } }
                    },
                    y: {
                        grid: { color: theme.gridColor },
                        ticks: {
                            color: theme.textColor,
                            font: { size: 11 },
                            callback: function(v) { return v + 'k'; }
                        }
                    }
                }
            }
        });
    }

    function setVentasMeses(n) {
        ventasMesesActuales = n;
        $('[id^="btn-ventas-"]').removeClass('btn-primary active').addClass('btn-outline-secondary');
        $('#btn-ventas-' + n).removeClass('btn-outline-secondary').addClass('btn-primary active');
        $('#badge-meses-ventas').html('<i class="bi bi-calendar-check me-1"></i>' + n + ' Meses Móviles');

        var meses = (allMesesVentas || []).slice(-n);
        var actual = (allVentasActual || []).slice(-n);
        var anterior = (allVentasAnterior || []).slice(-n);
        renderSalesChart(meses, actual, anterior);
    }

    // ========================================================
    // 2. RENDER GRÁFICO: DISTRIBUCIÓN POR SEDE (Central vs Ilo)
    // ========================================================
    function renderStackedChart(labels, central, ilo) {
        var canvas = document.getElementById('stackedBarChart');
        if (!canvas) return;
        if (stackedChartInstance) stackedChartInstance.destroy();

        var theme = getThemeConfig();
        var datasets = [];

        if (sedeActiva === 'vs' || sedeActiva === 'central') {
            datasets.push({
                label: 'Central',
                data: central,
                backgroundColor: theme.barCurrent,
                borderRadius: sedeActiva === 'central' ? 4 : 0
            });
        }
        if (sedeActiva === 'vs' || sedeActiva === 'ilo') {
            datasets.push({
                label: 'Ilo',
                data: ilo,
                backgroundColor: '#6c757d',
                borderRadius: 4
            });
        }

        stackedChartInstance = new Chart(canvas.getContext('2d'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: datasets
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                        callbacks: {
                            label: function(ctx) {
                                return ctx.dataset.label + ': S/ ' + (ctx.parsed.y * 1000).toLocaleString('es-PE') + ' (' + ctx.parsed.y + 'k)';
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        stacked: sedeActiva === 'vs',
                        grid: { display: false },
                        ticks: { color: theme.textColor, font: { size: 11 } }
                    },
                    y: {
                        stacked: sedeActiva === 'vs',
                        grid: { color: theme.gridColor },
                        ticks: {
                            color: theme.textColor,
                            font: { size: 11 },
                            callback: function(v) { return v + 'k'; }
                        }
                    }
                }
            }
        });
    }

    function setStackedDias(n) {
        stackedDiasActuales = n;
        $('[id^="btn-stacked-"]').removeClass('btn-primary active').addClass('btn-outline-secondary');
        $('#btn-stacked-' + n).removeClass('btn-outline-secondary').addClass('btn-primary active');

        var labels = (allStackedLabels || []).slice(-n);
        var central = (allDsCentral || []).slice(-n);
        var ilo = (allDsIlo || []).slice(-n);
        renderStackedChart(labels, central, ilo);
    }

    function toggleSedeFilter(modo) {
        sedeActiva = modo;
        $('.btn-sede-filter').removeClass('active').addClass('inactive');
        $('#filter-sede-' + modo).removeClass('inactive').addClass('active');
        setStackedDias(stackedDiasActuales);
    }

    // ========================================================
    // 3. RENDER GRÁFICO: PEDIDOS POR VENDEDOR
    // ========================================================
    function renderVendedorChart(labels, cantidades, montos, totalPedidos, totalMonto) {
        var canvas = document.getElementById('vendedorBarChart');
        if (!canvas) return;
        if (vendedorChartInstance) vendedorChartInstance.destroy();

        labels = labels || [];
        cantidades = cantidades || [];
        montos = montos || [];

        if (totalPedidos === undefined || totalPedidos === null) {
            totalPedidos = cantidades.reduce(function(a, b) { return a + (Number(b) || 0); }, 0);
        }
        if (!totalMonto) {
            var sumMto = montos.reduce(function(a, b) { return a + (Number(b) || 0); }, 0);
            totalMonto = formatMonedaPeruana(sumMto);
        }

        $('#vendedor-total-pedidos').text(totalPedidos + ' pedido' + (totalPedidos === 1 ? '' : 's') + ' en el periodo');
        $('#vendedor-total-monto').text('Total: ' + totalMonto);

        var theme = getThemeConfig();
        vendedorChartInstance = new Chart(canvas.getContext('2d'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        type: 'line',
                        label: 'Tendencia Pedidos',
                        data: cantidades,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.12)',
                        borderWidth: 2.5,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        pointBackgroundColor: '#10b981',
                        pointBorderColor: '#ffffff',
                        fill: false,
                        tension: 0.25,
                        order: 0
                    },
                    {
                        type: 'bar',
                        label: 'Cantidad de Pedidos',
                        data: cantidades,
                        backgroundColor: theme.barCurrent,
                        borderColor: theme.barCurrent,
                        borderRadius: 4,
                        order: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                        callbacks: {
                            label: function(ctx) {
                                if (ctx.dataset.type === 'line') {
                                    return 'Pico / Tendencia: ' + ctx.parsed.y + ' pedidos';
                                }
                                var idx = ctx.dataIndex;
                                var mto = (montos && montos.length > idx) ? montos[idx] : 0;
                                return [
                                    'Pedidos: ' + ctx.parsed.y,
                                    'Monto Total: ' + formatMonedaPeruana(mto)
                                ];
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: theme.textColor, font: { size: 11 } }
                    },
                    y: {
                        grid: { color: theme.gridColor },
                        ticks: {
                            color: theme.textColor,
                            font: { size: 11 },
                            stepSize: 1
                        }
                    }
                }
            }
        });
    }

    function setVendedorDias(n) {
        vendedorDiasActuales = n;
        $('[id^="btn-vendedor-dias-"]').removeClass('btn-primary active').addClass('btn-outline-secondary');
        $('#btn-vendedor-dias-' + n).removeClass('btn-outline-secondary').addClass('btn-primary active');

        var vid = $('#select-vendedor-chart').val() || @(Model?.PrimerVendedorId ?? 50);
        cargarDatosVendedor(vid, n);
    }

    function cambiarVendedorChart() {
        var vid = $('#select-vendedor-chart').val() || @(Model?.PrimerVendedorId ?? 50);
        cargarDatosVendedor(vid, vendedorDiasActuales);
    }

    function cargarDatosVendedor(vid, dias) {
        $.ajax({
            url: '@Url.Action("ObtenerPedidosVendedor", "Home")',
            type: 'GET',
            data: { vendedorId: vid, dias: dias },
            success: function(res) {
                if (res && res.success) {
                    allVendedorLabels = res.labels;
                    allVendedorCantidades = res.cantidades;
                    allVendedorMontos = res.montos;
                    renderVendedorChart(res.labels, res.cantidades, res.montos, res.totalPedidos, res.totalMonto);
                }
            }
        });
    }

    // ========================================================
    // 4. RENDER GRÁFICO: ESTADO DE PRODUCCIÓN (Doughnut)
    // ========================================================
    function renderProductionChart(labels, valores) {
        var canvas = document.getElementById('productionChart');
        if (!canvas) return;
        if (productionChartInstance) productionChartInstance.destroy();

        var total = (valores || []).reduce(function(a, b) { return a + b; }, 0);
        if (total === 0) {
            $('#productionChartEmpty').removeClass('d-none');
            $(canvas).addClass('d-none');
            return;
        } else {
            $('#productionChartEmpty').addClass('d-none');
            $(canvas).removeClass('d-none');
        }

        var theme = getThemeConfig();
        productionChartInstance = new Chart(canvas.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: valores,
                    backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#dc3545'],
                    borderWidth: 2,
                    borderColor: theme.isDark ? '#1e2227' : '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            boxWidth: 12,
                            padding: 12,
                            color: theme.textColor,
                            font: { size: 11 }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                var val = ctx.parsed;
                                var pct = total > 0 ? ((val / total) * 100).toFixed(1) : 0;
                                return ctx.label + ': ' + val + ' (' + pct + '%)';
                            }
                        }
                    }
                },
                cutout: '65%'
            }
        });
    }

    // ========================================================
    // 5. ACCIONES EN TABLAS DE DETALLE
    // ========================================================
    function alternarTopPedidos() {
        verTop10Pedidos = !verTop10Pedidos;
        if (verTop10Pedidos) {
            $('.fila-top-extra').removeClass('d-none');
            $('#label-top-pedidos').text('Top 10');
            $('#btn-toggle-top-pedidos').html('<i class="bi bi-chevron-up me-1"></i>Ver Top 5');
        } else {
            $('.fila-top-extra').addClass('d-none');
            $('#label-top-pedidos').text('Top 5');
            $('#btn-toggle-top-pedidos').html('<i class="bi bi-chevron-down me-1"></i>Ver Top 10');
        }
    }

    function alternarVerMasClientesInactivos() {
        ver10ClientesInactivos = !ver10ClientesInactivos;
        if (ver10ClientesInactivos) {
            $('.fila-inactivo-extra').removeClass('d-none');
            $('#btn-ver-mas-clientes').html('<i class="bi bi-chevron-up me-1"></i>Ver menos (5)');
        } else {
            $('.fila-inactivo-extra').addClass('d-none');
            $('#btn-ver-mas-clientes').html('<i class="bi bi-chevron-down me-1"></i>Ver más (10)');
        }
    }

    function cambiarFiltroInactivos() {
        var meses = parseInt($('#select-meses-inactivos').val()) || 5;
        var vid = $('#select-vendedor-inactivos').val();
        $('#label-meses-inactivos').html('&ge; ' + meses + ' Meses');

        $.ajax({
            url: '@Url.Action("ObtenerClientesInactivos", "Home")',
            type: 'GET',
            data: { meses: meses, vendedorId: vid ? parseInt(vid) : null },
            success: function(res) {
                if (res && res.success && res.data) {
                    var $tbody = $('#tabla-clientes-inactivos tbody').empty();
                    if (res.data.length === 0) {
                        $tbody.append('<tr><td colspan="2" class="text-center text-muted py-4"><i class="bi bi-check-circle-fill text-success me-1"></i> No se encontraron clientes inactivos para el filtro</td></tr>');
                    } else {
                        $.each(res.data, function(i, c) {
                            var isExtra = (i >= 5 && !ver10ClientesInactivos) ? 'd-none fila-inactivo-extra' : '';
                            var row = '<tr class="dashboard-drilldown-row ' + isExtra + '" onclick="mostrarEnDesarrollo(\'Ficha del Cliente: ' + (c.cliente || '') + '\');" title="Clic para ver ficha del cliente">' +
                                '<td class="py-2"><span class="fw-semibold text-body d-block">' + (c.cliente || 'Sin Nombre') + '</span><small class="text-muted"><i class="bi bi-person me-1"></i>' + (c.vendedor || 'Sin vendedor') + '</small></td>' +
                                '<td class="text-end py-2 pe-3 text-nowrap"><span class="badge bg-warning-subtle text-warning-emphasis border px-2 py-1 fw-bold"><i class="bi bi-calendar-x me-1"></i>' + (c.fechaFormateada || '') + '</span></td>' +
                                '</tr>';
                            $tbody.append(row);
                        });
                    }
                }
            }
        });
    }

    // ========================================================
    // 6. SINCRONIZACIÓN EN TIEMPO REAL (POLLING)
    // ========================================================
    function sincronizarDashboard() {
        var $icon = $('#icon-sync').addClass('fa-spin bi-spin');
        var vid = $('#select-vendedor-chart').val();
        var meses = $('#select-meses-inactivos').val() || 5;

        $.ajax({
            url: '@Url.Action("ObtenerMetricas", "Home")',
            type: 'GET',
            data: { vendedorId: vid, mesesInactivos: meses },
            success: function(res) {
                $icon.removeClass('fa-spin bi-spin');
                if (res && res.success) {
                    // Actualizar KPIs
                    $('#kpi-ventas').text(res.kpis.facturacionMes);
                    $('#kpi-pedidos').text(res.kpis.pedidosActivos);
                    $('#kpi-cotizaciones').text(res.kpis.cotizacionesActivas);
                    $('#kpi-produccion').text(res.kpis.ordenesProduccionMes);
                    $('#kpi-compras').text(res.kpis.ordenesCompraMes);
                    $('#kpi-pedidos-cantidad').text(res.kpis.pedidosMesCantidad.toLocaleString());
                    $('#kpi-pedidos-monto-footer').text('Total: ' + res.kpis.pedidosMesMonto);

                    // Actualizar Arrays
                    allMesesVentas = res.graficoVentas.meses;
                    allVentasActual = res.graficoVentas.ventasActual;
                    allVentasAnterior = res.graficoVentas.ventasAnterior;

                    allStackedLabels = res.graficoStackedBar.labels;
                    allDsCentral = res.graficoStackedBar.datasets[0].data;
                    allDsIlo = res.graficoStackedBar.datasets[1].data;

                    prodLabels = res.graficoProduccion.labels;
                    prodValores = res.graficoProduccion.valores;

                    // Re-render
                    setVentasMeses(ventasMesesActuales);
                    setStackedDias(stackedDiasActuales);
                    renderProductionChart(prodLabels, prodValores);
                }
            },
            error: function() {
                $icon.removeClass('fa-spin bi-spin');
            }
        });
    }

    // ========================================================
    // 7. GESTIÓN DEL DASHBOARD (PERSONALIZACIÓN USUARIO)
    // ========================================================
    var STORAGE_PREF_KEY = 'arco_dashboard_pref_' + ('@(userSession?.UsuarioLogon ?? "admin")');

    function aplicarPreferenciasDashboard() {
        var prefs = {};
        $('.chk-dashboard-area').each(function() {
            var area = $(this).data('area');
            prefs[area] = $(this).is(':checked');
        });

        var kpiPrefs = {};
        $('.chk-sub-kpi').each(function() {
            var kpi = $(this).data('kpi');
            kpiPrefs[kpi] = $(this).is(':checked');
        });
        prefs['sub_kpis'] = kpiPrefs;

        localStorage.setItem(STORAGE_PREF_KEY, JSON.stringify(prefs));
        ejecutarVisibilidadAreas(prefs);
    }

    function ejecutarVisibilidadAreas(prefs) {
        if (!prefs) return;

        // Tarjetas KPIs
        if (prefs['kpis'] === false) {
            $('#row-kpis-metricas').addClass('d-none');
        } else {
            $('#row-kpis-metricas').removeClass('d-none');
            if (prefs['sub_kpis']) {
                $.each(prefs['sub_kpis'], function(kpi, visible) {
                    var $card = $('#card-kpi-' + kpi);
                    if (visible === false) $card.addClass('d-none');
                    else $card.removeClass('d-none');
                });
            }
        }

        // Demás áreas
        var areasMap = {
            'evolucion-ventas': '#area-evolucion-ventas',
            'distribucion-sede': '#area-distribucion-sede',
            'pedidos-vendedor': '#area-pedidos-vendedor',
            'accesos-rapidos': '#area-accesos-rapidos',
            'estado-produccion': '#area-estado-produccion',
            'db-tiempo-real': '#area-db-tiempo-real',
            'top-pedidos': '#area-top-pedidos',
            'clientes-inactivos': '#area-clientes-inactivos'
        };

        var activas = 0;
        $.each(areasMap, function(k, sel) {
            if (prefs[k] === false) {
                $(sel).addClass('d-none');
            } else {
                $(sel).removeClass('d-none');
                activas++;
            }
        });
        if (prefs['kpis'] !== false) activas++;
        $('#modal-conteo-areas-activas').text(activas);
    }

    function cargarPreferenciasDashboard() {
        var saved = localStorage.getItem(STORAGE_PREF_KEY);
        var prefs = saved ? JSON.parse(saved) : null;
        if (prefs) {
            $('.chk-dashboard-area').each(function() {
                var area = $(this).data('area');
                if (prefs[area] !== undefined) {
                    $(this).prop('checked', prefs[area]);
                }
            });
            if (prefs['sub_kpis']) {
                $('.chk-sub-kpi').each(function() {
                    var kpi = $(this).data('kpi');
                    if (prefs['sub_kpis'][kpi] !== undefined) {
                        $(this).prop('checked', prefs['sub_kpis'][kpi]);
                    }
                });
            }
            ejecutarVisibilidadAreas(prefs);
        }
    }

    $('#chk-area-kpis').on('change', function() {
        if ($(this).is(':checked')) {
            $('#sub-kpis-container').slideDown(200);
        } else {
            $('#sub-kpis-container').slideUp(200);
        }
    });

    $('#btn-modal-marcar-todos').on('click', function() {
        $('.chk-dashboard-area, .chk-sub-kpi').prop('checked', true);
        $('#sub-kpis-container').slideDown(200);
    });

    $('#btn-modal-desmarcar-todos').on('click', function() {
        $('.chk-dashboard-area, .chk-sub-kpi').prop('checked', false);
        $('#sub-kpis-container').slideUp(200);
    });

    $('#btn-modal-restablecer').on('click', function() {
        localStorage.removeItem(STORAGE_PREF_KEY);
        $('.chk-dashboard-area, .chk-sub-kpi').prop('checked', true);
        $('#sub-kpis-container').hide();
        aplicarPreferenciasDashboard();
    });

    // ========================================================
    // 8. GESTIÓN POR ROL (ADMINISTRADOR)
    // ========================================================
    var STORAGE_ROLE_KEY = 'arco_dashboard_role_permissions';

    function getRolePermissionsMatrix() {
        var saved = localStorage.getItem(STORAGE_ROLE_KEY);
        return saved ? JSON.parse(saved) : {};
    }

    function cargarPermisosRol() {
        var rol = $('#select-rol-dashboard').val();
        var matrix = getRolePermissionsMatrix();
        var rolPrefs = matrix[rol] || null;

        if (rolPrefs) {
            $('.chk-dashboard-rol-area').each(function() {
                var area = $(this).data('area');
                $(this).prop('checked', rolPrefs[area] !== false);
            });
        } else {
            $('.chk-dashboard-rol-area').prop('checked', true);
        }
        contarAreasRol();
    }

    function contarAreasRol() {
        var checked = $('.chk-dashboard-rol-area:checked').length;
        $('#modal-rol-conteo-areas-activas').text(checked);
    }

    $('.chk-dashboard-rol-area').on('change', contarAreasRol);

    function guardarPermisosRol() {
        var rol = $('#select-rol-dashboard').val();
        var matrix = getRolePermissionsMatrix();
        var prefs = {};
        $('.chk-dashboard-rol-area').each(function() {
            var area = $(this).data('area');
            prefs[area] = $(this).is(':checked');
        });
        matrix[rol] = prefs;
        localStorage.setItem(STORAGE_ROLE_KEY, JSON.stringify(matrix));

        Swal.fire({
            icon: 'success',
            title: 'Permisos de Rol Guardados',
            text: 'Las áreas del dashboard para el rol ' + rol + ' se han actualizado.',
            timer: 1500,
            showConfirmButton: false
        });
    }

    function simularVistaRol() {
        var rol = $('#select-rol-dashboard').val();
        var matrix = getRolePermissionsMatrix();
        var prefs = matrix[rol] || {};
        ejecutarVisibilidadAreas(prefs);
        bootstrap.Modal.getInstance(document.getElementById('modal-gestionar-dashboard-rol')).hide();

        Swal.fire({
            icon: 'info',
            title: 'Simulando Vista de Rol',
            text: 'Visualizando el dashboard con los permisos asignados a ' + rol + '.',
            timer: 2000,
            showConfirmButton: false
        });
    }

    $('#btn-modal-rol-marcar-todos').on('click', function() {
        $('.chk-dashboard-rol-area').prop('checked', true);
        contarAreasRol();
    });

    $('#btn-modal-rol-desmarcar-todos').on('click', function() {
        $('.chk-dashboard-rol-area').prop('checked', false);
        contarAreasRol();
    });

    $('#btn-modal-rol-restablecer').on('click', function() {
        var rol = $('#select-rol-dashboard').val();
        var matrix = getRolePermissionsMatrix();
        delete matrix[rol];
        localStorage.setItem(STORAGE_ROLE_KEY, JSON.stringify(matrix));
        $('.chk-dashboard-rol-area').prop('checked', true);
        contarAreasRol();
    });

    // ========================================================
    // INICIALIZACIÓN DOCUMENT READY
    // ========================================================
    $(document).ready(function() {
        // Cargar preferencias guardadas
        cargarPreferenciasDashboard();

        // Render inicial de gráficos
        setVentasMeses(12);
        setStackedDias(12);
        setVendedorDias(12);
        renderProductionChart(prodLabels, prodValores);

        // Actualizar gráficos al cambiar tema claro/oscuro
        $(document).on('themeChanged', function() {
            setVentasMeses(ventasMesesActuales);
            setStackedDias(stackedDiasActuales);
            setVendedorDias(vendedorDiasActuales);
            renderProductionChart(prodLabels, prodValores);
        });

        // Polling en tiempo real cada 30 segundos
        setInterval(sincronizarDashboard, 30000);
    });
</script>
}
