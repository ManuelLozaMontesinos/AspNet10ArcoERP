                                <i class="bi bi-dash-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0 table-responsive" style="max-height: 380px;">
                        <table class="table table-striped table-hover align-middle mb-0" id="tabla-stock-insumos">
                            <thead class="table-header-custom border-bottom sticky-top">
                                <tr>
                                    <th style="width: 5%;" class="text-center">#</th>
                                    <th style="width: 15%;" class="text-center">Código</th>
                                    <th style="width: 35%;">Descripción del Producto</th>
                                    <th style="width: 20%;" class="text-end">Consumo Mes</th>
                                    <th style="width: 25%;" class="text-end pe-3">Stock / Saldo Actual</th>
                                </tr>
                            </thead>
                            <tbody id="tbody-stock-insumos">
                                @if (Model?.ListaStockInsumos != null && Model.ListaStockInsumos.Count > 0)
                                {
                                    foreach (var prod in Model.ListaStockInsumos)
                                    {
                                        <tr>
                                            <td class="text-center fw-bold text-muted py-2">@prod.Orden</td>
                                            <td class="text-center py-2">
                                                <span class="badge bg-body-tertiary border font-monospace fw-bold px-2 py-1 text-body">@prod.Codigo</span>
                                            </td>
                                            <td class="py-2">
                                                <span class="fw-semibold text-body d-block">@prod.Descripcion</span>
                                                <small class="text-muted">Unidad: @prod.UnidadMedida</small>
                                            </td>
                                            <td class="text-end py-2 font-monospace fw-bold text-warning">
                                                @prod.ConsumoMesFormateado
                                            </td>
                                            <td class="text-end py-2 pe-3 text-nowrap">
