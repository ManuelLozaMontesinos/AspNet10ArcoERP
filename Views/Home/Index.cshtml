                        <table class="table table-striped table-hover align-middle mb-0" id="tabla-top-pedidos">
                            <thead class="table-header-custom border-bottom">
                                <tr>
                                    <th style="width: 25%;" class="text-center">ID / Código</th>
                                    <th>Cliente</th>
                                    <th style="width: 28%;" class="text-end">Monto Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.TopPedidos != null && Model.TopPedidos.Count > 0)
                                {
                                    int ranking = 1;
                                    foreach (var p in Model.TopPedidos.Take(5))
                                    {
                                        string badgeClass = ranking == 1 ? "bg-warning text-dark fw-bold" : "bg-secondary-subtle text-secondary border";
                                        <tr>
                                            <td class="text-center font-monospace fw-bold text-primary py-2">
                                                <span class="badge @badgeClass me-1">#@ranking</span>
