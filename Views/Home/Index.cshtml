<div class="modal fade" id="modal-gestionar-dashboard" tabindex="-1" aria-labelledby="modalGestionarDashboardLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow border-0 rounded-4">
            <div class="modal-header bg-body-tertiary border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                        <i class="bi bi-sliders fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="modalGestionarDashboardLabel">Gestionar Dashboard</h5>
                        <small class="text-muted">Activa o desactiva las áreas que deseas visualizar en tu pantalla de inicio</small>
                    </div>
                </div>
                <div class="d-flex align-items-center">
                    <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm fw-semibold me-2" data-bs-dismiss="modal" id="btn-modal-aceptar-header">
                        <i class="bi bi-check-lg me-1"></i>Aceptar
                    </button>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
            </div>
            <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <span class="text-xs fw-semibold text-uppercase text-muted">
                        Áreas del Dashboard (<span id="modal-conteo-areas-activas" class="fw-bold text-primary">13</span> de 13 disponibles)
                    </span>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-primary btn-sm px-2" id="btn-modal-marcar-todos">
                            <i class="bi bi-check-all me-1"></i>Marcar Todos
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm px-2" id="btn-modal-desmarcar-todos">
                            <i class="bi bi-x-lg me-1"></i>Desmarcar Todos
                        </button>
                        <button type="button" class="btn btn-outline-info btn-sm px-2" id="btn-modal-restablecer">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Restablecer
                        </button>
                    </div>
                </div>

                <div class="d-flex flex-column gap-2">
                    <!-- 1. Tarjetas de Métricas (KPIs) -->
                    <label class="dashboard-area-card d-flex align-items-center justify-content-between p-3 rounded bg-body border shadow-sm" for="chk-area-kpis" style="cursor: pointer;">
                        <div class="d-flex align-items-center me-3">
                            <div class="rounded-3 bg-info bg-opacity-10 text-info d-flex align-items-center justify-content-center me-3" style="width: 42px; height: 42px;">
                                <i class="bi bi-grid-fill fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-bold mb-0">Tarjetas de Métricas (KPIs)</div>
                                <small class="text-muted">Facturación, Pedidos, Cotizaciones, Producción, Compras, Consumo Interno, Mermas y Guías</small>
                            </div>
                        </div>
                        <div class="form-check form-switch form-switch-md m-0">
                            <input class="form-check-input chk-dashboard-area" type="checkbox" id="chk-area-kpis" data-area="kpis" checked>
                        </div>
                    </label>

                    <!-- Sub-controles de Tarjetas Individuales -->
                    <div id="sub-kpis-container" class="ms-4 ps-3 py-2 border-start border-3 border-info bg-body-tertiary rounded-end" style="display: none;">
                        <div class="small fw-bold text-uppercase text-info mb-2">Tarjetas individuales visibles:</div>
                        <div class="row g-2">
                            <div class="col-md-4 col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input chk-sub-kpi" type="checkbox" id="chk-kpi-facturacion" data-kpi="facturacion" checked>
                                    <label class="form-check-label small" for="chk-kpi-facturacion">Facturación Mes</label>
                                </div>
                            </div>
                            <div class="col-md-4 col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input chk-sub-kpi" type="checkbox" id="chk-kpi-pedidos-activos" data-kpi="pedidos-activos" checked>
                                    <label class="form-check-label small" for="chk-kpi-pedidos-activos">Pedidos Activos</label>
                                </div>
                            </div>
                            <div class="col-md-4 col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input chk-sub-kpi" type="checkbox" id="chk-kpi-cotizaciones" data-kpi="cotizaciones" checked>
                                    <label class="form-check-label small" for="chk-kpi-cotizaciones">Cotizaciones Activas</label>
                                </div>
                            </div>
                            <div class="col-md-4 col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input chk-sub-kpi" type="checkbox" id="chk-kpi-produccion" data-kpi="produccion" checked>
                                    <label class="form-check-label small" for="chk-kpi-produccion">Producción Mes</label>
                                </div>
                            </div>
                            <div class="col-md-4 col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input chk-sub-kpi" type="checkbox" id="chk-kpi-compras" data-kpi="compras" checked>
                                    <label class="form-check-label small" for="chk-kpi-compras">Compras Mes</label>
                                </div>
                            </div>
                            <div class="col-md-4 col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input chk-sub-kpi" type="checkbox" id="chk-kpi-pedidos-mes" data-kpi="pedidos-mes" checked>
                                    <label class="form-check-label small" for="chk-kpi-pedidos-mes">Total Pedidos Mes</label>
                                </div>
                            </div>
                            <div class="col-md-4 col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input chk-sub-kpi" type="checkbox" id="chk-kpi-consumo-interno" data-kpi="consumo-interno" checked>
                                    <label class="form-check-label small" for="chk-kpi-consumo-interno">Consumo Interno</label>
                                </div>
                            </div>
                            <div class="col-md-4 col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input chk-sub-kpi" type="checkbox" id="chk-kpi-mermas" data-kpi="mermas" checked>
                                    <label class="form-check-label small" for="chk-kpi-mermas">Control de Mermas</label>
                                </div>
                            </div>
                            <div class="col-md-4 col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input chk-sub-kpi" type="checkbox" id="chk-kpi-guias-remision" data-kpi="guias-remision" checked>
                                    <label class="form-check-label small" for="chk-kpi-guias-remision">Guías Emitidas</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Evolución de Ventas -->
                    <label class="dashboard-area-card d-flex align-items-center justify-content-between p-3 rounded bg-body border shadow-sm" for="chk-area-evolucion-ventas" style="cursor: pointer;">
                        <div class="d-flex align-items-center me-3">
                            <div class="rounded-3 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-3" style="width: 42px; height: 42px;">
                                <i class="bi bi-graph-up fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-bold mb-0">Evolución de Ventas</div>
                                <small class="text-muted">Gráfico de barras y línea comparativa de los últimos meses móviles</small>
                            </div>
                        </div>
                        <div class="form-check form-switch form-switch-md m-0">
                            <input class="form-check-input chk-dashboard-area" type="checkbox" id="chk-area-evolucion-ventas" data-area="evolucion-ventas" checked>
                        </div>
                    </label>

                    <!-- 3. Distribución por Sede -->
                    <label class="dashboard-area-card d-flex align-items-center justify-content-between p-3 rounded bg-body border shadow-sm" for="chk-area-distribucion-sede" style="cursor: pointer;">
                        <div class="d-flex align-items-center me-3">
                            <div class="rounded-3 bg-info bg-opacity-10 text-info d-flex align-items-center justify-content-center me-3" style="width: 42px; height: 42px;">
                                <i class="bi bi-bar-chart-steps fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-bold mb-0">Distribución por Sede</div>
                                <small class="text-muted">Gráfico apilado comparando la facturación diaria entre Central e Ilo</small>
                            </div>
                        </div>
                        <div class="form-check form-switch form-switch-md m-0">
                            <input class="form-check-input chk-dashboard-area" type="checkbox" id="chk-area-distribucion-sede" data-area="distribucion-sede" checked>
                        </div>
                    </label>

                    <!-- 4. Cotizaciones por Vendedor -->
                    <label class="dashboard-area-card d-flex align-items-center justify-content-between p-3 rounded bg-body border shadow-sm" for="chk-area-cotizaciones-vendedor" style="cursor: pointer;">
                        <div class="d-flex align-items-center me-3">
                            <div class="rounded-3 bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center me-3" style="width: 42px; height: 42px;">
                                <i class="bi bi-file-earmark-text-fill fs-5"></i>
                            </div>
