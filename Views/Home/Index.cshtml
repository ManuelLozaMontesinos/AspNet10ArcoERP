                                '<td class="text-end py-2 pe-3 text-nowrap"><span class="badge bg-danger px-2 py-1 fw-bold me-1"><i class="fas fa-times-circle me-1"></i>Agotado ' + p.cantidadFormateada + '</span></td>' +
