@section Scripts {
<script type="text/javascript">
    $(document).ready(function () {
        // Formato monetario peruano: S/ 310,879.10 o si pasa al millón S/ 3'456,890.00
        function formatMonedaPeruana(valor) {
            if (valor === null || valor === undefined || isNaN(valor)) return 'S/ 0.00';
            var num = Number(valor);
            var isNeg = num < 0;
            num = Math.abs(num);
            var partes = num.toFixed(2).split('.');
            var entero = partes[0];
            var decimales = partes[1];

            if (entero.length > 6) {
                var millones = entero.slice(0, entero.length - 6);
                var miles = entero.slice(entero.length - 6, entero.length - 3);
                var unidades = entero.slice(entero.length - 3);
                var millonesFmt = millones.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
                entero = millonesFmt + "'" + miles + "," + unidades;
            } else if (entero.length > 3) {
                entero = entero.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
            }

            return (isNeg ? '-' : '') + 'S/ ' + entero + '.' + decimales;
        }

        function getThemeConfig() {
            var theme = document.documentElement.getAttribute('data-bs-theme') || 'light';
            var isDark = theme === 'dark';
            return {
                isDark: isDark,
                textColor: isDark ? '#cbd5e1' : '#64748b',
                gridColor: isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.06)',
                barCurrent: isDark ? '#3b82f6' : '#0d6efd',
                barPrevious: isDark ? '#64748b' : '#ced4da',
                pieColors: isDark ? ['#06b6d4', '#10b981', '#f59e0b', '#f43f5e'] : ['#0dcaf0', '#198754', '#ffc107', '#dc3545']
            };
        }

        var salesChartInstance = null;
        var productionChartInstance = null;
        var stackedBarChartInstance = null;

        var allStackedLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StackedLabels));
        var allStackedCentral = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DsCentral));
        var allStackedIlo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DsIlo));
        var nivelesDias = [6, 8, 10, 12];
        var diasActuales = 6;

        var allSalesMeses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MesesVentas));
        var allSales2025 = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Ventas2025));
        var allSales2026 = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Ventas2026));

        // Generar series para la comparativa:
        function generarSeriesVentas(n) {
            var slicedMeses = (allSalesMeses || []).slice(-n);
            var slicedBarra2025 = (allSales2025 || []).slice(-n);
            var slicedBarra2026 = (allSales2026 || []).slice(-n);

            // Identificar índices de Diciembre (2025) y Enero (2026)
            var idxDic = -1;
            var idxEne = -1;
            for (var i = 0; i < slicedMeses.length; i++) {
                var m = (slicedMeses[i] || '').toLowerCase();
                if (m.indexOf('dic') >= 0) idxDic = i;
                if (m.indexOf('ene') >= 0) idxEne = i;
            }

            // Puente Dic -> Ene (Naranja #fd7e14):
            // Solo tiene dos puntos: Dic (valor 2025) y Ene (valor 2026)
            var puenteDicEne = [];
            for (var i = 0; i < slicedMeses.length; i++) {
                if (i === idxDic && idxDic >= 0) {
                    puenteDicEne.push(slicedBarra2025[i] || null);
                } else if (i === idxEne && idxEne >= 0) {
                    puenteDicEne.push(slicedBarra2026[i] || null);
                } else {
                    puenteDicEne.push(null);
                }
            }

            // Línea Actual (Verde #198754):
            // Comienza desde Enero (2026) en adelante, NO incluye Diciembre anterior
            var slicedLinea2026 = [];
            for (var i = 0; i < slicedMeses.length; i++) {
                if (idxEne >= 0 && i < idxEne) {
                    slicedLinea2026.push(null);
                } else if (slicedBarra2026[i] && Number(slicedBarra2026[i]) > 0) {
                    slicedLinea2026.push(slicedBarra2026[i]);
                } else {
                    slicedLinea2026.push(null);
                }
            }

            return {
                meses: slicedMeses,
                puenteDicEne: puenteDicEne,
                linea2026: slicedLinea2026,
                linea2025: slicedBarra2025.slice(),
                barra2026: slicedBarra2026,
                barra2025: slicedBarra2025
            };
        }

        var nivelesMesesVentas = [6, 8, 10, 12];
        var mesesVentasActuales = 12;

        function setVentasMeses(meses) {
            mesesVentasActuales = meses;
            nivelesMesesVentas.forEach(function (m) {
                var $btn = $('#btn-ventas-' + m);
                if (m === meses) {
                    $btn.removeClass('btn-outline-secondary').addClass('btn-primary active');
                } else {
                    $btn.removeClass('btn-primary active').addClass('btn-outline-secondary');
                }
            });

            var $badge = $('#badge-meses-ventas');
            if ($badge.length) {
                if (meses === 12) {
                    $badge.html('<i class="bi bi-calendar-check me-1"></i>12 Meses Móviles');
                } else {
                    $badge.html('<i class="bi bi-calendar-check me-1"></i>Últimos ' + meses + ' meses');
                }
            }

            actualizarChartVentasMeses();
        }
        window.setVentasMeses = setVentasMeses;

        function actualizarChartVentasMeses() {
            if (!salesChartInstance) return;
            var series = generarSeriesVentas(mesesVentasActuales || 12);
            salesChartInstance.data.labels = series.meses;
            if (salesChartInstance.data.datasets[0]) salesChartInstance.data.datasets[0].data = series.puenteDicEne;
            if (salesChartInstance.data.datasets[1]) salesChartInstance.data.datasets[1].data = series.linea2026;
            if (salesChartInstance.data.datasets[2]) salesChartInstance.data.datasets[2].data = series.linea2025;
            if (salesChartInstance.data.datasets[3]) salesChartInstance.data.datasets[3].data = series.barra2026;
            if (salesChartInstance.data.datasets[4]) salesChartInstance.data.datasets[4].data = series.barra2025;
            salesChartInstance.update();
        }

        var sedesVisibles = { central: true, ilo: true };

        function setDiferenciaDias(dias) {
            diasActuales = dias;
            nivelesDias.forEach(function (n) {
                var $btn = $('#btn-dias-' + n);
                if (n === dias) {
                    $btn.removeClass('btn-outline-secondary').addClass('btn-primary active');
                } else {
                    $btn.removeClass('btn-primary active').addClass('btn-outline-secondary');
                }
            });

            actualizarBotonesSedesUI();
            actualizarChartDiferenciaDias();
        }
        window.setDiferenciaDias = setDiferenciaDias;

        function actualizarChartDiferenciaDias() {
            if (!stackedBarChartInstance) return;

            var n = diasActuales || 6;
            var slicedLabels = (allStackedLabels || []).slice(-n);
            var slicedCentral = (allStackedCentral || []).slice(-n);
            var slicedIlo = (allStackedIlo || []).slice(-n);

            var slicedTrend = [];
            for (var i = 0; i < slicedCentral.length; i++) {
                var vC = sedesVisibles.central ? (slicedCentral[i] || 0) : 0;
                var vI = sedesVisibles.ilo ? (slicedIlo[i] || 0) : 0;
                slicedTrend.push(Math.round((vC + vI) * 100) / 100);
            }

            stackedBarChartInstance.data.labels = slicedLabels;
            stackedBarChartInstance.data.datasets.forEach(function (ds) {
                if (ds.type === 'line' || (ds.label && ds.label.indexOf('Pico') >= 0)) {
                    ds.data = slicedTrend;
                } else if (ds.label === 'Central') {
                    ds.data = slicedCentral;
                    ds.hidden = !sedesVisibles.central;
                } else if (ds.label === 'Ilo') {
                    ds.data = slicedIlo;
                    ds.hidden = !sedesVisibles.ilo;
                }
            });

            stackedBarChartInstance.update();
        }

        function actualizarBotonesSedesUI() {
            var $btnCentral = $('#btn-filtro-central');
            var $btnIlo = $('#btn-filtro-ilo');
            var $btnVs = $('#btn-filtro-vs');

            if (sedesVisibles.central && sedesVisibles.ilo) {
                $btnCentral.removeClass('inactive').addClass('active').attr('title', 'Ver solo Sede Central');
                $btnIlo.removeClass('inactive').addClass('active').attr('title', 'Ver solo Sede Ilo');
                $btnVs.removeClass('inactive').addClass('active').attr('title', 'Ambas sedes activas (VS)');
            } else if (sedesVisibles.central && !sedesVisibles.ilo) {
                $btnCentral.removeClass('inactive').addClass('active').attr('title', 'Sede Central activa');
                $btnIlo.removeClass('active').addClass('inactive').attr('title', 'Cambiar a Sede Ilo');
                $btnVs.removeClass('active').addClass('inactive').attr('title', 'Clic para comparar ambas sedes (VS)');
            } else {
                $btnCentral.removeClass('active').addClass('inactive').attr('title', 'Cambiar a Sede Central');
                $btnIlo.removeClass('inactive').addClass('active').attr('title', 'Sede Ilo activa');
                $btnVs.removeClass('active').addClass('inactive').attr('title', 'Clic para comparar ambas sedes (VS)');
            }
        }

        function alternarSede(sede) {
            if (sede === 'central') {
                if (sedesVisibles.central && sedesVisibles.ilo) {
                    sedesVisibles.central = true;
                    sedesVisibles.ilo = false;
                } else if (sedesVisibles.central && !sedesVisibles.ilo) {
                    sedesVisibles.central = true;
                    sedesVisibles.ilo = true;
                } else {
                    sedesVisibles.central = true;
                    sedesVisibles.ilo = false;
                }
            } else {
                if (sedesVisibles.central && sedesVisibles.ilo) {
                    sedesVisibles.central = false;
                    sedesVisibles.ilo = true;
                } else if (!sedesVisibles.central && sedesVisibles.ilo) {
                    sedesVisibles.central = true;
                    sedesVisibles.ilo = true;
                } else {
                    sedesVisibles.central = false;
                    sedesVisibles.ilo = true;
                }
            }
            actualizarChartDiferenciaDias();
            actualizarBotonesSedesUI();
        }

        $(document).off('click', '#btn-filtro-central').on('click', '#btn-filtro-central', function (e) {
            e.preventDefault();
            alternarSede('central');
        });

        $(document).off('click', '#btn-filtro-ilo').on('click', '#btn-filtro-ilo', function (e) {
            e.preventDefault();
            alternarSede('ilo');
        });

        $(document).off('click', '#btn-filtro-vs').on('click', '#btn-filtro-vs', function (e) {
            e.preventDefault();
            sedesVisibles.central = true;
            sedesVisibles.ilo = true;
            actualizarChartDiferenciaDias();
            actualizarBotonesSedesUI();
        });

        var defaultDashboardData = {
            success: true,
            kpis: {
                facturacionMes: "@Html.Raw(Model.FacturacionMes)",
                pedidosActivos: "@Html.Raw(Model.PedidosActivos)",
                cotizacionesActivas: "@Html.Raw(Model.CotizacionesActivas)",
                ordenesProduccionMes: "@Html.Raw(Model.OrdenesProduccionMes)",
                ordenesCompraMes: "@Html.Raw(Model.OrdenesCompraMes)"
            },
            graficoVentas: {
                meses: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MesesVentas)),
                ventas2025: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Ventas2025)),
                ventas2026: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Ventas2026))
            },
            graficoProduccion: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProdLabels)),
                valores: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProdValores))
            },
            graficoStackedBar: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StackedLabels)),
                datasets: [
                    { label: 'Central', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DsCentral)) },
                    { label: 'Ilo', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DsIlo)) }
                ]
            }
        };

        var lastDashboardData = defaultDashboardData;

        // Render Gráfico de Ventas
        function renderSalesChart(data) {
            if (!data) return;
            var theme = getThemeConfig();
            var canvas = document.getElementById('salesChart');
            if (!canvas) return;

            if (salesChartInstance) {
                salesChartInstance.destroy();
                salesChartInstance = null;
            }

            if (typeof Chart === 'undefined') return;

            if (data.meses && data.meses.length) allSalesMeses = data.meses;
            if (data.ventas2025 && data.ventas2025.length) allSales2025 = data.ventas2025;
            if (data.ventas2026 && data.ventas2026.length) allSales2026 = data.ventas2026;

            var series = generarSeriesVentas(mesesVentasActuales || 12);

            salesChartInstance = new Chart(canvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: series.meses,
                    datasets: [
                        {
                            type: 'line',
                            label: 'Puente Dic → Ene',
                            order: 0,
                            data: series.puenteDicEne,
                            borderColor: '#fd7e14',
                            backgroundColor: 'rgba(253, 126, 20, 0.1)',
                            borderWidth: 3,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            pointBackgroundColor: '#fd7e14',
                            pointBorderColor: '#fd7e14',
                            tension: 0.25,
                            fill: false,
                            spanGaps: true
                        },
                        {
                            type: 'line',
                            label: 'Línea Actual',
                            order: 1,
                            data: series.linea2026,
                            borderColor: '#198754',
                            backgroundColor: 'rgba(25, 135, 84, 0.08)',
                            borderWidth: 3,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            pointBackgroundColor: '#198754',
                            pointBorderColor: '#198754',
                            tension: 0.25,
                            fill: false,
                            spanGaps: true
                        },
                        {
                            type: 'line',
                            label: 'Línea Anterior (2025)',
                            order: 2,
                            data: series.linea2025,
                            borderColor: '#ffc107',
                            backgroundColor: 'rgba(255, 193, 7, 0.08)',
                            borderWidth: 3,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            pointBackgroundColor: '#ffc107',
                            pointBorderColor: '#ffc107',
                            tension: 0.25,
                            fill: false,
                            spanGaps: true
                        },
                        {
                            type: 'bar',
                            label: 'Barra Actual (2026)',
                            order: 3,
                            backgroundColor: theme.barCurrent,
                            borderColor: theme.barCurrent,
                            data: series.barra2026,
                            borderRadius: 4
                        },
                        {
                            type: 'bar',
                            label: 'Barra Anterior (2025)',
                            order: 4,
                            backgroundColor: theme.barPrevious,
                            borderColor: theme.barPrevious,
                            data: series.barra2025,
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                            callbacks: {
                                label: function(context) {
                                    if (context.parsed.y === null || context.parsed.y === undefined) return '';
                                    var montoEnSoles = (Number(context.parsed.y) || 0) * 1000;
                                    if (context.dataset.label === 'Puente Dic → Ene') {
                                        return 'Puente Dic → Ene: ' + formatMonedaPeruana(montoEnSoles);
                                    }
                                    var anio = (context.dataset.label && context.dataset.label.indexOf('Actual') >= 0) ? 'Año Actual (2026)' : 'Año 2025';
                                    return anio + ': ' + formatMonedaPeruana(montoEnSoles);
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: theme.textColor },
                            grid: { display: false }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: {
                                color: theme.textColor,
                                callback: function(value) { return 'S/ ' + value + 'k'; }
                            },
                            grid: { color: theme.gridColor }
                        }
                    }
                }
            });
        }

        // Render Gráfico de Producción
        function renderProductionChart(data) {
            if (!data) return;
            var theme = getThemeConfig();
            var canvas = document.getElementById('productionChart');
            if (!canvas) return;

            if (productionChartInstance) {
                productionChartInstance.destroy();
                productionChartInstance = null;
            }

            if (typeof Chart === 'undefined') return;

            var rawData = data.valores || [];
            var total = 0;
            for (var i = 0; i < rawData.length; i++) {
                total += (Number(rawData[i]) || 0);
            }

            var $empty = $('#productionChartEmpty');
            if (total === 0) {
                if ($empty.length) $empty.removeClass('d-none');
            } else {
                if ($empty.length) $empty.addClass('d-none');
            }

            productionChartInstance = new Chart(canvas.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: data.labels,
                    datasets: [{
                        data: rawData,
                        backgroundColor: theme.pieColors,
                        borderWidth: theme.isDark ? 2 : 1,
                        borderColor: theme.isDark ? '#212529' : '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: theme.textColor,
                                boxWidth: 14,
                                padding: 12,
                                generateLabels: function (chart) {
                                    var ds = chart.data.datasets[0];
                                    return (chart.data.labels || []).map(function (label, idx) {
                                        var val = (ds && ds.data) ? (ds.data[idx] || 0) : 0;
                                        var fill = (ds && ds.backgroundColor && ds.backgroundColor[idx]) ? ds.backgroundColor[idx] : '#999';
                                        return {
                                            text: label + ' (' + val + ')',
                                            fillStyle: fill,
                                            strokeStyle: theme.isDark ? '#212529' : '#ffffff',
                                            lineWidth: 1,
                                            hidden: false,
                                            index: idx
                                        };
                                    });
                                }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    var label = context.label || '';
                                    var val = Number(context.raw) || 0;
                                    var pct = total > 0 ? Math.round((val / total) * 100) : 0;
                                    return ' ' + label + ': ' + val + ' orden' + (val === 1 ? '' : 'es') + ' (' + pct + '%)';
                                }
                            }
                        }
                    },
                    cutout: '62%'
                }
            });
        }

        // Render Gráfico de Diferencia Diaria
        function renderStackedBarChart(data) {
            if (!data) return;
            var theme = getThemeConfig();
            var canvas = document.getElementById('stackedBarChart');
            if (!canvas) return;

            if (stackedBarChartInstance) {
                stackedBarChartInstance.destroy();
                stackedBarChartInstance = null;
            }

            if (typeof Chart === 'undefined') return;

            if (data.labels && data.labels.length) allStackedLabels = data.labels;
            if (data.datasets && data.datasets.length >= 2) {
                data.datasets.forEach(function (ds) {
                    if (ds.label === 'Central') allStackedCentral = ds.data;
                    else if (ds.label === 'Ilo') allStackedIlo = ds.data;
                });
            }

            var n = diasActuales || 6;
            var slicedLabels = (allStackedLabels || []).slice(-n);
            var slicedCentral = (allStackedCentral || []).slice(-n);
            var slicedIlo = (allStackedIlo || []).slice(-n);

            var trendData = [];
            for (var i = 0; i < slicedCentral.length; i++) {
                var vC = sedesVisibles.central ? (slicedCentral[i] || 0) : 0;
                var vI = sedesVisibles.ilo ? (slicedIlo[i] || 0) : 0;
                trendData.push(Math.round((vC + vI) * 100) / 100);
            }

            stackedBarChartInstance = new Chart(canvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: slicedLabels,
                    datasets: [
                        {
                            type: 'line',
                            label: 'Pico / Tendencia',
                            data: trendData,
                            borderColor: '#198754',
                            backgroundColor: 'rgba(25, 135, 84, 0.1)',
                            borderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            pointBackgroundColor: '#198754',
                            fill: false,
                            tension: 0.25,
                            order: 0,
                            stack: 'trendStack'
                        },
                        {
                            type: 'bar',
                            label: 'Ilo',
                            stack: 'sedesStack',
                            backgroundColor: theme.barPrevious,
                            borderColor: theme.barPrevious,
                            borderRadius: 4,
                            data: slicedIlo,
                            hidden: !sedesVisibles.ilo,
                            order: 1
                        },
                        {
                            type: 'bar',
                            label: 'Central',
                            stack: 'sedesStack',
                            backgroundColor: theme.barCurrent,
                            borderColor: theme.barCurrent,
                            borderRadius: 4,
                            data: slicedCentral,
                            hidden: !sedesVisibles.central,
                            order: 2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                            callbacks: {
                                label: function(context) {
                                    var fmt = formatMonedaPeruana(context.parsed.y);
                                    if (context.dataset.type === 'line') return 'Pico Máximo: ' + fmt;
                                    return context.dataset.label + ': ' + fmt;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            stacked: true,
                            ticks: { color: theme.textColor },
                            grid: { display: false }
                        },
                        y: {
                            stacked: true,
                            beginAtZero: true,
                            ticks: {
                                color: theme.textColor,
                                callback: function(value) {
                                    if (value >= 1000) return 'S/ ' + (value / 1000).toLocaleString() + 'k';
                                    return 'S/ ' + Number(value).toLocaleString();
                                }
                            },
                            grid: { color: theme.gridColor }
                        }
                    }
                }
            });
            actualizarBotonesSedesUI();
        }

        // Inicializar gráficos
        function initChartsImmediately() {
            if (typeof Chart !== 'undefined') {
                try { renderSalesChart(lastDashboardData.graficoVentas); } catch(e) { console.error('Error renderSalesChart:', e); }
                try { renderProductionChart(lastDashboardData.graficoProduccion); } catch(e) { console.error('Error renderProductionChart:', e); }
                try { renderStackedBarChart(lastDashboardData.graficoStackedBar); } catch(e) { console.error('Error renderStackedBarChart:', e); }
            } else {
                setTimeout(initChartsImmediately, 80);
            }
        }
        initChartsImmediately();

        // ==========================================
        // GESTIÓN DEL DASHBOARD (Áreas Visibles)
        // ==========================================
        var STORAGE_AREAS_KEY = 'arco_dashboard_areas_visibles_v2';
        var areasDashboardConfig = {
            'kpis': { selector: '#row-kpis-metricas', visible: true },
            'evolucion-ventas': { selector: '#area-evolucion-ventas', visible: true },
            'diferencia-sedes': { selector: '#area-diferencia-sedes', visible: true },
            'accesos-rapidos': { selector: '#area-accesos-rapidos', visible: true },
            'estado-produccion': { selector: '#area-estado-produccion', visible: true },
            'db-tiempo-real': { selector: '#area-db-tiempo-real', visible: true },
            'top-pedidos': { selector: '#area-top-pedidos', visible: true },
            'clientes-inactivos': { selector: '#area-clientes-inactivos', visible: true }
        };

        function cargarConfiguracionAreas() {
            try {
                var guardado = localStorage.getItem(STORAGE_AREAS_KEY);
                if (guardado) {
                    var parsed = JSON.parse(guardado);
                    for (var key in parsed) {
                        if (areasDashboardConfig.hasOwnProperty(key)) {
                            areasDashboardConfig[key].visible = Boolean(parsed[key]);
                        }
                    }
                }
            } catch (e) { }
        }

        function guardarConfiguracionAreas() {
            try {
                var obj = {};
                for (var key in areasDashboardConfig) {
                    obj[key] = areasDashboardConfig[key].visible;
                }
                localStorage.setItem(STORAGE_AREAS_KEY, JSON.stringify(obj));
            } catch (e) { }
        }

        function aplicarVisibilidadAreas() {
            var activasCount = 0;

            for (var key in areasDashboardConfig) {
                var item = areasDashboardConfig[key];
                var $el = $(item.selector);
                var $chk = $('#chk-area-' + key);

                if (item.visible) {
                    activasCount++;
                    $el.removeClass('d-none');
                    if ($chk.length) $chk.prop('checked', true);
                } else {
                    $el.addClass('d-none');
                    if ($chk.length) $chk.prop('checked', false);
                }
            }

            $('#modal-conteo-areas-activas').text(activasCount);

            // Reflow responsivo de columnas
            var leftVisible = areasDashboardConfig['evolucion-ventas'].visible || areasDashboardConfig['diferencia-sedes'].visible;
            var rightVisible = areasDashboardConfig['accesos-rapidos'].visible || areasDashboardConfig['estado-produccion'].visible || areasDashboardConfig['db-tiempo-real'].visible;

            var $colLeft = $('#col-main-left');
            var $colRight = $('#col-main-right');
            var $rowMain = $('#row-main-dashboard');

            if (!leftVisible && !rightVisible) {
                $rowMain.addClass('d-none');
            } else {
                $rowMain.removeClass('d-none');
                if (leftVisible && !rightVisible) {
                    $colLeft.removeClass('d-none col-lg-7').addClass('col-lg-12');
                    $colRight.addClass('d-none');
                } else if (!leftVisible && rightVisible) {
                    $colLeft.addClass('d-none');
                    $colRight.removeClass('d-none col-lg-5').addClass('col-lg-12');
                } else {
                    $colLeft.removeClass('d-none col-lg-12').addClass('col-lg-7');
                    $colRight.removeClass('d-none col-lg-12').addClass('col-lg-5');
                }
            }

            var topPedidosVis = areasDashboardConfig['top-pedidos'].visible;
            var clientesVis = areasDashboardConfig['clientes-inactivos'].visible;
            var $areaTop = $('#area-top-pedidos');
            var $areaCli = $('#area-clientes-inactivos');
            var $rowTablas = $('#row-tablas-detalle');

            if (!topPedidosVis && !clientesVis) {
                $rowTablas.addClass('d-none');
            } else {
                $rowTablas.removeClass('d-none');
                if (topPedidosVis && !clientesVis) {
                    $areaTop.removeClass('d-none col-lg-6').addClass('col-lg-12');
                    $areaCli.addClass('d-none');
                } else if (!topPedidosVis && clientesVis) {
                    $areaTop.addClass('d-none');
                    $areaCli.removeClass('d-none col-lg-6').addClass('col-lg-12');
                } else {
                    $areaTop.removeClass('d-none col-lg-12').addClass('col-lg-6');
                    $areaCli.removeClass('d-none col-lg-12').addClass('col-lg-6');
                }
            }

            setTimeout(function () {
                if (salesChartInstance) salesChartInstance.resize();
                if (stackedBarChartInstance) stackedBarChartInstance.resize();
                if (productionChartInstance) productionChartInstance.resize();
            }, 60);
        }

        $(document).off('change', '.chk-dashboard-area').on('change', '.chk-dashboard-area', function () {
            var areaKey = $(this).data('area');
            var isChecked = $(this).is(':checked');
            if (areasDashboardConfig.hasOwnProperty(areaKey)) {
                areasDashboardConfig[areaKey].visible = isChecked;
                guardarConfiguracionAreas();
                aplicarVisibilidadAreas();
            }
        });

        $('#btn-modal-marcar-todos').on('click', function () {
            for (var k in areasDashboardConfig) areasDashboardConfig[k].visible = true;
            guardarConfiguracionAreas();
            aplicarVisibilidadAreas();
        });

        $('#btn-modal-desmarcar-todos').on('click', function () {
            for (var k in areasDashboardConfig) areasDashboardConfig[k].visible = false;
            guardarConfiguracionAreas();
            aplicarVisibilidadAreas();
        });

        $('#btn-modal-restablecer').on('click', function () {
            for (var k in areasDashboardConfig) areasDashboardConfig[k].visible = true;
            guardarConfiguracionAreas();
            aplicarVisibilidadAreas();
        });

        cargarConfiguracionAreas();
        aplicarVisibilidadAreas();

        // Soporte rueda de ratón para zoom en gráficos
        var canvasVentas = document.getElementById('salesChart');
        if (canvasVentas) {
            canvasVentas.addEventListener('wheel', function (e) {
                e.preventDefault();
                var delta = e.deltaY;
                var curIdx = nivelesMesesVentas.indexOf(mesesVentasActuales);
                if (delta > 0 && curIdx > 0) setVentasMeses(nivelesMesesVentas[curIdx - 1]);
                else if (delta < 0 && curIdx < nivelesMesesVentas.length - 1) setVentasMeses(nivelesMesesVentas[curIdx + 1]);
            }, { passive: false });
        }

        var canvasDiferencia = document.getElementById('stackedBarChart');
        if (canvasDiferencia) {
            canvasDiferencia.addEventListener('wheel', function (e) {
                e.preventDefault();
                var delta = e.deltaY;
                var curIdx = nivelesDias.indexOf(diasActuales);
                if (delta > 0 && curIdx > 0) setDiferenciaDias(nivelesDias[curIdx - 1]);
                else if (delta < 0 && curIdx < nivelesDias.length - 1) setDiferenciaDias(nivelesDias[curIdx + 1]);
            }, { passive: false });
        }

        // Top Pedidos (Conmutador 5 vs 10)
        var currentTopPedidosData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopPedidos));
        var currentTopLimit = 5;

        function cambiarTopPedidos(limit) {
            currentTopLimit = limit;
            renderTopPedidos(currentTopPedidosData, currentTopLimit);
            var $btn5 = $('#btn-top-5');
            var $btn10 = $('#btn-top-10');
            var $badge = $('#badge-top-pedidos');
            if (currentTopLimit === 10) {
                $btn5.removeClass('btn-primary active').addClass('btn-outline-secondary');
                $btn10.removeClass('btn-outline-secondary').addClass('btn-primary active');
                if ($badge.length) $badge.html('<i class="bi bi-calendar-event me-1"></i>Top 10 Hoy');
            } else {
                $btn5.removeClass('btn-outline-secondary').addClass('btn-primary active');
                $btn10.removeClass('btn-primary active').addClass('btn-outline-secondary');
                if ($badge.length) $badge.html('<i class="bi bi-calendar-event me-1"></i>Top 5 Hoy');
            }
        }
        window.cambiarTopPedidos = cambiarTopPedidos;

        function renderTopPedidos(lista, limit) {
            var $tbody = $('#tabla-top-pedidos tbody');
            if (!$tbody.length) return;
            if (!lista || !lista.length) {
                $tbody.html('<tr><td colspan="3" class="text-center text-muted py-4"><i class="bi bi-info-circle me-1"></i>No se registran pedidos en el día de hoy</td></tr>');
                return;
            }
            var subLista = lista.slice(0, limit || 5);
            var html = '';
            for (var i = 0; i < subLista.length; i++) {
                var p = subLista[i];
                var id = p.id !== undefined ? p.id : p.Id;
                var codigo = p.codigo || p.Codigo || '';
                var cliente = p.cliente || p.Cliente || 'Sin Cliente';
                var montoFormateado = p.montoFormateado || p.MontoFormateado || ('S/ ' + Number(p.monto || p.Monto || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                var rank = i + 1;
                var badgeClass = rank === 1 ? 'bg-warning text-dark fw-bold' : 'bg-secondary-subtle text-secondary border';

                html += '<tr>' +
                    '<td class="text-center font-monospace fw-bold text-primary py-2">' +
                        '<span class="badge ' + badgeClass + ' me-1">#' + rank + '</span>' +
                        '<span>' + id + '</span>' +
                        (codigo ? ' <small class="text-muted d-block">(' + codigo + ')</small>' : '') +
                    '</td>' +
                    '<td class="py-2"><span class="fw-semibold">' + cliente + '</span></td>' +
                    '<td class="text-end font-monospace fw-bold text-success py-2">' + montoFormateado + '</td>' +
                '</tr>';
            }
            $tbody.html(html);
        }

        // Clientes Inactivos
        var currentClientesInactivosData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ClientesInactivos));
        var currentClientesInactivosLimit = 5;

        function alternarVerMasClientesInactivos() {
            currentClientesInactivosLimit = currentClientesInactivosLimit === 5 ? 10 : 5;
            var $btn = $('#btn-ver-mas-clientes');
            if (currentClientesInactivosLimit === 10) {
                $btn.html('<i class="bi bi-chevron-up me-1"></i>Ver menos (5)').removeClass('btn-outline-secondary').addClass('btn-secondary');
            } else {
                $btn.html('<i class="bi bi-chevron-down me-1"></i>Ver más (10)').removeClass('btn-secondary').addClass('btn-outline-secondary');
            }
            var meses = parseInt($('#select-meses-inactivos').val()) || 5;
            renderClientesInactivos(currentClientesInactivosData, meses, currentClientesInactivosLimit);
        }
        window.alternarVerMasClientesInactivos = alternarVerMasClientesInactivos;

        function renderClientesInactivos(lista, meses, limit) {
            var $tbody = $('#tabla-clientes-inactivos tbody');
            if (!$tbody.length) return;
            if (!lista || !lista.length) {
                $tbody.html('<tr><td colspan="3" class="text-center text-muted py-4"><i class="bi bi-check-circle text-success me-1"></i>Sin clientes inactivos para este rango</td></tr>');
                return;
            }
            var subLista = lista.slice(0, limit || 5);
            var html = '';
            for (var i = 0; i < subLista.length; i++) {
                var c = subLista[i];
                var id = c.id !== undefined ? c.id : c.Id;
                var codigo = c.codigo || c.Codigo || '';
                var cliente = c.cliente || c.Cliente || 'Sin Nombre';
                var fStr = c.fechaFormateada || c.FechaFormateada || '';
                var rank = i + 1;

                html += '<tr>' +
                    '<td class="text-center font-monospace text-secondary py-2">' +
                        '<span class="badge bg-secondary-subtle text-secondary border me-1">#' + rank + '</span>' +
                        '<span>' + id + '</span>' +
                        (codigo ? ' <small class="text-muted d-block">(' + codigo + ')</small>' : '') +
                    '</td>' +
                    '<td class="py-2"><span class="fw-semibold">' + cliente + '</span></td>' +
                    '<td class="text-end py-2">' +
                        '<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle font-monospace px-2 py-1">' +
                            '<i class="bi bi-calendar-x me-1"></i>' + fStr +
                        '</span>' +
                    '</td>' +
                '</tr>';
            }
            $tbody.html(html);
        }

        $(document).off('change', '#select-meses-inactivos').on('change', '#select-meses-inactivos', function () {
            var meses = $(this).val();
            var $badge = $('#badge-clientes-inactivos');
            if ($badge.length) $badge.html('Inactivos (&ge; ' + meses + 'm)');
            var $tbody = $('#tabla-clientes-inactivos tbody');
            $tbody.html('<tr><td colspan="3" class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Consultando clientes...</td></tr>');

            $.ajax({
                url: '@Url.Action("ObtenerClientesInactivos", "Home")',
                type: 'GET',
                data: { meses: meses },
                success: function (res) {
                    if (res && res.success && res.data) {
                        currentClientesInactivosData = res.data;
                        renderClientesInactivos(res.data, meses, currentClientesInactivosLimit);
                    } else {
                        $tbody.html('<tr><td colspan="3" class="text-center text-muted py-4"><i class="bi bi-check-circle text-success me-1"></i>Sin clientes inactivos para este rango</td></tr>');
                    }
                },
                error: function () {
                    $tbody.html('<tr><td colspan="3" class="text-center text-danger py-4"><i class="bi bi-exclamation-triangle me-1"></i>Error al consultar clientes</td></tr>');
                }
            });
        });

        // Polling y Sincronización
        function sincronizarDashboard() {
            var $icon = $('#icon-sync');
            $icon.addClass('spinner-border spinner-border-sm').removeClass('bi-arrow-repeat');

            var mesesAct = parseInt($('#select-meses-inactivos').val()) || 5;
            $.ajax({
                url: '@Url.Action("ObtenerDatosDashboard", "Home")',
                type: 'GET',
                data: { mesesInactivos: mesesAct },
                success: function (res) {
                    $icon.removeClass('spinner-border spinner-border-sm').addClass('bi-arrow-repeat');
                    if (res && res.success) {
                        lastDashboardData = res;
                        if (res.kpis) {
                            if (res.kpis.facturacionMes) $('#kpi-ventas').text(res.kpis.facturacionMes);
                            if (res.kpis.pedidosActivos) $('#kpi-pedidos').text(res.kpis.pedidosActivos);
                            if (res.kpis.cotizacionesActivas) $('#kpi-cotizaciones').text(res.kpis.cotizacionesActivas);
                            if (res.kpis.ordenesProduccionMes) $('#kpi-produccion').text(res.kpis.ordenesProduccionMes);
                            if (res.kpis.ordenesCompraMes) $('#kpi-compras').text(res.kpis.ordenesCompraMes);
                        }
                        if (res.graficoVentas) renderSalesChart(res.graficoVentas);
                        if (res.graficoProduccion) renderProductionChart(res.graficoProduccion);
                        if (res.graficoStackedBar) renderStackedBarChart(res.graficoStackedBar);
                        if (res.topPedidos) {
                            currentTopPedidosData = res.topPedidos;
                            renderTopPedidos(res.topPedidos, currentTopLimit);
                        }
                        if (res.clientesInactivos) {
                            currentClientesInactivosData = res.clientesInactivos;
                            renderClientesInactivos(res.clientesInactivos, mesesAct, currentClientesInactivosLimit);
                        }
                    }
                },
                error: function () {
                    $icon.removeClass('spinner-border spinner-border-sm').addClass('bi-arrow-repeat');
                }
            });
        }
        window.sincronizarDashboard = sincronizarDashboard;

        // Auto polling cada 30 segundos
        var intervalId = setInterval(function () {
            if ($('#kpi-ventas').length) sincronizarDashboard();
            else clearInterval(intervalId);
        }, 30000);

        // Manejador para minimizar / expandir tarjetas (Card Collapse)
        $(document).off('click', '[data-lte-toggle="card-collapse"]').on('click', '[data-lte-toggle="card-collapse"]', function (e) {
            e.preventDefault();
            var $btn = $(this);
            var $card = $btn.closest('.card');
            var $body = $card.children('.card-body');
            var $footer = $card.children('.card-footer');
            var $icon = $btn.find('i');

            $body.slideToggle(200, function () {
                if (salesChartInstance) salesChartInstance.resize();
                if (stackedBarChartInstance) stackedBarChartInstance.resize();
                if (productionChartInstance) productionChartInstance.resize();
            });
            if ($footer.length) {
                $footer.slideToggle(200);
            }
            if ($icon.hasClass('bi-dash-lg')) {
                $icon.removeClass('bi-dash-lg').addClass('bi-plus-lg');
                $btn.attr('title', 'Expandir');
                $card.addClass('collapsed-card');
            } else {
                $icon.removeClass('bi-plus-lg').addClass('bi-dash-lg');
                $btn.attr('title', 'Minimizar');
                $card.removeClass('collapsed-card');
            }
        });

        // Observer para cambios de modo oscuro en <html>
        var observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                if (mutation.type === "attributes" && mutation.attributeName === "data-bs-theme") {
                    if (lastDashboardData) {
                        renderSalesChart(lastDashboardData.graficoVentas);
                        renderProductionChart(lastDashboardData.graficoProduccion);
                        renderStackedBarChart(lastDashboardData.graficoStackedBar);
                    }
                }
            });
        });
        observer.observe(document.documentElement, { attributes: true });
    });
</script>
}
