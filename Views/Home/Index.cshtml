    function cambiarSedeGlobal() {
        sedeGlobalSeleccionada = parseInt($('#select-filtro-sede-dashboard').val()) || 0;
        var textoSede = sedeGlobalSeleccionada === 1 ? 'SEDE CENTRAL' : (sedeGlobalSeleccionada === 2 ? 'SEDE ILO' : 'GLOBAL (AMBAS)');
