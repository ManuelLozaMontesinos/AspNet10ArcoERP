                                <i class="fas fa-chart-bar text-danger me-2"></i>Top 10 Productos con Menor Stock
                            </h5>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 badge-sede-dinamica" style="font-size: 0.72rem;">
                                SEDE CENTRAL
                            </span>
                            <span class="badge bg-danger text-white px-2 py-1" style="font-size: 0.72rem;">
                                <i class="fas fa-exclamation-triangle me-1"></i>Inventario Crítico
                            </span>
                        </div>
                        <div class="card-tools d-inline-flex flex-wrap align-items-center" style="gap: 6px;">
                            <!-- Filtro Sede -->
                            <select id="filtro-menor-stock-sede" class="form-select form-select-sm fw-semibold shadow-sm" style="min-width: 125px;" onchange="recargarTopMenorStock();">
                                <option value="1" selected>Sede Central</option>
                                <option value="2">Sede Ilo</option>
                            </select>

                            <!-- Filtro Grupo -->
                            <select id="filtro-menor-stock-grupo" class="form-select form-select-sm fw-semibold shadow-sm" style="min-width: 150px;" onchange="onGrupoChanged();">
                                <option value="" selected>- Todos los Grupos -</option>
                                @foreach (var grp in listaGrupos)
                                {
                                    <option value="@grp.Id">@grp.Nombre</option>
                                }
                            </select>

                            <!-- Filtro Clase -->
                            <select id="filtro-menor-stock-clase" class="form-select form-select-sm fw-semibold shadow-sm" style="min-width: 150px;" onchange="onClaseChanged();">
                                <option value="" selected>- Todas las Clases -</option>
                            </select>

                            <!-- Filtro Familia -->
                            <select id="filtro-menor-stock-familia" class="form-select form-select-sm fw-semibold shadow-sm" style="min-width: 150px;" onchange="recargarTopMenorStock();">
                                <option value="" selected>- Todas las Familias -</option>
                            </select>

                            <!-- Botón Limpiar Filtros -->
                            <button type="button" class="btn btn-outline-secondary btn-sm shadow-sm px-2" onclick="limpiarFiltrosMenorStock();" title="Limpiar Filtros">
                                <i class="fas fa-undo"></i>
                            </button>

                            <!-- Botón Recargar -->
                            <button type="button" class="btn btn-outline-danger btn-sm shadow-sm px-2" onclick="recargarTopMenorStock();" title="Actualizar">
                                <i class="fas fa-sync-alt" id="icon-recargar-menor-stock"></i>
                            </button>

                            <div class="btn-group btn-group-sm widget-size-control me-1">
                                <button type="button" class="btn btn-tool" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="Tamaño y posición del widget">
                                    <i class="fas fa-expand-arrows-alt"></i>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end shadow-sm py-1" style="font-size: 0.825rem; min-width: 195px;">
                                    <h6 class="dropdown-header text-xs text-uppercase fw-bold py-1">Ubicación / Ancho</h6>
                                    <a class="dropdown-item py-1 btn-widget-pos" href="javascript:void(0);" data-zone="full-top"><i class="fas fa-arrows-alt-v me-2 text-primary"></i>Ancho Completo Superior</a>
                                    <a class="dropdown-item py-1 btn-widget-pos" href="javascript:void(0);" data-zone="left"><i class="fas fa-arrow-left me-2 text-info"></i>Columna Izquierda</a>
                                    <a class="dropdown-item py-1 btn-widget-pos" href="javascript:void(0);" data-zone="right"><i class="fas fa-arrow-right me-2 text-info"></i>Columna Derecha</a>
                                    <a class="dropdown-item py-1 btn-widget-pos" href="javascript:void(0);" data-zone="full-bottom"><i class="fas fa-arrows-alt-v me-2 text-primary"></i>Ancho Completo Inferior</a>
                                    <div class="dropdown-divider my-1"></div>
                                    <h6 class="dropdown-header text-xs text-uppercase fw-bold py-1">Altura de Contenido</h6>
                                    <a class="dropdown-item py-1 btn-widget-height" href="javascript:void(0);" data-height="190"><i class="fas fa-compress-arrows-alt me-2 text-muted"></i>Compacta (190px)</a>
                                    <a class="dropdown-item py-1 btn-widget-height" href="javascript:void(0);" data-height="260"><i class="fas fa-equals me-2 text-muted"></i>Normal (260px)</a>
                                    <a class="dropdown-item py-1 btn-widget-height" href="javascript:void(0);" data-height="360"><i class="fas fa-expand-alt me-2 text-muted"></i>Ampliada (360px)</a>
                                    <a class="dropdown-item py-1 btn-widget-height" href="javascript:void(0);" data-height="480"><i class="fas fa-arrows-alt-v me-2 text-muted"></i>Grande (480px)</a>
                                </div>
                            </div>

                            <!-- Minimizar -->
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" title="Minimizar">
                                <i class="bi bi-dash-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0 table-responsive" style="max-height: 380px;">
                        <table class="table table-striped table-hover align-middle mb-0" id="tabla-top-menor-stock">
                            <thead class="table-header-custom border-bottom sticky-top">
                                <tr>
                                    <th style="width: 5%;" class="text-center">#</th>
                                    <th style="width: 15%;" class="text-center">Código</th>
                                    <th style="width: 35%;">Nombre del Producto</th>
                                    <th style="width: 25%;">Categoría</th>
                                    <th style="width: 20%;" class="text-end pe-3">Cantidad (Stock)</th>
                                </tr>
                            </thead>
                            <tbody id="tbody-top-menor-stock">
                                @if (Model?.ListaTopMenorStock != null && Model.ListaTopMenorStock.Count > 0)
                                {
                                    foreach (var prod in Model.ListaTopMenorStock)
                                    {
                                        <tr>
                                            <td class="text-center py-2">
                                                <span class="badge bg-danger rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 22px; height: 22px; font-size: 0.75rem;">
                                                    @prod.Orden
                                                </span>
                                            </td>
                                            <td class="text-center py-2">
                                                <span class="badge bg-body-tertiary border font-monospace fw-bold px-2 py-1 text-body">@prod.Codigo</span>
                                            </td>
                                            <td class="py-2">
                                                <span class="fw-semibold text-body d-block">@prod.Nombre</span>
                                                <small class="text-muted">Unidad: @prod.UnidadMedida</small>
                                            </td>
                                            <td class="py-2 small text-muted">
                                                @prod.CategoriaCompleta
                                            </td>
                                            <td class="text-end py-2 pe-3 text-nowrap">
                                                <span class="badge bg-danger px-2 py-1 fw-bold me-1">
                                                    <i class="fas fa-times-circle me-1"></i>Agotado @prod.CantidadFormateada
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            <i class="fas fa-info-circle me-1"></i> No se encontraron productos para los filtros seleccionados
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer bg-body border-top py-2 px-3 d-flex justify-content-between align-items-center">
                        <small class="text-muted"><i class="fas fa-info-circle text-danger me-1"></i>Top 10 productos con menor stock vinculados al módulo Volumen de Existencias en tiempo real</small>
                        <span class="text-muted small"><i class="fas fa-filter me-1"></i>Filtro: Todos los Grupos</span>
                    </div>
                    <div class="dashboard-card-resize-bar" title="Arrastra hacia arriba o abajo para cambiar la altura del widget"><div class="resize-grip"></div></div>
                </div>
            </div>

        </div>

    </div>
</div>

