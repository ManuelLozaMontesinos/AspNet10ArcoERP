            <div class="modal-footer bg-body-tertiary border-top py-2 px-4">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm fw-semibold" data-bs-dismiss="modal" onclick="guardarPermisosRol();">
                    <i class="bi bi-save me-1"></i>Guardar Permisos del Rol
                </button>
            </div>
        </div>
    </div>
</div>
}

@section Scripts {
<script>
    // ========================================================
    // VARIABLES GLOBALES Y DATOS DE MODELO
    // ========================================================
    var currentUsername = '@(userSession?.UsuarioLogon ?? "admin")';
    var currentRoleCode = '@rolActualCodigo';

    var allMesesVentas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.MesesVentas ?? Array.Empty<string>()));
    var allVentasAnterior = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.VentasAnterior ?? Array.Empty<double>()));
    var allVentasActual = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.VentasActual ?? Array.Empty<double>()));
    var allVentasBarra = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.VentasBarraActual ?? Array.Empty<double?>()));

    var allStackedLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.StackedLabels ?? new List<string>()));
    var allDsCentral = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.DsCentral ?? Array.Empty<double>()));
    var allDsIlo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.DsIlo ?? Array.Empty<double>()));

    var allVendedorLabels = [];
    var allVendedorCantidades = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.VendedorCantidades ?? new List<int>()));
    var allVendedorMontos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.VendedorMontos ?? new List<double>()));

    var allCotizacionLabels = [];
    var allCotizacionCantidades = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.CotizacionCantidades ?? new List<int>()));
    var allCotizacionMontos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.CotizacionMontos ?? new List<double>()));

    var prodLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.ProdLabels ?? Array.Empty<string>()));
    var prodValores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.ProdValores ?? Array.Empty<int>()));

    // Matriz de roles desde BD
    var rolesConfigBd = @Html.Raw(Model?.DashboardRolesConfigJson ?? "{}");

    // Instancias de Gráficos
    var salesChartInstance = null;
    var stackedChartInstance = null;
    var vendedorChartInstance = null;
    var cotizacionChartInstance = null;
    var productionChartInstance = null;

    // Estados de filtros
    var ventasMesesActuales = 12;
    var stackedDiasActuales = 12;
    var sedeActiva = 'vs'; // 'vs', 'central', 'ilo'
    var vendedorDiasActuales = 12;
    var cotizacionDiasActuales = 12;
    var verTop10Pedidos = false;
    var ver10ClientesInactivos = false;
    var sedeGlobalSeleccionada = 0; // 0: Global, 1: Central, 2: Ilo

    // Helper Formato Moneda
    function formatMonedaPeruana(num) {
        var n = Number(num) || 0;
        return 'S/ ' + n.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    // Configuración de Tema Claro/Oscuro
    function getThemeConfig() {
        var isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
        return {
            isDark: isDark,
            textColor: isDark ? '#adb5bd' : '#495057',
            gridColor: isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.06)',
            barCurrent: isDark ? '#3b82f6' : '#0d6efd',
            linePrev: isDark ? '#64748b' : '#adb5bd'
        };
    }

    // ========================================================
    // 1. RENDER GRÁFICO: EVOLUCIÓN DE VENTAS
    // ========================================================
    function renderSalesChart(meses, actual, anterior) {
        var canvas = document.getElementById('salesChart');
        if (!canvas) return;
        if (salesChartInstance) salesChartInstance.destroy();

        var theme = getThemeConfig();
        salesChartInstance = new Chart(canvas.getContext('2d'), {
            type: 'bar',
            data: {
                labels: meses,
                datasets: [
                    {
                        type: 'line',
                        label: 'Periodo Anterior',
                        data: anterior,
                        borderColor: theme.linePrev,
                        backgroundColor: 'transparent',
                        borderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        pointBackgroundColor: theme.linePrev,
                        tension: 0.3,
                        order: 0
                    },
                    {
                        type: 'bar',
                        label: 'Periodo Actual',
                        data: actual,
                        backgroundColor: theme.barCurrent,
                        borderColor: theme.barCurrent,
                        borderRadius: 4,
                        order: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                        callbacks: {
                            label: function(ctx) {
                                return ctx.dataset.label + ': S/ ' + (ctx.parsed.y * 1000).toLocaleString('es-PE') + ' (' + ctx.parsed.y + 'k)';
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: theme.textColor, font: { size: 11 } }
                    },
                    y: {
                        grid: { color: theme.gridColor },
                        ticks: {
                            color: theme.textColor,
                            font: { size: 11 },
                            callback: function(v) { return v + 'k'; }
                        }
                    }
                }
            }
        });
    }

    function setVentasMeses(n) {
        ventasMesesActuales = n;
        $('[id^="btn-ventas-"]').removeClass('btn-primary active').addClass('btn-outline-secondary');
        $('#btn-ventas-' + n).removeClass('btn-outline-secondary').addClass('btn-primary active');
        $('#badge-meses-ventas').html('<i class="bi bi-calendar-check me-1"></i>' + n + ' Meses Móviles');

        var meses = (allMesesVentas || []).slice(-n);
        var actual = (allVentasActual || []).slice(-n);
        var anterior = (allVentasAnterior || []).slice(-n);
        renderSalesChart(meses, actual, anterior);
    }

    // ========================================================
    // 2. RENDER GRÁFICO: DISTRIBUCIÓN POR SEDE (Central vs Ilo)
    // ========================================================
    function renderStackedChart(labels, central, ilo) {
        var canvas = document.getElementById('stackedBarChart');
        if (!canvas) return;
        if (stackedChartInstance) stackedChartInstance.destroy();

        var theme = getThemeConfig();
        var datasets = [];

        if (sedeActiva === 'vs' || sedeActiva === 'central') {
            datasets.push({
                label: 'Central',
                data: central,
                backgroundColor: theme.barCurrent,
                borderRadius: sedeActiva === 'central' ? 4 : 0
            });
        }
        if (sedeActiva === 'vs' || sedeActiva === 'ilo') {
            datasets.push({
                label: 'Ilo',
                data: ilo,
                backgroundColor: '#6c757d',
                borderRadius: 4
            });
        }

        stackedChartInstance = new Chart(canvas.getContext('2d'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: datasets
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                        callbacks: {
                            label: function(ctx) {
                                return ctx.dataset.label + ': S/ ' + (ctx.parsed.y * 1000).toLocaleString('es-PE') + ' (' + ctx.parsed.y + 'k)';
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        stacked: sedeActiva === 'vs',
                        grid: { display: false },
                        ticks: { color: theme.textColor, font: { size: 11 } }
                    },
                    y: {
                        stacked: sedeActiva === 'vs',
                        grid: { color: theme.gridColor },
                        ticks: {
                            color: theme.textColor,
                            font: { size: 11 },
                            callback: function(v) { return v + 'k'; }
                        }
                    }
                }
            }
        });
    }

    function setStackedDias(n) {
        stackedDiasActuales = n;
        $('[id^="btn-stacked-"]').removeClass('btn-primary active').addClass('btn-outline-secondary');
        $('#btn-stacked-' + n).removeClass('btn-outline-secondary').addClass('btn-primary active');

        var labels = (allStackedLabels || []).slice(-n);
        var central = (allDsCentral || []).slice(-n);
        var ilo = (allDsIlo || []).slice(-n);
        renderStackedChart(labels, central, ilo);
    }

    function toggleSedeFilter(modo) {
        sedeActiva = modo;
        $('.btn-sede-filter').removeClass('active').addClass('inactive');
        $('#filter-sede-' + modo).removeClass('inactive').addClass('active');
        setStackedDias(stackedDiasActuales);
    }

    // ========================================================
    // 3. RENDER GRÁFICO: PEDIDOS POR VENDEDOR
    // ========================================================
    function renderVendedorChart(labels, cantidades, montos, totalPedidos, totalMonto) {
        var canvas = document.getElementById('vendedorBarChart');
        if (!canvas) return;
        if (vendedorChartInstance) vendedorChartInstance.destroy();

        labels = labels || [];
        cantidades = cantidades || [];
        montos = montos || [];

        if (totalPedidos === undefined || totalPedidos === null) {
            totalPedidos = cantidades.reduce(function(a, b) { return a + (Number(b) || 0); }, 0);
        }
        if (!totalMonto) {
            var sumMto = montos.reduce(function(a, b) { return a + (Number(b) || 0); }, 0);
            totalMonto = formatMonedaPeruana(sumMto);
        }

        $('#vendedor-total-pedidos').text(totalPedidos + ' pedido' + (totalPedidos === 1 ? '' : 's') + ' en el periodo');
        $('#vendedor-total-monto').text('Total: ' + totalMonto);

        var theme = getThemeConfig();
        vendedorChartInstance = new Chart(canvas.getContext('2d'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        type: 'line',
                        label: 'Tendencia Pedidos',
                        data: cantidades,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.12)',
                        borderWidth: 2.5,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        pointBackgroundColor: '#10b981',
                        pointBorderColor: '#ffffff',
                        fill: false,
                        tension: 0.25,
                        order: 0
                    },
                    {
                        type: 'bar',
                        label: 'Cantidad de Pedidos',
                        data: cantidades,
                        backgroundColor: theme.barCurrent,
                        borderColor: theme.barCurrent,
                        borderRadius: 4,
                        order: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                        callbacks: {
                            label: function(ctx) {
                                if (ctx.dataset.type === 'line') {
                                    return 'Pico / Tendencia: ' + ctx.parsed.y + ' pedidos';
                                }
                                var idx = ctx.dataIndex;
                                var mto = (montos && montos.length > idx) ? montos[idx] : 0;
                                return [
                                    'Pedidos: ' + ctx.parsed.y,
                                    'Monto Total: ' + formatMonedaPeruana(mto)
                                ];
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: theme.textColor, font: { size: 11 } }
                    },
                    y: {
                        grid: { color: theme.gridColor },
                        ticks: {
                            color: theme.textColor,
                            font: { size: 11 },
                            stepSize: 1
                        }
                    }
                }
            }
        });
    }

    function setVendedorDias(n) {
        vendedorDiasActuales = n;
        $('[id^="btn-vendedor-dias-"]').removeClass('btn-primary active').addClass('btn-outline-secondary');
        $('#btn-vendedor-dias-' + n).removeClass('btn-outline-secondary').addClass('btn-primary active');

        var vid = $('#select-vendedor-chart').val() || @(Model?.PrimerVendedorId ?? 50);
        cargarDatosVendedor(vid, n);
    }

    function cambiarVendedorChart() {
        var vid = $('#select-vendedor-chart').val() || @(Model?.PrimerVendedorId ?? 50);
        cargarDatosVendedor(vid, vendedorDiasActuales);
    }

    function cargarDatosVendedor(vid, dias) {
        $.ajax({
            url: '@Url.Action("ObtenerPedidosVendedor", "Home")',
            type: 'GET',
            data: { vendedorId: vid, dias: dias },
            success: function(res) {
                if (res && res.success) {
                    allVendedorLabels = res.labels;
                    allVendedorCantidades = res.cantidades;
                    allVendedorMontos = res.montos;
                    renderVendedorChart(res.labels, res.cantidades, res.montos, res.totalPedidos, res.totalMonto);
                }
            }
        });
    }

    // ========================================================
    // 3.1 RENDER GRÁFICO: COTIZACIONES POR VENDEDOR
    // ========================================================
    function renderCotizacionChart(labels, cantidades, montos, totalCotizaciones, totalMonto) {
        var canvas = document.getElementById('cotizacionVendedorBarChart');
        if (!canvas) return;
        if (cotizacionChartInstance) cotizacionChartInstance.destroy();

        labels = labels || [];
        cantidades = cantidades || [];
        montos = montos || [];

        if (totalCotizaciones === undefined || totalCotizaciones === null) {
            totalCotizaciones = cantidades.reduce(function(a, b) { return a + (Number(b) || 0); }, 0);
        }
        if (!totalMonto) {
            var sumMto = montos.reduce(function(a, b) { return a + (Number(b) || 0); }, 0);
            totalMonto = formatMonedaPeruana(sumMto);
        }

        $('#cotizacion-total-pedidos, #cotizacion-total-cant').text(totalCotizaciones + ' cotización' + (totalCotizaciones === 1 ? '' : 'es') + ' en el periodo');
        $('#cotizacion-total-monto').text('Total: ' + totalMonto);

        var theme = getThemeConfig();
        cotizacionChartInstance = new Chart(canvas.getContext('2d'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        type: 'line',
                        label: 'Tendencia Cotizaciones',
                        data: cantidades,
                        borderColor: '#20c997',
                        backgroundColor: 'rgba(32, 201, 151, 0.12)',
                        borderWidth: 2.5,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        pointBackgroundColor: '#20c997',
                        pointBorderColor: '#ffffff',
                        fill: false,
                        tension: 0.25,
                        order: 0
                    },
                    {
                        type: 'bar',
                        label: 'Cantidad de Cotizaciones',
                        data: cantidades,
                        backgroundColor: '#198754',
                        borderColor: '#198754',
                        borderRadius: 4,
                        order: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                        callbacks: {
                            label: function(ctx) {
                                if (ctx.dataset.type === 'line') {
                                    return 'Pico / Tendencia: ' + ctx.parsed.y + ' cotizaciones';
                                }
                                var idx = ctx.dataIndex;
                                var mto = (montos && montos.length > idx) ? montos[idx] : 0;
                                return [
                                    'Cotizaciones: ' + ctx.parsed.y,
                                    'Monto Total: ' + formatMonedaPeruana(mto)
                                ];
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: theme.textColor, font: { size: 11 } }
                    },
                    y: {
                        grid: { color: theme.gridColor },
                        ticks: {
                            color: theme.textColor,
                            font: { size: 11 },
                            stepSize: 1
                        }
                    }
                }
            }
        });
    }

    function setCotizacionDias(n) {
        cotizacionDiasActuales = n;
        $('[id^="btn-cotizacion-dias-"]').removeClass('btn-info text-white active').addClass('btn-outline-secondary');
        $('#btn-cotizacion-dias-' + n).removeClass('btn-outline-secondary').addClass('btn-info text-white active');

        var vid = $('#select-cotizacion-vendedor-chart').val() || 0;
        cargarDatosCotizaciones(vid, n);
    }

    function cambiarCotizacionVendedorChart() {
        var vid = $('#select-cotizacion-vendedor-chart').val() || 0;
        cargarDatosCotizaciones(vid, cotizacionDiasActuales);
    }

    function cargarDatosCotizaciones(vid, dias) {
        $.ajax({
            url: '@Url.Action("ObtenerCotizacionesVendedor", "Home")',
            type: 'GET',
            data: { vendedorId: vid, dias: dias },
            success: function(res) {
                if (res && res.success) {
                    allCotizacionLabels = res.labels;
                    allCotizacionCantidades = res.cantidades;
                    allCotizacionMontos = res.montos;
                    renderCotizacionChart(res.labels, res.cantidades, res.montos, res.totalCotizaciones, res.totalMonto);
                }
            }
        });
    }

    // ========================================================
    // 4. RENDER GRÁFICO: ESTADO DE PRODUCCIÓN (Doughnut)
    // ========================================================
    function renderProductionChart(labels, valores) {
        var canvas = document.getElementById('productionChart');
        if (!canvas) return;
        if (productionChartInstance) productionChartInstance.destroy();

        var total = (valores || []).reduce(function(a, b) { return a + b; }, 0);
        if (total === 0) {
            $('#productionChartEmpty').removeClass('d-none');
            $(canvas).addClass('d-none');
            return;
        } else {
            $('#productionChartEmpty').addClass('d-none');
            $(canvas).removeClass('d-none');
        }

        var theme = getThemeConfig();
        productionChartInstance = new Chart(canvas.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: valores,
                    backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#dc3545'],
                    borderWidth: 2,
                    borderColor: theme.isDark ? '#1e2227' : '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            boxWidth: 12,
                            padding: 12,
                            color: theme.textColor,
                            font: { size: 11 }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                var val = ctx.parsed;
                                var pct = total > 0 ? ((val / total) * 100).toFixed(1) : 0;
                                return ctx.label + ': ' + val + ' (' + pct + '%)';
                            }
                        }
                    }
                },
                cutout: '65%'
            }
        });
    }

    // ========================================================
    // 5. ACCIONES EN TABLAS DE DETALLE
    // ========================================================
    function setTopPedidos(cant) {
        verTop10Pedidos = (cant === 10);
        if (verTop10Pedidos) {
            $('.fila-top-extra').removeClass('d-none');
            $('#btn-top-pedidos-10').addClass('btn-primary active').removeClass('btn-outline-secondary');
            $('#btn-top-pedidos-5').removeClass('btn-primary active').addClass('btn-outline-secondary');
            $('#badge-top-pedidos-fecha').html('<i class="fas fa-calendar-day me-1"></i>Top 10 - @(Model?.TopPedidosFecha ?? DateTime.Today.ToString("dd/MM/yyyy"))');
        } else {
            $('.fila-top-extra').addClass('d-none');
            $('#btn-top-pedidos-5').addClass('btn-primary active').removeClass('btn-outline-secondary');
            $('#btn-top-pedidos-10').removeClass('btn-primary active').addClass('btn-outline-secondary');
            $('#badge-top-pedidos-fecha').html('<i class="fas fa-calendar-day me-1"></i>Top 5 - @(Model?.TopPedidosFecha ?? DateTime.Today.ToString("dd/MM/yyyy"))');
        }
    }

    function alternarTopPedidos() {
        setTopPedidos(verTop10Pedidos ? 5 : 10);
    }

    function alternarVerMasClientesInactivos() {
        ver10ClientesInactivos = !ver10ClientesInactivos;
        if (ver10ClientesInactivos) {
            $('.fila-inactivo-extra').removeClass('d-none');
            $('#btn-ver-mas-clientes').html('<i class="fas fa-chevron-up me-1"></i>Ver menos (5)');
        } else {
            $('.fila-inactivo-extra').addClass('d-none');
            $('#btn-ver-mas-clientes').html('<i class="fas fa-chevron-down me-1"></i>Ver más (10)');
        }
    }

    function cambiarFiltroInactivos() {
        var meses = parseInt($('#select-meses-inactivos').val()) || 5;
        var vid = $('#select-vendedor-inactivos').val();
        $('#label-meses-inactivos').html('&ge; ' + meses + ' Meses');

        $.ajax({
            url: '@Url.Action("ObtenerClientesInactivos", "Home")',
            type: 'GET',
            data: { meses: meses, vendedorId: vid ? parseInt(vid) : null, sedeId: sedeGlobalSeleccionada > 0 ? sedeGlobalSeleccionada : null },
            success: function(res) {
                if (res && res.success && res.data) {
                    var $tbody = $('#tabla-clientes-inactivos tbody').empty();
                    if (res.data.length === 0) {
                        $tbody.append('<tr><td colspan="3" class="text-center text-muted py-4"><i class="fas fa-check-circle text-success me-1"></i> No se encontraron clientes inactivos para el filtro</td></tr>');
                    } else {
                        $.each(res.data, function(i, c) {
                            var isExtra = (i >= 5 && !ver10ClientesInactivos) ? 'd-none fila-inactivo-extra' : '';
                            var row = '<tr class="dashboard-drilldown-row ' + isExtra + '" onclick="window.location.href=\'@Url.Action("Index", "Pedido", new { area = "VT" })\';" title="Clic para ir al módulo de pedidos">' +
                                '<td class="py-2"><span class="fw-semibold text-body d-block">' + (c.cliente || 'Sin Nombre') + '</span></td>' +
                                '<td class="py-2 small text-muted"><i class="fas fa-user text-muted me-1"></i>' + (c.vendedor || 'Sin vendedor') + '</td>' +
                                '<td class="text-end py-2 pe-3 text-nowrap"><span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 fw-bold"><i class="fas fa-calendar-alt me-1"></i>' + (c.fechaFormateada || '') + '</span></td>' +
                                '</tr>';
                            $tbody.append(row);
                        });
                    }
                }
            }
        });
    }

    // ========================================================
    // 6. STOCK Y CONSUMO DE INSUMOS CRÍTICOS
    // ========================================================
    function filtrarTablaInsumos() {
        var texto = ($('#filtro-stock-insumos').val() || '').toLowerCase();
        $('#tbody-stock-insumos tr').each(function() {
            var rowText = $(this).text().toLowerCase();
            if (rowText.indexOf(texto) > -1) {
                $(this).show();
            } else {
                $(this).hide();
            }
        });
    }

    function recargarStockInsumos() {
        var almId = parseInt($('#select-almacen-stock').val()) || 0;
        var sedeId = sedeGlobalSeleccionada > 0 ? sedeGlobalSeleccionada : null;
        var $icon = $('#icon-recargar-stock').addClass('fa-spin bi-spin');

        $.ajax({
            url: '@Url.Action("ObtenerStockInsumos", "Home")',
            type: 'GET',
            data: { almacenId: almId, sedeId: sedeId },
            success: function(res) {
                $icon.removeClass('fa-spin bi-spin');
                if (res && res.success && res.data) {
                    var $tbody = $('#tbody-stock-insumos').empty();
                    $('#span-cant-insumos-monitoreados').text(res.data.length);
                    if (res.data.length === 0) {
                        $tbody.append('<tr><td colspan="5" class="text-center text-muted py-4"><i class="fas fa-info-circle me-1"></i> No se encontraron saldos de insumos</td></tr>');
                    } else {
                        $.each(res.data, function(i, item) {
                            var badgeHtml = item.stockActual > 0
                                ? '<span class="badge bg-success px-2 py-1 fw-bold me-1"><i class="fas fa-check-circle me-1"></i>Disponible ' + item.stockActualFormateado + '</span>'
                                : '<span class="badge bg-danger px-2 py-1 fw-bold me-1"><i class="fas fa-times-circle me-1"></i>Agotado ' + item.stockActualFormateado + '</span>';

                            var row = '<tr>' +
