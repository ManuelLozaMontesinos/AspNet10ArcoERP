                                '<td class="py-2"><span class="fw-semibold text-body d-block">' + item.descripcion + '</span><small class="text-muted">Unidad: ' + item.unidadMedida + '</small></td>' +
                                '<td class="text-end py-2 font-monospace fw-bold text-warning">' + item.consumoMesFormateado + '</td>' +
