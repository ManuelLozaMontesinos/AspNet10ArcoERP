    // ========================================================
    // 8. AGENDA Y RECORDATORIOS
    // ========================================================
    var fechaInicioSemanaActual = new Date();
    function actualizarTextoRangoSemanal() {
        var curr = new Date(fechaInicioSemanaActual);
        var primer = curr.getDate() - curr.getDay() + (curr.getDay() === 0 ? -6 : 1);
        var primerDia = new Date(curr.setDate(primer));
        var ultimoDia = new Date(curr.setDate(primerDia.getDate() + 6));
        var mesesStr = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Set', 'Oct', 'Nov', 'Dic'];
        var txt = primerDia.getDate() + ' - ' + ultimoDia.getDate() + ' ' + mesesStr[ultimoDia.getMonth()] + ' ' + ultimoDia.getFullYear();
        $('#agenda-rango-semanal').text(txt);
    }

    function navegarAgendaSemana(offset) {
        if (offset === 0) {
            fechaInicioSemanaActual = new Date();
        } else {
            fechaInicioSemanaActual.setDate(fechaInicioSemanaActual.getDate() + (offset * 7));
        }
        actualizarTextoRangoSemanal();
        recargarEventosAgenda();
    }

    function cambiarAreaAgenda() {
        var areaId = $('#select-agenda-area').val();
        var areaNombre = $('#select-agenda-area option:selected').text();
        $('#footer-agenda-area').text(areaNombre);
        recargarEventosAgenda(areaId);
    }

    function recargarEventosAgenda(areaId) {
        areaId = areaId || $('#select-agenda-area').val() || 1;
        var $icon = $('#icon-recargar-agenda').addClass('fa-spin bi-spin');

        $.ajax({
            url: '@Url.Action("ObtenerEventosAgenda", "Home")',
            type: 'GET',
            data: { areaId: areaId },
            success: function(res) {
                $icon.removeClass('fa-spin bi-spin');
                if (res && res.success && res.data) {
                    var $cont = $('#lista-eventos-agenda').empty();
                    if (res.data.length === 0) {
                        $cont.append('<div class="text-center text-muted py-4" id="agenda-empty-msg"><i class="fas fa-calendar-check fs-2 text-secondary opacity-50 mb-2"></i><div class="small fw-semibold">No hay eventos programados para esta área</div></div>');
                    } else {
                        $.each(res.data, function(i, ev) {
                            var item = '<div class="agenda-event-item p-2 rounded bg-body-tertiary border shadow-sm" style="border-left-color: ' + (ev.color || '#0d6efd') + ' !important;">' +
                                '<div class="d-flex justify-content-between align-items-center mb-1">' +
                                '<span class="fw-bold text-body small">' + ev.titulo + '</span>' +
                                '<span class="badge bg-body border text-muted small"><i class="bi bi-clock me-1"></i>' + (ev.fechaInicioFormateada || '') + '</span>' +
                                '</div>' +
                                (ev.contexto ? '<p class="text-muted small mb-1">' + ev.contexto + '</p>' : '') +
                                '<div class="d-flex justify-content-between align-items-center text-xs text-muted">' +
                                '<span><i class="bi bi-tag-fill me-1" style="color: ' + (ev.color || '#0d6efd') + ';"></i>' + ev.areaNombre + '</span>' +
                                '<span><i class="bi bi-person me-1"></i>' + ev.usuarioLogon + '</span>' +
                                '</div>' +
                                '</div>';
                            $cont.append(item);
                        });
                    }
                }
            },
            error: function() {
                $icon.removeClass('fa-spin bi-spin');
            }
        });
    }

