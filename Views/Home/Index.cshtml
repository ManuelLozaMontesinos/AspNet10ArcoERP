                    <div class="dashboard-card-resize-bar" title="Arrastra hacia arriba o abajo para cambiar la altura del widget"><div class="resize-grip"></div></div>
                </div>
            </div>

            <!-- 5. SECCIÓN: TOP 10 PRODUCTOS CON MENOR STOCK -->
            <div class="col-12 mb-3 dashboard-draggable-card" id="row-top-menor-stock" data-widget-id="top-menor-stock">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-body border-bottom py-2 px-3 d-flex flex-wrap justify-content-between align-items-center" style="gap: 8px;">
